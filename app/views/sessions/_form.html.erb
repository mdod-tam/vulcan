<div id="sign_in_form">
  <% if @errors&.any? %>
    <div id="signin-error-summary"
         role="alert"
         aria-labelledby="signin-error-heading"
         tabindex="-1"
         data-controller="error-summary"
         class="bg-red-50 border border-red-400 text-red-700 p-4 rounded mb-6 focus:outline-none focus:ring-2 focus:ring-red-500">
      <h2 id="signin-error-heading" class="sr-only"><%= t("sessions.form.error_heading") %></h2>
      <ul class="list-disc list-inside">
        <% @errors.each do |field, msg| %>
            <li><a href="#<%= field %>-input" class="underline" data-action="click->error-summary#focus"><%= msg %></a></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: sign_in_path(locale: public_request_locale_param),
                local: true,
                class: "space-y-6",
                aria: { labelledby: "signin-heading" },
                data: { controller: "visibility" } do |form| %>

  <div class="space-y-1" role="group" aria-labelledby="contact-input-label">
    <%= form.label :contact, t("sessions.form.contact_label"),
        for: "contact-input",
        id: "contact-input-label",
        class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :contact,
        id: "contact-input",
        class: "mt-1 block w-full px-4 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
        value: "",
        required: true,
        autocomplete: "username",
        autofocus: true,
        "aria-required": "true",
        "aria-invalid": (@errors&.include?(:contact) ? "true" : "false"),
        "aria-describedby": (["contact-hint", (@errors&.include?(:contact) ? "contact-error" : nil)].compact.join(" ")) %>
    <p id="contact-hint" class="text-xs text-gray-500"><%= t("sessions.form.contact_hint") %></p>
    <% if @errors&.include?(:contact) %>
      <p id="contact-error" class="mt-1 text-sm text-red-600">
        <%= @errors[:contact] %>
      </p>
    <% end %>
  </div>

  <%= render 'shared/password_field',
             form: form,
             attribute: :password,
             id: 'password-input',
             label_id: 'password-input-label',
             label: t('sessions.form.password_label'),
             autocomplete: 'current-password',
             hint: t('sessions.form.password_hint'),
             errors: Array(@errors&.[](:password)) %>

  <%= form.submit t("sessions.form.submit"),
      class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
      "data-disable-with": t("sessions.form.submitting"),
      "aria-busy": "true",
      "aria-label": t("sessions.form.submit_aria") %>

  <div class="text-center" role="contentinfo">
    <%= link_to t("sessions.form.forgot_password"),
      new_password_path(locale: public_request_locale_param),
      class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded",
      "aria-label": t("sessions.form.forgot_password_aria") %>
    <p class="text-sm text-gray-600">
      <%= t("sessions.form.sign_up_prompt") %>
      <%= link_to t("sessions.form.sign_up"),
          sign_up_path(locale: public_request_locale_param),
          class: "ml-1 font-medium text-indigo-600 hover:text-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded",
          "aria-label": t("sessions.form.sign_up_aria") %>
    </p>
  </div>
  <% end %>
</div>
