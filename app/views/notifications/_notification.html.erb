<li class="p-4 hover:bg-gray-50 transition-colors duration-150 flex items-start" id="notification_<%= notification.id %>">
  <div class="flex-shrink-0 mr-3">
    <span class="inline-flex items-center justify-center h-8 w-8 rounded-full <%= notification_icon_classes(notification) %>">
      <% case notification_icon_type(notification)
        when :training_requested %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8m-8 4h5m-7 7h12a2 2 0 002-2V7a2 2 0 00-2-2h-3.586a1 1 0 01-.707-.293l-1.414-1.414A1 1 0 0011.586 3H6a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      <% when :trainer_assigned %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      <% when :medical %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      <% when :approved %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      <% when :rejected %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      <% when :documents %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
        </svg>
      <% else %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% end %>
    </span>
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex justify-between">
      <p class="text-sm font-medium text-gray-900 <%= notification.read_at.nil? ? 'font-semibold' : '' %>">
        <%= notification.message(current_user) %>
      </p>
      <% if notification.read_at.nil? %>
        <%= button_to mark_as_read_notification_path(notification), method: :post,
                                                                    class: [
                                                                      'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium',
                                                                      'bg-blue-100 text-blue-800 hover:bg-blue-200 transition-colors'
                                                                    ],
                                                                    form: { 'data-turbo' => true } do %>
          <%= t('notification_delivery.mark_as_read', locale: notification_viewer_locale) %>
        <% end %>
      <% end %>
    </div>

    <p class="text-xs text-gray-500 mt-1">
      <%= t('notification_delivery.ago', time: time_ago_in_words(notification.created_at, locale: notification_viewer_locale), locale: notification_viewer_locale) %>
    </p>

    <%= delivery_visibility(notification, locale: notification_viewer_locale, diagnostics: current_user.admin?) %>
    <% if current_user.admin? && notification.email_tracking? %>
      <%= button_to t('notification_delivery.check_status', locale: notification_viewer_locale), check_email_status_notification_path(notification),
                    method: :post, class: 'mt-2 rounded border px-3 py-2 text-sm text-indigo-700 focus:ring-2 focus:ring-indigo-500' %>
    <% end %>
  </div>
</li>
