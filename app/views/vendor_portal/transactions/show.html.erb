<% shipments = @transaction.shipments.reject(&:new_record?) %>
<div class="max-w-4xl mx-auto">
  <div class="md:flex md:items-center md:justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Purchase <%= @transaction.reference_number %></h1>
    <%= link_to 'Back to Transaction History', vendor_portal_transactions_path,
                class: 'mt-4 md:mt-0 inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
  </div>

  <section aria-labelledby="purchase-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="purchase-heading" class="text-lg font-medium text-gray-900 mb-4">Purchase details</h2>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">Date</dt>
        <dd class="text-sm text-gray-900"><%= @transaction.processed_at.strftime('%B %d, %Y %I:%M %p') %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Customer</dt>
        <dd class="text-sm text-gray-900"><%= @transaction.voucher.application&.user&.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Voucher</dt>
        <dd class="text-sm text-gray-900"><%= @transaction.voucher.code %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Amount</dt>
        <dd class="text-sm text-gray-900"><%= number_to_currency(@transaction.amount) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="text-sm text-gray-900"><%= voucher_transaction_status_badge(@transaction) %></dd>
      </div>
      <% if @transaction.products.any? %>
        <div>
          <dt class="text-sm font-medium text-gray-500">Products</dt>
          <dd class="text-sm text-gray-900"><%= @transaction.products.map(&:name).to_sentence %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% if @transaction.fulfillable? %>
    <section aria-labelledby="fulfillment-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <h2 id="fulfillment-heading" class="text-lg font-medium text-gray-900">Fulfillment</h2>
        <%= fulfillment_status_badge(@transaction) %>
      </div>

      <%= form_with url: vendor_portal_transaction_path(@transaction), method: :patch, class: 'space-y-4' do |f| %>
        <%= hidden_field_tag :fulfillment_version, @expected_version, id: nil %>
        <fieldset>
          <legend class="text-sm font-medium text-gray-700">How does the customer get this order?</legend>
          <div class="mt-2 space-y-2">
            <% [['shipping', 'We ship it'], ['local_pickup', 'The customer picks it up']].each do |value, label| %>
              <div class="flex items-center">
                <%= radio_button_tag :fulfillment_mode, value, @transaction.fulfillment_mode == value,
                                     required: true, class: 'h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500' %>
                <%= label_tag "fulfillment_mode_#{value}", label, class: 'ml-3 text-sm text-gray-700' %>
              </div>
            <% end %>
          </div>
        </fieldset>
        <%= f.submit 'Save fulfillment',
                     class: 'inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
      <% end %>
    </section>

    <section aria-labelledby="packages-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 id="packages-heading" class="text-lg font-medium text-gray-900 mb-1">Packages</h2>
      <p class="text-sm text-gray-500 mb-4">Record each package's tracking number. The customer and program staff can see it. Tracking does not confirm delivery or acceptance.</p>

      <% if shipments.any? %>
        <ul role="list" class="divide-y divide-gray-200 mb-6">
          <% shipments.each do |shipment| %>
            <% correction = @invalid_correction&.id == shipment.id ? @invalid_correction : shipment %>
            <li class="py-4">
              <p class="text-sm font-medium text-gray-900 break-all"><%= shipment.tracking_number %></p>
              <p class="text-sm text-gray-500">
                <%= shipment.dispatched? ? "Ship date: #{shipment.dispatched_on.strftime('%B %d, %Y')}" : 'Ship date not recorded' %>
              </p>
              <% if shipment.contents.present? %>
                <p class="text-sm text-gray-700 mt-1"><%= shipment.contents %></p>
              <% end %>
              <details class="mt-2" <%= 'open' if correction.errors.any? %>>
                <summary class="text-sm text-indigo-600 hover:text-indigo-900 cursor-pointer">Correct this package</summary>
                <div class="mt-3">
                  <%= render 'vendor_portal/shipments/form', transaction: @transaction, shipment: correction %>
                </div>
              </details>
            </li>
          <% end %>
        </ul>
      <% end %>

      <h3 class="text-base font-medium text-gray-900 mb-2"><%= shipments.any? ? 'Add another package' : 'Add a package' %></h3>
      <% if @transaction.fulfillment_local_pickup? %>
        <p class="text-sm text-gray-600 mb-2">This purchase is set to local pickup. Saving a tracking number changes it to shipping.</p>
      <% end %>
      <%= render 'vendor_portal/shipments/form', transaction: @transaction, shipment: @new_shipment, expected_version: @expected_version %>
    </section>
  <% end %>
</div>
