<main class="container mx-auto px-4 py-8" role="main">
  <div class="max-w-7xl mx-auto">
    <div class="md:flex md:items-center md:justify-between mb-8">
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl font-bold text-gray-900">Transaction History</h1>
      </div>
      <div class="mt-4 flex flex-wrap gap-4 md:mt-0 md:ml-4">
        <%= link_to vendor_portal_transactions_path(format: :csv, **request.query_parameters.except('page')),
                    class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium ' \
                           'text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' do %>
          <svg class="-ml-1 mr-2 h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Export CSV
        <% end %>

        <%= link_to vendor_portal_dashboard_path,
                    class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium ' \
                           'text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' do %>
          Back to Dashboard
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white shadow rounded-lg mb-8">
      <div class="px-4 py-5 sm:p-6">
        <%= form_with url: vendor_portal_transactions_path, method: :get, class: 'space-y-6', data: { controller: 'date-range' },
                      aria: { describedby: 'transaction-date-hint' } do |f| %>
          <p id="transaction-date-hint" class="text-sm text-gray-600"><%= t('.date_hint') %></p>
          <% if @filter_errors.any? %>
            <div id="transaction-filter-errors" role="alert" class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
              <h2 class="font-semibold"><%= t('.filter_errors') %></h2>
              <ul class="mt-2 list-disc pl-5">
                <% @filter_errors.each do |error| %>
                  <li><%= error %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
            <div class="sm:col-span-2">
              <%= f.label :period, 'Time Period', class: 'block text-sm font-medium text-gray-700' %>
              <div class="mt-1">
                <%= f.select :period,
                             options_for_select([
                                                  [t('.periods.all'), nil],
                                                  [t('.periods.today'), 'today'],
                                                  [t('.periods.week'), 'week'],
                                                  [t('.periods.month'), 'month'],
                                                  [t('.periods.custom'), 'custom']
                                                ], params[:period]),
                             {},
                             class: 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md',
                             data: { action: 'change->date-range#toggleCustomRange' } %>
              </div>
            </div>

            <div class="sm:col-span-2 <%= 'hidden' unless params[:period] == 'custom' %>" data-date-range-target="customRange">
              <%= f.label :start_date, 'Start Date', class: 'block text-sm font-medium text-gray-700' %>
              <div class="mt-1">
                <%= f.text_field :start_date,
                                 value: accessible_date_value(params[:start_date]),
                                 **typed_date_field_options(aria: { describedby: "transaction-date-hint#{' transaction-filter-errors' if @filter_errors.any?}",
                                                                    invalid: @filter_errors.any? }),
                                 class: 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md' %>
              </div>
            </div>

            <div class="sm:col-span-2 <%= 'hidden' unless params[:period] == 'custom' %>" data-date-range-target="customRange">
              <%= f.label :end_date, 'End Date', class: 'block text-sm font-medium text-gray-700' %>
              <div class="mt-1">
                <%= f.text_field :end_date,
                                 value: accessible_date_value(params[:end_date]),
                                 **typed_date_field_options(aria: { describedby: "transaction-date-hint#{' transaction-filter-errors' if @filter_errors.any?}",
                                                                    invalid: @filter_errors.any? }),
                                 class: 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md' %>
              </div>
            </div>
          </div>

          <div class="flex items-center">
            <%= f.check_box :needs_shipping_details,
                            { checked: params[:needs_shipping_details] == '1',
                              class: 'h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500' }, '1', nil %>
            <%= f.label :needs_shipping_details, 'Only purchases that need shipping details', class: 'ml-2 text-sm text-gray-700' %>
          </div>

          <div class="flex justify-end">
            <%= f.submit 'Apply Filters',
                         class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md ' \
                                'text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
          </div>
        <% end %>
      </div>
    </div>

    <p class="mb-4 text-sm font-medium text-gray-700"><%= t('.summary', count: @transaction_count, amount: number_to_currency(@total_amount)) %></p>

    <!-- Transactions Table -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Voucher</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fulfillment</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @transactions.each do |transaction| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= transaction.processed_at.strftime('%B %d, %Y %I:%M %p') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= transaction.voucher.code %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= number_to_currency(transaction.amount) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= voucher_transaction_status_badge(transaction) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= link_to transaction.reference_number, vendor_portal_transaction_path(transaction),
                              class: 'text-indigo-600 hover:text-indigo-900',
                              aria: { label: "View purchase #{transaction.reference_number}" } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if transaction.invoice %>
                    <%= link_to transaction.invoice.invoice_number, vendor_portal_invoice_path(transaction.invoice),
                                class: 'text-indigo-600 hover:text-indigo-900' %>
                  <% elsif transaction.on_billing_hold? %>
                    <span class="text-amber-800">On hold — contact the program</span>
                  <% else %>
                    <span class="text-gray-500">Not yet invoiced</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= fulfillment_status_badge(transaction) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @transactions.empty? %>
        <p class="px-6 py-4 text-sm text-gray-500">No transactions match these filters.</p>
      <% end %>

      <%= render 'shared/pagination', pagy: @pagy, label: t('pagination.transactions') %>
    </div>
  </div>
</main>
