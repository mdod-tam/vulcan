<main class="container mx-auto px-4 py-8" role="main">
  <div class="max-w-7xl mx-auto">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-bold text-gray-900">Vendor Dashboard</h1>
      <div class="flex flex-wrap items-start gap-4">
        <% if current_user.can_process_vouchers? %>
          <%= link_to vendor_portal_vouchers_path,
                      class: 'btn btn-primary' do %>
            Process Voucher
          <% end %>
        <% else %>
          <%# The server refuses voucher work for an unapproved vendor anyway; this says so up front. %>
          <div class="flex flex-col items-end">
            <span aria-disabled="true" aria-describedby="process-voucher-unavailable"
                  class="btn bg-gray-200 text-gray-600 shadow-none cursor-not-allowed">
              Process Voucher
            </span>
            <p id="process-voucher-unavailable" class="mt-1 text-sm text-gray-600"><%= t('alerts.vendor_not_approved_for_vouchers') %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card mb-8">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-medium text-gray-900">Business Information</h2>
          <%= link_to "Edit Profile", edit_vendor_portal_profile_path, class: 'text-sm font-medium text-primary-600 hover:text-primary-500' %>
        </div>
        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
          <div class="sm:col-span-3">
            <h3 class="text-sm font-medium text-gray-500">Business Name</h3>
            <p class="mt-1 text-sm text-gray-900"><%= current_user.business_name %></p>
          </div>
          <% if current_user.website_url.present? %>
            <div class="sm:col-span-3">
              <h3 class="text-sm font-medium text-gray-500">Website</h3>
              <p class="mt-1 text-sm text-gray-900">
                <%= link_to current_user.website_url, current_user.website_url, class: 'text-primary-600 hover:text-primary-500', target: "_blank" %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%= render 'vendor_portal/shared/onboarding_guidance', vendor: current_user %>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-8">
      <%# What the vendor is owed: not yet on an invoice, and invoiced but unpaid. %>
      <div class="card overflow-hidden">
        <div class="p-5">
          <dl>
            <dt class="text-sm font-medium text-gray-500">Not yet invoiced</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= number_to_currency(@not_yet_invoiced_total) %></dd>
          </dl>
          <p class="mt-1 text-sm text-gray-500">
            Goes on the next invoice.
            <% if @on_hold_count.positive? %>Not included: <%= pluralize(@on_hold_count, 'voucher redemption') %> on hold — contact the program.<% end %>
          </p>
        </div>
        <div class="bg-gray-50 px-5 py-3">
          <%= link_to 'View transactions', vendor_portal_transactions_path, class: 'text-sm font-medium text-primary-700 hover:text-primary-900' %>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="p-5">
          <dl>
            <dt class="text-sm font-medium text-gray-500">Invoiced, awaiting payment</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= number_to_currency(@awaiting_payment_total) %></dd>
          </dl>
          <p class="mt-1 text-sm text-gray-500">On invoices not yet paid.</p>
        </div>
        <div class="bg-gray-50 px-5 py-3">
          <%= link_to 'View invoices', vendor_portal_invoices_path, class: 'text-sm font-medium text-primary-700 hover:text-primary-900' %>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">This Month's Total</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900">
                    <%= number_to_currency(@monthly_totals[@months.last] || 0) %>
                  </div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 px-5 py-3">
          <%= link_to vendor_portal_transactions_path(period: "month"), class: 'text-sm font-medium text-primary-700 hover:text-primary-900' do %>
            View month details
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-8">
      <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-900">Recent Transactions</h2>
        <%= link_to "View All", vendor_portal_transactions_path, class: 'text-sm font-medium text-primary-600 hover:text-primary-500' %>
      </div>
      <div class="border-t border-gray-200">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Voucher</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product & Status</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @recent_transactions.each do |transaction| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= transaction.processed_at.strftime("%B %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= masked_voucher_code(transaction.voucher.code) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= number_to_currency(transaction.amount) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if primary_product = transaction.voucher_transaction_products.first&.product %>
                      <span class="block text-sm text-gray-800 mb-1"><%= primary_product.name %></span>
                    <% end %>
                    <%= voucher_transaction_status_badge(transaction) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card" data-controller="chart-toggle">
      <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
        <h2 id="monthly-totals-heading" class="text-lg font-medium text-gray-900">Monthly Totals</h2>
        <button type="button" 
                data-chart-toggle-target="button"
                aria-expanded="false"
                aria-controls="monthly-totals-chart"
                data-action="chart-toggle#toggle" 
                class="text-sm font-medium text-primary-600 hover:text-primary-500">
          Show Chart
        </button>
      </div>
      
      <div class="border-t border-gray-200">
        <div class="overflow-x-auto">
          <table id="monthly-totals-table" aria-labelledby="monthly-totals-heading" class="min-w-full divide-y divide-gray-200">
            <caption class="sr-only">Monthly transaction totals for the past 6 months. This table provides the same data as the chart below.</caption>
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @months.each do |month| %>
                <% month_total = @monthly_totals[month] || 0 %>
                <% if month_total > 0 %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= link_to month.strftime("%B %Y"), vendor_portal_transactions_path(
                        period: "custom",
                        start_date: month.beginning_of_month.strftime("%Y-%m-%d"),
                        end_date: month.end_of_month.strftime("%Y-%m-%d")
                      ), class: 'text-primary-600 hover:text-primary-900' %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= number_to_currency(month_total) %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <div id="chart-description" class="sr-only">
        This chart displays the total voucher amounts processed each month for the past 6 months.
        <% if @monthly_totals_chart.present? %>
          The highest monthly total was <%= number_to_currency(@highest_month_total) %> in <%= @highest_month.strftime('%B %Y') %>.
        <% else %>
          No transaction data is available for this period.
        <% end %>
      </div>
      
      <div id="monthly-totals-chart" data-chart-toggle-target="chart" class="hidden p-6 border-t border-gray-200">
        <div data-controller="chart"
             data-chart-data-value="<%= @monthly_totals_chart.to_json %>"
             data-chart-format-value="currency"
             data-chart-dataset-label-value="Monthly Total"
             data-chart-y-axis-label-value="Amount in USD"
             class="relative h-[300px] w-full">
          <canvas data-chart-target="canvas" role="img" aria-label="Monthly voucher totals" aria-describedby="chart-description"></canvas>
        </div>
      </div>
    </div>
  </div>
</main>
