<main class="container mx-auto px-4 py-8" role="main">
  <div class="max-w-3xl mx-auto">
    <div class="md:flex md:items-center md:justify-between mb-8">
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl font-bold text-gray-900">Vendor Profile</h1>
      </div>
      <div class="mt-4 flex md:mt-0 md:ml-4">
        <%= link_to vendor_portal_dashboard_path,
            class: 'btn btn-outline' do %>
          Back to Dashboard
        <% end %>
      </div>
    </div>

    <%= render 'vendor_portal/shared/onboarding_guidance', vendor: @vendor %>

    <%= form_with model: @vendor, url: vendor_portal_profile_path, local: true, class: "space-y-8" do |f| %>
      <% if @vendor.errors.any? %>
        <div class="rounded-md bg-danger-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-danger-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-danger-800">
                <%= pluralize(@vendor.errors.count, "error") %> prevented your profile from being saved:
              </h3>
              <div class="mt-2 text-sm text-danger-700">
                <ul class="list-disc pl-5 space-y-1">
                  <% @vendor.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4">Business Information</h2>
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :business_name, class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :business_name,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>

            <div class="sm:col-span-4">
              <%= f.label :business_tax_id, t('vendor_tax_records.tax_id_label'), class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :business_tax_id, value: '', autocomplete: 'off', 'aria-describedby': 'vendor-tax-id-hint',
                                                   class: 'form-input',
                                                   required: @vendor.business_tax_id.blank? %>
              </div>
              <p id="vendor-tax-id-hint" class="form-hint">
                <%= t('vendor_tax_records.keep_tax_id') %>
              </p>
            </div>

            <div class="sm:col-span-4">
              <%= f.label :website_url, "Website URL", class: 'form-label' %>
              <div class="mt-1">
                <%= f.url_field :website_url,
                    class: 'form-input',
                    placeholder: "https://www.example.com" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">
                Enter your company website URL (optional)
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4">Contact Information</h2>
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :physical_address_1, "Address Line 1", class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :physical_address_1,
                    class: 'form-input',
                    required: true %>
              </div>
              <p class="mt-2 text-sm text-gray-500">
                Must match the address on your W9 form.
              </p>
            </div>
            <div class="sm:col-span-4">
              <%= f.label :physical_address_2, "Address Line 2", class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :physical_address_2,
                    class: 'form-input' %>
              </div>
            </div>
            <div class="sm:col-span-2">
              <%= f.label :city, "City", class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :city,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>
            <div class="sm:col-span-2">
              <%= f.label :state, "State", class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :state,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>
            <div class="sm:col-span-2">
              <%= f.label :zip_code, "Zip Code", class: 'form-label' %>
              <div class="mt-1">
                <%= f.text_field :zip_code,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>
            <div class="sm:col-span-2">
              <%= f.label :phone, "Phone", class: 'form-label' %>
              <div class="mt-1">
                <%= f.telephone_field :phone,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>
            <div class="sm:col-span-4">
              <%= f.label :email, "Email", class: 'form-label' %>
              <div class="mt-1">
                <%= f.email_field :email,
                    class: 'form-input',
                    required: true %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4">W9 Form</h2>
          
          <% if @stored_w9 %>
            <div class="mb-4 p-4 bg-gray-50 rounded-md">
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-success-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-gray-700">
                    Current W9 form: <%= @stored_w9.filename %>
                  </p>
                  <div class="mt-2">
                    <%= link_to 'View Current W9',
                                vendor_w9_document_path(@vendor, @stored_w9, disposition: 'inline'),
                                class: 'text-sm text-primary-600 hover:text-primary-500',
                                target: '_blank', rel: 'noopener' %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="mt-2">
            <%= f.label :w9_form, "Upload New W9", class: 'form-label' %>
            <p id="w9_form_help" class="form-hint">
              Accepted formats: <%= proof_upload_formats_label %>. Files must be smaller than <%= ProofUploadFormats.max_megabytes(:w9) %>MB.
            </p>
            <div class="mt-2">
              <%= render 'shared/document_upload',
                         form: f, field: 'w9_form', model: Users::Vendor, input_id: 'users_vendor_w9_form',
                         blob: @retained_w9, described_by: 'w9_form_help', retained_reference: @retained_w9_reference %>
            </div>
          </div>
        </div>
      </div>

      <% terms_locale = I18n.locale %> <%# erb_lint:disable Rubocop %>
      <div class="card" lang="<%= terms_locale %>">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4"><%= t('vendor_onboarding.terms.title', locale: terms_locale) %></h2>
          <% if @vendor.terms_accepted_at_in_database.present? %>
            <p class="text-sm text-gray-700">
              <%= t('vendor_onboarding.terms.accepted_on',
                    date: l(@vendor.terms_accepted_at_in_database.to_date, format: :long, locale: terms_locale), locale: terms_locale) %>
            </p>
          <% elsif VendorTerms.available? %>
            <div class="relative flex items-start">
              <%= f.check_box :terms_accepted, class: 'mt-1 h-5 w-5 rounded border-gray-300 text-primary-600' %>
              <div class="ml-3 text-sm">
                <%= f.label :terms_accepted, t('vendor_onboarding.terms.acceptance_label', locale: terms_locale), class: 'font-medium text-gray-700' %>
                <p class="mt-1 text-gray-600">
                  <%= t('vendor_onboarding.terms.acceptance_help', locale: terms_locale) %>
                </p>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-700"><%= t('vendor_onboarding.terms.unavailable', locale: terms_locale) %></p>
          <% end %>
          <%= link_to t('vendor_onboarding.terms.review', locale: terms_locale), terms_path(locale: terms_locale),
                      class: 'mt-3 inline-flex min-h-11 items-center text-sm font-medium text-primary-700 underline hover:text-primary-500' %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save Changes",
            class: 'btn btn-primary ml-3' %>
      </div>
    <% end %>
  </div>
</main>
