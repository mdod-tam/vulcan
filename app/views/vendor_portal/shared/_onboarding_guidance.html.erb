<%# locals: (vendor:, state: vendor_onboarding_state(vendor), locale: vendor.locale.presence || I18n.default_locale) -%>
<section lang="<%= locale %>" aria-labelledby="vendor-onboarding-heading"
         class="mb-8 rounded-lg border border-blue-200 bg-blue-50 p-4 sm:p-6" data-vendor-onboarding-state="<%= state %>">
  <h2 id="vendor-onboarding-heading" class="text-lg font-semibold text-blue-950"><%= t("vendor_onboarding.states.#{state}.title", locale: locale) %></h2>
  <p class="mt-2 text-sm text-blue-950"><%= t("vendor_onboarding.states.#{state}.body", locale: locale) %></p>
  <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-semibold text-blue-950"><%= t('vendor_onboarding.w9_label', locale: locale) %></dt>
      <dd class="text-blue-950"><%= t("vendor_onboarding.w9_statuses.#{vendor.w9_status}", locale: locale) %></dd>
    </div>
    <div>
      <dt class="font-semibold text-blue-950"><%= t('vendor_onboarding.authorization_label', locale: locale) %></dt>
      <dd class="text-blue-950"><%= t("vendor_onboarding.authorization_statuses.#{vendor.vendor_authorization_status}", locale: locale) %></dd>
    </div>
  </dl>
  <% if action_path = vendor_onboarding_action_path(state, locale: locale) %>
    <%= link_to t("vendor_onboarding.states.#{state}.action", locale: locale), action_path,
                class: 'mt-4 inline-flex min-h-11 items-center rounded-md px-3 py-2 font-medium text-blue-900 underline ' \
                       'hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:ring-offset-2' %>
  <% end %>
</section>
