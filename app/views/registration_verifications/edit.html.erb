<a href="#signup-form"
   class="skip-link"
   role="link"
   aria-label="<%= t('portal_self_service.registrations.skip_to_form') %>">
  <%= t('portal_self_service.registrations.skip_to_form') %>
</a>

<div class="flex items-center justify-center bg-gray-100 px-4 py-12">
  <div class="card p-6 sm:p-8 w-full max-w-md">
    <header>
      <h1 id="signup-heading" class="text-2xl font-semibold mb-6 text-center text-gray-900">
        <%= t('registration_verification.complete_title') %>
      </h1>
    </header>

    <p class="text-center text-base text-gray-900">
      <span class="text-danger-700">*</span> <%= t('portal_self_service.registrations.required_indicator') %>
    </p>

    <section aria-labelledby="signup-heading">
      <%= form_with model: @user,
                    scope: :user,
                    url: registration_verification_path(token: params[:token]),
                    method: :patch,
                    local: true,
                    id: 'signup-form',
                    aria: { labelledby: 'signup-heading' } do |form| %>

        <% if @user.errors[:base].any? %>
          <div role="alert" aria-live="assertive" aria-atomic="true"
               class="flash-message flash-error">
            <ul>
              <% @user.errors[:base].each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <fieldset class="mb-4">
          <legend class="sr-only"><%= t('portal_self_service.registrations.name_legend') %></legend>
          <div class="mb-4">
            <%= form.label :first_name, t('portal_self_service.registrations.first_name_label'), class: 'form-label mb-1 required-label' %>
            <%= form.text_field :first_name, required: true, autofocus: true,
                                             class: 'form-input',
                                             aria: { required: 'true', invalid: @user.errors[:first_name].any?, errormessage: 'first-name-error' } %>
            <% if @user.errors[:first_name].any? %>
              <p id="first-name-error" role="alert" class="mt-1 text-sm text-danger-600"><%= @user.errors[:first_name].join(', ') %></p>
            <% end %>
          </div>
          <div class="mb-4">
            <%= form.label :middle_initial, t('portal_self_service.registrations.middle_initial_label'), class: 'form-label mb-1' %>
            <%= form.text_field :middle_initial, maxlength: 1,
                                                 class: 'form-input' %>
          </div>
          <div class="mb-4">
            <%= form.label :last_name, t('portal_self_service.registrations.last_name_label'), class: 'form-label mb-1 required-label' %>
            <%= form.text_field :last_name, required: true,
                                            class: 'form-input',
                                            aria: { required: 'true', invalid: @user.errors[:last_name].any?, errormessage: 'last-name-error' } %>
            <% if @user.errors[:last_name].any? %>
              <p id="last-name-error" role="alert" class="mt-1 text-sm text-danger-600"><%= @user.errors[:last_name].join(', ') %></p>
            <% end %>
          </div>
        </fieldset>

        <p class="mb-4"><%= t('registration_verification.verified_email', email: @verification.email) %></p>
        <p class="form-hint mb-4"><%= t('registration_verification.phone_later') %></p>

        <fieldset class="mb-4">
          <legend class="sr-only"><%= t('portal_self_service.registrations.security_legend') %></legend>
          <div class="mb-4">
            <%= render 'shared/password_field',
                       form: form,
                       attribute: :password,
                       label: t('portal_self_service.registrations.password_label'),
                       autocomplete: 'new-password',
                       new_password: true,
                       required_marker: true,
                       errors: @user.errors[:password] %>
          </div>
          <div class="mb-4">
            <%= render 'shared/password_field',
                       form: form,
                       attribute: :password_confirmation,
                       label: t('portal_self_service.registrations.password_confirmation_label'),
                       autocomplete: 'new-password',
                       required_marker: true,
                       errors: @user.errors[:password_confirmation] %>
          </div>
        </fieldset>

        <div class="mb-4">
          <%= form.label :date_of_birth, t('shared.date_of_birth.label'), class: 'form-label mb-1 required-label' %>
          <%= date_of_birth_text_field form,
                                       required: true,
                                       value: date_of_birth_input_value(@user),
                                       class: 'form-input',
                                       aria: { required: 'true', invalid: @user.errors[:date_of_birth].any?, errormessage: 'dob-error', describedby: 'dob-hint' } %>
          <p id="dob-hint" class="form-hint"><%= t('shared.date_of_birth.hint') %></p>
          <% if @user.errors[:date_of_birth].any? %>
            <p id="dob-error" role="alert" class="mt-1 text-sm text-danger-600"><%= @user.errors[:date_of_birth].join(', ') %></p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= form.label :locale, t('portal_self_service.registrations.language_preference_label'), class: 'form-label mb-1 required-label' %>
          <%= form.select :locale,
                          [
                            [t('portal_self_service.registrations.language_options.en'), 'en'],
                            [t('portal_self_service.registrations.language_options.es'), 'es']
                          ],
                          { prompt: t('portal_self_service.registrations.language_prompt') },
                          class: 'form-input',
                          required: true,
                          aria: { required: 'true', invalid: @user.errors[:locale].any?, errormessage: 'locale-error', describedby: 'language-hint' } %>
          <p id="language-hint" class="form-hint"><%= t('portal_self_service.registrations.language_hint') %></p>
          <% if @user.errors[:locale].any? %>
            <p id="locale-error" role="alert" class="mt-1 text-sm text-danger-600"><%= @user.errors[:locale].join(', ') %></p>
          <% end %>
        </div>

        <fieldset class="mb-4" data-controller="delivery-preference">
          <legend id="comm-pref-legend" class="form-label mb-1"><%= t('portal_self_service.registrations.notification_method_label') %></legend>
          <div class="space-y-2">
            <div class="flex items-center">
              <%= form.radio_button(
                    :communication_preference, 'email', id: 'pref_email', class: 'h-4 w-4',
                                                        data: { action: 'delivery-preference#togglePreference', delivery_preference_target: 'emailRadio' }
                  ) %>
              <%= form.label :communication_preference_email, t('portal_self_service.registrations.notification_email_label'), for: 'pref_email',
                                                                                                                               class: 'ml-3 text-sm text-gray-700' %>
            </div>
            <div class="flex items-center">
              <%= form.radio_button(
                    :communication_preference, 'letter', id: 'pref_letter', class: 'h-4 w-4',
                                                         data: { action: 'delivery-preference#togglePreference', delivery_preference_target: 'letterRadio' }
                  ) %>
              <%= form.label :communication_preference_letter, t('portal_self_service.registrations.notification_letter_label'), for: 'pref_letter',
                                                                                                                                 class: 'ml-3 text-sm text-gray-700' %>
            </div>
          </div>

          <div id="mail-notice" class="mt-2 p-3 bg-warning-50 border border-warning-200 rounded text-sm text-warning-800 hidden" aria-hidden="true" data-delivery-preference-target="notice">
            <p><strong><%= t('portal_self_service.registrations.mail_notice_label') %></strong> <%= t('portal_self_service.registrations.mail_notice') %></p>
          </div>

          <div id="address_fields" class="mt-4 hidden" aria-hidden="true" data-delivery-preference-target="addressFields">
            <div class="mb-4">
              <%= form.label :physical_address_1, t('portal_self_service.registrations.street_address_label'), class: 'form-label mb-1 required-label' %>
              <%= form.text_field :physical_address_1, disabled: true,
                                                       class: 'form-input' %>
            </div>
            <div class="mb-4">
              <%= form.label :physical_address_2, t('portal_self_service.registrations.address_2_label'), class: 'form-label mb-1' %>
              <%= form.text_field :physical_address_2, disabled: true,
                                                       class: 'form-input' %>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <%= form.label :city, t('portal_self_service.registrations.city_label'), class: 'form-label mb-1 required-label' %>
                <%= form.text_field :city, disabled: true,
                                           class: 'form-input' %>
              </div>
              <div>
                <%= form.label :state, t('portal_self_service.registrations.state_label'), class: 'form-label mb-1 required-label' %>
                <%= form.select :state,
                                us_states_options,
                                { selected: @user.state || 'MD' },
                                { disabled: true,
                                  class: 'form-input' } %>
              </div>
              <div>
                <%= form.label :zip_code, t('portal_self_service.registrations.zip_code_label'), class: 'form-label mb-1 required-label' %>
                <%= form.text_field :zip_code, disabled: true, placeholder: '12345', pattern: '[0-9]{5}(-[0-9]{4})?',
                                               class: 'form-input' %>
              </div>
            </div>
          </div>
        </fieldset>

        <div class="mb-4">
          <div class="flex items-start">
            <%= form.check_box :newsletter_signup,
                               id: 'newsletter_signup',
                               class: 'mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded' %>
            <%= form.label :newsletter_signup,
                           t('portal_self_service.registrations.newsletter_signup'),
                           class: 'ml-2 block text-sm text-gray-700' %>
          </div>
        </div>

        <div class="mb-4">
          <%= form.submit t('portal_self_service.registrations.submit'),
                          class: 'btn btn-primary w-full',
                          data: { turbo_submits_with: t('portal_self_service.registrations.submitting') } %>
        </div>

        <footer class="text-center">
            <p class="text-sm text-gray-700"><%= t('portal_self_service.registrations.sign_in_prompt') %>
              <%= link_to t('portal_self_service.registrations.sign_in_link'),
                          sign_in_path(locale: public_form_locale_param),
                          class: 'font-medium text-primary-600 hover:text-primary-500' %></p>
        </footer>

      <% end %>
    </section>
  </div>
</div>
