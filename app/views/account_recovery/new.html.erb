<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-12">
  <div class="card p-6 sm:p-8 w-full max-w-md">
    <h1 class="text-2xl font-semibold mb-6 text-center text-gray-900"><%= t("portal_self_service.account_recovery.title") %></h1>

    <div class="mb-6 p-4 bg-warning-50 border border-warning-300 rounded-md">
      <p class="text-sm text-warning-700">
        <strong><%= t("portal_self_service.account_recovery.note_label") %></strong>
        <%= t("portal_self_service.account_recovery.note") %>
      </p>
    </div>

    <%= form_with url: request_security_key_reset_path, local: true, class: "space-y-6" do |form| %>
      <%= hidden_field_tag :locale, public_form_locale_param if public_form_locale_param.present? %>

      <div class="space-y-1">
        <%= form.label :contact, t("portal_self_service.contact_label"), class: "form-label" %>
        <%= form.text_field :contact,
            id: "account-recovery-contact",
            class: "form-input mt-1",
            required: true,
            autofocus: true,
            aria: { describedby: "account-recovery-contact-hint" } %>
        <p id="account-recovery-contact-hint" class="form-hint">
          <%= t("portal_self_service.account_recovery.contact_hint") %>
        </p>
      </div>

      <div class="space-y-1">
        <%= form.label :details, t("portal_self_service.account_recovery.details_label"), class: "form-label" %>
        <%= form.text_area :details,
                           class: "form-input mt-1 h-24",
                           placeholder: t("portal_self_service.account_recovery.details_placeholder") %>
      </div>

      <%= form.submit t("portal_self_service.account_recovery.submit"),
                     class: "btn btn-primary w-full" %>
    <% end %>

    <div class="mt-6 text-center">
      <p class="text-sm text-gray-600">
        <%= t("portal_self_service.account_recovery.remember_key_prompt") %>
        <%= link_to t("portal_self_service.account_recovery.back_to_sign_in"),
                    sign_in_path(locale: public_form_locale_param),
                    class: "text-primary-600 hover:text-primary-500" %>
      </p>
    </div>
  </div>
</div>
