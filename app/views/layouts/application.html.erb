<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maryland Accessible Telecommunications Program</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag 'TAM.ico' %>

    <!-- Tailwind CSS and Javascript-->
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", "data-turbo-track" => "reload" %>

  </head>

  <body class="font-sans antialiased bg-gray-50">
    <% if (session_deadlines = session_activity_deadlines) %>
      <%= render 'shared/session_activity',
                 deadlines: session_deadlines,
                 locale: public_request_locale_param || current_user.effective_message_locale || I18n.default_locale %>
    <% end %>
    <%= render "shared/header" %>
    <div id="flash">
      <%= render "shared/flash" %>
    </div>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
