<% content_for :title, t('documents.preview.unavailable') %>
<section class="rounded-lg border border-gray-200 bg-white p-6" aria-labelledby="document-unavailable-heading">
  <h1 id="document-unavailable-heading" class="text-xl font-semibold text-gray-900"><%= t('documents.preview.unavailable') %></h1>
  <p class="mt-3 text-gray-700">
    <%= @scan_status == 'not_scanned' ? t('documents.preview.not_scanned') : t("documents.scan.#{@scan_status}") %>
  </p>
  <% if @scan_status == 'pending' %>
    <p class="mt-3 text-gray-700"><%= t('documents.preview.try_again') %></p>
  <% end %>
</section>
