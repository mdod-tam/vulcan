<%# Shown while staff still need to resolve this account's duplicate review, on arrival or after a
    refused submission. This is a status message, not the #error-summary block: the constituent made
    no error and their draft is intact, so it uses role="status" and does not take focus. %>
<% if @pending_identity_review_message.present? %>
  <div id="pending-review-notice"
       class="bg-info-50 border border-info-200 p-4 rounded mb-6 text-info-900"
       role="status"
       aria-live="polite"
       aria-atomic="true">
    <p><%= @pending_identity_review_message %></p>
    <%# Shown only after a refused submission. Browsers cannot repopulate file inputs, so the
        documents the constituent selected are gone from the form; this message points to the action
        that recovers them. Not shown on arrival, when nothing has been selected yet. %>
    <% if @pending_identity_review_documents_message.present? %>
      <p id="pending-review-documents-notice" class="mt-2">
        <%= @pending_identity_review_documents_message %>
      </p>
    <% end %>
  </div>
<% end %>
