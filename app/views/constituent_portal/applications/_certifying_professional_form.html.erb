<div id="certifying-professional-fields" class="space-y-4 p-4 bg-white border border-gray-200 rounded" data-testid="certifying-professional-fields">
  <h3 id="certifying-professional-info-heading" class="text-base font-medium text-gray-900">Certifying Professional Information and Authorization to Contact</h3>
  
  <p class="text-sm text-gray-700 mb-4">
    Please provide contact information for your Doctor or a qualified Certifying Professional. 
    The system will automatically send your Disability Certification form to them to complete.
  </p>

  <div class="text-sm text-gray-700 mb-4">
    <p class="font-medium mb-2">Qualified Certifying Professionals include:</p>
    <ul class="list-disc list-inside space-y-1 ml-2" aria-label="List of qualified certifying professionals">
      <li>Doctor / Physician</li>
      <li>Audiologist</li>
      <li>Rehabilitation Counselor</li>
      <li>Speech-Language Pathologist</li>
      <li>Social Worker</li>
      <li>Psychologist</li>
      <li>Mental Health Counselor</li>
      <li>Registered Nurse (RN)</li>
      <li>Licensed Practical Nurse (LPN)</li>
      <li>Physical Therapist</li>
      <li>Occupational Therapist</li>
      <li>Optometrist</li>
      <li>Nurse Practitioner</li>
    </ul>
  </div>

  <%= form.label :name, "Name", class: "form-label required-label" %>
  <%= form.text_field :name, 
      class: "form-input mt-1",
      "aria-describedby": "name-description" %>
  <p id="name-description" class="form-hint">Enter the full name of your certifying professional</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <%= form.label :phone, "Phone", class: "form-label required-label" %>
      <%= form.telephone_field :phone, 
          class: "form-input mt-1",
          "aria-describedby": "phone-description",
          pattern: "[0-9]{10}|[0-9]{3}-[0-9]{3}-[0-9]{4}" %>
      <p id="phone-description" class="form-hint">Enter 10-digit phone number</p>
    </div>
    <div>
      <%= form.label :email, "Email", class: "form-label required-label" %>
      <%= form.email_field :email, 
          class: "form-input mt-1",
          "aria-describedby": "email-description" %>
      <p id="email-description" class="form-hint">Enter professional email address</p>
    </div>
  </div>

  <div class="mt-4">
    <%= form.label :fax, "Fax (Optional)", class: "form-label" %>
    <%= form.telephone_field :fax, 
        class: "form-input mt-1",
        "aria-describedby": "fax-description" %>
    <p id="fax-description" class="form-hint">Enter fax number if available</p>
  </div>

  <div class="mt-6 p-4 bg-info-50 border border-info-200 rounded">
    <h4 class="text-base font-medium text-info-800 mb-3">Professional Information Release Authorization</h4>
    
    <div class="bg-white p-3 rounded border mb-4">
      <h4 class="text-sm font-medium text-gray-900 mb-2">MAT Program Contact Information</h4>
      <div class="space-y-1 text-xs text-gray-700">
        <p><strong>Email:</strong> <a href="mailto:<%= ProgramContact.support_email %>"
                                      class="text-primary-600 hover:text-primary-500"><%= ProgramContact.support_email %></a></p>
        <p><strong>Phone:</strong> <a href="tel:8005527724" class="text-primary-600 hover:text-primary-500">800-552-7724</a></p>
        <p><strong>Voice/TTY:</strong> <a href="tel:4107677253" class="text-primary-600 hover:text-primary-500">410-767-7253</a></p>
        <p><strong>Video Phone:</strong> <a href="tel:4108019618" class="text-primary-600 hover:text-primary-500">410-801-9618</a></p>
      </div>
    </div>
    
    <div class="text-sm text-info-700 space-y-3">
      <p class="font-medium">By providing your certifying professional's contact information and checking the authorization below, you consent to:</p>
      
      <ul class="list-disc list-inside space-y-1 ml-4">
        <li>The release of your information to your certifying professional, including the capability to view your application in its entirety</li>
        <li>The MAT program contacting your certifying professional to verify disability-related information for your application</li>
        <li>Your certifying professional sharing relevant disability documentation with the MAT program for application processing</li>
        <li>The MAT program sharing relevant disability information with authorized program staff for application review</li>
      </ul>
      
      <p class="text-xs">
        <strong>Important:</strong> You are responsible for ensuring that the contact information provided is correct. 
        For security and privacy, you cannot make changes after you submit this application. 
        If you need to update your certifying professional's contact information after submission, you must contact MAT staff.
      </p>
    </div>
    
    <div class="flex items-start pt-3 mt-3 border-t border-info-200">
      <%# Bound to the submitted value, falling back to the stored one, so a re-render (validation
          failure, pending review, any refusal) keeps the authorization. The box is required, so
          losing it would leave final_submit_gate holding "Submit Application" disabled. %>
      <%= check_box_tag "application[disability_information_release_authorized]", "1",
          disability_information_release_authorized_checked?(@application),
          class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
          required: true,
          "aria-required": "true",
          "aria-describedby": "disability-release-description",
          id: "application_disability_information_release_authorized" %>
      <%= label_tag "application[disability_information_release_authorized]",
          "I authorize the release and sharing of my disability-related information as described above",
          class: "ml-2 block text-sm font-medium text-info-800 required-label",
          for: "application_disability_information_release_authorized" %>
    </div>
    <p id="disability-release-description" class="text-xs text-info-600 ml-6 mt-1">
      This authorization is required to process your MAT application and verify your eligibility.
    </p>
  </div>
</div>
