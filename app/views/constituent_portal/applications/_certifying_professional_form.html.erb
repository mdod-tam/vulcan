<div id="certifying-professional-fields" class="space-y-4 p-4 bg-white border border-gray-200 rounded" data-testid="certifying-professional-fields">
  <h3 id="certifying-professional-info-heading" class="text-base font-medium text-gray-900">Certifying Professional Information and Authorization to Contact</h3>
  
  <p class="text-sm text-gray-700 mb-4">
    <%= t('applications.certifying_professional.enter_contact', locale: form_message_locale) %>
  </p>

  <div class="text-sm text-gray-700 mb-4">
    <p class="font-medium mb-2">Qualified Certifying Professionals include:</p>
    <ul class="list-disc list-inside space-y-1 ml-2" aria-label="List of qualified certifying professionals">
      <li>Doctor / Physician</li>
      <li>Audiologist</li>
      <li>Rehabilitation Counselor</li>
      <li>Speech-Language Pathologist</li>
      <li>Social Worker</li>
      <li>Psychologist</li>
      <li>Mental Health Counselor</li>
      <li>Registered Nurse (RN)</li>
      <li>Licensed Practical Nurse (LPN)</li>
      <li>Physical Therapist</li>
      <li>Occupational Therapist</li>
      <li>Optometrist</li>
      <li>Nurse Practitioner</li>
    </ul>
  </div>

  <%= form.label :name, t('applications.form_labels.professional_name', locale: form_message_locale), class: 'form-label required-label' %>
  <%= form.text_field :name,
      class: "form-input mt-1",
      "aria-describedby": "name-description" %>
  <p id="name-description" class="form-hint">Enter the full name of your certifying professional</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <%= form.label :phone, t('applications.form_labels.professional_phone', locale: form_message_locale), class: 'form-label required-label' %>
      <%= form.telephone_field :phone,
          class: "form-input mt-1",
          "aria-describedby": "phone-description",
          pattern: "[0-9]{10}|[0-9]{3}-[0-9]{3}-[0-9]{4}" %>
      <p id="phone-description" class="form-hint">Enter 10-digit phone number</p>
    </div>
    <div>
      <%= form.label :email, t('applications.form_labels.professional_email', locale: form_message_locale), class: 'form-label required-label' %>
      <%= form.email_field :email,
          class: "form-input mt-1",
          "aria-describedby": "email-description" %>
      <p id="email-description" class="form-hint">Enter professional email address</p>
    </div>
  </div>

  <div class="mt-4">
    <%= form.label :fax, "Fax (Optional)", class: "form-label" %>
    <%= form.telephone_field :fax,
        class: "form-input mt-1",
        "aria-describedby": "fax-description" %>
    <p id="fax-description" class="form-hint">Enter fax number if available</p>
  </div>

  <div class="mt-6 p-4 bg-info-50 border border-info-200 rounded">
    <h4 class="text-base font-medium text-info-800 mb-3">
      <%= t('applications.disability_release.heading', locale: form_message_locale) %>
    </h4>

    <div class="space-y-2 text-sm text-gray-700">
      <p><%= t('applications.disability_release.intro', locale: form_message_locale) %></p>
      <ul role="list" class="list-disc space-y-1 pl-5">
        <% t('applications.disability_release.summary', locale: form_message_locale).each do |term| %>
          <li><%= term %></li>
        <% end %>
      </ul>
      <details id="disability-release-details" class="mb-3 rounded border border-gray-200 bg-white p-3">
        <summary class="cursor-pointer font-medium text-primary-700">
          <%= t('applications.disability_release.read_full', locale: form_message_locale) %>
        </summary>
        <p class="mt-3"><%= t('applications.disability_release.full_intro', locale: form_message_locale) %></p>
        <ul role="list" class="mt-2 list-disc space-y-1 pl-5">
          <% t('applications.disability_release.full_terms', locale: form_message_locale).each do |term| %>
            <li><%= term %></li>
          <% end %>
        </ul>
      </details>
      <p><%= t('applications.certifying_professional.check_contact', locale: form_message_locale) %></p>
      <p>
        <%= t(
              'applications.disability_release.contact_html',
              locale: form_message_locale,
              email: mail_to(ProgramContact.support_email, class: 'underline'),
              phone: link_to(ProgramContact.support_phone, "tel:#{ProgramContact.support_phone.delete('-')}", class: 'underline'),
              videophone: link_to(ProgramContact.support_videophone, "tel:#{ProgramContact.support_videophone.delete('-')}", class: 'underline')
            ) %>
      </p>
    </div>

    <div class="flex items-start pt-3 mt-3 border-t border-info-200">
      <%# Bound to the submitted value, falling back to the stored one, so a re-render (validation
          failure, pending review, any refusal) keeps the authorization. The box is required, so
          losing it would leave final_submit_gate holding "Submit Application" disabled. %>
      <%= check_box_tag "application[disability_information_release_authorized]", "1",
          disability_information_release_authorized_checked?(@application),
          class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
          required: true,
          "aria-required": "true",
          "aria-describedby": "disability-release-description",
          id: "application_disability_information_release_authorized" %>
      <%= label_tag 'application[disability_information_release_authorized]', t('applications.form_labels.release_authorized', locale: form_message_locale),
                    class: 'ml-2 block text-sm font-medium text-info-800 required-label', for: 'application_disability_information_release_authorized' %>
    </div>
    <p id="disability-release-description" class="text-xs text-info-600 ml-6 mt-1">
      <%= t('applications.disability_release.required', locale: form_message_locale) %>
    </p>
  </div>
</div>
