<div class="min-h-screen bg-gray-100 py-12">
  <div class="form-container max-w-2xl mx-auto">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <div id="main-content" tabindex="-1" class="card p-4 sm:p-8">
      <h1 class="text-2xl font-semibold mb-6 text-center" id="form-title">
        <% if @applicant_type == 'dependent' && @selected_dependent_name.present? %>
          New Application for <%= @selected_dependent_name %>
        <% else %>
          New Application for <%= current_user.full_name %>
        <% end %>
      </h1>
      <p class="text-base text-gray-900"><span class="text-danger-700">*</span> Indicates a required field</p>

      <%# The server resolves the draft for this applicant. A dependent page must name the
          dependent here, or every save goes to the guardian's own draft. %>
      <% new_app_form_data = {
        controller: "final-submit-gate currency-formatter accessibility-announcer autosave",
        action: %w[
          input->autosave#fieldInput change->autosave#fieldChange focusout->autosave#fieldLeave
          submit->autosave#prepareSubmission turbo:submit-start->autosave#submissionStarted
          turbo:submit-end->autosave#submissionEnded turbo:before-cache@document->autosave#beforeCache
        ].join(' '),
        autosave_url_value: autosave_field_constituent_portal_applications_path(user_id: (@application.user_id if @applicant_type == 'dependent')),
        autosave_debounce_wait_value: 1000,
        autosave_saving_text_value: t('applications.autosave.saving', locale: form_message_locale),
        autosave_saved_text_value: t('applications.autosave.saved', locale: form_message_locale),
        autosave_failed_text_value: t('applications.autosave.failed', locale: form_message_locale),
        autosave_unsaved_text_value: t('applications.autosave.unsaved', locale: form_message_locale),
        autosave_form_dirty_value: @form.present?
      }
        if FeatureFlag.income_proof_required?
          new_app_form_data[:controller] = "income-validation #{new_app_form_data[:controller]}"
          new_app_form_data[:"income-validation-fpl-thresholds-value"] = fpl_thresholds_json
          new_app_form_data[:"income-validation-modifier-value"] = fpl_modifier_value
        end
        if @applicant_type == "dependent"
          new_app_form_data[:controller] = "dependent-fields #{new_app_form_data[:controller]}"
        end
        # Present only while an identity review is pending. The submit gate treats it as a hard
        # block and announces it, so the constituent is never invited to select documents that a
        # refusal would discard. Localized here rather than in the gate, which must not compose a
        # user-facing string in JavaScript.
        if @submission_blocked_message.present?
          new_app_form_data[:final_submit_gate_blocked_message] = @submission_blocked_message
        end %>
      <%= form_with(model: [:constituent_portal, @application],
          local: true,
          class: "space-y-6",
          html: { "aria-labelledby": "form-title" },
          data: new_app_form_data) do |form| %>

        <%= render 'autosave_fields', state: autosave_form_state %>
        <div data-autosave-target="status" class="text-sm mt-2 min-h-10 sm:min-h-5" role="status" aria-live="polite"></div>

        <%= render "pending_review_notice" %>

        <% if @application.errors.any? %>
          <div id="error-summary"
               class="bg-danger-50 p-4 rounded mb-6"
               role="alert"
               aria-live="assertive"
               aria-atomic="true"
               tabindex="-1"
               data-controller="error-summary">
            <h2 class="text-danger-700 font-medium">
              <%= pluralize(@application.errors.count, "error") %> prohibited this application from being saved:
            </h2>
            <ul class="list-disc list-inside text-danger-700">
              <% I18n.with_locale(form_message_locale) { @application.errors.full_messages }.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 class="text-lg font-medium text-gray-900">Application Status</h2>
          <div>
            <div class="mt-1">
              <span class="<%= badge_class_for(:application, :draft, size: :lg) %>">
                Draft
              </span>
            </div>
            <p class="mt-2 text-sm text-gray-700">
              Current status of your application
            </p>
          </div>
        </div>

        <section class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="applicant-info-title" class="text-lg font-medium text-gray-900">Applicant</h2>

          <% if @applicant_type == 'dependent' && @selected_dependent_name.present? %>
            <div class="flex items-center justify-between">
              <p class="text-sm text-gray-700">
                This application is for <span class="font-semibold text-gray-900"><%= @selected_dependent_name %></span>
              </p>
              <%= link_to constituent_portal_dashboard_path,
                    class: "text-sm text-primary-600 hover:text-primary-500 rounded",
                    "aria-label": "Return to dashboard to select a different applicant" do %>
                <span class="flex items-center">
                  <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                  </svg>
                  Change applicant
                </span>
              <% end %>
            </div>
            <%= hidden_field_tag "application[for_self]", "false" %>
            <%= form.hidden_field :user_id, value: @application.user_id %>
          <% else %>
            <p class="text-sm text-gray-700">
              This application is for <span class="font-semibold text-gray-900"><%= current_user.full_name %></span>
            </p>
            <%= hidden_field_tag "application[for_self]", "true" %>
          <% end %>
        </section>

        <section class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="communication-section-title" class="text-lg font-medium text-gray-900">Communication Preferences</h2>
          <div>
            <%= label_tag "constituent_locale", "Preferred Language", class: "form-label" %>
            <%= select_tag "constituent[locale]",
                options_for_select(
                  [
                    ["English", "en"],
                    ["Spanish", "es"]
                  ],
                  params.dig(:constituent, :locale).presence || @applicant_user&.locale.presence || current_user&.locale.presence || "en"
                ),
                id: "constituent_locale",
                data: { no_autosave: true },
                class: "form-input mt-1 h-10" %>
            <p class="mt-1 text-xs text-gray-700">
              We will use this language for notifications when Spanish templates are available.
            </p>
          </div>
        </section>

          <%= render "address_fields",
            form: form,
            address: @address,
            guardian_address: @guardian_address,
            dependent_application: @applicant_type == "dependent",
            use_guardian_address: @use_guardian_address %>

        <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
          <h2 class="text-lg font-semibold text-gray-800 mb-4">Disability Certification</h2>

          <section class="space-y-4 p-4 bg-white border border-gray-200 rounded mb-4">
            <h3 id="disability-section-title" class="text-base font-medium text-gray-900 required-label">Disability Information</h3>
            <div class="flex items-start">
              <%= form.check_box :self_certify_disability,
                  {
                    class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
                    required: true,
                    "aria-describedby": "disability-certification-description",
                    "aria-required": "true"
                  }, "1", "0" %>
              <%= form.label :self_certify_disability,
                  "I certify that I have a disability that affects my ability to access telecommunications services",
                  class: "ml-2 block text-sm text-gray-700" %>
            </div>
            <p id="disability-certification-description" class="form-hint">
              If you have a disability, please self-certify by checking the box above.
            </p>
            <fieldset class="space-y-2" data-requires-one-checkbox="true" aria-describedby="portal-disability-type-help">
              <legend class="text-sm text-gray-700 font-medium">Disability type</legend>
              <p id="portal-disability-type-help"
                 class="form-hint">Select at least one disability that applies to <%= @applicant_type == 'dependent' ? 'your dependent' : 'you' %>.</p>
              <div class="grid sm:grid-cols-2 gap-4">
                <% disabilities = [:hearing, :vision, :speech, :mobility, :cognition] %>
                <% disabilities.each do |disability| %>
                  <div class="flex items-center">
                    <%= form.check_box "#{disability}_disability",
                        checked: disability_checked?("#{disability}_disability", @applicant_user || current_user),
                        class: "h-4 w-4 text-primary-600 border-gray-300 rounded",
                        "aria-describedby": "#{disability}-description" %>
                    <%= form.label "#{disability}_disability", disability.to_s.titleize,
                        class: "ml-2 text-sm text-gray-700" %>
                  </div>
                  <div id="<%= disability %>-description" class="sr-only">
                    Check if <%= @applicant_type == 'dependent' ? 'your dependent' : 'you' %> <%= @applicant_type == 'dependent' ? 'has' : 'have' %> a <%= disability %> disability
                  </div>
                <% end %>
              </div>
            </fieldset>
          </section>

          <%# Certifying professional. fields_for does not fetch a non-association attribute.
              Without the explicit object, the inputs show no value on edit or after a refused save. %>
          <%= form.fields_for :medical_provider_attributes, @application.medical_provider_attributes do |mp| %>
            <%= render "medical_provider_form", form: mp %>
          <% end %>
        </div>

        <section class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="alternate-contact-section-title" class="text-lg font-medium text-gray-900">Alternate Contact (Optional)</h2>
          <p class="text-sm text-gray-700"><%= t("applications.alternate_contact.portal_help") %></p>

          <div class="space-y-4">
            <div>
              <%= form.label :alternate_contact_name, "Name", class: "form-label" %>
              <%= form.text_field :alternate_contact_name, autocomplete: "name", class: "form-input mt-1" %>
            </div>

            <div>
              <%= form.label :alternate_contact_relationship_type, "Relationship", class: "form-label" %>
              <% relationship_options = [
                [t("applications.alternate_contact_relationship_types.parent"), "parent"],
                [t("applications.alternate_contact_relationship_types.spouse"), "spouse"],
                [t("applications.alternate_contact_relationship_types.child"), "child"],
                [t("applications.alternate_contact_relationship_types.sibling"), "sibling"],
                [t("applications.alternate_contact_relationship_types.neighbor"), "neighbor"],
                [t("applications.alternate_contact_relationship_types.friend"), "friend"],
                [t("applications.alternate_contact_relationship_types.other"), "other"]
              ] %>
              <%= form.select :alternate_contact_relationship_type,
                  options_for_select(relationship_options, @application.alternate_contact_relationship_type),
                  { prompt: "Select a relationship" },
                  class: "form-input mt-1" %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <%= form.label :alternate_contact_phone, "Phone", class: "form-label" %>
                <%= form.telephone_field :alternate_contact_phone, autocomplete: "tel", class: "form-input mt-1" %>
              </div>
              <div>
                <%= form.label :alternate_contact_email, "Email", class: "form-label" %>
                <%= form.email_field :alternate_contact_email, autocomplete: "email", class: "form-input mt-1" %>
              </div>
            </div>
          </div>
        </section>

        <fieldset class="space-y-6 p-4 bg-gray-50 rounded">
          <legend class="text-lg font-medium text-gray-900">Required Documentation</legend>

          <% if FeatureFlag.income_proof_required? %>
          <div class="space-y-4">
            <h3 class="text-base font-medium text-gray-900">Income Verification</h3>

            <div class="p-4 border-2 border-gray-200 rounded-md bg-white transition-colors duration-200"
                 data-income-validation-target="incomeFieldsContainer">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <%= form.label :household_size, "Household Size", class: "form-label required-label" %>
                  <div class="mt-1">
                    <%= form.number_field :household_size,
                        min: 1,
                        required: true,
                        class: "form-input border-gray-500",
                        "aria-describedby": "household_size_help",
                        "aria-required": "true",
                        data: {
                          "income-validation-target": "householdSize"
                        } %>
                  </div>
                  <p class="form-hint" id="household_size_help">
                    Total number of people living in your household
                  </p>
                </div>

                <div>
                  <%= form.label :annual_income, "Annual Income", class: "form-label required-label" %>
                  <div class="mt-1 relative rounded-md">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <span class="text-gray-700 sm:text-sm font-medium" aria-hidden="true">$</span>
                    </div>
                    <%= form.number_field :annual_income,
                        step: "0.01",
                        required: true,
                        class: "form-input pl-7 border-gray-500",
                        "aria-describedby": "annual_income_help",
                        "aria-required": "true",
                        inputmode: "decimal",
                        data: {
                          "income-validation-target": "annualIncome",
                          currency_formatter_target: "input"
                        } %>
                  </div>
                  <p class="form-hint" id="annual_income_help">
                    Total yearly household income before taxes
                  </p>
                </div>
              </div>
            </div>

            <div id="income-threshold-warning" hidden class="hidden" role="alert" aria-live="assertive" data-income-validation-target="warningContainer"></div>

            <div>
              <label for="application_income_proof" class="form-label">Upload Income Proof Document</label>
              <p id="income-hint" class="form-hint mb-2">
                We need proof of your household income. Please provide one of the following acceptable documents:
                <strong>Tax return</strong> (preferred), <strong>current year SSA award letter</strong> (less than 2 months old),
                <strong>recent bank statement</strong> showing your SSA deposit, <strong>current, unexpired SSA/SSI/SSDI documentation</strong>,
                <strong>current, unexpired Medicaid and/or SNAP award letter</strong>, or <strong>current, unexpired VA Benefits letter</strong>.
                <span class="font-semibold text-danger-600">This proof is required to submit your application.</span>
              </p>
              <%= render 'shared/document_upload', form: form, model: @application, field: :income_proof,
                                                   input_id: 'application_income_proof', described_by: 'income-hint' %>
              <p class="mt-1 text-xs text-gray-700">
                <span class="sr-only">Keyboard users:</span> Press Space or Enter to open the file browser
              </p>
            </div>
          </div>
          <% end %>

          <div class="space-y-4 pt-4 border-t border-gray-200">
            <h3 class="text-base font-medium text-gray-900">Residency Verification</h3>

            <div class="p-3 bg-white border border-gray-200 rounded">
              <div class="flex items-start">
                <%= form.check_box :maryland_resident,
                    class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
                    required: true,
                    "aria-required": "true",
                    "aria-describedby": "maryland_resident_help" %>
                <%= form.label :maryland_resident, "I certify that I am a resident of Maryland",
                    class: "ml-2 block text-sm text-gray-700 required-label" %>
              </div>
              <p id="maryland_resident_help" class="form-hint ml-6">Note: This will be verified through the residency proof upload/review process</p>
            </div>

            <div>
              <label for="application_residency_proof" class="form-label required-label">Upload Residency Proof Document</label>
              <p id="residency-hint" class="form-hint mb-2">
                Upload one of the following acceptable documents: <strong>driver's license</strong>, <strong>state ID</strong>,
                <strong>identification card</strong>, <strong>utility bill</strong>, or <strong> photo ID</strong>.
                <span class="font-semibold text-danger-600">This proof is required to submit your application.</span>
              </p>
              <%= render 'shared/document_upload', form: form, model: @application, field: :residency_proof,
                                                   input_id: 'application_residency_proof', described_by: 'residency-hint' %>
              <p class="mt-1 text-xs text-gray-700">
                <span class="sr-only">Keyboard users:</span> Press Space or Enter to open the file browser
              </p>
            </div>
          </div>

          <div class="space-y-4 pt-4 border-t border-gray-200">
            <h3 class="text-base font-medium text-gray-900">ID Verification</h3>

            <div>
              <label for="application_id_proof" class="form-label required-label">Upload ID Proof Document</label>
              <p id="id-hint" class="form-hint mb-2">
                Upload a government-issued photo ID such as a <strong>driver's license</strong>, <strong>state ID card</strong>,
                <strong>identification card</strong>, or <strong>passport</strong>.
                <span class="font-semibold text-danger-600">This proof is required to submit your application.</span>
              </p>
              <%= render 'shared/document_upload', form: form, model: @application, field: :id_proof,
                                                   input_id: 'application_id_proof', described_by: 'id-hint' %>
              <p class="mt-1 text-xs text-gray-700">
                <span class="sr-only">Keyboard users:</span> Press Space or Enter to open the file browser
              </p>
            </div>
          </div>
        </fieldset>

        <div class="px-6 py-4 bg-gray-50">
          <h3 class="font-semibold mb-2 text-gray-900">MAT Statement of Terms and Conditions Agreement</h3>
          <div class="max-h-60 overflow-y-auto mb-4 p-4 bg-white rounded border border-gray-200">
            <%= render "terms_and_conditions" %>
          </div>
          <div class="flex items-start">
            <%= form.check_box :terms_accepted,
                id: "terms_accepted",
                required: true,
                class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded" %>
            <%= form.label :terms_accepted,
                "I have read and accept the terms and conditions",
                class: "ml-2 block text-sm text-gray-700 required-label" %>
          </div>
        </div>

        <div class="px-6 py-4 bg-gray-50">
          <div class="flex items-start">
            <%= form.check_box :information_verified,
                id: "information_verified",
                required: true,
                class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded" %>
            <%= form.label :information_verified,
                "I verify that all information provided above is accurate and complete",
                class: "ml-2 block text-sm text-gray-700 required-label" %>
          </div>
        </div>

        <div class="px-6 py-4 bg-gray-50 flex items-center justify-end space-x-3 rounded-b-lg">
          <%= link_to "Cancel",
              constituent_portal_applications_path,
              class: "btn btn-outline",
              role: "button",
              "aria-label": "Cancel application and return to applications list" %>

          <%= form.submit "Save Application",
              name: "save_draft",
              formnovalidate: true,
              class: "btn btn-primary",
              "aria-label": "Save application draft" %>

          <p id="portal-submit-gate-status" class="sr-only" aria-live="polite" data-final-submit-gate-target="status"></p>

          <%= form.submit "Submit Application",
              name: "submit_application",
              disabled: true,
              class: "btn btn-success",
              "aria-label": "Submit final application",
              data: { final_submit_gate_target: "submitButton" },
              aria: { describedby: "portal-submit-gate-status" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
