<%# locals: (form:, locale:) %>
<section class="px-6 py-4 bg-gray-50" aria-labelledby="application-terms-heading">
  <h3 id="application-terms-heading" class="font-semibold text-gray-900">
    <%= t('terms_and_conditions.equipment_heading', locale: locale) %>
  </h3>
  <div class="mt-2 space-y-2 text-sm text-gray-700">
    <p><%= t('terms_and_conditions.summary.intro', locale: locale) %></p>
    <ul role="list" class="list-disc space-y-1 pl-5">
      <% t('terms_and_conditions.summary.points', locale: locale).each do |point| %>
        <li><%= point %></li>
      <% end %>
    </ul>
    <p><%= t('terms_and_conditions.summary.more', locale: locale) %></p>
  </div>
  <details id="equipment-agreement-details" class="my-4 rounded border border-gray-200 bg-white p-3">
    <summary class="cursor-pointer font-medium text-primary-700">
      <%= t('terms_and_conditions.summary.read_full', locale: locale) %>
    </summary>
    <div class="mt-3">
      <%= render 'terms_and_conditions', locale: locale %>
    </div>
  </details>
  <div class="flex items-start">
    <%= form.check_box(
          :terms_accepted, id: 'terms_accepted', required: true, class: 'mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded'
        ) %>
    <%= form.label(
          :terms_accepted, t('applications.form_labels.terms_accepted', locale: locale),
          for: 'terms_accepted', class: 'ml-2 block text-sm text-gray-700 required-label'
        ) %>
  </div>
</section>
