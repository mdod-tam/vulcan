<div class="mx-auto max-w-5xl px-4 py-8">
  <h1 class="text-3xl font-bold"><%= @product.manufacturer %> <%= @product.name %></h1>
  <p class="mt-2 text-gray-700"><%= t('product_resources.devices.model', number: @product.model_number) %></p>
  <% if @product.description.present? %><p class="mt-4 text-gray-700"><%= @product.description %></p><% end %>
  <%= render 'history', groups: @product_groups, link_products: false %>
  <p class="mt-3 text-sm text-gray-600"><%= t('product_resources.devices.shipment_notice') %></p>
  <%= render 'shared/product_resources', product: @product, region_id: dom_id(@product, :device_product_resources) %>
  <% if (documentation_url = safe_manufacturer_documentation_url(@product)) %>
    <p class="mt-5">
      <%= link_to t('product_resources.manufacturer_documentation'), documentation_url, target: '_blank',
                                                                                        rel: 'noopener noreferrer', class: 'text-primary-700 underline' %>
      <%= t('product_resources.external_link') %>
    </p>
  <% end %>
  <%= link_to t('product_resources.devices.back'), constituent_portal_products_path, class: 'mt-6 inline-block text-primary-700 underline' %>
</div>
