<%# locals: (groups:, link_products: true) %>
<% groups.each do |group| %>
  <section class="card mt-5 p-5">
    <h2 class="text-xl font-semibold"><%= t('product_resources.devices.beneficiary', name: group.beneficiary.full_name) %></h2>
    <ul class="mt-4 space-y-5">
      <% group.entries.each do |entry| %>
        <li>
          <% if link_products %>
            <%= link_to "#{entry.product.manufacturer} #{entry.product.name}", constituent_portal_product_path(entry.product),
                        class: 'font-semibold text-primary-700 underline' %>
          <% else %>
            <p class="font-semibold"><%= entry.product.manufacturer %> <%= entry.product.name %></p>
          <% end %>
          <p class="text-sm text-gray-600"><%= t('product_resources.devices.model', number: entry.product.model_number) %></p>
          <ul class="mt-2 text-sm text-gray-700">
            <% entry.sources.each do |source| %>
              <li><%= t("product_resources.devices.sources.#{source.kind}") %> · <%= l(source.occurred_on, format: :long) %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
