<div class="mx-auto max-w-5xl px-4 py-8">
  <h1 class="text-3xl font-bold"><%= t('product_resources.devices.heading') %></h1>
  <p class="mt-3 text-gray-700"><%= t('product_resources.devices.description') %></p>
  <p class="mt-2 text-sm text-gray-600"><%= t('product_resources.devices.shipment_notice') %></p>
  <% if @product_groups.any? %>
    <%= render 'history', groups: @product_groups %>
  <% else %>
    <div class="card mt-6 p-6">
      <h2 class="text-xl font-semibold"><%= t('product_resources.devices.empty_heading') %></h2>
      <p class="mt-2 text-gray-600"><%= t('product_resources.devices.empty') %></p>
    </div>
  <% end %>
  <%= link_to t('product_resources.devices.dashboard'), constituent_portal_dashboard_path, class: 'mt-6 inline-block text-primary-700 underline' %>
</div>
