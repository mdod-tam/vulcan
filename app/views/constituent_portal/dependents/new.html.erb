<div class="min-h-screen bg-gray-100 py-12">
  <div class="form-container max-w-2xl mx-auto">
    <a href="#main-content" class="skip-link">
      <%= t('constituent_portal.workflow.skip') %>
    </a>
    <div id="main-content" tabindex="-1" class="card p-4 sm:p-8">
      <h1 class="text-2xl font-semibold mb-6 text-center" id="form-title"><%= t('constituent_portal.dependents.pages.new_title') %></h1>

      <%# The layout renders flash through shared/_flash; rendering it here would show every alert twice. %>

      <p class="text-sm text-gray-600 mb-6 text-center">
        <%= t('constituent_portal.dependents.pages.new_help', email: current_user.email) %>
      </p>

      <%= render 'form', dependent_user: @dependent_user, guardian_relationship: @guardian_relationship %>
    </div>
  </div>
</div>
