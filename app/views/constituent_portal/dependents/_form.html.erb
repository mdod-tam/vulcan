<%# The guardian-contact choice is explicit form state, not something to infer from whether the
    contact field happens to be blank. A guardian can type dependent contact and then check "use
    mine"; the typed value survives, so blankness-inference would flip the choice on a failed
    re-render. @use_guardian_email/@use_guardian_phone carry the choice the server applied; the
    blank fallback is only for a fresh form that was never submitted. %>
<% use_guardian_email_checked = @use_guardian_email.nil? ? dependent_user.email.blank? : @use_guardian_email %>
<% use_guardian_phone_checked = @use_guardian_phone.nil? ? dependent_user.phone.blank? : @use_guardian_phone %>
<%= form_with(model: dependent_user,
    url: dependent_user.new_record? ? constituent_portal_dependents_path : constituent_portal_dependent_path(dependent_user),
      local: true,
      scope: :dependent,
      class: "space-y-6",
      "aria-labelledby": "form-title",
      data: { controller: "dependent-fields" }) do |form| %>

  <%# Identifies this submission so the server can tell a retransmitted request -- double click,
      lost response, browser retry -- from a guardian deliberately adding another person. Generated
      once per rendered form and carried across a failed re-render, so correcting a validation error
      and resubmitting stays the same request. Creation only; an update is not a creation replay. %>
  <% if dependent_user.new_record? %>
    <%= hidden_field_tag :portal_creation_key, portal_creation_key_for_form %>
  <% end %>

  <% if dependent_user.errors.any? %>
    <div class="bg-danger-50 p-4 rounded mb-6 text-danger-600" role="alert" aria-atomic="true">
      <h2 class="font-medium">
        <%= t('constituent_portal.dependents.form.errors', count: dependent_user.errors.count) %>
      </h2>
      <ul class="list-disc list-inside">
        <% dependent_user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="space-y-4 p-4 bg-gray-50 rounded">
    <h2 id="personal-information-title" class="text-lg font-medium text-gray-900"><%= t('constituent_portal.dependents.form.information') %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :first_name, t('constituent_portal.dependents.form.first_name'), class: 'form-label' %>
        <%= form.text_field :first_name,
            class: "form-input mt-1",
            required: true %>
      </div>

      <div>
        <%= form.label :last_name, t('constituent_portal.dependents.form.last_name'), class: 'form-label' %>
        <%= form.text_field :last_name,
            class: "form-input mt-1",
            required: true %>
      </div>

        <div class="space-y-3 md:col-span-2">
          <% if dependent_user.new_record? %>
            <div class="flex items-start">
              <%= check_box_tag :use_guardian_email, "1", use_guardian_email_checked,
                  id: "use_guardian_email_checkbox",
                  class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
                  data: {
                    dependent_fields_target: "sameEmailCheckbox",
                    action: "change->dependent-fields#toggleEmailField"
                  },
                  "aria-controls": "dependent_email_field",
                  "aria-describedby": "use_guardian_email_help" %>
              <label for="use_guardian_email_checkbox" class="ml-2">
                <span class="block text-sm font-medium text-gray-700"><%= t('constituent_portal.dependents.form.use_email') %></span>
                <span id="use_guardian_email_help" class="block text-xs text-gray-500"><%= t('constituent_portal.dependents.form.use_email_help') %></span>
              </label>
            </div>
          <% end %>

          <div id="dependent_email_field"
               data-dependent-fields-target="emailFieldContainer"
               class="<%= 'hidden' if dependent_user.new_record? && use_guardian_email_checked %>"
               aria-hidden="<%= dependent_user.new_record? && use_guardian_email_checked %>">
            <%= form.label :email, t('constituent_portal.dependents.form.email'), class: 'form-label' %>
            <%= form.email_field :email,
                class: "form-input mt-1",
                required: false,
                autocomplete: "email",
                data: { dependent_fields_target: "dependentEmail" },
                "aria-describedby": "dependent_email_help" %>
            <p id="dependent_email_help" class="form-hint"><%= t('constituent_portal.dependents.form.email_help') %></p>

            <div class="mt-3">
              <div class="flex items-start">
                <%= form.check_box :newsletter_signup,
                    id: "dependent_newsletter_signup",
                    class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded" %>
                <%= form.label :newsletter_signup,
                               t('constituent_portal.dependents.form.newsletter'),
                    class: "ml-2 block text-sm text-gray-700" %>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3 md:col-span-2">
          <% if dependent_user.new_record? %>
            <div class="flex items-start">
              <%= check_box_tag :use_guardian_phone, "1", use_guardian_phone_checked,
                  id: "use_guardian_phone_checkbox",
                  class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded",
                  data: {
                    dependent_fields_target: "samePhoneCheckbox",
                    action: "change->dependent-fields#togglePhoneField"
                  },
                  "aria-controls": "dependent_phone_field",
                  "aria-describedby": "use_guardian_phone_help" %>
              <label for="use_guardian_phone_checkbox" class="ml-2">
                <span class="block text-sm font-medium text-gray-700"><%= t('constituent_portal.dependents.form.use_phone') %></span>
                <span id="use_guardian_phone_help" class="block text-xs text-gray-500"><%= t('constituent_portal.dependents.form.use_phone_help') %></span>
              </label>
            </div>
          <% end %>

          <div id="dependent_phone_field"
               data-dependent-fields-target="phoneFieldContainer"
               class="<%= 'hidden' if dependent_user.new_record? && use_guardian_phone_checked %>"
               aria-hidden="<%= dependent_user.new_record? && use_guardian_phone_checked %>">
            <%= form.label :phone, t('constituent_portal.dependents.form.phone'), class: 'form-label' %>
            <%= form.telephone_field :phone,
                class: "form-input mt-1",
                placeholder: "555-555-5555",
                autocomplete: "tel",
                data: { dependent_fields_target: "dependentPhone" },
                "aria-describedby": "dependent_phone_help" %>
            <p id="dependent_phone_help" class="form-hint"><%= t('constituent_portal.dependents.form.phone_help') %></p>
          </div>
        </div>

      <div>
        <%= form.label :phone_type, t('constituent_portal.dependents.form.phone_type'), class: 'form-label mb-2' %>
        <div role="radiogroup" class="space-y-2">
          <div class="flex items-center">
            <%= form.radio_button :phone_type, "voice", id: "dependent_phone_type_voice",
                   class: "h-4 w-4 text-primary-600 border-gray-300" %>
            <%= form.label :phone_type_voice, t('constituent_portal.dependents.form.voice'), for: 'dependent_phone_type_voice', class: 'ml-3 text-sm text-gray-700' %>
          </div>
          <div class="flex items-center">
            <%= form.radio_button :phone_type, "videophone", id: "dependent_phone_type_videophone",
                   class: "h-4 w-4 text-primary-600 border-gray-300" %>
            <%= form.label :phone_type_videophone, t('constituent_portal.dependents.form.videophone'),
                           for: 'dependent_phone_type_videophone', class: 'ml-3 text-sm text-gray-700' %>
          </div>
          <div class="flex items-center">
            <%= form.radio_button :phone_type, "text", id: "dependent_phone_type_text",
                   class: "h-4 w-4 text-primary-600 border-gray-300" %>
            <%= form.label :phone_type_text, t('constituent_portal.dependents.form.text'), for: 'dependent_phone_type_text', class: 'ml-3 text-sm text-gray-700' %>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :date_of_birth, t('shared.date_of_birth.label'), class: 'form-label' %>
        <%= date_of_birth_text_field form,
            value: date_of_birth_input_value(dependent_user),
            "aria-describedby": "dependent-date-of-birth-hint",
            class: "form-input mt-1",
            required: true %>
        <p id="dependent-date-of-birth-hint" class="form-hint"><%= t('shared.date_of_birth.hint') %></p>
      </div>
    </div>
  </section>

  <section class="space-y-4 p-4 bg-gray-50 rounded">
    <h2 id="disability-section-title" class="text-lg font-medium text-gray-900"><%= t('constituent_portal.dependents.form.disability_information') %></h2>
    <fieldset class="space-y-2"
              data-requires-one-checkbox="true"
              aria-required="true"
              aria-describedby="disability-error"
              aria-invalid="<%= dependent_user.errors.of_kind?(:base, :disability_required) %>">
      <legend class="text-sm text-gray-700 font-medium">
        <%= t('constituent_portal.dependents.form.select_disabilities') %>
        <span class="text-danger-600" aria-hidden="true">*</span>
        <span class="sr-only"><%= t('constituent_portal.workflow.required') %></span>
      </legend>

      <% if dependent_user.errors.of_kind?(:base, :disability_required) %>
        <div id="disability-error" role="alert" class="mt-2 p-3 bg-danger-50 border border-danger-400 text-danger-700 rounded text-sm">
          <%= t('errors.messages.disability_required') %>
        </div>
      <% end %>

      <div class="grid sm:grid-cols-2 gap-4">
        <% disabilities = [:hearing, :vision, :speech, :mobility, :cognition] %>
        <% disabilities.each do |disability| %>
          <div class="flex items-center">
            <%= form.check_box "#{disability}_disability",
                class: "h-4 w-4 text-primary-600 border-gray-300 rounded",
                "aria-describedby": "#{disability}-description" %>
            <%= form.label "#{disability}_disability", t("constituent_portal.dependents.form.disabilities.#{disability}"),
                class: "ml-2 text-sm text-gray-700" %>
          </div>
          <div id="<%= disability %>-description" class="sr-only">
            <%= t('constituent_portal.dependents.form.disability_help', disability: t("constituent_portal.dependents.form.disabilities.#{disability}")) %>
          </div>
        <% end %>
      </div>
    </fieldset>
  </section>

  <%= fields_for :guardian_relationship, guardian_relationship do |gr_form| %>
    <section class="space-y-4 p-4 bg-gray-50 rounded">
      <h2 id="relationship-section-title" class="text-lg font-medium text-gray-900"><%= t('constituent_portal.dependents.form.relationship_information') %></h2>
      <div>
        <%= gr_form.label :relationship_type, t('constituent_portal.dependents.form.relationship'), class: 'form-label' %>
        <%= gr_form.select :relationship_type,
                           options_for_select([
                                                [t('constituent_portal.dependents.form.relationships.parent'), 'Parent'],
                                                [t('constituent_portal.dependents.form.relationships.grandparent'), 'Grandparent'],
                                                [t('constituent_portal.dependents.form.relationships.foster_parent'), 'Foster Parent'],
                                                [t('constituent_portal.dependents.form.relationships.legal_guardian'), 'Legal Guardian'],
                                                [t('constituent_portal.dependents.form.relationships.relative_caregiver'), 'Relative Caregiver'],
                                                [t('constituent_portal.dependents.form.relationships.power_of_attorney'), 'Power of Attorney'],
                                                [t('constituent_portal.dependents.form.relationships.other'), 'Other']
                                              ], guardian_relationship&.relationship_type),
                           { include_blank: t('constituent_portal.dependents.form.relationship_prompt') },
                           { class: 'form-input mt-1', required: true } %>
      </div>
    </section>
  <% end %>

  <div class="px-6 py-4 bg-gray-50 flex items-center justify-end space-x-3 rounded-b-lg">
    <%= link_to t('constituent_portal.workflow.cancel'),
        constituent_portal_dashboard_path,
        class: "btn btn-outline",
        role: "button",
        'aria-label': t('constituent_portal.dependents.form.cancel_label') %>

    <%# data-turbo-submits-with is visible feedback only. Turbo already disables the submitter while
        the request is in flight; neither prevents a duplicate, which the server-side key does. %>
    <%= form.submit dependent_user.new_record? ? t('constituent_portal.dependents.form.add') : t('constituent_portal.dependents.form.update'),
        class: "btn btn-primary",
        data: { turbo_submits_with: dependent_user.new_record? ? t('constituent_portal.dependents.form.adding') : t('constituent_portal.dependents.form.saving') },
        'aria-label': dependent_user.new_record? ? t('constituent_portal.dependents.form.add_label') : t('constituent_portal.dependents.form.update_label') %>
  </div>
<% end %>
