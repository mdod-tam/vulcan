<div class="py-10">
  <header>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="md:flex md:items-center md:justify-between">
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
            <%= t('constituent_portal.proofs.upload.title', proof: t("applications.proof_card.types.#{@proof_type}")) %>
          </h1>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
          <%= link_to t('constituent_portal.workflow.back'), constituent_portal_dashboard_path,
              class: "btn btn-outline" %>
        </div>
      </div>
    </div>
  </header>

  <main>
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="card overflow-hidden rounded-none sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="rounded-md bg-info-50 p-4 mb-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-info-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3 flex-1 md:flex md:justify-between">
                <p class="text-sm text-info-700">
                  <%= t("constituent_portal.proofs.upload.guidance.#{@proof_type}") %>
                </p>
              </div>
            </div>
          </div>

          <%= form_with url: constituent_portal_application_proofs_resubmit_path(@application), method: :post, class: 'space-y-6' do |form| %>
            <%= hidden_field_tag :proof_type, @proof_type %>

            <div>
              <label for="<%= "#{@proof_type}_proof" %>" class="form-label">
                <%= t('constituent_portal.proofs.upload.label', proof: t("applications.proof_card.types.#{@proof_type}")) %>
              </label>
              <p class="form-hint" id="file-description">
                <%= t('constituent_portal.proofs.upload.formats', formats: proof_upload_formats_label, size: proof_upload_max_size_label) %>
              </p>

              <div class="mt-2">
                <%= render 'shared/document_upload',
                           form: form, field: "#{@proof_type}_proof", model: Application, blob: @retained_upload,
                           described_by: 'file-description' %>
              </div>
            </div>

            <div class="flex justify-end">
              <%= link_to t('constituent_portal.workflow.cancel'), constituent_portal_application_path(@application),
                          class: 'btn btn-outline mr-3' %>
              <%= form.submit t('constituent_portal.proofs.upload.submit'),
                              class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-6 px-4 sm:px-0">
        <h2 class="sr-only"><%= t('constituent_portal.proofs.upload.instructions') %></h2>
        <div class="border-t border-gray-200 py-5">
          <details class="group">
            <summary class="flex items-center text-sm font-medium text-gray-500 cursor-pointer hover:text-gray-700">
              <span><%= t('constituent_portal.proofs.upload.help') %></span>
              <span class="ml-2 flex-shrink-0">
                <svg class="h-5 w-5 text-gray-500 group-open:transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 text-sm text-gray-500 space-y-3">
              <p><%= t('constituent_portal.proofs.upload.steps') %></p>
              <ol class="list-decimal pl-5 space-y-2">
                <li><%= t('constituent_portal.proofs.upload.choose') %></li>
                <li><%= t('constituent_portal.proofs.upload.select') %></li>
                <li><%= t('constituent_portal.proofs.upload.send') %></li>
              </ol>
              <p class="mt-3"><%= t('constituent_portal.proofs.upload.troubleshooting') %></p>
              <ul class="list-disc pl-5 space-y-2">
                <li><%= t('constituent_portal.proofs.upload.format_help', formats: proof_upload_formats_label) %></li>
                <li><%= t('constituent_portal.proofs.upload.size_help', size: proof_upload_max_size_label) %></li>
                <li><%= t('constituent_portal.proofs.upload.legible') %></li>
                <li><%= t('constituent_portal.proofs.upload.complete') %></li>
              </ul>
              <p class="mt-3">
                <%= t('constituent_portal.proofs.upload.support_html',
                      email: mail_to(ProgramContact.support_email, class: 'text-primary-600 hover:text-primary-900'),
                      phone: ProgramContact.support_phone) %>
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </main>
</div>
