<%# locals: (purchase:) %>
<li class="py-4">
  <div class="flex flex-wrap items-center gap-2">
    <p class="text-base font-medium text-gray-900"><%= purchase.vendor.business_name %></p>
    <%= fulfillment_status_badge(purchase) %>
  </div>
  <p class="text-sm text-gray-600">
    <%= t('fulfillment.orders.purchased_on', date: purchase_date(purchase)) %> ·
    <%= t('fulfillment.orders.amount', amount: number_to_currency(purchase.amount)) %>
  </p>
  <% if purchase.shipments.any? %>
    <h4 class="sr-only"><%= t('fulfillment.orders.packages_heading') %></h4>
    <%= render 'shared/packages', shipments: purchase.shipments %>
  <% end %>
  <p class="mt-2 text-sm text-gray-500">
    <%= t('fulfillment.orders.support', vendor: purchase.vendor.business_name,
                                        email: ProgramContact.support_email, phone: ProgramContact.support_phone) %>
  </p>
</li>
