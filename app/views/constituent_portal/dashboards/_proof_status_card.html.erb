<%# locals: (application:, proof_type:) -%>
<%# One proof's status for an application: its review state, why it was rejected, and a link to upload a replacement. %>
<div>
  <div class="flex items-center justify-between">
    <div>
      <h4 class="text-base font-medium text-gray-900"><%= t('applications.proof_card.heading', proof: t("applications.proof_card.types.#{proof_type}")) %></h4>
      <% if application.public_send("#{proof_type}_proof_status") == 'approved' %>
        <div class="flex items-center mt-2">
          <div class="badge badge-success">
            <%= t('applications.proof_card.approved') %>
          </div>
        </div>
      <% elsif application.public_send("#{proof_type}_proof_status") == 'rejected' %>
        <div class="flex items-center mt-2">
          <div class="badge badge-danger">
            <%= t('applications.proof_card.rejected') %>
          </div>
          <% if get_latest_rejection_reason(application, proof_type).present? %>
            <span class="ml-2 text-sm text-gray-600">
              <%= t('applications.proof_card.reason', reason: get_latest_rejection_reason(application, proof_type)) %>
            </span>
          <% end %>
        </div>
        <% if get_latest_rejection_date(application, proof_type).present? %>
          <div class="mt-1 text-sm text-gray-600">
            <%= t('applications.proof_card.rejected_on', date: l(get_latest_rejection_date(application, proof_type).to_date, format: :long)) %>
          </div>
        <% end %>
      <% else %>
        <div class="flex items-center mt-2">
          <div class="badge badge-info">
            <%= t('applications.proof_card.pending') %>
          </div>
        </div>
      <% end %>
    </div>

    <% if can_resubmit_proof?(application, proof_type, @max_proof_submissions) %>
      <%= link_to t('applications.proof_card.upload', proof: t("applications.proof_card.types.#{proof_type}")),
                  new_proof_constituent_portal_application_path(application, proof_type: proof_type),
                  class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
