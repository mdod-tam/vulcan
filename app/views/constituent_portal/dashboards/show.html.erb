<nav aria-label="<%= t('training_history.title') %>" class="mx-auto flex max-w-7xl flex-wrap gap-4 px-4 pt-6">
  <%= link_to t('training_history.devices'), constituent_portal_products_path, class: 'font-medium text-primary-700 underline' %>
  <%= link_to t('training_history.title'), constituent_portal_training_sessions_path, class: 'font-medium text-primary-700 underline' %>
</nav>
<a href="#main-content" class="skip-link">
  Skip to main content
</a>

<div class="min-h-screen bg-gray-100">
  <div class="py-10">
    <header>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold leading-tight text-gray-900">My Dashboard</h1>
      </div>
    </header>

    <main id="main-content">
      <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
          <div class="card overflow-hidden rounded-none sm:rounded-lg p-6 mb-6">
            <div class="px-4 py-5 sm:px-6 space-y-6">
              <section aria-labelledby="my-application-status-title">
                <h3 id="my-application-status-title" class="text-lg leading-6 font-medium text-gray-900">My Application</h3>

                <% if @draft_application %>
                  <div class="mt-4 flex items-center">
                    <span class="badge badge-warning">
                      Draft
                    </span>
                    <span class="ml-4 text-sm text-gray-600">
                      Started: <%= @draft_application.created_at.strftime("%B %d, %Y") %>
                    </span>
                  </div>
                  <%= link_to "Continue Unsubmitted Application", edit_constituent_portal_application_path(@draft_application),
                      class: "btn btn-primary mt-3" %>
                <% elsif @active_application %>
                  <div class="mt-4 flex items-center">
                    <%= application_status_badge(@active_application) %>
                    <span class="ml-4 text-sm text-gray-600">
                      Submitted: <%= @active_application.application_date.strftime("%B %d, %Y") %>
                    </span>
                  </div>
                  <%= link_to "View Application Details", constituent_portal_application_path(@active_application),
                      class: "btn btn-secondary mt-3" %>
                <% else %>
                  <p class="mt-2 text-sm text-gray-600">No active application found.</p>
                  <%= link_to "Apply for Myself", new_constituent_portal_application_path(for_self: true),
                      class: "btn btn-primary mt-3" %>
                <% end %>
              </section>

              <section aria-labelledby="managed-applications-title" class="border-t border-gray-200 pt-6">
                <h3 id="managed-applications-title" class="text-lg leading-6 font-medium text-gray-900">Managed Dependent Applications</h3>

                <% if current_user&.dependents&.any? %>
                  <div class="mt-3 space-y-3">
                    <% current_user.dependents.each do |dependent| %>
                      <% dependent_active_app = @managed_applications.find { |app| app.user_id == dependent.id } %>
                      <% dependent_draft_app = @managed_drafts.find { |app| app.user_id == dependent.id } %>
                      <% if dependent_active_app %>
                        <div>
                          <%= link_to "View #{dependent.full_name}'s Application", constituent_portal_application_path(dependent_active_app),
                              class: "btn btn-secondary" %>
                        </div>
                      <% elsif dependent_draft_app %>
                        <div>
                          <%= link_to "Continue #{dependent.full_name}'s Draft", edit_constituent_portal_application_path(dependent_draft_app),
                              class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium " \
                                     "rounded-md text-warning-700 bg-warning-100 hover:bg-warning-200" %>
                        </div>
                      <% else %>
                        <div>
                          <%= link_to "Apply for #{dependent.full_name}", new_constituent_portal_application_path(user_id: dependent.id, for_self: false),
                              class: "btn btn-secondary" %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="mt-3">
                    <%= link_to "Add Another Dependent", new_constituent_portal_dependent_path,
                        class: "btn btn-outline" %>
                  </div>
                <% else %>
                  <h4 class="mt-3 text-sm font-medium text-gray-900">Want to apply for a dependent?</h4>
                  <p class="mt-2 text-sm text-gray-600">You must first add dependents to your account before applying on their behalf.</p>
                  <%= link_to "Add a Dependent", new_constituent_portal_dependent_path,
                      class: "btn btn-outline mt-3" %>
                <% end %>
              </section>
            </div>
          </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="card overflow-hidden">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg aria-hidden="true" class="h-6 w-6 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <div role="group" aria-labelledby="disability-cert-label">
                    <h3 id="disability-cert-label" class="text-sm font-medium text-gray-500 truncate">Disability Certification</h3>
                    <div class="flex items-center">
                      <p class="text-lg font-medium text-gray-900">
                        <% if @active_application %>
                          <%= @active_application.disability_certification_status.titleize.gsub('_', ' ') %>
                        <% else %>
                          <%= current_user.valid_dcf? ? "Verified" : "Pending" %>
                        <% end %>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
              <% if @active_application %>
                <%= link_to "View Details", constituent_portal_application_path(@active_application),
                      class: "text-sm text-primary-700 hover:text-primary-900" %>
              <% else %>
                <span class="text-sm text-gray-500">No active application</span>
              <% end %>
            </div>
          </div>

          <div class="card overflow-hidden">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg aria-hidden="true" class="h-6 w-6 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <div role="group" aria-labelledby="voucher-label">
                    <h3 id="voucher-label" class="text-sm font-medium text-gray-500 truncate">My Voucher</h3>
                    <div class="flex items-center">
                      <% if @voucher %>
                        <p class="text-lg font-medium text-gray-900">
                          $<%= @voucher.remaining_value %> remaining
                        </p>
                      <% else %>
                        <p class="text-lg font-medium text-gray-900">
                          No active voucher
                        </p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
              <% if @voucher %>
                <div class="text-sm text-gray-500">
                  Code: <span class="font-medium"><%= @voucher.code %></span>
                  <% if @voucher.expiration_date %>
                    <span class="ml-2">Expires: <%= @voucher.expiration_date.strftime("%b %d, %Y") %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-sm text-gray-500">No active voucher</span>
              <% end %>
            </div>
          </div>
        </div>

        <% if @recent_purchases.any? %>
          <section aria-labelledby="dashboard-orders-heading" class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
            <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
              <h3 id="dashboard-orders-heading" class="text-lg leading-6 font-medium text-gray-900"><%= t('fulfillment.orders.heading') %></h3>
            </div>
            <ul role="list" class="divide-y divide-gray-200 px-4 sm:px-6">
              <% @recent_purchases.each do |purchase| %>
                <li class="py-4 flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= purchase.vendor.business_name %></p>
                    <p class="text-sm text-gray-500">
                      <%= t('fulfillment.orders.purchased_on', date: purchase_date(purchase)) %>
                      <% if purchase.voucher.application.user_id != current_user.id %>
                        · <%= t('fulfillment.orders.for_applicant', name: purchase.voucher.application.user.full_name) %>
                      <% end %>
                    </p>
                  </div>
                  <div class="flex flex-wrap items-center gap-3">
                    <%= fulfillment_status_badge(purchase) %>
                    <%= link_to t('fulfillment.orders.view_link'),
                                constituent_portal_application_path(purchase.voucher.application, anchor: 'orders-and-shipping'),
                                class: 'text-sm text-primary-700 hover:text-primary-900',
                                aria: { label: t('fulfillment.orders.view_link_label', vendor: purchase.vendor.business_name,
                                                                                       date: purchase_date(purchase)) } %>
                  </div>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <% if current_user&.dependents.any? || @managed_applications&.any? %>
          <div class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
            <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">My Dependents</h3>
            </div>
            <div class="px-4 py-5 sm:p-6">
              <% if @managed_applications&.any? %>
                <h4 class="text-base font-medium text-gray-900 mb-4">Applications I'm Managing</h4>
                <div class="overflow-hidden border-b border-gray-200 sm:rounded-lg mb-6">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Applicant</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% @managed_applications.each do |application| %>
                        <tr>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900"><%= application.user.full_name %></div>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <%= application_status_badge(application) %>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <%= application.application_date&.strftime("%b %d, %Y") || application.created_at.strftime("%b %d, %Y") %>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <%= link_to "View", constituent_portal_application_path(application), class: "text-primary-600 hover:text-primary-900" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>

              <% if current_user.dependents.any? %>
                <h4 class="text-base font-medium text-gray-900 mb-4">My Dependents</h4>
                <ul role="list" class="divide-y divide-gray-200">
                  <% current_user.dependents.each do |dependent| %>
                    <li class="py-4 flex items-center justify-between">
                      <div class="flex-1">
                        <div class="flex items-center">
                          <p class="text-sm font-medium text-gray-900"><%= dependent.full_name %></p>
                          <%= link_to 'View', constituent_portal_dependent_path(dependent),
                              class: "ml-2 text-xs text-primary-600 hover:text-primary-900" %>
                          <%= link_to 'Edit', edit_constituent_portal_dependent_path(dependent),
                              class: "ml-2 text-xs text-primary-600 hover:text-primary-900" %>
                        </div>
                        <% guardian_relationship = GuardianRelationship.find_by(guardian_user: current_user, dependent_user: dependent) %>
                        <% if guardian_relationship %>
                          <p class="text-sm text-gray-500">Relationship: <%= guardian_relationship.relationship_type %></p>
                        <% end %>
                      </div>
                      <div>
                        <% dependent_active = @managed_applications.find { |app| app.user_id == dependent.id } %>
                        <% dependent_draft = @managed_drafts.find { |app| app.user_id == dependent.id } %>
                        <% if dependent_active %>
                          <%= link_to "View Application", constituent_portal_application_path(dependent_active),
                              class: "btn btn-primary btn-sm rounded-full" %>
                        <% elsif dependent_draft %>
                          <%= link_to "Continue Draft", edit_constituent_portal_application_path(dependent_draft),
                              class: "inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium " \
                                     "rounded-full shadow-elevation-1 text-white bg-warning-600 hover:bg-warning-700" %>
                        <% else %>
                          <%= link_to "Start Application", new_constituent_portal_application_path(user_id: dependent.id, for_self: false),
                              class: "btn btn-success btn-sm rounded-full" %>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-gray-500 text-sm">You do not have any dependents listed yet.</p>
              <% end %>
              <div class="mt-4">
                <%= link_to "Add New Dependent", new_constituent_portal_dependent_path,
                    class: "btn btn-secondary" %>
              </div>
            </div>
          </div>
        <% end %>

        <% if current_user&.guardians.any? %>
          <div class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
            <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">My Guardians</h3>
            </div>
            <div class="px-4 py-5 sm:p-6">
              <% if current_user.guardians.any? %>
                <ul role="list" class="divide-y divide-gray-200">
                  <% current_user.guardians.each do |guardian| %>
                    <li class="py-4 flex items-center justify-between">
                      <div class="flex-1">
                        <p class="text-sm font-medium text-gray-900"><%= guardian.full_name %></p>
                        <% guardian_relationship = GuardianRelationship.find_by(guardian_user: guardian, dependent_user: current_user) %>
                        <% if guardian_relationship %>
                          <p class="text-sm text-gray-500">Relationship: <%= guardian_relationship.relationship_type %></p>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-gray-500 text-sm">You do not have any guardians listed yet.</p>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @active_application %>
          <div class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
            <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">
                Document Status
                <% if @active_application.for_dependent? %>
                  - <%= @active_application.user.full_name %>
                <% else %>
                  - My Application
                <% end %>
              </h3>
              <% if @active_application.for_dependent? %>
                <p class="mt-1 text-sm text-gray-600">
                  Documents for <%= @active_application.user.full_name %>'s application
                </p>
              <% else %>
                <p class="mt-1 text-sm text-gray-600">
                  Documents for your application
                </p>
              <% end %>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-6">
              <% if @active_application&.income_proof_required? %>
                <%= render 'proof_status_card', application: @active_application, proof_type: 'income', label: 'Income' %>
              <% end %>
              <%= render 'proof_status_card', application: @active_application, proof_type: 'residency', label: 'Residency' %>
              <%= render 'proof_status_card', application: @active_application, proof_type: 'id', label: 'ID' %>
            </div>
          </div>
        <% end %>

        <% if @managed_applications&.any? %>
          <% @managed_applications.where.not(status: :draft).each do |managed_app| %>
            <div class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
              <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                  Document Status - <%= managed_app.user.full_name %>
                </h3>
                <p class="mt-1 text-sm text-gray-600">
                  Documents for <%= managed_app.user.full_name %>'s application
                </p>
              </div>
              <div class="px-4 py-5 sm:p-6 space-y-6">
                <% if managed_app.income_proof_required? %>
                  <%= render 'proof_status_card', application: managed_app, proof_type: 'income', label: 'Income' %>
                <% end %>
                <%= render 'proof_status_card', application: managed_app, proof_type: 'residency', label: 'Residency' %>
                <%= render 'proof_status_card', application: managed_app, proof_type: 'id', label: 'ID' %>
              </div>
            </div>
          <% end %>
        <% end %>

        <% if @active_application && @active_application.status_approved? %>
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="card overflow-hidden rounded-none sm:rounded-lg" data-testid="application-admission-card">
              <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900"><%= t('applications.admission.title') %></h3>
              </div>
              <div class="px-4 py-5 sm:p-6">
                <div class="flex items-center">
                  <svg aria-hidden="true" class="h-6 w-6 text-warning-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <p class="ml-3 text-sm text-gray-700"><%= t('applications.admission.blocking_application') %></p>
                </div>
                <% if @remaining_service_months.present? %>
                  <p class="mt-3 text-sm text-gray-700"><%= t('applications.admission.remaining_service_months', count: @remaining_service_months) %></p>
                <% end %>
              </div>
            </div>

            <div class="card overflow-hidden rounded-none sm:rounded-lg" data-testid="training-card">
              <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900">Training Sessions</h3>
              </div>
              <div class="px-4 py-5 sm:p-6">
                <% service_window_end = @active_application.service_window_end_date %>

                <% if @completed_training_sessions&.any? %>
                  <div class="mb-5">
                    <h4 class="text-sm font-medium text-gray-700 mb-2">Previous Sessions</h4>
                    <% @completed_training_sessions.each do |session| %>

                      <div class="mb-3 rounded-md border border-gray-200 bg-gray-50 p-3 text-sm text-gray-700">
                        <p>
                          <span class="font-medium text-gray-900">
                            <%= t('training_history.session', number: session.appointment_number) %>
                          </span>
                          &mdash;
                          <span class="font-medium"><%= session.trainer.full_name %></span>,
                          completed <%= l(session.completed_at, format: :long) %>
                          <% if session.product_trained_on %>
                            on <span class="italic"><%= session.product_trained_on.name %></span>
                          <% end %>
                        </p>
                        <% if session.constituent_summary.present? %>
                          <div class="mt-2">
                            <p class="font-medium text-gray-800"><%= t('training_history.summary') %></p>
                            <div class="mt-1 text-gray-700">
                              <p class="text-sm"><%= t('training_history.language', language: localized_contact_label(:languages, session.summary_locale)) %></p>
                              <%= simple_format(session.constituent_summary, { lang: session.summary_locale }, wrapper_tag: 'p') %>
                              <%= link_to t('training_history.open'), constituent_portal_training_session_path(session), class: 'text-primary-700 underline' %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% if @active_application.service_window_active? %>
                  <% if service_window_end.present? %>
                    <p class="text-xs text-gray-500 mb-3">
                      Training available through <%= service_window_end.strftime("%b %-d, %Y") %> or until all sessions are used.
                    </p>
                  <% end %>

                  <p class="text-sm text-gray-700 mb-4">
                    <span class="font-medium"><%= @remaining_training_sessions %></span>
                    of
                    <span class="font-medium"><%= @max_training_sessions %></span>
                    training sessions remaining.
                  </p>

                  <% if @active_application.training_request_pending? %>
                    <div class="mb-4 rounded-md bg-info-50 p-4">
                      <p class="text-sm text-info-700">
                        <%= t('applications.training_requests.messages.duplicate_pending', locale: current_user.effective_locale) %>
                      </p>
                    </div>
                    <button type="button" disabled class="inline-flex cursor-not-allowed items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-500 shadow-elevation-1">
                      Training Session Requested
                    </button>
                  <% elsif @active_training_session.present? %>
                    <% if @active_training_session.status_requested? %>
                      <div class="mb-4 rounded-md bg-info-50 p-4">
                        <p class="text-sm font-medium text-info-800 mb-1">
                          <%= t('training_history.session', number: @active_training_session.appointment_number) %> &mdash; Awaiting Scheduling
                        </p>
                        <p class="text-sm text-info-700">
                          Assigned to
                          <span class="font-medium"><%= @active_training_session.trainer.full_name %></span>.
                          No date has been set yet &mdash; your trainer will contact you to schedule.
                        </p>
                      </div>
                    <% elsif @active_training_session.scheduled_for.present? %>
                      <div class="mb-4 rounded-md bg-info-50 p-4">
                        <p class="text-sm font-medium text-info-800 mb-1">
                          <%= t('training_history.session', number: @active_training_session.appointment_number) %> &mdash; Scheduled
                        </p>
                        <p class="text-sm text-info-700">
                          With
                          <span class="font-medium"><%= @active_training_session.trainer.full_name %></span>
                          on
                          <span class="font-medium"><%= l(@active_training_session.scheduled_for, format: :long) %></span>.
                        </p>
                      </div>
                    <% else %>
                      <div class="mb-4 rounded-md bg-info-50 p-4">
                        <p class="text-sm font-medium text-info-800 mb-1">
                          <%= t('training_history.session', number: @active_training_session.appointment_number) %> &mdash; In Progress
                        </p>
                        <p class="text-sm text-info-700">
                          With
                          <span class="font-medium"><%= @active_training_session.trainer.full_name %></span>.
                        </p>
                      </div>
                    <% end %>
                    <button type="button" disabled class="inline-flex cursor-not-allowed items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-500 shadow-elevation-1">
                      Training Assigned
                    </button>
                  <% elsif @remaining_training_sessions > 0 %>
                    <%= button_to "Request Training",
                        { controller: "constituent_portal/applications", action: "request_training", id: @active_application.id },
                        method: :post,
                        class: "btn btn-primary" %>
                  <% else %>
                    <p class="text-sm text-gray-700">
                      You have used all of your available training sessions.
                    </p>
                  <% end %>
                <% else %>
                  <% if service_window_end.present? %>
                    <p class="text-sm text-gray-700">
                      Training is no longer available because this application is outside the service window
                      (ended <%= service_window_end.strftime("%B %d, %Y") %>).
                    </p>
                  <% else %>
                    <p class="text-sm text-gray-700">
                      Training is not currently available for this application.
                    </p>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="mt-6 card overflow-hidden rounded-none sm:rounded-lg">
          <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Recent Activity</h3>
          </div>
          <div class="px-4 py-5 sm:p-6">
            <% if @recent_activities.present? %>
              <div class="flow-root">
                <ul role="list" class="-mb-8">
          <% @recent_activities.each do |activity| %>
            <li>
              <div class="relative pb-4">
                <div class="relative flex space-x-3">
                  <div>
                            <span class="<%= activity_icon_class(activity) %>" aria-hidden="true">
                              <%= activity.icon_symbol %>
                            </span>
                          </div>
                          <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                            <div>
                              <p class="text-sm text-gray-700"><%= activity.description %></p>
                              <% if activity.details.present? %>
                                <p class="mt-1 text-sm text-gray-600">
                                  <span class="text-gray-500">Reason:</span> "<%= activity.details %>"
                                </p>
                              <% end %>
                            </div>
                            <div class="text-sm text-gray-500 whitespace-nowrap">
                              <time datetime="<%= activity.created_at.iso8601 %>">
                                <%= time_ago_in_words(activity.created_at) %> ago
                              </time>
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% else %>
              <p class="text-gray-500 text-sm">No recent activity</p>
            <% end %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
