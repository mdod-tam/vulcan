<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="card p-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">Text Message Verification</h1>
      <p class="mt-3 text-gray-600">We've sent a 6-digit code by text to your phone.</p>
    </div>

    <!-- Step Indicator -->
    <div class="flex justify-center mb-8">
      <div class="flex items-center space-x-4">
        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center text-white font-semibold">✓</div>
          <span class="mt-2 text-sm text-primary-600 font-medium">Phone</span>
        </div>
        <div class="w-16 h-1 bg-primary-600"></div>
        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center text-white font-semibold">2</div>
          <span class="mt-2 text-sm text-primary-600 font-medium">Verify</span>
        </div>
        <div class="w-16 h-1 bg-gray-200"></div>
        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-700 font-semibold">3</div>
          <span class="mt-2 text-sm text-gray-600 font-medium">Complete</span>
        </div>
      </div>
    </div>

    <div class="max-w-md mx-auto">
      <div class="bg-info-50 p-4 rounded-lg mb-6">
        <p class="text-sm text-info-800">
          We've sent a 6-digit code by text to <strong><%= @sms_phone_number %></strong>.
          Enter the code below to complete the setup.
        </p>
      </div>

      <%= form_with url: @sms_confirm_path, method: :post, class: "space-y-4" do |form| %>
        <div>
          <label for="code" class="form-label mb-1">Verification Code</label>
          <div class="mt-1 relative rounded-md shadow-elevation-1">
            <%= form.text_field :code, 
                class: "form-input px-4 py-3 text-lg text-center tracking-widest", 
                placeholder: "123456", 
                required: true, 
                pattern: "[0-9]{6}", 
                inputmode: "numeric", 
                autocomplete: "one-time-code",
                autofocus: true,
                maxlength: 6 %>
          </div>
          <p class="mt-2 text-sm text-gray-500">Enter the 6-digit code from the text message.</p>
        </div>

        <div class="flex items-center justify-between pt-4">
          <div>
            <%= render 'shared/sms_resend',
                resend_path: @sms_resend_path,
                message: nil,
                message_type: :success %>
          </div>

          <div>
            <%= form.submit "Verify", class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <a href="<%= setup_two_factor_authentication_path %>" class="text-sm text-gray-600 hover:text-gray-900">
          &larr; Back to all authentication methods
        </a>
      </div>
    </div>

    <div class="mt-8 max-w-md mx-auto bg-warning-50 border border-warning-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-warning-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-warning-800">About text message codes</h3>
          <div class="mt-2 text-sm text-warning-700">
            <p>The code is valid for 10 minutes. If you don't receive the code within a few minutes, ensure your phone number is correct or try another authentication method.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
