<% content_for :title, t('.title') %>

<section class="card border border-gray-200 p-6" aria-labelledby="secure-provider-info-resend-title">
  <h1 id="secure-provider-info-resend-title" class="text-2xl font-semibold text-gray-900"><%= t('.heading') %></h1>
  <p class="mt-3 text-sm text-gray-700"><%= t('.body') %></p>

  <%= form_with url: secure_provider_info_form_resend_path, method: :post, local: true, class: 'mt-6' do |form| %>
    <%= hidden_field_tag :token, @token %>
    <%= form.submit t('.submit'),
                    class: "btn btn-primary min-h-11 w-full sm:w-auto",
                    data: { turbo_submits_with: t('.submitting') } %>
  <% end %>
</section>
