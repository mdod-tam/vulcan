<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="card p-8 w-full max-w-md">
    <h2 class="text-2xl font-semibold mb-6 text-center"><%= t("portal_self_service.account_access.title") %></h2>

    <% if flash[:alert] %>
      <div class="flash-message flash-alert">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <%= form_with url: password_path, method: :post, class: "space-y-6" do |form| %>
      <%= hidden_field_tag :locale, public_form_locale_param if public_form_locale_param.present? %>

      <div>
        <%= form.label :contact, t("portal_self_service.contact_label"), class: "form-label" %>
        <%= form.text_field :contact,
            id: "account-access-contact",
            class: "form-input mt-1",
            required: true,
            autofocus: true,
            aria: { describedby: "account-access-contact-hint" } %>
        <p id="account-access-contact-hint" class="form-hint">
          <%= t("portal_self_service.contact_hint") %>
        </p>
      </div>

      <div>
        <%= form.submit t("portal_self_service.account_access.submit"), class: "btn btn-primary w-full" %>
      </div>

      <div class="text-center mt-4">
        <%= link_to t("portal_self_service.account_access.back_to_sign_in"),
                    sign_in_path(locale: public_form_locale_param),
                    class: "text-sm text-primary-600 hover:text-primary-500" %>
      </div>
    <% end %>
  </div>
</div>
