<%= turbo_stream.prepend "flash" do %>
  <%= render "shared/flash" %>
<% end %>

<%= turbo_stream.replace "password-reset-container" do %>
  <div class="card p-8 w-full max-w-md text-center">
    <h2 class="text-2xl font-semibold mb-4 text-success-700">Password Updated</h2>
    <p class="mb-6 text-gray-700">Your password has been successfully updated.</p>
    <%= link_to "Proceed to Sign In", sign_in_path, class: "btn btn-primary" %>
  </div>
<% end %>
