<main role="main" class="min-h-screen flex items-center justify-center bg-gray-100">
  <section id="password-form-container" class="bg-white p-8 rounded shadow-md w-full max-w-md" aria-labelledby="password-form-heading">
    <% token_reset = params[:token].present? %>
    <h2 id="password-form-heading" class="text-2xl font-semibold mb-6 text-center"><%= token_reset ? "Reset Password" : "Change Password" %></h2>

    <% if flash[:alert] %>
      <div role="alert" aria-live="assertive" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <%= form_with(url: password_path, method: :patch, html: { class: "space-y-6" }) do |form| %>
      <% if token_reset %>
        <%= form.hidden_field :token, value: params[:token] %>
      <% else %>
        <%= render 'shared/password_field',
                   form: form,
                   attribute: :password_challenge,
                   label: 'Current Password',
                   autocomplete: 'current-password',
                   autofocus: true %>
      <% end %>

      <%= render 'shared/password_field',
                 form: form,
                 attribute: :password,
                 label: 'New Password',
                 autocomplete: 'new-password',
                 new_password: true %>

      <%= render 'shared/password_field',
                 form: form,
                 attribute: :password_confirmation,
                 label: 'Confirm New Password',
                 autocomplete: 'new-password' %>

      <div class="flex justify-end space-x-4">
        <%= link_to "Cancel", sign_in_path,
            class: "inline-flex items-center px-3 py-1 border border-gray-300 rounded-md shadow-sm text-xs font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <%= form.submit token_reset ? "Reset Password" : "Change Password",
            class: "inline-flex items-center px-3 py-1 rounded-md shadow-sm text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </section>
</main>
