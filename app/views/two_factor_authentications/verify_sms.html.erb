<div class="max-w-md mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-800"><%= t('two_factor_verification.sms.heading') %></h1>
      <% if @sms_code_sent %>
        <p class="mt-3 text-gray-600"><%= t('two_factor_verification.sms.intro_sent') %></p>
      <% else %>
        <p class="mt-3 text-gray-600"><%= t('two_factor_verification.sms.intro_unsent') %></p>
      <% end %>
      <p class="mt-2 text-sm text-gray-600"><%= t('two_factor_verification.sms.hint') %></p>
    </div>

    <div class="bg-blue-50 rounded-lg p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-blue-700">
            <% if @sms_code_sent %>
              <%= t('two_factor_verification.sms.instructions_sent', phone: @sms_credential.phone_number) %>
            <% else %>
              <%= t('two_factor_verification.sms.instructions_unsent', phone: @sms_credential.phone_number) %>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <% if @sms_code_sent %>
      <%= form_with url: process_verification_two_factor_authentication_path(type: 'sms'), method: :post, class: "space-y-4" do |form| %>
        <div>
          <label for="code" class="block text-sm font-medium text-gray-700 mb-1"><%= t('two_factor_verification.common.code_label') %></label>
          <div class="mt-1 relative rounded-md shadow-sm">
            <%= form.text_field :code,
                class: "block w-full py-3 px-4 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-lg text-center tracking-widest",
                placeholder: "123456",
                required: true,
                pattern: "[0-9]{6}",
                inputmode: "numeric",
                autocomplete: "one-time-code",
                autofocus: true,
                maxlength: 6 %>
          </div>
          <p class="mt-2 text-sm text-gray-500"><%= t('two_factor_verification.sms.code_hint') %></p>
        </div>

        <div class="flex justify-between items-center gap-4 pt-4">
          <%= render 'shared/sms_resend',
              resend_path: resend_sms_verification_two_factor_authentication_path,
              message: nil,
              message_type: :success %>

          <%= form.submit t('two_factor_verification.common.submit'), class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    <% else %>
      <div id="sms_resend" class="space-y-3">
        <%= button_to t('two_factor_verification.sms.send'),
            select_sms_verification_two_factor_authentication_path,
            method: :post,
            class: "w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <p class="text-sm text-gray-500 text-center"><%= t('two_factor_verification.sms.send_hint') %></p>
      </div>
    <% end %>

    <div class="mt-4 flex justify-between gap-4">
      <div>
        <% if @webauthn_enabled %>
          <%= link_to t('two_factor_verification.common.use_key'), verify_method_two_factor_authentication_path(type: 'webauthn'), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
        <% end %>
      </div>
      <div>
        <% if @totp_enabled %>
          <%= link_to t('two_factor_verification.common.use_totp'),
                      verify_method_two_factor_authentication_path(type: 'totp'), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
        <% end %>
      </div>
    </div>

    <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800"><%= t('two_factor_verification.common.trouble') %></h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p><%= t('two_factor_verification.sms.help') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
