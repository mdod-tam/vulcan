<div class="max-w-md mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-800"><%= t('security_key_verification.page.heading') %></h1>
      <p class="mt-3 text-gray-600"><%= t('security_key_verification.page.intro') %></p>
    </div>

    <div class="bg-blue-50 rounded-lg p-6 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800"><%= t('security_key_verification.page.other_methods') %></h3>
          <div class="mt-2 space-y-1">
            <p class="text-sm text-blue-700 flex items-center">
              <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <%= t('security_key_verification.page.key_name') %>
            </p>
            <% if @totp_enabled %>
              <p class="text-sm text-blue-700 flex items-center">
                <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                </svg>
                <%= t('security_key_verification.page.totp_name') %>
              </p>
            <% end %>
            <% if @sms_enabled %>
              <p class="text-sm text-blue-700 flex items-center">
                <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                <%= t('security_key_verification.page.sms_name') %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div data-controller="credential-authenticator"
         data-credential-authenticator-verification-url-value="<%= process_verification_two_factor_authentication_path(type: 'webauthn') %>"
         data-credential-authenticator-messages-value="<%= t('security_key_verification.feedback').merge(
                                                             user_session: t('two_factor_verification.errors.user_session')
                                                           ).to_json %>">
      <%= form_with url: verification_options_two_factor_authentication_path(type: 'webauthn'),
        method: :get,
        local: true,
        class: "space-y-6",
        data: { credential_authenticator_target: "webauthnForm" } do |form| %>

      <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
        <div class="flex items-center space-x-4">
          <div class="flex-shrink-0">
            <svg class="h-12 w-12 text-indigo-600" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium text-gray-900"><%= t('security_key_verification.page.key_name') %></h3>
            <p class="text-sm text-gray-500"><%= t('security_key_verification.page.key_description') %></p>
          </div>
        </div>
        
        <div class="mt-4">
          <ol class="text-sm text-gray-600 space-y-2 ml-4 list-decimal">
            <li>
              <%= t('security_key_verification.page.prepare') %>
              <% if @platform_key_available %>
                <%= t('security_key_verification.page.prepare_platform') %>
              <% else %>
                <%= t('security_key_verification.page.prepare_key') %>
              <% end %>
            </li>
            <li><%= t('security_key_verification.page.click_button') %></li>
            <li>
              <%= t('security_key_verification.page.follow_prompt') %>
              <% if @platform_key_available %>
                <%= t('security_key_verification.page.prompt_platform') %>
              <% else %>
                <%= t('security_key_verification.page.prompt_key') %>
              <% end %>
            </li>
          </ol>
        </div>

        <div class="mt-6 flex justify-center">
          <button type="button"
                  data-credential-authenticator-target="verificationButton"
                  data-action="click->credential-authenticator#startVerification"
                  aria-describedby="security-key-feedback"
                  aria-disabled="false"
                  class="inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50">
            <%= t('security_key_verification.page.submit') %>
          </button>
        </div>
        <p id="security-key-feedback"
           data-credential-authenticator-target="feedback"
           role="status" aria-live="polite" aria-atomic="true"
           class="mt-4 text-sm text-gray-700"></p>
      </div>
      <% end %>
    </div>

    <div class="mt-4 flex justify-between">
      <div>
        <% if @totp_enabled %>
          <%= link_to t('security_key_verification.page.use_totp'), verify_method_two_factor_authentication_path(type: 'totp'), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
        <% end %>
      </div>
      <div>
        <% if @sms_enabled %>
          <%= button_to t('security_key_verification.page.use_sms'),
              select_sms_verification_two_factor_authentication_path,
              method: :post,
              form: { class: "inline" },
              class: "text-sm text-indigo-600 hover:text-indigo-900 bg-transparent border-0 p-0 cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <div class="mt-6 text-center">
      <%= link_to t('security_key_verification.page.lost_key'), lost_security_key_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>
</div>
