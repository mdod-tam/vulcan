<% if flash.any? %>
  <div class="max-w-md mx-auto px-4 mb-4">
    <% flash.each do |key, message| %>
      <div class="<%= flash_class_for(key) %> px-4 py-3 rounded relative">
        <span class="block sm:inline"><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>

<div class="max-w-md mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-800"><%= t('two_factor_verification.totp.heading') %></h1>
      <p class="mt-3 text-gray-600"><%= t('two_factor_verification.totp.intro') %></p>
      <p class="mt-2 text-sm text-gray-600"><%= t('two_factor_verification.totp.hint') %></p>
    </div>

    <div class="bg-blue-50 rounded-lg p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3">
            <p class="text-sm text-blue-700">
              <%= t('two_factor_verification.totp.instructions') %>
            </p>
        </div>
      </div>
    </div>

    <%= form_with url: process_verification_two_factor_authentication_path(type: 'totp'), method: :post, class: "space-y-4" do |form| %>
      <div>
        <label for="code" class="block text-sm font-medium text-gray-700 mb-1"><%= t('two_factor_verification.common.code_label') %></label>
        <div class="mt-1 relative rounded-md shadow-sm">
          <%= form.text_field :code,
              class: "block w-full py-3 px-4 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-lg text-center tracking-widest",
              placeholder: "123456",
              required: true,
              pattern: "[0-9]{6}",
              inputmode: "numeric",
              autocomplete: "one-time-code",
              autofocus: true,
              maxlength: 6 %>
        </div>
        <p class="mt-2 text-sm text-gray-500"><%= t('two_factor_verification.totp.code_hint') %></p>
      </div>

      <div class="flex justify-end pt-4">
        <%= form.submit t('two_factor_verification.common.submit'), class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>

    <div class="mt-4 flex justify-between gap-4">
      <div>
        <% if @webauthn_enabled %>
          <%= link_to t('two_factor_verification.common.use_key'), verify_method_two_factor_authentication_path(type: 'webauthn'), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
        <% end %>
      </div>
      <div>
        <% if @sms_enabled %>
          <%= button_to t('two_factor_verification.common.use_sms'),
              select_sms_verification_two_factor_authentication_path,
              method: :post,
              form: { class: "inline" },
              class: "text-sm text-indigo-600 hover:text-indigo-900 bg-transparent border-0 p-0 cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800"><%= t('two_factor_verification.common.trouble') %></h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p><%= t('two_factor_verification.totp.help') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
