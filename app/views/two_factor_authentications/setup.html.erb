<% locale = @user.effective_message_locale # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<%= link_to 'Skip to main content', '#main-content', class: 'skip-link' %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div id="main-content" tabindex="-1">
    <div class="card p-8">

      <header class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Secure Your Account</h1>
        <p class="mt-3 text-gray-600"><%= t('credential_setup.intro', locale: locale) %></p>
      </header>

      <section aria-labelledby="choose-2fa-heading" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 items-stretch">
        <h2 id="choose-2fa-heading" class="sr-only"><%= t('credential_setup.options', locale: locale) %></h2>

        <!-- WebAuthn/Security Key Option -->
        <article aria-labelledby="webauthn-heading" class="card border border-gray-200 hover:shadow-elevation-3 transition flex flex-col">
          <div class="p-5 flex-1">
            <div class="flex justify-center mb-4">
              <svg aria-hidden="true" focusable="false" class="w-16 h-16 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 116 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 id="webauthn-heading" class="text-lg font-semibold text-center text-gray-800">Security Key</h3>
            <div class="mt-2 flex justify-center">
              <span class="badge badge-success">
                <%= t('credential_setup.recommended', locale: locale) %>
              </span>
            </div>
            <p class="mt-3 text-gray-600 text-center">
              <%= t('credential_setup.description_device', locale: locale) %>
            </p>
          </div>
          <div class="p-5 pt-0">
            <div class="flex flex-col space-y-2">
              <%= link_to new_credential_two_factor_authentication_path(type: 'webauthn'),
                          class: 'btn btn-primary w-full' do %>
                <svg aria-hidden="true" focusable="false" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 116 0z" clip-rule="evenodd"/>
                </svg>
                Set Up Device or Security Key
              <% end %>
            </div>
          </div>
        </article>

        <!-- TOTP Option -->
        <article aria-labelledby="totp-heading" class="card border border-gray-200 hover:shadow-elevation-3 transition flex flex-col">
          <div class="p-5 flex-1">
            <div class="flex justify-center mb-4">
              <svg aria-hidden="true" focusable="false" class="w-16 h-16 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 id="totp-heading" class="text-lg font-semibold text-center text-gray-800">Authenticator App</h3>
            <p class="mt-3 text-gray-600 text-center">
              <%= t('credential_setup.description_app', locale: locale) %>
            </p>
          </div>
          <div class="p-5 pt-0">
            <div class="flex flex-col space-y-2">
              <%= link_to new_credential_two_factor_authentication_path(type: 'totp'),
                          class: 'btn btn-primary w-full' do %>
                <svg aria-hidden="true" focusable="false" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                </svg>
                Set Up Authenticator App
              <% end %>
            </div>
          </div>
        </article>

        <!-- SMS Option -->
        <article aria-labelledby="sms-heading" class="card border border-gray-200 hover:shadow-elevation-3 transition flex flex-col">
          <div class="p-5 flex-1">
            <div class="flex justify-center mb-4">
              <svg aria-hidden="true" focusable="false" class="w-16 h-16 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
              </svg>
            </div>
            <h3 id="sms-heading" class="text-lg font-semibold text-center text-gray-800">Text Message</h3>
            <p class="mt-3 text-gray-600 text-center">
              <%= t('credential_setup.description_text', locale: locale) %>
            </p>
          </div>
          <div class="p-5 pt-0">
            <div class="flex flex-col space-y-2">
              <%= link_to new_credential_two_factor_authentication_path(type: 'sms'),
                          class: 'btn btn-primary w-full' do %>
                <svg aria-hidden="true" focusable="false" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
                  <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
                </svg>
                Set Up Text Message
              <% end %>
            </div>
          </div>
        </article>

      </section>

      <% unless @mfa_required_for_setup_user %>
        <div class="mt-8 text-center">
          <%= link_to 'Skip for now (not recommended)', @setup_dashboard_path, class: 'text-primary-600 hover:text-primary-800 font-medium' %>
        </div>
      <% end %>

    </div>
  </div>
</div>
