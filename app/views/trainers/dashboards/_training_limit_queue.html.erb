<%# locals: (entries:, trainers:, selected_trainer:) -%>
<section id="training-limit" class="card mb-6 p-4">
  <h2 id="training-limit-heading" class="text-lg font-semibold"><%= t('trainer_workflow.dashboard.limit.heading') %></h2>
  <% if trainers.present? %>
    <%= form_with url: trainers_dashboard_path(anchor: 'training-limit'), method: :get, class: 'my-3 flex flex-wrap items-end gap-2' do |form| %>
      <div>
        <%= form.label :training_limit_trainer, t('trainer_workflow.dashboard.trainer'), class: 'form-label' %>
        <%= form.select :training_limit_trainer, trainers.map { |trainer| [trainer.full_name, trainer.id.to_s] },
                        { include_blank: t('trainer_workflow.dashboard.limit.all_trainers'), selected: selected_trainer }, class: 'form-select' %>
      </div>
      <%= form.button(
            t('trainer_workflow.dashboard.limit.apply'),
            name: nil,
            class: 'btn btn-outline',
            aria: { label: t('trainer_workflow.dashboard.limit.apply_filter') }
          ) %>
    <% end %>
  <% end %>
  <% if entries.empty? %>
    <p class="mt-2 text-sm text-gray-600"><%= t('trainer_workflow.dashboard.limit.empty') %></p>
  <% else %>
    <div class="mt-3 max-w-full overflow-x-auto" role="group" aria-labelledby="training-limit-heading" tabindex="0">
      <table class="w-full divide-y divide-gray-200 text-left text-sm" aria-labelledby="training-limit-heading">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.constituent') %></th>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.trainer') %></th>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.limit.completed') %></th>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.limit.reserved') %></th>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.status') %></th>
            <th scope="col" class="px-3 py-2"><%= t('trainer_workflow.dashboard.limit.next_appointment') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% entries.each do |entry| %>
            <tr>
              <th scope="row" class="px-3 py-2 font-medium">
                <%= link_to entry.application.user.full_name, admin_application_path(entry.application, anchor: 'admin-training-heading'),
                            class: 'text-primary-700 underline' %>
              </th>
              <td class="px-3 py-2"><%= entry.application.assigned_trainer&.full_name || t('trainer_workflow.dashboard.limit.unassigned') %></td>
              <td class="px-3 py-2 tabular-nums"><%= entry.completed %></td>
              <td class="px-3 py-2 tabular-nums"><%= entry.reserved %></td>
              <td class="px-3 py-2"><%= t(entry.remaining.zero? ? 'trainer_workflow.dashboard.limit.last_reserved' : 'trainer_workflow.dashboard.limit.one_left') %></td>
              <td class="px-3 py-2"><%= entry.next_appointment ? l(entry.next_appointment, format: :short) : t('trainer_workflow.dashboard.limit.none_scheduled') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
