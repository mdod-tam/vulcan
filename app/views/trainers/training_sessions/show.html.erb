<div class="container mx-auto max-w-5xl px-4 py-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= t('trainer_workflow.show.title', number: @session_number) %></h1>
    <div class="flex flex-wrap gap-4">
      <% if @current_training_access %><%= link_to t('trainer_workflow.show.jump_actions'), '#session-actions', class: 'text-primary-700 underline' %><% end %>
      <%= link_to t('trainer_workflow.show.back'), trainers_training_sessions_path, class: 'text-primary-700 underline' %>
    </div>
  </div>
  <% if @failed_training_action &&
        !training_available_actions(@training_session, can_manage: @can_manage_training_session).include?(@failed_training_action) &&
        training_next_action(@training_session, can_manage: @can_manage_training_session, actor: current_user) != @failed_training_action %>
    <%= render 'shared/action_errors', action: @failed_training_action, form: nil, form_errors: @training_form_errors,
                                       heading: t('trainer_workflow.error_heading') %>
  <% end %>
  <section class="mb-6 card p-6" aria-labelledby="session-heading">
    <h2 id="session-heading" class="text-lg font-semibold"><%= t('trainer_workflow.show.training_for', name: @constituent.full_name) %></h2>
    <p class="mt-2"><%= training_session_status_badge(@training_session, label: t("trainer_workflow.statuses.#{@training_session.status}")) %></p>
    <dl class="mt-4 space-y-3">
      <div><dt class="font-medium"><%= t('trainer_workflow.show.agreed_appointment', zone: Time.zone.name) %></dt>
        <dd><%= if @training_session.scheduled_for
                  l(@training_session.scheduled_for,
                    format: :long)
                else
                  t('trainer_workflow.show.not_scheduled')
                end %></dd>
      </div>
      <div><dt class="font-medium"><%= t('trainer_workflow.show.trainer') %></dt>
        <dd><%= @training_session.trainer.full_name %></dd>
      </div>
      <% if @training_session.location.present? %><div><dt class="font-medium"><%= t('trainer_workflow.fields.location') %></dt>
        <dd><%= @training_session.location %></dd>
      </div><% end %>
      <% if @training_session.internal_notes.present? %><div><dt class="font-medium"><%= t('trainer_workflow.fields.private_notes') %></dt>
        <dd><%= simple_format(@training_session.internal_notes) %></dd>
      </div><% end %>
      <% if @training_session.status_completed? %>
        <div><dt class="font-medium"><%= t('trainer_workflow.show.actual_completion') %></dt>
        <dd><%= l(@training_session.completed_at, format: :long) %></dd>
      </div>
        <div><dt class="font-medium"><%= t('trainer_workflow.show.report_submitted') %></dt>
        <dd><%= @training_session.report_submitted_at && l(@training_session.report_submitted_at, format: :long) %></dd>
      </div>
        <div><dt class="font-medium"><%= t('trainer_workflow.show.duration') %></dt>
        <dd><%= t('trainer_workflow.duration_label', count: @training_session.duration_hours,
                                                     hours: number_with_precision(@training_session.duration_hours, precision: 2, strip_insignificant_zeros: true)) %></dd>
      </div>
        <div><dt class="font-medium"><%= t('trainer_workflow.fields.product') %></dt>
        <dd><%= @training_session.product_trained_on&.name %></dd>
      </div>
        <div><dt class="font-medium"><%= t('trainer_workflow.show.shared_summary_language', language: t("trainer_workflow.languages.#{@training_session.summary_locale}")) %></dt>
        <dd lang="<%= @training_session.summary_locale %>"><%= simple_format(@training_session.constituent_summary) %></dd>
      </div>
      <% end %>
      <% if @training_session.cancellation_reason.present? %><div><dt class="font-medium"><%= t('trainer_workflow.fields.cancellation_reason') %></dt>
        <dd><%= @training_session.cancellation_reason %></dd>
      </div><% end %>
      <% if @training_session.no_show_notes.present? %><div><dt class="font-medium"><%= t('trainer_workflow.fields.no_show_reason') %></dt>
        <dd><%= @training_session.no_show_notes %></dd>
      </div><% end %>
    </dl>
  </section>

  <% if @current_training_access %>
    <section class="mb-6 card p-6" aria-labelledby="training-capacity-heading">
      <h2 id="training-capacity-heading" class="mb-3 text-lg font-semibold"><%= t('trainer_workflow.capacity.heading') %></h2>
      <p><strong><%= t('trainer_workflow.capacity.completed', count: @completed_training_sessions_count) %></strong>,
        <%= t('trainer_workflow.capacity.reserved', count: @reserved_training_sessions_count - @completed_training_sessions_count) %>,
        <%= t('trainer_workflow.capacity.remaining', count: @remaining_training_session_slots, max: @max_training_sessions) %></p>
      <% @open_training_sessions.each do |session| %>
        <% unless session.id == @training_session.id %>
          <p class="mt-2">
            <%= link_to t('training_feedback.open_appointment', number: session.appointment_number),
                        trainers_training_session_path(session), class: 'text-primary-700 underline' %>
          </p>
        <% end %>
      <% end %>
    </section>
    <section id="session-actions" class="mb-6" aria-labelledby="session-actions-heading" tabindex="-1">
      <h2 id="session-actions-heading" class="mb-4 text-xl font-semibold">
        <%= if @training_session.status_scheduled? || @training_session.status_confirmed?
              t('trainer_workflow.show.what_happened')
            else
              t('trainer_workflow.show.actions_heading')
            end %>
      </h2>
      <% if @application.training_request_pending? %>
        <p class="mb-4 rounded-lg bg-info-50 p-4 font-medium"><%= t('trainer_workflow.show.request_pending') %></p>
      <% end %>
    <% if @can_manage_training_session %>
      <% if @training_session.status_requested? %>
        <%= render 'appointment_form', action: :schedule, training_session: @training_session %>
        <details class="mb-6 rounded-lg border border-gray-300 p-4" <%= 'open' if @failed_training_action == :cancel %>>
          <summary class="cursor-pointer font-medium text-gray-700"><%= t('trainer_workflow.actions.cancel_requested') %></summary>
          <%= render 'outcome_reason_form', action: :cancel, training_session: @training_session %>
        </details>
      <% elsif @training_session.status_scheduled? || @training_session.status_confirmed? %>
        <section class="mb-6 card p-6" data-controller="training-outcome"
                 data-training-outcome-message-value="<%= t('trainer_workflow.show.form_shown', action: '__ACTION__') %>">
          <label for="training-outcome" class="mt-3 block font-medium"><%= t('trainer_workflow.show.choose_outcome') %></label>
          <%= select_tag :training_outcome,
                         options_for_select(training_outcome_options(@training_session, can_manage: @can_manage_training_session), @failed_training_action),
                         include_blank: t('trainer_workflow.show.choose_action'), id: 'training-outcome', class: 'form-input mt-2',
                         data: { training_outcome_target: 'selection', action: 'training-outcome#change' } %>
          <p class="mt-2 text-sm text-gray-600" role="status" aria-live="polite" aria-atomic="true" data-training-outcome-target="status"></p>
          <% training_available_actions(@training_session, can_manage: @can_manage_training_session).each do |action| %>
            <div data-training-outcome-target="panel" data-outcome="<%= action %>">
              <% if action == :complete %><%= render 'completion_form', training_session: @training_session %>
              <% elsif action == :reschedule %><%= render 'appointment_form', action: action, training_session: @training_session %>
              <% else %><%= render 'outcome_reason_form', action: action, training_session: @training_session %><% end %>
            </div>
          <% end %>
        </section>
      <% else %>
        <% if training_next_action(@training_session, can_manage: @can_manage_training_session, actor: current_user) %>
          <%= render 'appointment_form', action: training_next_action(@training_session, can_manage: @can_manage_training_session, actor: current_user),
                                         training_session: @training_session %>
        <% elsif (reason = training_next_action_unavailable_reason(@training_session, can_manage: @can_manage_training_session, actor: current_user)) %>
          <p class="mb-6 rounded-lg bg-info-50 p-4"><%= reason %></p>
        <% end %>
      <% end %>
    <% else %><p class="mb-6"><%= t('trainer_workflow.show.read_only') %></p><% end %>
    </section>
    <section class="mb-6 card p-6" aria-labelledby="preparation-heading">
      <h2 id="preparation-heading" class="text-lg font-semibold"><%= t('trainer_workflow.show.preparation') %></h2>
      <dl><%= render 'shared/application_contacts', context: @contact_context %></dl>
      <% if @evaluation_recommendations %>
        <h3 class="mt-4 font-semibold"><%= t('trainer_workflow.show.evaluation_recommendations') %></h3>
        <%= render 'shared/evaluation_recommendations', evaluation: @evaluation_recommendations, locale: I18n.locale %>
      <% end %>
      <h3 id="known-products-heading" class="mt-4 font-semibold"><%= t('trainer_workflow.show.known_products') %></h3>
      <p class="text-sm text-gray-600"><%= t('trainer_workflow.show.known_products_help') %></p>
      <% if @known_products.any? %>
        <% @known_products.each do |product| %>
          <%= render 'shared/product_resources', product: product, heading_level: 4,
                                                 region_id: dom_id(@training_session, "preparation_product_#{product.id}_resources"),
                                                 context_id: 'known-products-heading' %>
        <% end %>
      <% else %><p><%= t('trainer_workflow.show.no_known_products') %></p><% end %>
    </section>
    <% if @previous_training_sessions.any? %>
      <section class="mb-6 card p-6">
        <h2 class="text-lg font-semibold"><%= t('trainer_workflow.history.heading') %></h2>
        <% @previous_training_sessions.each do |session| %>
          <article class="mt-4 border-t pt-4">
            <h3 class="font-medium"><%= t('trainer_workflow.history.session', number: session.appointment_number, trainer: session.trainer.full_name) %></h3>
            <p><%= t('trainer_workflow.fields.private_notes') %></p><%= simple_format(session.internal_notes) %>
            <p><%= t('trainer_workflow.history.summary_language', language: t("trainer_workflow.languages.#{session.summary_locale}")) %></p>
            <div lang="<%= session.summary_locale %>"><%= simple_format(session.constituent_summary) %></div>
          </article>
        <% end %>
      </section>
    <% end %>
    <div class="mt-6">
      <%= render 'shared/activity_history', activity_logs: @activity_logs, title: t('training_feedback.activity') %>
    </div>
    <% if @training_notifications.any? || @unlinked_training_attempts.any? %>
      <section class="mt-6 rounded-lg border border-gray-200 bg-white p-6" aria-label="<%= t('delivery_visibility.history') %>">
        <h2 class="text-lg font-semibold"><%= t('delivery_visibility.history') %></h2>
        <p class="mt-2 text-sm text-gray-600"><%= t('training_feedback.manual_contact') %></p>
        <% @training_notifications.each do |notification| %>
          <%= delivery_visibility(notification) %>
        <% end %>
        <% @unlinked_training_attempts.each do |attempt| %>
          <%= render 'shared/delivery/status', presenter: DeliveryStatusPresenter.new(@training_session, attempt: attempt) %>
        <% end %>
      </section>
    <% end %>
  <% else %><p><%= t('trainer_workflow.show.historical_access') %></p><% end %>
  <% if @training_session.status_completed? && @training_session.product_trained_on %>
    <section class="card p-6"><h2 id="completed-trained-product-heading" class="text-lg font-semibold"><%= t('trainer_workflow.show.resources') %></h2>
      <%= render 'shared/product_resources',
                 product: @training_session.product_trained_on, heading_level: 3,
                 region_id: dom_id(@training_session, :completed_product_resources), context_id: 'completed-trained-product-heading' %>
    </section>
  <% end %>
</div>
