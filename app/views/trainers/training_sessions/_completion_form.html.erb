<%# locals: (training_session:) -%>
<div class="mt-4">
  <h3 class="text-lg font-semibold"><%= t('trainer_workflow.forms.completion_heading') %></h3>
  <p class="mt-2 text-sm text-gray-600"><%= t('trainer_workflow.forms.completion_help') %></p>
  <%= form_with url: complete_trainers_training_session_path(training_session), namespace: :complete, class: 'mt-4 space-y-4',
                data: { controller: 'training-duration-confirmation', action: 'submit->training-duration-confirmation#confirm',
                        training_duration_confirmation_message_value: t('trainer_workflow.confirmation.message', hours: '__HOURS__') } do |f| %>
    <%= render 'shared/action_errors', action: :complete, form: f, form_errors: @training_form_errors,
                                       heading: t('trainer_workflow.error_heading') %>
    <div>
      <p id="complete-time-help" class="form-hint"><%= t('trainer_workflow.forms.completed_at_help') %>
        <%= t('date_time_input.hint', zone: Time.zone.name) %></p>
      <%= f.label :completed_at, training_required_label(t('trainer_workflow.fields.completed_at', zone: Time.zone.name)), class: 'form-label' %>
      <%= f.datetime_local_field :completed_at,
                                 value: training_form_value(:complete,
                                                            :completed_at,
                                                            training_completion_time_default(training_session),
                                                            form_values: @training_form_values),
                                 required: true,

                                 class: 'form-input mt-1',
                                 aria: training_form_aria(:complete,
                                                          :completed_at,
                                                          describedby: 'complete-time-help',
                                                          form_errors: @training_form_errors) %>
      <%= render 'shared/field_errors', action: :complete, attribute: :completed_at, form_errors: @training_form_errors %>
    </div>
    <div>
      <%= f.label :product_trained_on_id, training_required_label(t('trainer_workflow.fields.product')), class: 'form-label' %>
      <p id="complete-product-help" class="form-hint"><%= t('trainer_workflow.forms.product_help') %></p>
      <%= f.collection_select :product_trained_on_id,
                              @available_products,
                              :id,
                              :name,
                              { include_blank: t('trainer_workflow.forms.choose_product'),
                                selected: training_form_value(:complete,
                                                              :product_trained_on_id,
                                                              training_session.product_trained_on_id,
                                                              form_values: @training_form_values) },
                              { required: true,
                                class: 'form-input mt-1',
                                aria: training_form_aria(:complete,
                                                         :product_trained_on_id,
                                                         describedby: 'complete-product-help',
                                                         form_errors: @training_form_errors) } %>
      <%= render 'shared/field_errors', action: :complete, attribute: :product_trained_on_id, form_errors: @training_form_errors %>
    </div>
    <div>
      <%= f.label :duration_hours, training_required_label(t('trainer_workflow.fields.duration')), class: 'form-label' %>
      <%= f.number_field :duration_hours, data: { training_duration_confirmation_target: 'duration' },
                                          value: training_form_value(:complete,
                                                                     :duration_hours,
                                                                     training_session.duration_hours,
                                                                     form_values: @training_form_values),
                                          min: 0.01,
                                          step: 0.01,

                                          required: true,
                                          class: 'form-input mt-1',
                                          aria: training_form_aria(:complete,
                                                                   :duration_hours,
                                                                   describedby: 'duration_hours_hint',
                                                                   form_errors: @training_form_errors) %>
      <p id="duration_hours_hint" class="form-hint"><%= t('trainer_workflow.forms.duration_help') %></p>
      <%= render 'shared/field_errors', action: :complete, attribute: :duration_hours, form_errors: @training_form_errors %>
    </div>
    <div>
      <%= f.label :constituent_summary, training_required_label(t('trainer_workflow.fields.summary')), class: 'form-label' %>
      <p id="complete-summary-help" class="form-hint"><%= t('trainer_workflow.forms.summary_help') %></p>
      <%= f.text_area :constituent_summary,
                      value: training_form_value(:complete,
                                                 :constituent_summary,
                                                 form_values: @training_form_values),
                      rows: 5,
                      required: true,

                      class: 'form-input mt-1',
                      aria: training_form_aria(:complete,
                                               :constituent_summary,
                                               describedby: 'complete-summary-help',
                                               form_errors: @training_form_errors) %>
      <%= render 'shared/field_errors', action: :complete, attribute: :constituent_summary, form_errors: @training_form_errors %>
    </div>
    <div>
      <p id="complete-summary-language-help" class="form-hint"><%= t('trainer_workflow.forms.summary_language_help') %></p>
      <%= f.label :summary_locale, training_required_label(t('trainer_workflow.fields.summary_locale')), class: 'form-label' %>
      <%= f.select :summary_locale,
                   I18n.available_locales.map { |locale|
                     [t("trainer_workflow.languages.#{locale}"),
                      locale]
                   },
                   { include_blank: t('trainer_workflow.forms.choose_language'),
                     selected: training_form_value(:complete,
                                                   :summary_locale,
                                                   @contact_context.locale,
                                                   form_values: @training_form_values) },
                   { required: true,
                     class: 'form-input mt-1',
                     aria: training_form_aria(:complete,
                                              :summary_locale,
                                              describedby: 'complete-summary-language-help',
                                              form_errors: @training_form_errors) } %>
      <%= render 'shared/field_errors', action: :complete, attribute: :summary_locale, form_errors: @training_form_errors %>
    </div>
    <div>
      <%= f.label :internal_notes, t('trainer_workflow.fields.observations'), class: 'form-label' %>
      <p id="complete-observations-help" class="form-hint"><%= t('trainer_workflow.forms.observations_help') %></p>
      <%= f.text_area :internal_notes,
                      value: training_form_value(:complete,
                                                 :internal_notes,
                                                 training_session.internal_notes,
                                                 form_values: @training_form_values),

                      rows: 4,
                      class: 'form-input mt-1',
                      aria: training_form_aria(:complete,
                                               :internal_notes,
                                               describedby: 'complete-observations-help',
                                               form_errors: @training_form_errors) %>
      <%= render 'shared/field_errors', action: :complete, attribute: :internal_notes, form_errors: @training_form_errors %>
    </div>
      <dialog class="max-w-[calc(100%_-_2rem)] rounded-lg bg-white p-0 shadow-elevation-4 backdrop:bg-gray-500 backdrop:bg-opacity-75" aria-labelledby="training-duration-confirmation-title" aria-describedby="training-duration-confirmation-message" data-training-duration-confirmation-target="dialog" data-action="cancel->training-duration-confirmation#cancel">
        <div class="max-w-md p-6">
          <h4 id="training-duration-confirmation-title" class="text-lg font-semibold text-gray-900"><%= t('trainer_workflow.confirmation.title') %></h4>
          <p id="training-duration-confirmation-message" class="mt-3 text-sm text-gray-700" data-training-duration-confirmation-target="message"></p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
            <button type="button" class="btn btn-outline min-h-[44px]" data-training-duration-confirmation-target="noButton" data-action="training-duration-confirmation#cancel">
              <%= t('trainer_workflow.confirmation.no') %>
            </button>
            <button type="button" class="btn btn-primary min-h-[44px]" data-training-duration-confirmation-target="yesButton" data-action="training-duration-confirmation#proceed">
              <%= t('trainer_workflow.confirmation.yes') %>
            </button>
          </div>
        </div>
      </dialog>
    <%= f.submit t('trainer_workflow.forms.save_report'),
                 id: 'complete_submit', class: 'btn btn-success',
                 data: { turbo_submits_with: t('trainer_workflow.forms.saving_report'), training_duration_confirmation_target: 'submitButton' } %>
  <% end %>
</div>
