<%# locals: (action:, training_session:) -%>
<section class="mb-6 mt-4 card p-6" aria-labelledby="<%= action %>-heading">
  <h3 id="<%= action %>-heading" class="text-lg font-semibold">
    <%= t(training_session.status_requested? ? 'trainer_workflow.actions.cancel_requested' : "trainer_workflow.actions.#{action}") %>
  </h3>
  <p id="<%= action %>-reason-help" class="form-hint">
    <%= t(training_session.status_requested? ? 'trainer_workflow.forms.requested_cancel_help' : 'trainer_workflow.forms.outcome_help') %>
  </p>
  <%= form_with url: training_action_url(action, training_session), namespace: action, class: 'mt-4 space-y-4',
                data: { turbo_confirm: (t('trainer_workflow.forms.cancel_confirm') if action == :cancel) } do |f| %>
    <%= render 'shared/action_errors', action: action, form: f, form_errors: @training_form_errors,
                                       heading: t('trainer_workflow.error_heading') %>
    <% if action == :cancel %>
      <div><%= f.label :cancellation_initiator, training_required_label(t('trainer_workflow.fields.who_cancelled')), class: 'form-label' %>
        <%= f.select :cancellation_initiator,
                     [[t('trainer_workflow.cancellers.constituent'), 'constituent'],
                      [t('trainer_workflow.cancellers.trainer'), 'trainer'],
                      [t('trainer_workflow.cancellers.program'), 'program']],
                     { include_blank: t('trainer_workflow.forms.choose_canceller'),
                       selected: training_form_value(action,
                                                     :cancellation_initiator,
                                                     form_values: @training_form_values) },
                     { required: true,
                       class: 'form-input mt-1',
                       aria: training_form_aria(action,
                                                :cancellation_initiator,
                                                form_errors: @training_form_errors) } %>
        <%= render 'shared/field_errors', action: action, attribute: :cancellation_initiator, form_errors: @training_form_errors %>
      </div>
      <div><%= f.label :cancellation_reason, training_required_label(t('trainer_workflow.fields.cancellation_reason')), class: 'form-label' %>
        <%= f.text_area :cancellation_reason,
                        value: training_form_value(action,
                                                   :cancellation_reason,
                                                   form_values: @training_form_values),
                        required: true,
                        rows: 3,

                        class: 'form-input mt-1',
                        aria: training_form_aria(action,
                                                 :cancellation_reason,
                                                 describedby: "#{action}-reason-help",
                                                 form_errors: @training_form_errors) %>
        <%= render 'shared/field_errors', action: action, attribute: :cancellation_reason, form_errors: @training_form_errors %>
      </div>
    <% else %>
      <div><%= f.label :no_show_notes, training_required_label(t('trainer_workflow.fields.no_show_reason')), class: 'form-label' %>
        <%= f.text_area :no_show_notes,
                        value: training_form_value(action,
                                                   :no_show_notes,
                                                   form_values: @training_form_values),
                        required: true,
                        rows: 3,

                        class: 'form-input mt-1',
                        aria: training_form_aria(action,
                                                 :no_show_notes,
                                                 describedby: "#{action}-reason-help",
                                                 form_errors: @training_form_errors) %>
        <%= render 'shared/field_errors', action: action, attribute: :no_show_notes, form_errors: @training_form_errors %>
      </div>
    <% end %>
    <%= f.submit t(training_session.status_requested? ? 'trainer_workflow.actions.cancel_requested' : "trainer_workflow.actions.#{action}"),
                 class: 'btn btn-outline',
                 data: { turbo_submits_with: t('trainer_workflow.forms.saving_outcome') } %>
  <% end %>
</section>
