<a href="#main-content" class="skip-link">
  <%= t('trainer_workflow.list.skip') %>
</a>
<div id="main-content" tabindex="-1" class="container mx-auto px-4 py-8">
  <% trainer_filter_params = @trainer_filter.present? ? { trainer_id: @trainer_filter.id } : {} # rubocop:disable Lint/UselessAssignment %>

  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <h1 id="sessions-list-heading" class="text-2xl font-bold">
      <% if @current_status == 'requested' %>
        <%= t('trainer_workflow.list.titles.requested') %>
      <% elsif @current_status == 'scheduled' %>
        <%= t('trainer_workflow.list.titles.scheduled') %>
      <% elsif @current_status == 'completed' %>
        <%= t('trainer_workflow.list.titles.completed') %>
      <% elsif %w[needs_followup no_show cancelled].include?(@current_status) %>
        <%= t('trainer_workflow.list.titles.follow_up') %>
      <% else %>
        <%= t('trainer_workflow.list.titles.all') %>
      <% end %>

      <% if current_user.admin? && @current_scope.present? %>
        <span class="text-lg font-normal ml-2 text-gray-600">
          (<%= if @trainer_filter.present?
                 @trainer_filter.full_name
               else
                 (@current_scope == 'mine' ? t('trainer_workflow.list.scopes.assigned_to_me') : t('trainer_workflow.list.scopes.all_trainers'))
               end %>)
        </span>
      <% end %>
    </h1>

    <div>
      <%= link_to t('trainer_workflow.list.back'), trainers_dashboard_path,
                  class: 'btn btn-outline' %>
    </div>
  </div>

  <div class="mb-6 flex flex-wrap gap-4">
    <% if current_user.admin? %>
      <div class="flex items-center gap-2 bg-gray-100 p-1 rounded-lg">
        <span class="text-xs font-semibold text-gray-500 px-2"><%= t('trainer_workflow.list.filters.view') %>:</span>
        <%= link_to t('trainer_workflow.list.scopes.all_trainers'), filtered_trainers_training_sessions_path(scope: 'all', status: @current_status),
                    class: [@current_scope == 'all' ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                            'px-4 py-2 rounded-md font-medium transition-colors duration-200'] %>

        <%= link_to t('trainer_workflow.list.scopes.my_sessions'), filtered_trainers_training_sessions_path(scope: 'mine', status: @current_status),
                    class: [@current_scope == 'mine' ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                            'px-4 py-2 rounded-md font-medium transition-colors duration-200'] %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-2 bg-gray-100 p-1 rounded-lg" role="group" aria-labelledby="training-status-filter-label">
      <span id="training-status-filter-label" class="text-xs font-semibold text-gray-500 px-2"><%= t('trainer_workflow.list.filters.status') %>:</span>
      <%= link_to t('trainer_workflow.list.filters.all'),
                  if current_user.admin?
                    filtered_trainers_training_sessions_path({ scope: @current_scope }.merge(trainer_filter_params))
                  else
                    trainers_training_sessions_path
                  end,
                  class: [@current_status.blank? ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                          'px-4 py-2 rounded-md font-medium transition-colors duration-200'],
                  aria: { current: (@current_status.blank? ? 'true' : nil) } %>

      <%= link_to t('trainer_workflow.list.filters.requested'),
                  if current_user.admin?
                    filtered_trainers_training_sessions_path({ scope: @current_scope, status: 'requested' }.merge(trainer_filter_params))
                  else
                    requested_trainers_training_sessions_path
                  end,
                  class: [@current_status == 'requested' ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                          'px-4 py-2 rounded-md font-medium transition-colors duration-200'],
                  aria: { current: (@current_status == 'requested' ? 'true' : nil) } %>

      <%= link_to t('trainer_workflow.list.filters.scheduled'),
                  if current_user.admin?
                    filtered_trainers_training_sessions_path({ scope: @current_scope, status: 'scheduled' }.merge(trainer_filter_params))
                  else
                    scheduled_trainers_training_sessions_path
                  end,
                  class: [@current_status == 'scheduled' ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                          'px-4 py-2 rounded-md font-medium transition-colors duration-200'],
                  aria: { current: (@current_status == 'scheduled' ? 'true' : nil) } %>

      <%= link_to t('trainer_workflow.list.filters.completed'),
                  if current_user.admin?
                    filtered_trainers_training_sessions_path({ scope: @current_scope, status: 'completed' }.merge(trainer_filter_params))
                  else
                    completed_trainers_training_sessions_path
                  end,
                  class: [@current_status == 'completed' ? 'bg-white shadow-elevation-1 text-primary-600' : 'text-gray-700 hover:bg-gray-200',
                          'px-4 py-2 rounded-md font-medium transition-colors duration-200'],
                  aria: { current: (@current_status == 'completed' ? 'true' : nil) } %>

      <%= link_to t('trainer_workflow.list.filters.needs_followup'),
                  if current_user.admin?
                    filtered_trainers_training_sessions_path({ scope: @current_scope, status: 'needs_followup' }.merge(trainer_filter_params))
                  else
                    needs_followup_trainers_training_sessions_path
                  end,
                  class: "#{if %w[needs_followup cancelled
                                  no_show].include?(@current_status)
                              'bg-white shadow-elevation-1 text-primary-600'
                            else
                              'text-gray-700 hover:bg-gray-200'
                            end} px-4 py-2 rounded-md font-medium transition-colors duration-200",
                  aria: { current: (%w[needs_followup cancelled no_show].include?(@current_status) ? 'true' : nil) } %>
    </div>
  </div>

  <% if @training_sessions.any? %>
    <div class="overflow-x-auto card" role="region" aria-labelledby="sessions-list-heading" tabindex="0">
      <table class="min-w-full divide-y divide-gray-200" aria-labelledby="sessions-list-heading">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('trainer_workflow.list.columns.date_time') %></th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('trainer_workflow.list.columns.constituent') %></th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('trainer_workflow.list.columns.status') %></th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('trainer_workflow.list.columns.application_id') %></th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('trainer_workflow.list.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @training_sessions.each do |session| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <% if session.status == 'completed' && session.completed_at.present? %>
                  <%= t('trainer_workflow.list.completed_date', date: l(session.completed_at.to_date, format: :long)) %>
                  <div class="text-xs text-gray-500">
                    <%= t('trainer_workflow.list.duration', duration: training_duration_hours_label(session.duration_hours)) %>
                  </div>
                <% else %>
                  <%= session.scheduled_for ? l(session.scheduled_for, format: :long) : t('trainer_workflow.show.not_scheduled') %>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= session.application.constituent_full_name %>
                <p class="text-xs text-gray-600"><%= t('trainer_workflow.list.session', number: session.appointment_number) %></p>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="<%= badge_class_for(:training_session, session.status) %>">
                  <span class="sr-only"><%= t('trainer_workflow.list.columns.status') %>: </span>
                  <% if session.status == 'requested' %>
                    <%= t('trainer_workflow.list.filters.requested') %>
                  <% else %>
                    <%= t("trainer_workflow.statuses.#{session.status}") %>
                  <% end %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.application.id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <% if session.status == 'requested' %>
                  <%= link_to t('trainer_workflow.list.actions.view_schedule'), trainers_training_session_path(session),
                              class: 'btn btn-primary btn-sm',
                              aria: { label: t('trainer_workflow.list.action_name', action: t('trainer_workflow.list.actions.view_schedule'),
                                                                                    name: session.application.constituent_full_name,
                                                                                    number: session.appointment_number) } %>
                <% elsif session.status_scheduled? || session.status_confirmed? %>
                  <%= link_to t('trainer_workflow.list.actions.complete_report'), trainers_training_session_path(session),
                              class: 'btn btn-primary btn-sm',
                              aria: { label: t('trainer_workflow.list.action_name', action: t('trainer_workflow.list.actions.complete_report'),
                                                                                    name: session.application.constituent_full_name,
                                                                                    number: session.appointment_number) } %>
                <% else %>
                  <%= link_to t('trainer_workflow.list.actions.view_details'), trainers_training_session_path(session),
                              class: 'btn btn-primary btn-sm',
                              aria: { label: t('trainer_workflow.list.action_name', action: t('trainer_workflow.list.actions.view_details'),
                                                                                    name: session.application.constituent_full_name,
                                                                                    number: session.appointment_number) } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="py-4">
      <%== pagy_nav(@pagy) if defined?(@pagy) %>
    </div>
  <% else %>
    <div class="bg-white shadow-elevation-2 sm:rounded-lg p-6 text-center">
      <p class="text-gray-500"><%= t('trainer_workflow.list.empty') %></p>
    </div>
  <% end %>
</div>
