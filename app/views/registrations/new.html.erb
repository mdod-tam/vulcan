<a href="#signup-form" class="skip-link"><%= t('portal_self_service.registrations.skip_to_form') %></a>
<div class="flex items-center justify-center bg-gray-100 px-4 py-12">
  <section class="card p-6 sm:p-8 w-full max-w-md" aria-labelledby="signup-heading">
    <h1 id="signup-heading" class="text-2xl font-semibold mb-4"><%= t('portal_self_service.registrations.title') %></h1>
    <p class="mb-4"><%= t('registration_verification.introduction') %></p>
    <%= form_with scope: :user, url: sign_up_path, id: 'signup-form' do |form| %>
      <%= form.hidden_field :locale, value: @verification.locale %>
      <div class="mb-4">
        <%= form.label :email, t('portal_self_service.registrations.email_label'), class: 'form-label required-label' %>
        <%= form.email_field :email, value: @verification.email, required: true, autocomplete: 'email', autofocus: true,
                                     class: 'form-input', aria: { invalid: @verification.errors[:email].any?, describedby: 'email-help' } %>
        <p id="email-help" class="form-hint"><%= t('registration_verification.email_help') %></p>
        <% if @verification.errors[:email].any? %>
          <p role="alert" class="mt-1 text-sm text-danger-600"><%= t('registration_verification.invalid_email') %></p>
        <% end %>
      </div>
      <%= form.submit t('registration_verification.send_link'), class: 'btn btn-primary w-full',
                                                                data: { turbo_submits_with: t('registration_verification.sending') } %>
    <% end %>
    <p class="mt-4 text-sm"><%= link_to t('portal_self_service.registrations.sign_in_link'), sign_in_path(locale: public_form_locale_param) %></p>
  </section>
</div>
