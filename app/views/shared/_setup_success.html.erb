<% locale = current_user&.effective_message_locale || I18n.locale # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<div class="max-w-md mx-auto px-4 py-8">
  <div class="card p-8">
    <div class="text-center">
      <div class="inline-flex items-center justify-center h-24 w-24 rounded-full bg-success-100 mb-6">
        <svg class="h-16 w-16 text-success-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      
      <h1 class="text-3xl font-bold text-gray-800 mb-6"><%= t("credential_setup.added.#{auth_method}", locale: locale) %></h1>

      <% if local_assigns[:setup_another] %>
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
          <a href="<%= setup_two_factor_authentication_path %>" class="btn btn-primary">
            <svg aria-hidden="true" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            <%= t('credential_setup.backup', locale: locale) %>
          </a>
        </div>
      <% end %>
      
      <a href="<%= dashboard_path_for_current_user %>" class="btn btn-outline">
        <%= t('credential_setup.continue', locale: locale) %>
      </a>
    </div>
  </div>
</div>
