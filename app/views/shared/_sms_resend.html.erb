<div id="sms_resend" class="flex flex-col items-start">
  <%= link_to t('two_factor_verification.sms.resend'),
      resend_path,
      class: "text-primary-600 hover:text-primary-900 text-sm font-medium",
      data: { turbo_method: :post } %>
  <p class="mt-2 text-xs text-gray-500"><%= t('two_factor_verification.sms.resend_hint') %></p>

  <% if message.present? %>
    <div class="mt-3 text-sm <%= message_type == :error ? 'text-danger-700' : 'text-success-700' %>">
      <%= message %>
    </div>
  <% end %>
</div>
