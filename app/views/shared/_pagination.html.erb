<%# locals: (pagy:, label:) -%>
<% if pagy.pages > 1 %>
  <nav aria-label="<%= label %>" class="flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 bg-white px-4 py-4 sm:px-6">
    <p class="text-sm text-gray-700"><%= t('pagination.summary', first: pagy.from, last: pagy.to, count: pagy.count) %></p>
    <div class="flex flex-wrap items-center gap-2">
      <% if pagy.prev %>
        <%= pagination_link(pagy, pagy.prev, t('pagination.previous'), rel: 'prev') %>
      <% else %>
        <span aria-disabled="true" class="inline-flex min-h-11 items-center rounded-md border border-gray-200 bg-gray-50 px-3 text-sm text-gray-500">
          <%= t('pagination.previous') %>
        </span>
      <% end %>
      <% pagy.series.each do |item| %>
        <% if item.is_a?(Integer) %>
          <%= pagination_link(pagy, item) %>
        <% elsif item.is_a?(String) %>
          <span aria-current="page" aria-label="<%= t('pagination.current_page', page: item) %>"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md bg-indigo-600 px-3 text-sm font-semibold text-white"><%= item %></span>
        <% elsif item == :gap %>
          <span class="px-1 text-gray-500" aria-hidden="true">&hellip;</span>
        <% end %>
      <% end %>
      <% if pagy.next %>
        <%= pagination_link(pagy, pagy.next, t('pagination.next'), rel: 'next') %>
      <% else %>
        <span aria-disabled="true" class="inline-flex min-h-11 items-center rounded-md border border-gray-200 bg-gray-50 px-3 text-sm text-gray-500">
          <%= t('pagination.next') %>
        </span>
      <% end %>
    </div>
  </nav>
<% end %>
