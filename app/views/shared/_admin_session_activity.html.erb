<%# locals: (deadlines:) %>
<div data-controller="session-activity"
     data-session-activity-url-value="<%= session_activity_path %>"
     data-session-activity-state-value="<%= deadlines.to_json %>"
     data-action="input@document->session-activity#recordInteraction change@document->session-activity#recordInteraction keydown@document->session-activity#recordInteraction pointerdown@document->session-activity#recordInteraction submit@document->session-activity#beforeSubmit focus@window->session-activity#checkStatus visibilitychange@document->session-activity#checkStatus">
  <aside hidden tabindex="-1"
         class="mx-auto max-w-7xl rounded-md border border-amber-300 bg-amber-50 p-4 text-amber-900"
         aria-label="Sign-in time remaining"
         data-session-activity-target="notice">
    <p role="status" aria-live="polite" aria-atomic="true" data-session-activity-target="message"></p>
    <button type="button"
            class="mt-2 rounded-md bg-amber-900 px-3 py-2 text-sm font-medium text-white hover:bg-amber-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-900 focus-visible:ring-offset-2"
            data-session-activity-target="renew"
            data-action="session-activity#renew">Keep working</button>
  </aside>
</div>
