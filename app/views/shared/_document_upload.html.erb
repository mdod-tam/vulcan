<%# locals: (form:, field:, model:, blob: nil, described_by: nil, input_id: field.to_s, input_data: {}, input_aria: {}, retained_reference: nil, accept: proof_upload_accept_attribute, purpose: nil, slot: field, secure_form_type: nil, required: false, active_selector: nil, active_value: nil) %>
<%= tag.div data: document_upload_data(model, field, purpose: purpose, slot: slot, secure_form_type: secure_form_type).merge(
      document_upload_active_selector_value: active_selector,
      document_upload_active_value_value: active_value,
      document_upload_retained_name_value: form.field_name("#{field}_signed_id"),
      document_upload_retained_filename_value: blob&.filename.to_s
    ) do %>
  <% if document_scan_new_context?(model) %>
    <%= hidden_field_tag :document_scan_context, document_scan_context(model), id: nil %>
  <% end %>
  <%= form.file_field(
        field,
        id: input_id, accept: accept, required: required,
        aria: input_aria.merge(describedby: [described_by, input_aria[:describedby], "#{input_id}_status"].compact.flat_map(&:split).uniq.join(' ')),
        class: 'block w-full text-sm text-gray-700',
        data: { document_upload_target: 'input', action: 'change->document-upload#select' }.merge(input_data)
      ) %>
  <% if blob %>
    <%= form.hidden_field "#{field}_signed_id", value: retained_reference || blob.signed_id, id: nil, data: { document_upload_target: 'retained' } %>
  <% end %>
  <p id="<%= input_id %>_status" role="status" aria-live="polite" class="mt-2 text-sm" data-document-upload-target="status">
    <%= t('documents.upload.uploaded', filename: blob.filename) if blob %>
  </p>
  <noscript><p class="mt-2 text-sm"><%= t('documents.upload.javascript_required') %></p></noscript>
  <progress hidden max="100" class="mt-2 w-full" aria-label="<%= t('documents.upload.progress') %>" data-document-upload-target="progress"></progress>
  <div class="mt-2 flex gap-4">
    <button type="button" <%= 'hidden' unless blob %> class="text-sm text-indigo-700 underline"
            data-action="document-upload#remove" data-document-upload-target="remove">
      <%= t('documents.upload.remove') %>
    </button>
    <button type="button" hidden class="text-sm text-indigo-700 underline"
            data-action="document-upload#cancel" data-document-upload-target="cancel">
      <%= t('documents.upload.cancel') %>
    </button>
    <button type="button" hidden class="text-sm text-indigo-700 underline"
            data-action="document-upload#check" data-document-upload-target="retry">
      <%= t('documents.upload.retry') %>
    </button>
  </div>
<% end %>
