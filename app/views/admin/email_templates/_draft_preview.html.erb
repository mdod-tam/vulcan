<%# locals: (frame_id:, template:, rendered_subject: nil, rendered_body: nil, error_message: nil) -%>
<%= turbo_frame_tag frame_id, aria: { live: "polite", atomic: "true" } do %>
  <div class="mt-6 mb-6 p-4 border border-gray-200 rounded-md bg-white">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h3 class="text-lg font-medium text-gray-700">
        Draft Preview (<%= template.locale.to_s.upcase %>)
      </h3>
      <span class="<%= template_syntax_badge_classes(template) %>">
        <%= template_syntax_label(template) %>
      </span>
    </div>

    <% if template.html? %>
      <%= tag.div class: 'rounded-md border border-danger-300 bg-danger-50 p-3 text-sm text-danger-800',
                  role: 'alert', aria: { atomic: true }, data: { 'email-preview-target': 'error' },
                  hidden: error_message.blank? do %>
        <%= 'Preview unavailable. Review the error below, correct the draft, and try again.' if error_message.present? %>
      <% end %>
    <% end %>

    <% if error_message.present? && !template.html? %>
      <div class="rounded-md border border-danger-300 bg-danger-50 p-3 text-sm text-danger-800" role="alert">
        <p><%= error_message %></p>
      </div>
    <% else %>
      <div role="status">
        <% unless template.html? %>
          <div class="mb-4">
            <h4 class="text-base font-medium text-gray-600 mb-2">
              Subject Preview: <span class="font-normal"><%= rendered_subject %></span>
            </h4>
          </div>
        <% end %>

        <div class="prose max-w-none mb-4">
          <h4 class="text-base font-medium text-gray-600 mb-2">
            Body Preview
          </h4>

          <div class="border border-gray-300 rounded-lg shadow-elevation-1 p-4 bg-white">
            <% if template.format == 'html' %>
              <%= render 'admin/email_templates/html_preview',
                         template: template,
                         frame_id: "#{frame_id}-document", title: "Draft email body preview (#{template.locale.upcase})",
                         error_message: error_message, announce_result: true %>
            <% else %>
              <pre class="whitespace-pre-wrap text-sm"><%= rendered_body %></pre>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="text-sm text-gray-600 mt-2 italic">
      <p>Preview uses sample data and does not save changes.</p>
    </div>
  </div>
<% end %>
