<%# locals: (master:, channels:, categories:) -%>
<section id="email-delivery" aria-labelledby="email-delivery-heading" class="card mb-6 p-4 sm:p-6">
  <h2 id="email-delivery-heading" class="text-xl font-semibold text-gray-900"><%= email_delivery_t('heading') %></h2>

  <div class="mt-4 rounded-lg border p-4 <%= master.saved_enabled == false ? 'border-danger-200 bg-danger-50' : 'border-gray-200 bg-gray-50' %>"
       data-email-control="<%= master.name %>">
    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
      <div class="min-w-0 flex-1">
        <% if master.missing? %>
          <h3 class="text-lg font-semibold text-gray-900"><%= master.label %></h3>
          <%= email_control_state_badge(saved_enabled: nil, suppressed_by: nil) %>
        <% else %>
          <h3 class="text-xl font-semibold <%= master.saved_enabled ? 'text-gray-900' : 'text-danger-800' %>">
            <%= email_delivery_t(master.saved_enabled ? 'correspondence_on' : 'correspondence_off') %>
          </h3>
          <p class="mt-1 text-sm text-gray-700"><%= email_delivery_t('correspondence_help') %></p>
          <p class="text-sm text-gray-700"><%= email_delivery_t('released_help') %></p>
        <% end %>
      </div>
      <%= email_control_button(label: master.label, url: admin_email_delivery_control_path, enabled: master.saved_enabled,
                               version: EmailDelivery::ControlWriter.version_for(master.row), extra_params: { control: master.name }) %>
    </div>
    <details class="mt-4 border-t border-gray-300 pt-3 text-sm text-gray-700" id="sign-in-and-recovery-exceptions">
      <summary class="cursor-pointer rounded font-semibold text-primary-700"><%= email_delivery_t('account_access_heading') %></summary>
      <p class="mt-2 max-w-prose"><%= email_delivery_t('account_access_help') %></p>
      <ul role="list" class="list-disc pl-5">
        <li><%= email_delivery_t('account_access_sign_in') %></li>
        <li><%= email_delivery_t('account_access_recovery') %></li>
      </ul>
    </details>
  </div>

  <h3 class="mt-5 text-base font-semibold text-gray-900">Delivery channels</h3>
  <p class="mt-1 text-sm text-gray-700"><%= email_delivery_t('channels_help') %></p>
  <ul role="list" class="mt-2 grid gap-3 md:grid-cols-3">
    <% channels.each do |control| %>
      <li class="flex flex-wrap items-start justify-between gap-2 rounded-lg border border-gray-200 p-3" data-email-control="<%= control.name %>">
        <div>
          <p class="mb-1 text-sm font-semibold text-gray-900"><%= control.label %></p>
          <%= email_control_state_badge(saved_enabled: control.saved_enabled, suppressed_by: control.suppressed_by) %>
          <% if control.name == EmailDelivery::CHANNEL_CONTROLS.fetch('sms') %>
            <p class="mt-1 text-sm text-gray-700"><%= email_delivery_t('sms_help') %></p>
          <% end %>
        </div>
        <%= email_control_button(label: control.label, url: admin_email_delivery_control_path, enabled: control.saved_enabled,
                                 version: EmailDelivery::ControlWriter.version_for(control.row), extra_params: { control: control.name }) %>
      </li>
    <% end %>
  </ul>

  <details class="mt-4 border-t border-gray-200 pt-3" id="communication-categories">
    <summary class="cursor-pointer rounded font-semibold text-primary-700"><%= email_delivery_t('categories_heading') %></summary>
    <p class="mt-2 text-sm text-gray-700 max-w-prose"><%= email_delivery_t('categories_help') %></p>
    <ul role="list" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% categories.each do |control| %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-gray-200 p-3" data-email-control="<%= control.name %>">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= control.label %></p>
            <%= email_control_state_badge(saved_enabled: control.saved_enabled, suppressed_by: control.suppressed_by) %>
          </div>
          <%= email_control_button(label: "#{control.label} communications", url: admin_email_delivery_control_path, enabled: control.saved_enabled,
                                   version: EmailDelivery::ControlWriter.version_for(control.row), extra_params: { control: control.name }) %>
        </li>
      <% end %>
    </ul>
  </details>
</section>
