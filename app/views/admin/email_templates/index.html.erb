<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:p-2 focus:bg-indigo-600 focus:text-white focus:z-50 focus:rounded">
  Skip to main content
</a>
<main class="container mx-auto px-4 py-8" role="main" id="main-content" tabindex="-1">
  <div class="max-w-7xl mx-auto">
    <%= render 'admin/shared/communications_section_nav', current: :email_templates %>

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-bold" id="page-title">
        <%= t('admin.email_templates.index.page_title') %>
      </h1>
      <div class="flex flex-wrap gap-2">
        <%= button_to t('admin.email_templates.index.disable_all'), bulk_disable_admin_email_templates_path,
                      method: :patch, params: { operation_id: SecureRandom.uuid }, form: { class: 'inline' },
                      class: email_bulk_button_class(false),
                      data: { turbo_confirm: t('admin.email_templates.index.disable_all_confirm') } %>
        <%= button_to t('admin.email_templates.index.enable_all'), bulk_enable_admin_email_templates_path,
                      method: :patch, params: { operation_id: SecureRandom.uuid }, form: { class: 'inline' },
                      class: email_bulk_button_class(true),
                      data: { turbo_confirm: t('admin.email_templates.index.enable_all_confirm') } %>
      </div>
    </div>

    <section id="email-delivery" aria-labelledby="email-delivery-heading" class="bg-white rounded-lg shadow mb-8 p-6">
      <h2 id="email-delivery-heading" class="text-xl font-semibold text-gray-900"><%= email_delivery_t('heading') %></h2>
      <p class="mt-1 text-sm text-gray-700 max-w-prose"><%= email_delivery_t('intro') %></p>
      <p class="mt-1 text-sm text-gray-700 max-w-prose"><%= email_delivery_t('test_send.explanation') %></p>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-md border border-gray-200 p-4"
           data-email-control="<%= @control_panel.global.name %>">
        <div>
          <h3 class="text-base font-semibold text-gray-900"><%= @control_panel.global.label %></h3>
          <p class="text-sm text-gray-700"><%= email_delivery_t('global_help') %></p>
          <div class="mt-1"><%= email_control_state_badge(saved_enabled: @control_panel.global.saved_enabled, suppressed_by: nil) %></div>
        </div>
        <%= email_control_button(label: @control_panel.global.label, url: admin_email_delivery_control_path,
                                 enabled: @control_panel.global.saved_enabled,
                                 version: EmailDelivery::ControlWriter.version_for(@control_panel.global.row),
                                 extra_params: { control: @control_panel.global.name }) %>
      </div>

      <h3 class="mt-6 text-base font-semibold text-gray-900">Delivery channels</h3>
      <p class="text-sm text-gray-700"><%= email_delivery_t('channels_help') %></p>
      <ul role="list" class="mt-3 grid gap-3 sm:grid-cols-3">
        <% @control_panel.channels.each do |control| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-gray-200 p-3" data-email-control="<%= control.name %>">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= control.label %></p>
              <% if control.name == EmailDelivery::CHANNEL_CONTROLS['sms'] %>
                <p class="text-sm text-gray-700"><%= email_delivery_t('sms_help') %></p>
              <% end %>
              <%= email_control_state_badge(saved_enabled: control.saved_enabled, suppressed_by: control.suppressed_by) %>
            </div>
            <%= email_control_button(label: control.label, url: admin_email_delivery_control_path,
                                     enabled: control.saved_enabled, version: EmailDelivery::ControlWriter.version_for(control.row),
                                     extra_params: { control: control.name }) %>
          </li>
        <% end %>
      </ul>

      <h3 class="mt-6 text-base font-semibold text-gray-900"><%= email_delivery_t('categories_heading') %></h3>
      <p class="text-sm text-gray-700 max-w-prose"><%= email_delivery_t('categories_help') %></p>
      <ul role="list" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% @control_panel.categories.each do |control| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-gray-200 p-3"
              data-email-control="<%= control.name %>">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= control.label %></p>
              <%= email_control_state_badge(saved_enabled: control.saved_enabled, suppressed_by: control.suppressed_by) %>
            </div>
            <%= email_control_button(label: "#{control.label} communications", url: admin_email_delivery_control_path,
                                     enabled: control.saved_enabled, version: EmailDelivery::ControlWriter.version_for(control.row),
                                     extra_params: { control: control.name }) %>
          </li>
        <% end %>
      </ul>
    </section>

    <% @control_panel.pairs_by_category.each do |category, pairs| %>
      <section aria-labelledby="templates-<%= category %>-heading" class="bg-white rounded-lg shadow mb-6">
        <h2 id="templates-<%= category %>-heading" class="px-6 pt-5 text-lg font-semibold text-gray-900">
          <%= EmailDelivery::ControlPanel.category_label(category) %>
        </h2>
        <ul role="list" class="divide-y divide-gray-200">
          <% pairs.each do |pair| %>
            <li id="<%= email_template_pair_anchor(pair) %>"
                class="px-6 py-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900">
                  <%= truncate(pair.primary_row.description.presence || pair.name, length: 140) %>
                </p>
                <p class="text-xs font-mono text-gray-600 break-all"><%= pair.name %></p>
                <p class="text-xs text-gray-600">
                  <%= pair.primary_row.format.titleize %> · <%= template_syntax_label(pair.primary_row) %> ·
                  <%= pair.locales.join(', ') %> · v<%= pair.primary_row.version %>
                </p>
                <div class="mt-1 flex flex-wrap gap-2">
                  <%= email_control_state_badge(saved_enabled: pair.saved_enabled, suppressed_by: pair.suppressed_by,
                                                category: pair.category, mixed: pair.mixed) %>
                  <% if pair.rows.any?(&:locale_needs_sync?) %>
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
                      Needs Sync
                    </span>
                  <% end %>
                </div>
                <% @control_panel.pair_channel_states(pair).each do |channel, state| %>
                  <p class="mt-1 text-xs text-gray-700"><%= channel %>: <%= state %></p>
                <% end %>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <%= link_to t('shared.view'), admin_email_template_path(pair.primary_row),
                            class: email_template_link_class,
                            aria: { label: t('admin.email_templates.index.view_aria', template_name: pair.name) } %>
                <%= link_to t('shared.edit'), edit_admin_email_template_path(pair.primary_row),
                            class: email_template_link_class,
                            aria: { label: t('admin.email_templates.index.edit_aria', template_name: pair.name) } %>
                <%= email_control_button(label: email_delivery_t('pair_label', name: pair.name),
                                         url: toggle_disabled_admin_email_template_path(pair.primary_row),
                                         enabled: pair.saved_enabled,
                                         version: EmailDelivery::ControlWriter.version_for(pair.rows)) %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @control_panel.fragments.any? %>
      <section aria-labelledby="fragments-heading" class="bg-white rounded-lg shadow mb-6">
        <h2 id="fragments-heading" class="px-6 pt-5 text-lg font-semibold text-gray-900"><%= email_delivery_t('fragments_heading') %></h2>
        <p class="px-6 text-sm text-gray-700 max-w-prose"><%= email_delivery_t('fragments_help') %></p>
        <ul role="list" class="divide-y divide-gray-200">
          <% @control_panel.fragments.each do |fragment| %>
            <li class="px-6 py-3 flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-mono text-gray-700"><%= fragment.name %> · <%= fragment.locale.upcase %></span>
              <span class="flex gap-3">
                <%= link_to t('shared.view'), admin_email_template_path(fragment),
                            class: email_template_link_class,
                            aria: { label: t('admin.email_templates.index.view_aria', template_name: fragment.name) } %>
                <%= link_to t('shared.edit'), edit_admin_email_template_path(fragment),
                            class: email_template_link_class,
                            aria: { label: t('admin.email_templates.index.edit_aria', template_name: fragment.name) } %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @control_panel.pairs.empty? && @control_panel.fragments.empty? %>
      <div class="p-6 text-center bg-white rounded-lg shadow">
        <p class="text-gray-600">No email templates found in the database.</p>
      </div>
    <% end %>
  </div>
</main>
