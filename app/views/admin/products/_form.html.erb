<div class="min-h-screen bg-gray-100 py-12">
  <div class="form-container max-w-2xl mx-auto">
    <div class="card p-4 sm:p-8">
      <h1 class="text-2xl font-semibold mb-6 text-center" id="form-title">New Product</h1>

      <%= form_with(model: [:admin, @product], local: true, class: "space-y-6", "aria-labelledby": "form-title") do |f| %>
        <% if @product.errors.any? %>
          <div class="bg-danger-50 p-4 rounded mb-6" role="alert" aria-atomic="true">
            <h2 class="text-danger-700 font-medium">
              <%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:
            </h2>
            <ul class="list-disc list-inside text-danger-700">
              <% @product.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <section aria-labelledby="basic-info-title" class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="basic-info-title" class="text-lg font-medium text-gray-900">Basic Information</h2>
          
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
            <div>
              <%= f.label :manufacturer, class: "form-label" %>
              <%= f.text_field :manufacturer, class: "form-input mt-1" %>
            </div>

            <div>
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-input mt-1" %>
            </div>

            <div>
              <%= f.label :model_number, class: "form-label" %>
              <%= f.text_field :model_number, class: "form-input mt-1" %>
            </div>
            <div class="space-y-2">
              <%= f.label :device_types, "Device Types", class: "form-label" %>
              <div class="grid grid-cols-2 gap-4">
                <% Product::DEVICE_TYPES.sort.each do |device_type| %>
                  <div class="flex items-center">
                    <%= f.check_box :device_types, 
                        { multiple: true, class: "h-4 w-4 text-primary-600 border-gray-300 rounded" },
                        device_type, 
                        nil %>
                    <%= f.label "device_types_#{device_type.parameterize}", device_type, class: "ml-2 text-sm text-gray-700" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <section aria-labelledby="details-section-title" class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="details-section-title" class="text-lg font-medium text-gray-900">Product Details</h2>

          <div class="space-y-4">
            <div>
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, rows: 3, class: "form-input mt-1" %>
            </div>

            <div>
              <%= f.label :features, class: "form-label" %>
              <%= f.text_area :features, rows: 3, class: "form-input mt-1" %>
            </div>

            <div>
              <%= f.label :compatibility_notes, class: "form-label" %>
              <%= f.text_area :compatibility_notes, rows: 2, class: "form-input mt-1" %>
            </div>
          </div>
        </section>

        <section aria-labelledby="additional-info-title" class="space-y-4 p-4 bg-gray-50 rounded">
          <h2 id="additional-info-title" class="text-lg font-medium text-gray-900">Additional Information</h2>
          
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
            <div>
              <%= f.label :documentation_url, class: "form-label" %>
              <%= f.url_field :documentation_url, class: "form-input mt-1" %>
            </div>
            <div class="sm:col-span-2">
              <%= f.label :vendor_ids, "Vendors", class: "form-label mb-2" %>
              <div class="grid grid-cols-2 gap-4">
                <%= f.collection_check_boxes :vendor_ids,
                User.where(type: 'Vendor').order(:first_name),
                :id, :full_name do |b| %>
                  <div class="flex items-center">
                    <%= b.check_box(class: "h-4 w-4 text-primary-600 border-gray-300 rounded") %>
                    <%= b.label(class: "ml-2 text-sm text-gray-700") %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <div class="px-6 py-4 bg-gray-50 flex items-center justify-end space-x-3 rounded-b-lg">
          <%= link_to "Cancel",
              admin_products_path,
              class: "btn btn-outline" %>
              
          <%= f.submit "Save Product",
              class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>