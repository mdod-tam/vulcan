<%# locals: (title:, config:, headers:, rows:, available:, height:, note: nil, data_table: true, data_label: nil, show_empty: true) -%>
<% heading = title.parameterize # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<% show_table = data_table && rows.any? && (available || config[:type] != 'line') # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<% if available || show_table || show_empty %>
  <%= tag.section class: 'card min-w-0 p-4', aria: { hidden: (true unless data_table) } do %>
    <h3 class="text-lg font-semibold text-gray-900" id="<%= heading %>"><%= title %></h3>
    <% if note.present? && (available || show_empty) %>
      <p class="mt-1 text-sm text-gray-600"><%= note %></p>
    <% end %>
    <% if available %>
      <div class="relative mt-3 <%= height %>" data-controller="chart" data-chart-config-value="<%= config.to_json %>">
        <canvas data-chart-target="canvas" aria-hidden="true"></canvas>
      </div>
    <% elsif show_empty %>
      <p class="mt-3 text-sm text-gray-600"><%= rows.flatten.any?(Numeric) ? 'No activity for these dates.' : 'No data for this period.' %></p>
    <% end %>
    <% if show_table %>
      <details class="mt-2">
        <summary class="w-fit cursor-pointer py-2 text-sm font-medium text-primary-800">View data<span class="sr-only"> for <%= data_label || title.downcase %></span></summary>
        <%= render 'table', caption: title, headers:, rows: %>
      </details>
    <% end %>
  <% end %>
<% end %>
