<%# locals: (vouchers_enabled:, report_period:, period:, period_options:, period_label:, rows:, chart_data:, error_message: nil) -%>
<% non_voucher_label = 'Shipped units' # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<% voucher_label = 'Units from vouchers' # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>

<section aria-labelledby="equipment-by-type-heading" class="card p-6 mb-8">
  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between mb-4">
    <div>
      <h3 id="equipment-by-type-heading" class="text-lg font-semibold">Equipment by type</h3>
      <p class="text-sm text-gray-500 mt-1">
        A device can count under more than one type.
      </p>
    </div>
    <%= form_with url: equipment_distribution_admin_reports_path, method: :get, class: 'flex flex-wrap items-center gap-2' do |f| %>
      <%= f.hidden_field :period, value: report_period %>
      <%= f.label :equipment_period, 'Equipment period', class: 'form-label' %>
      <%= f.select :equipment_period,
                   options_for_select(period_options.map { |value, label| [label, value] }, period),
                   {},
                   class: 'form-input w-auto' %>
      <%= f.button 'Apply', name: nil, class: 'btn btn-outline', aria: { label: 'Apply equipment period' } %>
    <% end %>
  </div>

  <div class="bg-gray-50 rounded p-4">
    <h4 id="equipment-period-heading" class="font-medium text-gray-700 mb-3"><%= period_label %></h4>
    <% if error_message.present? %>
      <div class="rounded-md border border-warning-200 bg-warning-50 p-4" role="alert">
        <p class="text-sm font-medium text-warning-900"><%= error_message %></p>
      </div>
    <% elsif rows.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm [overflow-wrap:anywhere]">
          <caption class="sr-only">Equipment counts by device type for <%= period_label %></caption>
          <thead>
            <tr>
              <th scope="col" class="py-2 pr-3 text-left font-medium text-gray-700">Device type</th>
              <th scope="col" class="px-3 py-2 text-right font-medium text-gray-700">
                <%= non_voucher_label %>
              </th>
              <% if vouchers_enabled %>
                <th scope="col" class="py-2 pl-3 text-right font-medium text-gray-700"><%= voucher_label %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% rows.each do |row| %>
              <tr>
                <th scope="row" class="py-2 pr-3 text-left font-normal text-gray-600"><%= row[:device_type] %></th>
                <td class="px-3 py-2 text-right font-medium text-gray-900"><%= row[:non_voucher_count] %></td>
                <% if vouchers_enabled %>
                  <td class="py-2 pl-3 text-right font-medium text-gray-900"><%= row[:voucher_count] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4 relative h-[300px] w-full" data-controller="chart"
           data-chart-config-value="<%= report_equipment_type_chart_config(chart_data, vouchers_enabled:).to_json %>">
        <canvas data-chart-target="canvas" aria-hidden="true"></canvas>
      </div>
    <% else %>
      <p class="text-sm text-gray-600">No equipment recorded for this period.</p>
    <% end %>
  </div>
</section>
