<div id="main-content" tabindex="-1" class="mx-auto max-w-7xl px-4 py-8">
  <%= render 'report_header', section: :index, period: @period %>
  <div class="space-y-4">
    <% backlog = @activity.backlog # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
    <%= render 'totals', values: backlog.to_h { |label, values| ["#{label} now", values.last] } %>
    <%= report_chart('Review backlog', report_months(@period), backlog,
                     category: 'Month', unit: 'Applications', type: 'line', show_zero: true,
                     note: 'Month-end counts, plus today.') %>
    <%= report_chart('Time in each review stage', Reports::ApplicationActivity::STAGES.values, @activity.time_in_stages,
                     category: 'Stage', unit: 'Average days', horizontal: true, show_zero: true, table_unit: 'average days',
                     note: 'Completed stages with a recorded start date.', data_label: 'time by review stage') %>
    <div class="grid gap-4 lg:grid-cols-2">
      <% intake = @activity.intake # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
      <% stages = @activity.current_stages # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
      <%= report_chart('How applications were submitted', intake.keys, { 'Applications' => intake.values },
                       category: 'Submission method', unit: 'Applications', horizontal: true, data_label: 'submission methods') %>
      <%= report_chart('Applications by current stage', stages.keys, { 'Applications' => stages.values },
                       category: 'Stage', unit: 'Applications', horizontal: true,
                       note: 'Applications submitted in this period.', data_label: 'current application stages') %>
    </div>
    <section class="card p-4" aria-labelledby="staff-contributions">
      <h3 id="staff-contributions" class="text-lg font-semibold">Top staff contributions</h3>
      <% contributions = @activity.staff_contributions # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
      <% if contributions.any? %>
        <%= render 'table', caption: 'Top staff contributions',
                            headers: ['Staff', 'Proofs reviewed', 'Certifications reviewed', 'Evaluations provided'], rows: contributions.first(10) %>
      <% else %>
        <p class="mt-2 text-sm text-gray-600">No reviews or evaluation appointments recorded in this period.</p>
      <% end %>
    </section>
    <%= render 'application_totals', report: @report %>
    <%= link_to 'Application form analysis', admin_application_analytics_pain_points_path, class: 'text-primary-800 underline' %>
  </div>
</div>
