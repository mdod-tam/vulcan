<%# locals: (events:, audit_records:, title: 'Equipment correction history', expanded: false, history_id: nil) -%>
<%= tag.details id: history_id, open: expanded, class: 'rounded border border-gray-200 p-4' do %>
  <summary class="cursor-pointer font-medium"><%= title %></summary>
  <ul class="mt-3 divide-y divide-gray-200">
    <% events.each do |event| %>
      <li class="py-2 text-sm break-words">
        <div>
          <p><span class="font-semibold"><%= equipment_audit_action_label(event) %></span> — <%= event.user&.full_name.presence || 'System' %></p>
          <time datetime="<%= event.created_at.iso8601 %>" class="block text-gray-600"><%= audit_log_timestamp(event) %></time>
        </div>
        <% details = equipment_audit_details(event, records: audit_records) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
        <% if details.present? %><p class="mt-1 text-gray-700"><%= details %></p><% end %>
      </li>
    <% end %>
    <% if events.empty? %><li class="py-2 text-sm text-gray-600">No activity has been recorded yet.</li><% end %>
  </ul>
<% end %>
