<div id="equipment-correction" class="max-w-4xl mx-auto p-4 space-y-6">
  <%= tag.h1(
        "Device ##{@item.id}", id: 'equipment-correction-title', tabindex: '-1', autofocus: @back_to_edit, class: 'text-2xl font-bold text-gray-900'
      ) %>
  <p><%= equipment_item_context_link(@item, return_context: @return_context) %></p>
  <p><%= equipment_queue_badge(@item) %></p>
  <%= render 'admin/equipment/form_errors', errors: @form_errors, id: 'equipment-item-errors', title: 'Review the equipment correction',
                                            conflicts: Array(@item.identity_conflicts), return_context: @return_context %>
  <%= form_with model: @item, url: admin_equipment_item_path(@item), method: :patch, class: 'space-y-4' do |form| %>
    <%= hidden_field_tag :expected_version, @expected_version %>
    <% @return_context.each do |key, value| %><%= hidden_field_tag "return_context[#{key}]", value %><% end %>
    <% if @reviewing %>
      <%= render 'review', item: @item, draft: @draft_attributes, reason: params[:reason],
                           previous_values: @previous_values, impact_token: @impact_token, products: @products, purchase_orders: @purchase_orders %>
    <% else %>
      <%= render 'fields', form: form, item: @item, products: @products, return_context: @return_context,
                           reason: (params[:reason] unless @disposition_submission) %>
      <% if @item.shipped_at_in_database.present? %>
        <%= button_tag 'Review correction', name: :review, value: '1', data: { turbo_submits_with: 'Reviewing...' }, class: 'btn btn-primary' %>
      <% else %>
        <%= form.submit 'Save equipment correction', data: { turbo_submits_with: 'Saving...' }, class: 'btn btn-primary' %>
      <% end %>
    <% end %>
  <% end %>
  <% if !@reviewing && (action = equipment_disposition_action(@item)) %>
    <%= render 'disposition', item: @item, operation: action.first, label: action.last, expected_version: @expected_version,
                              return_context: @return_context, submitted: @disposition_submission && params[:operation] == action.first %>
  <% end %>
  <% if @stale_edit %>
    <p>
      <%= link_to 'Reload latest record', edit_admin_equipment_item_path(@item, return_context: @return_context), class: 'text-primary-700 underline' %>
      Reloading clears your draft.
    </p>
  <% end %>
  <% unless @reviewing %>
    <% if @return_context.any? %><%= link_to 'Back to Equipment', equipment_return_path(@return_context), class: 'text-primary-700 underline' %><% end %>
    <%= render 'admin/stock_allocations/reservation', item: @item, candidates: @swap_candidates, return_context: @return_context %>
    <%= render 'admin/equipment_items/history', events: @history, audit_records: @equipment_audit_records %>
  <% end %>
</div>
