<div class="max-w-4xl mx-auto p-4 space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">Equipment item #<%= @item.id %></h1>
  <p><%= link_to "Application ##{@item.application_id}",
                 admin_application_path(@item.application, anchor: "equipment-item-#{@item.id}", return_context: @return_context),
                 class: 'text-indigo-700 underline' %></p>
  <p><%= equipment_queue_badge(@item) %></p>
  <% if @form_errors.present? %>
    <div role="alert" tabindex="-1" class="rounded border border-red-300 bg-red-50 p-4 text-red-900">
      <h2 class="font-semibold">Review the equipment correction</h2>
      <ul class="list-disc pl-5"><% @form_errors.each do |error| %><li><%= error %></li><% end %></ul>
      <% Array(@item.identity_conflicts).uniq.each do |conflict| %>
        <p><%= link_to "Review equipment item ##{conflict.id}", edit_admin_equipment_item_path(conflict), class: 'underline' %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @item, url: admin_equipment_item_path(@item), method: :patch, local: true, data: { turbo: false }, class: 'space-y-4' do |form| %>
    <%= hidden_field_tag :expected_version, @expected_version %>
    <% @return_context.each do |key, value| %><%= hidden_field_tag "return_context[#{key}]", value %><% end %>
    <% @purchase_order_versions.each do |id, version| %><%= hidden_field_tag "purchase_order_versions[#{id}]", version %><% end %>
    <div>
      <%= form.label :product_id, 'Actual catalog product', class: 'block font-medium' %>
      <%= form.select :product_id, equipment_catalog_options(@products), {}, class: 'mt-1 w-full rounded border-gray-300' %>
      <p class="text-sm text-gray-600">Changing this device leaves the original evaluation recommendation unchanged.</p>
    </div>
    <div>
      <%= form.label :purchase_order_id, 'Current purchase order', class: 'block font-medium' %>
      <%= form.select :purchase_order_id,
                      @purchase_orders.map { |order| ["#{order.vendor.business_name} / #{order.number}", order.id] },
                      { include_blank: 'No current purchase order' }, class: 'mt-1 w-full rounded border-gray-300' %>
    </div>
    <details class="rounded border border-gray-300 p-3" <%= 'open' if params[:create_purchase_order] == '1' %>>
      <summary class="font-medium cursor-pointer">Move to a new purchase order</summary>
      <p class="my-3">
        <%= check_box_tag :create_purchase_order, '1', params[:create_purchase_order] == '1' %>
        <%= label_tag :create_purchase_order, 'Create a purchase order for this device' %>
      </p>
      <%= fields_for :new_purchase_order, @new_purchase_order do |order_form| %>
        <%= render 'admin/purchase_orders/fields', form: order_form, purchase_order: @new_purchase_order, vendors: @vendors, prefix: 'New ' %>
      <% end %>
    </details>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :shipped_at, 'Date shipped', class: 'block font-medium' %>
        <%= form.text_field :shipped_at,
                            typed_date_field_options(value: typed_date_input_value(@item, :shipped_at), class: 'mt-1 w-full rounded border-gray-300',
                                                     'aria-describedby': 'equipment-ship-date-help') %>
        <p id="equipment-ship-date-help" class="text-sm text-gray-600">MM/DD/YYYY, on or after the PO date and no later than today. Tracking alone leaves the device Ordered.</p>
      </div>
      <div>
        <%= form.label :tracking_number, class: 'block font-medium' %>
        <%= form.text_field :tracking_number, maxlength: 128, autocomplete: 'off', class: 'mt-1 w-full rounded border-gray-300' %>
      </div>
      <div>
        <%= form.label :carrier, class: 'block font-medium' %>
        <%= form.select :carrier, EquipmentItem::CARRIERS.invert, { include_blank: 'Not recorded' }, class: 'mt-1 w-full rounded border-gray-300' %>
      </div>
      <div>
        <%= form.label :serial_number, class: 'block font-medium' %>
        <%= form.text_field :serial_number, maxlength: 128, autocomplete: 'off', class: 'mt-1 w-full rounded border-gray-300' %>
      </div>
      <div>
        <%= form.label :imei, 'IMEI (15 digits)', class: 'block font-medium' %>
        <%= form.text_field :imei, inputmode: 'numeric', autocomplete: 'off', class: 'mt-1 w-full rounded border-gray-300' %>
      </div>
    </div>
    <div>
      <%= label_tag :serial_duplicate_reason, 'Potential serial duplicate acknowledgment reason', class: 'block font-medium' %>
      <%= text_field_tag :serial_duplicate_reason, params[:serial_duplicate_reason], autocomplete: 'off', class: 'mt-1 w-full rounded border-gray-300' %>
      <p class="text-sm text-gray-600">Use only after reviewing a matching serial on a different model. Confirmed duplicates cannot be acknowledged.</p>
    </div>
    <div>
      <%= label_tag :operation, 'Correction action', class: 'block font-medium' %>
      <%= select_tag :operation,
                     options_for_select([['Save device details or move purchase order', 'update'],
                                         ['Detach an unshipped device for reorder', 'detach'],
                                         ['Withdraw a detached unshipped device', 'withdraw']], params[:operation].presence || 'update'),
                     class: 'mt-1 w-full rounded border-gray-300' %>
    </div>
    <div>
      <%= label_tag :reason, 'Correction reason', class: 'block font-medium' %>
      <%= text_area_tag :reason, params[:reason], required: true, rows: 2, class: 'mt-1 w-full rounded border-gray-300' %>
    </div>
    <% if @reviewing %>
      <%= hidden_field_tag :reviewing, '1' %>
      <%= hidden_field_tag :impact_token, @impact_token %>
      <div class="rounded border border-amber-300 bg-amber-50 p-4">
        <h2 class="font-semibold">Correction impact: 1 device across 1 application</h2>
        <p>Shipped devices affected: <%= @item.shipped_at_in_database.present? ? 1 : 0 %>.</p>
        <dl class="mt-2 space-y-1">
          <% Equipment::Correction::ITEM_FIELDS.first(7).each do |field| %>
            <div>
              <dt class="inline font-medium"><%= field.delete_suffix('_id').humanize %>:</dt>
              <dd class="inline">
                <%= equipment_impact_value(field, @previous_values[field], products: @products, purchase_orders: @purchase_orders) %> →
                <%= equipment_impact_value(field, @item.public_send(field), products: @products, purchase_orders: @purchase_orders,
                                                                            vendors: @vendors, new_purchase_order: (if params[:create_purchase_order] == '1'
                                                                                                                      @new_purchase_order
                                                                                                                    end)) %>
              </dd>
            </div>
          <% end %>
        </dl>
        <p class="mt-3">
          <%= check_box_tag :confirmed_impact, '1', false, required: true %>
          <%= label_tag :confirmed_impact, 'I confirm this correction and its impact on shipment history.' %>
        </p>
      </div>
    <% end %>
    <% if @item.shipped_at_in_database.present? && !@reviewing %>
      <%= button_tag 'Review correction', name: :review, value: '1', formnovalidate: true, class: 'rounded bg-indigo-700 px-4 py-2 text-white' %>
    <% else %>
      <%= form.submit 'Save equipment correction', class: 'rounded bg-indigo-700 px-4 py-2 text-white' %>
      <% if @reviewing %>
        <%= button_tag 'Review changed values', name: :review, value: '1', formnovalidate: true, class: 'ml-3 text-indigo-700 underline' %>
      <% end %>
    <% end %>
  <% end %>
  <p><%= link_to 'Refresh equipment item and discard this draft',
                 edit_admin_equipment_item_path(@item, return_context: @return_context), class: 'text-indigo-700 underline' %></p>
  <% if @return_context.any? %><%= link_to 'Back to Equipment', equipment_return_path(@return_context), class: 'text-indigo-700 underline' %><% end %>
  <%= render 'admin/equipment_items/history', events: @history %>
</div>
