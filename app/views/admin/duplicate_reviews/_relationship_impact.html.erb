<%# locals: (preview:, dom_id_prefix:) -%>
<section class="border-t border-gray-100 pt-3"
         aria-labelledby="<%= dom_id_prefix %>-relationships-heading"
         data-testid="merge-relationship-impact">
  <h3 id="<%= dom_id_prefix %>-relationships-heading" class="text-sm font-medium text-gray-700">Relationships affected</h3>
  <p class="mt-1 text-xs text-gray-500">
    <% if preview.direct_relationships.any? %>
      These two records are directly related as guardian and dependent. Their relationship cannot remain after they become one record.
    <% else %>
      These relationships follow the surviving record. Different dependent records and their applications are not merged by this action.
    <% end %>
  </p>

  <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
    <% preview.participants.each do |participant| %>
      <article class="rounded-md border border-gray-200 p-3 text-xs text-gray-700" data-testid="merge-participant-relationships">
        <h4 class="font-medium text-gray-900"><%= duplicate_review_constituent_label(participant.user) %></h4>

        <% if participant.dependents.empty? %>
          <p class="mt-1 text-gray-500">Has no dependents.</p>
        <% else %>
          <p class="mt-1 font-medium">Guardian for:</p>
          <ul class="mt-1 space-y-2">
            <% participant.dependents.each do |dependent| %>
              <li>
                <span><%= duplicate_review_constituent_label(dependent.user) %> · <%= dependent.relationship_type %></span>
                <% if dependent.application_count.zero? %>
                  <span class="block text-gray-500">Applications: None on file</span>
                <% else %>
                  <span class="block text-gray-500">
                    Applications:
                    <% dependent.applications.each_with_index do |application, index| %>
                      <%= ' · ' unless index.zero? %><%= link_to "##{application.id} #{application.status.humanize}", admin_application_path(application), class: 'text-indigo-600 hover:text-indigo-900', target: '_blank', rel: 'noopener' %>
                    <% end %>
                    <% if dependent.application_count > dependent.applications.size %>
                      · and <%= dependent.application_count - dependent.applications.size %> more
                    <% end %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if participant.guardians.any? %>
          <p class="mt-2 font-medium">Dependent of:</p>
          <ul class="mt-1 space-y-1">
            <% participant.guardians.each do |guardian| %>
              <li><%= duplicate_review_constituent_label(guardian.user) %> · <%= guardian.relationship_type %></li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
  </div>

  <% if preview.any? %>
    <div class="mt-2 rounded-md bg-blue-50 p-3 text-xs text-blue-900" data-testid="merge-relationship-outcome">
      <h4 class="font-medium">After this merge</h4>
      <ul class="mt-1 list-disc space-y-1 pl-4">
        <% preview.direct_relationships.each do |relationship| %>
          <li data-testid="direct-merge-relationship">
            <%= duplicate_review_constituent_label(relationship.guardian) %> is <%= relationship.relationship_type.downcase %> for
            <%= duplicate_review_constituent_label(relationship.dependent) %>. This relationship will be removed because the surviving record cannot be related to itself.
          </li>
        <% end %>
        <% if preview.direct_relationships.any? %>
          <% preview.participants.each do |participant| %>
            <% next if participant.application_count.zero? %>
            <li data-testid="direct-merge-application-impact">
              <%= duplicate_review_constituent_label(participant.user) %> owns <%= pluralize(participant.application_count, 'application') %>.
              If this record is retired, <%= participant.application_count == 1 ? 'the application' : 'those applications' %> will move to the surviving record.
              <% if participant.applications_managed_by_other_count.positive? %>
                The managing guardian will be cleared for <%= pluralize(participant.applications_managed_by_other_count, 'application') %> because the survivor cannot manage its own application.
              <% end %>
            </li>
          <% end %>
        <% end %>
        <% preview.dependent_outcomes.each do |outcome| %>
          <li>
            <% if outcome.linked_from_both %>
              <%= duplicate_review_constituent_label(outcome.user) %> is already linked to both records; the redundant guardian relationship will consolidate into one.
            <% else %>
              <%= duplicate_review_constituent_label(outcome.user) %> will be linked to the surviving record.
            <% end %>
            <% if outcome.application_count.zero? %>
              No applications are attached to this dependent.
            <% else %>
              Its <%= pluralize(outcome.application_count, 'application') %> will remain attached to this dependent.
            <% end %>
          </li>
        <% end %>
        <% preview.guardian_outcomes.each do |outcome| %>
          <li>
            <% if outcome.linked_from_both %>
              <%= duplicate_review_constituent_label(outcome.user) %> is already guardian for both records; the redundant relationship will consolidate into one.
            <% else %>
              The relationship with <%= duplicate_review_constituent_label(outcome.user) %> will remain attached to the surviving record.
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if preview.dependent_outcomes.many? %>
        <p class="mt-2 font-medium">These dependent records remain separate. This merge does not decide whether any two dependents are the same person.</p>
      <% end %>
    </div>
  <% end %>
</section>
