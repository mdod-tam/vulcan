<%# locals: review_case %>
<%= form_with url: resolve_admin_duplicate_review_path(review_case), method: :post, class: 'space-y-4' do |f| %>
  <fieldset>
    <legend class="text-sm font-medium text-gray-700">Action</legend>
    <label class="inline-flex items-center mr-4 text-sm">
      <%= radio_button_tag :resolution_action, 'approve', false, required: true %>
      <span class="ml-1">Approve</span>
    </label>
    <label class="inline-flex items-center mr-4 text-sm">
      <%= radio_button_tag :resolution_action, 'ignore' %>
      <span class="ml-1">Ignore</span>
    </label>
    <label class="inline-flex items-center text-sm">
      <%= radio_button_tag :resolution_action, 'keep_separate' %>
      <span class="ml-1">Keep separate</span>
    </label>
  </fieldset>

  <%# The identity outcome is server-owned, not selected. A non-merge resolution means exactly one
      thing -- staff decided these are different people -- so a control offering five values where
      only one is legal was presenting a fake choice. Rendered as static text so staff can see what
      they are recording. The server persists its own value; a request carrying a conflicting
      legacy determination is rejected rather than accepted, so a page rendered before this shipped
      cannot resolve a case under the wrong intent.
      See DuplicateReviewCases::ResolutionService::NON_MERGE_DETERMINATION. %>
  <div id="identity-outcome" class="rounded-md bg-gray-50 border border-gray-200 p-3">
    <p class="text-sm font-medium text-gray-900">Identity outcome: Keep records separate</p>
    <p class="mt-1 text-xs text-gray-600">
      This resolution records that the records represent different people. If you are still
      gathering information, leave this case open instead of resolving it.
    </p>
  </div>

  <fieldset>
    <legend class="text-sm font-medium text-gray-700">Evidence / reason codes</legend>
    <% Array(review_case.metadata['reason_codes']).each do |code| %>
      <label class="inline-flex items-center mr-3 text-sm">
        <%= check_box_tag 'reason_codes[]', code, true %>
        <span class="ml-1"><%= duplicate_review_reason_label(code) %></span>
      </label>
    <% end %>
  </fieldset>

  <div>
    <%= label_tag :rationale, 'Rationale (required)', class: 'block text-sm font-medium text-gray-700' %>
    <%= text_area_tag :rationale, nil, rows: 2, required: true, class: 'w-full border-gray-300 rounded-md text-sm', placeholder: 'Explain the decision.' %>
  </div>

  <%= f.submit 'Resolve case', class: 'bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-4 rounded text-sm cursor-pointer' %>
<% end %>
