<%# locals: review_case %>
<%= form_with url: resolve_admin_duplicate_review_path(review_case), method: :post, class: 'space-y-4' do |f| %>
  <%# The outcome and the status are server-owned rather than selected: a non-merge resolution
      means exactly one thing, that staff decided these are different people. Shown as static text
      so staff can see what they are recording. A request carrying a conflicting determination or
      resolution_action is rejected rather than accepted, so a stale page cannot resolve a case
      under an intent the server would otherwise reinterpret.
      See DuplicateReviewCases::ResolutionService::NON_MERGE_DETERMINATION. %>
  <div id="identity-outcome" class="rounded-md bg-gray-50 border border-gray-200 p-3">
    <p class="text-sm font-medium text-gray-900">Identity outcome: Keep records separate</p>
    <p class="mt-1 text-xs text-gray-600">
      This records that the records represent different people. If they are the same person, merge
      them instead; if you are still gathering information, leave this case open.
    </p>
  </div>

  <div>
    <%= label_tag :rationale, 'Why these records are different people (required)', class: 'block text-sm font-medium text-gray-700' %>
    <%= text_area_tag :rationale,
                      nil,
                      rows: 2,
                      required: true,
                      class: 'w-full border-gray-300 rounded-md text-sm',
                      placeholder: 'Describe what you verified beyond the matching name and date of birth.' %>
  </div>

  <%= f.submit 'Resolve case', class: 'bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-4 rounded text-sm cursor-pointer' %>
<% end %>
