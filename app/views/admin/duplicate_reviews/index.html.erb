<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8" data-testid="duplicate-review-queue">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold">Duplicate Review Queue</h1>
      <p class="mt-1 text-sm text-gray-600">Review records that may belong to the same person.</p>
    </div>
    <%= link_to 'Back to users', admin_users_path, class: 'text-indigo-600 hover:text-indigo-900 text-sm' %>
  </div>

  <section aria-labelledby="open-cases-heading" class="mb-10">
    <h2 id="open-cases-heading" class="text-lg font-medium text-gray-900">Reviews in progress</h2>
    <p class="mt-1 mb-3 text-sm text-gray-600">
      Comparisons already started as durable cases, from any source, that still need a decision.
    </p>

    <% if @open_cases.any? %>
      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <ul class="divide-y divide-gray-200">
          <% @open_cases.each do |review_case| %>
            <% participants = duplicate_review_case_participants(review_case) %>
            <li class="px-4 py-4 sm:px-6"
                data-testid="duplicate-review-case-row"
                data-case-id="<%= review_case.id %>">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <h3 class="text-base font-medium text-gray-900">
                    Duplicate review case #<%= review_case.id %>
                  </h3>
                  <p class="mt-1 text-sm text-gray-600" data-testid="open-case-summary">
                    <%= pluralize(participants.size, 'record') %> in this case
                  </p>
                  <div class="mt-1 flex flex-wrap gap-2 text-xs">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-100 text-blue-800" data-testid="case-source">
                      <%= duplicate_review_source_label(review_case.source) %>
                    </span>
                    <% Array(review_case.metadata['reason_codes']).each do |code| %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-700"><%= duplicate_review_reason_label(code) %></span>
                    <% end %>
                  </div>
                </div>
                <div class="text-sm text-right">
                  <div class="text-gray-500 mb-2">Opened <%= review_case.opened_at.strftime('%b %d, %Y') %></div>
                  <%= link_to 'Continue review', admin_duplicate_review_path(review_case), class: 'text-indigo-600 hover:text-indigo-900 font-medium' %>
                </div>
              </div>

              <ol class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-px overflow-hidden rounded-md bg-gray-200 border border-gray-200"
                  aria-label="Records in duplicate review case <%= review_case.id %>">
                <% participants.each_with_index do |participant, index| %>
                  <% user = participant[:user] %>
                  <li class="bg-white px-4 py-3"
                      data-testid="open-case-participant"
                      data-constituent-id="<%= participant[:constituent_id] %>">
                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Record <%= index + 1 %></p>
                    <% if user.present? %>
                      <h4 class="mt-1 text-base font-medium text-gray-900">
                        <%= link_to user.full_name, admin_user_path(user), class: 'hover:text-indigo-600' %>
                      </h4>
                      <p class="text-xs text-gray-500">Constituent ID <%= user.id %></p>
                      <dl class="mt-2 space-y-1 text-xs text-gray-600">
                        <div><dt class="inline font-medium">Email:</dt> <dd class="inline"><%= stored_email_display(user) %></dd></div>
                        <div><dt class="inline font-medium">Phone:</dt> <dd class="inline"><%= stored_phone_display(user) %></dd></div>
                      </dl>
                    <% else %>
                      <h4 class="mt-1 text-base font-medium text-gray-900">Record unavailable</h4>
                      <p class="text-xs text-gray-500">
                        <%= participant[:constituent_id].present? ? "Constituent ID #{participant[:constituent_id]}" : 'No constituent ID recorded' %>
                      </p>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="bg-white shadow sm:rounded-md p-6 text-center text-gray-500">No duplicate reviews are in progress.</div>
    <% end %>
  </section>

  <section aria-labelledby="unreviewed-groups-heading" class="mb-10">
    <h2 id="unreviewed-groups-heading" class="text-lg font-medium text-gray-900">Potential duplicate groups</h2>
    <p class="mt-1 mb-3 text-sm text-gray-600">
      The pairings shown below are current name-and-date-of-birth matches that have not been opened as cases or resolved.
      Matching does not establish that the records belong to the same person.
      Compare two records at a time; each decision applies only to that pair.
    </p>

    <% if @unreviewed_match_groups.any? %>
      <div class="space-y-4">
        <% @unreviewed_match_groups.each do |group| %>
          <% group_dom_id = "duplicate-match-group-#{group.ids.join('-')}" %>
          <article class="bg-white shadow overflow-hidden sm:rounded-md"
                   aria-labelledby="<%= group_dom_id %>-heading"
                   data-testid="unreviewed-match-group">
            <header class="border-b border-gray-200 px-4 py-4 sm:px-6">
              <h3 id="<%= group_dom_id %>-heading" class="text-lg font-medium text-gray-900"><%= group.display_name %></h3>
              <p class="mt-1 text-sm text-gray-600" data-testid="match-group-summary">
                <%= pluralize(group.members.size, 'record') %> · <%= pluralize(group.pairs.size, 'comparison') %> remaining
              </p>
            </header>

            <ul class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-px bg-gray-200"
                aria-label="Records in this potential duplicate group">
              <% group.members.each do |member| %>
                <li class="bg-white px-4 py-4 sm:px-6"
                    data-testid="match-group-member"
                    data-constituent-id="<%= member.id %>">
                  <h4 class="text-base font-medium text-gray-900">
                    <%= link_to member.name, admin_user_path(member.id), class: 'hover:text-indigo-600' %>
                  </h4>
                  <p class="text-xs text-gray-500">Constituent ID <%= member.id %></p>
                  <dl class="mt-2 space-y-1 text-xs text-gray-600">
                    <div><dt class="inline font-medium">Email present:</dt> <dd class="inline"><%= duplicate_review_presence_label(member.real_email) %></dd></div>
                    <div><dt class="inline font-medium">Phone present:</dt> <dd class="inline"><%= duplicate_review_presence_label(member.real_phone) %></dd></div>
                    <div><dt class="inline font-medium">Applications:</dt> <dd class="inline"><%= member.application_summary.humanize %></dd></div>
                  </dl>
                </li>
              <% end %>
            </ul>

            <div class="border-t border-gray-200 bg-gray-50 px-4 py-4 sm:px-6">
              <% if group.pairs.one? %>
                <%= render 'pair_actions', group:, button_label: 'Compare these two records' %>
              <% else %>
                <% next_pair = group.pairs.first %>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" data-testid="next-pair-action">
                  <p class="text-sm text-gray-700">Next pair: Constituent IDs <%= next_pair.first.id %> and <%= next_pair.second.id %></p>
                  <%= render 'pair_form',
                             pair: next_pair,
                             button_label: 'Compare next',
                             form_id_suffix: 'next' %>
                </div>
                <details class="group" data-testid="match-group-review-disclosure">
                  <summary
                    class="mt-3 ml-auto w-fit cursor-pointer list-none select-none rounded border border-indigo-600 bg-white
                           px-4 py-2 text-sm text-indigo-700 hover:bg-indigo-50 focus:outline-none focus:ring-2
                           focus:ring-indigo-500 focus:ring-offset-2 [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">Show pairings</span>
                    <span class="hidden group-open:inline">Hide pairings</span>
                  </summary>
                  <div class="mt-4 border-t border-gray-200 pt-4">
                    <h4 class="text-sm font-medium text-gray-900">Choose two records to compare</h4>
                    <p class="mt-1 mb-3 text-xs text-gray-600">Each comparison opens one exact pair for review.</p>
                    <%= render 'pair_actions', group:, button_label: 'Compare records' %>
                  </div>
                </details>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white shadow sm:rounded-md p-6 text-center text-gray-500">No potential duplicate groups.</div>
    <% end %>
  </section>

  <section aria-labelledby="legacy-heading">
    <h2 id="legacy-heading" class="text-lg font-medium text-gray-900 mb-3">Other records flagged for review</h2>

    <% if @legacy_flagged_users.any? %>
      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <ul class="divide-y divide-gray-200">
          <% @legacy_flagged_users.each do |user| %>
            <li class="px-4 py-4 sm:px-6" data-testid="legacy-flag-row">
              <div class="sm:flex sm:items-center sm:justify-between">
                <div>
                  <h3 class="text-base font-medium text-gray-900">
                    <%= link_to user.full_name, admin_user_path(user), class: 'hover:text-indigo-600' %>
                    <span class="ml-2 text-xs font-semibold text-yellow-800 bg-yellow-200 px-2 py-0.5 rounded-full">Manual / legacy flag</span>
                  </h3>
                  <p class="text-sm text-gray-500"><%= stored_email_display(user) %> · <%= stored_phone_display(user) %></p>
                </div>
                <%= form_with url: clear_flag_admin_duplicate_reviews_path, method: :post, class: 'mt-3 sm:mt-0 flex items-end gap-2' do |f| %>
                  <%= f.hidden_field :user_id, value: user.id %>
                  <div>
                    <%= f.label :rationale, 'Rationale', class: 'block text-xs text-gray-600' %>
                    <%= f.text_field :rationale, required: true, class: 'border-gray-300 rounded-md text-sm', placeholder: 'Why is this flag being cleared?' %>
                  </div>
                  <%= f.submit 'Clear flag', class: 'bg-gray-700 hover:bg-gray-800 text-white py-2 px-3 rounded text-xs cursor-pointer' %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="bg-white shadow sm:rounded-md p-6 text-center text-gray-500">No other records are awaiting review.</div>
    <% end %>
  </section>
</div>
