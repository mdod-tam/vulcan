<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Vendors</h1>
    <div>
      <a href="<%= admin_applications_path %>" 
         class="btn btn-outline"
         data-turbo-frame="_top"
         aria-label="Return to applications dashboard">
        Back to Dashboard
      </a>
    </div>
  </div>

  <div class="p-4 border-b mb-6">
    <div class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium text-gray-700">W9 Status:</span>
        <%= link_to "All", admin_vendors_path, class: "btn btn-outline" %>
        <%= link_to "Not Submitted", admin_vendors_path(w9_status: :not_submitted), class: "btn btn-outline" %>
        <%= link_to "Pending Review", admin_vendors_path(w9_status: :pending_review), class: "btn btn-outline" %>
        <%= link_to "Approved", admin_vendors_path(w9_status: :approved), class: "btn btn-outline" %>
        <%= link_to "Rejected", admin_vendors_path(w9_status: :rejected), class: "btn btn-outline" %>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Business Name</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tax ID</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">W9 Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @vendors.each do |vendor| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900"><%= vendor.business_name %></div>
              <div class="text-sm text-gray-500"><%= vendor.email %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= vendor.masked_business_tax_id %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="badge <%= vendor.vendor_approved? ? 'badge-success' : vendor.vendor_pending? ? 'badge-warning' : 'badge-danger' %>">
                <%= vendor.vendor_authorization_status.titleize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="<%= badge_class_for(:w9, vendor.w9_status) %>">
                <%= vendor.w9_status.to_s.titleize %>
              </span>
              <% if vendor.w9_status_pending_review? %>
                <span class="ml-2 text-xs text-danger-600 font-medium">Needs Review</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "View", admin_vendor_path(vendor), class: "text-primary-600 hover:text-primary-900 mr-3" %>
              <% if vendor.w9_status_pending_review? && vendor.w9_form.attached? %>
                <%= link_to "Review W9", new_admin_vendor_w9_review_path(vendor), class: "text-success-600 hover:text-success-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
    <%= render 'shared/pagination', pagy: @pagy, label: t('pagination.vendors') %>
  </div>
</div>
