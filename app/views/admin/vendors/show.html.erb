<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= @vendor.business_name %></h1>
    <div class="flex space-x-2">
      <%= link_to admin_vendors_path,
          class: "btn btn-outline",
          aria: { label: "Return to vendors list" } do %>
        <span>Back to Vendors</span>
      <% end %>
      <%= link_to edit_admin_vendor_path(@vendor),
          class: "btn btn-primary",
          aria: { label: "Edit vendor" } do %>
        <span>Edit</span>
      <% end %>
    </div>
  </div>

  <div class="card overflow-hidden mb-6">
    <div class="px-4 py-5 sm:px-6 bg-gray-50">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Vendor Information</h3>
    </div>
    <div class="border-t border-gray-200">
      <dl>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Business Name</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vendor.business_name %></dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Business Tax ID</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vendor.masked_business_tax_id %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Email</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vendor.email %></dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Phone</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vendor.phone || "Not provided" %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Vendor Approval Status</dt>
          <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
            <span class="badge <%= @vendor.vendor_approved? ? 'badge-success' : @vendor.vendor_pending? ? 'badge-warning' : 'badge-danger' %>">
              <%= @vendor.vendor_authorization_status.titleize %>
            </span>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Tax Form (W9) Status</dt>
          <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
            <span class="<%= badge_class_for(:w9, @vendor.w9_status) %>">
              <%= @vendor.w9_status.to_s.titleize %>
            </span>
            <% if @vendor.w9_status_pending_review? && @vendor.w9_form.attached? %>
              <%= link_to "Review W9", new_admin_vendor_w9_review_path(@vendor), class: "ml-3 text-sm text-primary-600 hover:text-primary-900" %>
            <% end %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">W9 Form</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @vendor.w9_form.attached? %>
              <div class="flex items-center">
                <svg class="h-5 w-5 text-gray-500 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <%= link_to 'View W9 Form', vendor_w9_document_path(@vendor, @vendor.w9_form.blob, disposition: 'inline'),
                            target: '_blank', rel: 'noopener', class: 'text-primary-600 hover:text-primary-900' %>
              </div>
              <%= render 'shared/document_scan_status', document: @vendor.w9_form %>
            <% else %>
              <span class="text-danger-600">No W9 form uploaded</span>
            <% end %>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Terms Accepted</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @vendor.terms_accepted_at.present? %>
              <%= @vendor.terms_accepted_at.strftime("%B %d, %Y") %>
            <% else %>
              <span class="text-danger-600">Not accepted</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <%= render "secure_request_forms" %>

  <div class="card overflow-hidden">
    <div class="px-4 py-5 sm:px-6 bg-gray-50">
      <h3 class="text-lg leading-6 font-medium text-gray-900">W9 Review History</h3>
    </div>
    <div class="border-t border-gray-200 p-4">
      <% w9_history_items = vendor_w9_history_items(w9_reviews: @w9_reviews,
                                                     secure_request_notifications: @w9_secure_request_notifications,
                                                     secure_request_events: @w9_secure_request_events) %>
      <% if w9_history_items.any? %>
        <div class="flow-root">
          <ul role="list" class="-mb-8">
            <% w9_history_items.each_with_index do |item, index| %>
              <li>
                <div class="relative pb-8">
                  <% if index < w9_history_items.size - 1 %>
                    <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                  <% end %>
                  <div class="relative flex space-x-3">
                    <div>
                      <span class="h-8 w-8 rounded-full flex items-center justify-center ring-8 ring-white 
                        <%= vendor_w9_history_item_icon_class(item) %>">
                        <% if item.type == :review && item.record.status_approved? %>
                          <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                          </svg>
                        <% else %>
                          <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                          </svg>
                        <% end %>
                      </span>
                    </div>
                    <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                      <div>
                        <p class="text-sm text-gray-500">
                          <span class="font-medium text-gray-900">
                            <%= vendor_w9_history_item_title(item) %>
                          </span>
                          by <%= vendor_w9_history_item_actor(item) %>
                        </p>
                        <% if vendor_w9_history_item_detail(item).present? %>
                          <p class="mt-1 text-sm text-gray-700">
                            <%= vendor_w9_history_item_detail(item) %>
                          </p>
                        <% end %>
                      </div>
                      <div class="text-right text-sm whitespace-nowrap text-gray-500">
                        <%= item.occurred_at.strftime("%b %d, %Y") %>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No W9 reviews yet.</p>
      <% end %>
    </div>
  </div>
</div>
