<%= turbo_frame_tag(turbo_frame_request_id || "user_edit_#{@user.id}") do %>
<main class="container mx-auto px-4 py-8">
  <div class="card p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">Edit User: <%= @user.full_name %></h1>
      <%= link_to "Back to User", admin_user_path(@user), class: "text-primary-600 hover:text-primary-500", data: { turbo_frame: "_top" } %>
    </div>

    <%= form_for @user, url: admin_user_path(@user), method: :patch, local: true, as: :user, html: { class: "space-y-6", data: { turbo_frame: turbo_frame_request_id || "_top" } } do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-danger-50 p-4 rounded mb-6" role="alert" aria-atomic="true">
          <h2 class="text-danger-700 font-medium">
            <%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:
          </h2>
          <ul class="list-disc list-inside text-danger-700">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset class="space-y-4 p-4 bg-gray-50 rounded">
        <legend class="text-lg font-medium text-gray-900">Basic Information</legend>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name,
                  class: "form-input mt-1" %>
          </div>

          <div>
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name,
                  class: "form-input mt-1" %>
          </div>

          <div>
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email,
                  class: "form-input mt-1" %>
          </div>

          <%# Shown for every user so staff can add one before converting a user to a constituent.
              Required only once on file: an older record without one can still save other edits. %>
          <div>
            <%= f.label :date_of_birth, t('shared.date_of_birth.label'), class: 'form-label' %>
            <%= date_of_birth_text_field f,
                                         value: date_of_birth_input_value(@user),
                                         required: @user.date_of_birth.present?,
                                         class: 'form-input mt-1',
                                         aria: { describedby: 'admin_user_dob_hint' } %>
            <p id="admin_user_dob_hint" class="form-hint"><%= t('shared.date_of_birth.hint') %></p>
          </div>

          <div>
            <%= f.label :phone, class: "form-label" %>
            <%= f.telephone_field :phone,
                  class: "form-input mt-1",
                  placeholder: "555-555-5555" %>
          </div>
        </div>

        <div>
          <%= f.label :phone_type, "Phone Type", class: "form-label mb-2" %>
          <div role="radiogroup" class="space-y-2">
            <div class="flex items-center">
              <%= f.radio_button :phone_type, "voice", id: "admin_user_phone_type_voice",
                     class: "h-4 w-4 text-primary-600 border-gray-300" %>
              <%= f.label :phone_type_voice, "Voice", for: "admin_user_phone_type_voice", class: "ml-3 text-sm text-gray-700" %>
            </div>
            <div class="flex items-center">
              <%= f.radio_button :phone_type, "videophone", id: "admin_user_phone_type_videophone",
                     class: "h-4 w-4 text-primary-600 border-gray-300" %>
              <%= f.label :phone_type_videophone, "Videophone", for: "admin_user_phone_type_videophone", class: "ml-3 text-sm text-gray-700" %>
            </div>
            <div class="flex items-center">
              <%= f.radio_button :phone_type, "text", id: "admin_user_phone_type_text",
                     class: "h-4 w-4 text-primary-600 border-gray-300" %>
              <%= f.label :phone_type_text, "Text/SMS", for: "admin_user_phone_type_text", class: "ml-3 text-sm text-gray-700" %>
            </div>
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 p-4 bg-gray-50 rounded">
        <legend class="text-lg font-medium text-gray-900">Address Information</legend>
        
        <div>
          <%= f.label :physical_address_1, "Street Address", class: "form-label" %>
          <%= f.text_field :physical_address_1,
                class: "form-input mt-1" %>
        </div>

        <div>
          <%= f.label :physical_address_2, "Apartment/Suite", class: "form-label" %>
          <%= f.text_field :physical_address_2,
                class: "form-input mt-1" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <%= f.label :city, "City", class: "form-label" %>
            <%= f.text_field :city,
                  class: "form-input mt-1" %>
          </div>

          <div>
            <%= f.label :state, "State", class: "form-label" %>
            <%= f.text_field :state,
                  class: "form-input mt-1" %>
          </div>

          <div>
            <%= f.label :zip_code, "ZIP Code", class: "form-label" %>
            <%= f.text_field :zip_code,
                  class: "form-input mt-1" %>
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 p-4 bg-gray-50 rounded">
        <legend class="text-lg font-medium text-gray-900">Communication Preferences</legend>

        <div>
          <%= f.label :communication_preference, "Notification Method", class: "form-label mb-2" %>
          <div role="radiogroup" class="space-y-2">
            <div class="flex items-center">
              <%= f.radio_button :communication_preference, "email", id: "admin_user_comm_pref_email",
                     class: "h-4 w-4 text-primary-600 border-gray-300" %>
              <%= f.label :communication_preference_email, "Email", for: "admin_user_comm_pref_email", class: "ml-3 text-sm text-gray-700" %>
            </div>
            <div class="flex items-center">
              <%= f.radio_button :communication_preference, "letter", id: "admin_user_comm_pref_letter",
                     class: "h-4 w-4 text-primary-600 border-gray-300" %>
              <%= f.label :communication_preference_letter, "Mailed Letter", for: "admin_user_comm_pref_letter", class: "ml-3 text-sm text-gray-700" %>
            </div>
          </div>
        </div>

        <div class="flex items-start">
          <%= f.check_box :newsletter_signup,
              id: "admin_user_newsletter_signup",
              class: "mt-1 h-4 w-4 text-primary-600 border-gray-300 rounded" %>
          <%= f.label :newsletter_signup,
              "Sign up for our newsletter to receive updates about MAT programs and services",
              class: "ml-2 block text-sm text-gray-700" %>
        </div>
      </fieldset>

      <div class="flex items-center justify-end space-x-3">
        <%= link_to "Cancel", admin_user_path(@user),
            class: "btn btn-outline",
            data: { turbo_frame: "_top" } %>
            
        <%= f.submit "Update User",
            class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</main>
<% end %>
