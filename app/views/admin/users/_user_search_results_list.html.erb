<%# This partial is rendered inside a turbo_frame_tag (e.g., "guardian_search_results") %>
<%# It receives `users` and `role` (e.g., "guardian", "dependent", "constituent") as local variables. %>

<% if users.any? %>
  <ul class="divide-y divide-gray-200 border border-gray-200 rounded-md max-h-60 overflow-y-auto" data-turbo="false">
    <% users.each do |user| %>
      <% is_constituent_search = role == 'constituent' %>
      <% eligibility = paper_application_eligibility(user) if is_constituent_search %>
      <% last_app = latest_user_application(user) if is_constituent_search %>
      <% last_products = is_constituent_search ? (last_app&.products&.map(&:name) || []) : [] %>
      <% ineligible_reason = paper_application_ineligibility_reason(eligibility) if is_constituent_search %>
      <% ineligible = is_constituent_search && !eligibility.eligible? %>
      <% email_display = display_contact_email(user) %>
      <% phone_display = display_contact_phone(user) %>
      <li class="p-3 <%= ineligible ? 'opacity-50 cursor-not-allowed bg-gray-50' : 'hoverable-user-item' %>"
          <% if ineligible %>
          tabindex="-1"
          <% else %>
          data-action="click->admin-user-search#selectUser"
          role="button"
          tabindex="0"
          <% end %>
          data-user-id="<%= user.id %>"
          data-user-name="<%= user.full_name %>"
          data-user-email="<%= displayable_contact_email?(user) ? email_display : '' %>"
          data-user-address-1="<%= user.physical_address_1 %>"
          data-user-address-2="<%= user.physical_address_2 %>"
          data-user-city="<%= user.city %>"
          data-user-state="<%= user.state %>"
          data-user-zip="<%= user.zip_code %>"
          data-user-phone="<%= phone_display == ConstituentCommunicationLabelsHelper::NO_PHONE_ON_FILE ? '' : phone_display %>"
          data-user-dob="<%= user.date_of_birth %>"
          <% if is_constituent_search %>
          data-user-eligible="<%= eligibility.eligible? %>"
          data-user-ineligible-reason="<%= ineligible_reason %>"
          data-user-last-app-date="<%= last_app&.application_date %>"
          data-user-products="<%= last_products.join(', ') %>"
          <% end %>
          data-user-dependents-count="<%= role == 'guardian' ? user.guardian_relationships_as_guardian.size : 0 %>"
          <% if ineligible %>
          data-user-ineligible="true"
          aria-disabled="true"
          <% end %>
          data-turbo="false">
          <div class="flex items-center justify-between">
            <div class="font-medium text-sm text-gray-900"><%= user.full_name %></div>
            <% if is_constituent_search %>
              <% if eligibility.eligible? %>
                <span class="badge badge-success">Eligible</span>
              <% else %>
                <span class="badge badge-danger">Ineligible</span>
              <% end %>
            <% end %>
          </div>
          <div class="text-xs text-gray-500"><%= email_display %></div>

          <% if is_constituent_search && user.date_of_birth.present? %>
            <div class="text-xs text-gray-500 mt-1">DOB: <%= user.date_of_birth.strftime('%m/%d/%Y') %></div>
          <% end %>

          <% if user.physical_address_1.present? %>
            <div class="text-xs text-gray-500 mt-1">
              <%= user.physical_address_1 %>
              <%= ", #{user.physical_address_2}" if user.physical_address_2.present? %>
              <%= ", #{user.city}" if user.city.present? %>
              <%= ", #{user.state}" if user.state.present? %>
              <%= " #{user.zip_code}" if user.zip_code.present? %>
            </div>
          <% end %>

          <% if phone_display != ConstituentCommunicationLabelsHelper::NO_PHONE_ON_FILE %>
            <div class="text-xs text-gray-500">Phone: <%= phone_display %></div>
          <% end %>

          <% if ineligible_reason.present? %>
            <div class="text-xs text-danger-600 mt-1"><%= ineligible_reason %></div>
          <% elsif last_products.any? %>
            <div class="text-xs text-gray-500 mt-1">Last products: <%= last_products.join(', ') %></div>
          <% end %>

          <% unless is_constituent_search %>
            <div class="text-xs text-gray-500 mt-1">
              Role: <%= user.type.demodulize if user.type %>
              <% if role == 'guardian' && user.guardian? %>
                <span class="badge badge-success ml-2">
                  <%= pluralize(user.guardian_relationships_as_guardian.size, 'dependent') %>
                </span>
              <% end %>
              <% if role == 'dependent' && user.dependent? %>
                <span class="badge badge-info ml-2">
                  Has guardian
                </span>
              <% end %>
            </div>
          <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-gray-500 p-3">No users found matching your search.</p>
<% end %>
