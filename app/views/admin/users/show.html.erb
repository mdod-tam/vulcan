<a href="#main-content" class="skip-link">
  Skip to main content
</a>

<div class="container mx-auto px-4 py-8">
  <div id="main-content" tabindex="-1" class="max-w-7xl mx-auto">
    <% if @contact_delivery_attention.present? %>
      <section class="mb-4 rounded border border-warning-200 bg-warning-50 p-4" aria-label="Delivery needs attention">
        <h2 class="font-semibold">Delivery to this contact needs attention</h2>
        <% @contact_delivery_attention.each do |attempt| %>
          <%= render 'shared/delivery/status', presenter: DeliveryStatusPresenter.new(attempt, attempt: attempt) %>
          <% if attempt.application %><%= link_to 'Review application', admin_application_path(attempt.application), class: 'underline text-primary-700' %><% end %>
        <% end %>
      </section>
    <% end %>
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
      <h1 id="user-title" class="text-3xl font-bold text-gray-900 mb-4 md:mb-0">
        User Details: <%= @user.full_name %>
      </h1>
      <div class="flex flex-wrap gap-3">
        <% if @user.needs_duplicate_review %>
          <%= link_to admin_duplicate_review_entry_path(@user),
              class: "inline-flex items-center px-4 py-2 border border-warning-300 rounded-md shadow-elevation-1 " \
                     "text-sm font-medium text-warning-800 bg-warning-50 hover:bg-warning-100",
              aria: { label: "Review duplicate flag for #{@user.full_name}" } do %>
            <span>Review Duplicate</span>
          <% end %>
        <% end %>
        <%= link_to edit_admin_user_path(@user),
            class: "btn btn-secondary",
            aria: { label: "Edit user" } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          <span>Edit User</span>
        <% end %>
        <%= link_to 'Security-key recovery requests', admin_recovery_requests_path, class: 'btn btn-secondary' %>
        <%= button_to mfa_tokens_admin_user_path(@user),
            method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: "Are you sure?" } },
            class: "btn btn-danger-outline",
            aria: { label: "Delete MFA tokens for #{@user.full_name}" } do %>
          <span>Delete MFA Tokens</span>
        <% end %>
        <% unless @user.login_status_change_refusal_reason(actor: current_user) %>
          <% if @user.inactive? || @user.suspended? %>
            <%= button_to reactivate_admin_user_path(@user),
                          method: :post,
                          form: { class: 'inline-flex' },
                          class: 'btn btn-secondary',
                          aria: { label: "Reactivate user #{@user.full_name}" } do %>
              <span>Reactivate User</span>
            <% end %>
          <% else %>
            <%= button_to deactivate_admin_user_path(@user),
                          method: :post,
                          form: {
                            class: 'inline-flex',
                            data: { turbo_confirm: 'Deactivate this user? Sign-in will be blocked and current sessions revoked. ' \
                                                   'Their records and history will be preserved.' }
                          },
                          class: 'btn btn-danger-outline',
                          aria: { label: "Deactivate user #{@user.full_name}" } do %>
              <span>Deactivate User</span>
            <% end %>
          <% end %>
        <% end %>
        <%= link_to admin_users_path,
            class: "btn btn-outline",
            "aria-label": "Return to users list" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Back to List</span>
        <% end %>
      </div>
    </header>

    <section class="card p-6 mb-6" aria-labelledby="basic-info-title">
      <h2 id="basic-info-title" class="text-xl font-semibold text-gray-900 mb-4">Basic Information</h2>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-700">Full Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.full_name %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Account Status</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.status&.humanize || 'Active' %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Email (delivery contact)</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% email_display = display_contact_email(@user) %>
            <% if displayable_contact_email?(@user) %>
              <%= mail_to email_display, email_display, class: "text-primary-600 hover:text-primary-500 rounded" %>
            <% else %>
              <span class="text-gray-700"><%= email_display %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Phone (delivery contact)</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% phone_display = display_contact_phone(@user) %>
            <% if phone_display != ConstituentCommunicationLabelsHelper::NO_PHONE_ON_FILE %>
              <%= phone_display %>
              <% if @user.phone_type.present? %>
                <span class="text-gray-700">(<%= @user.phone_type %>)</span>
              <% end %>
            <% else %>
              <span class="text-gray-700"><%= phone_display %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Date of Birth</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.date_of_birth&.strftime("%B %d, %Y") || "Not provided" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Address</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @user.physical_address_1.present? %>
              <%= @user.physical_address_1 %><br>
              <% if @user.physical_address_2.present? %>
                <%= @user.physical_address_2 %><br>
              <% end %>
              <%= "#{@user.city}, #{@user.state} #{@user.zip_code}" %>
            <% else %>
              <span class="text-gray-700">No address provided</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-700">Communication Preferences</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <ul class="space-y-1">
              <li><strong>Contact Method:</strong> <%= contact_method_label(@user.phone_type) %></li>
              <li><strong>Preferred Language:</strong> <%= language_label(@user.locale) %></li>
              <li><strong>Communication Modality:</strong> <%= @user.preferred_means_of_communication.presence || "Not specified" %></li>
              <li><strong>Newsletter Signup:</strong> <%= @user.newsletter_signup ? "Yes" : "No" %></li>
            </ul>
          </dd>
        </div>
      </dl>
    </section>

    <% if @access_events.present? %>
      <section class="card p-6 mb-6" aria-labelledby="access-history-title">
        <h2 id="access-history-title" class="text-xl font-semibold text-gray-900 mb-4">Access History</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <caption class="sr-only">Capability changes for <%= @user.full_name %>, newest first</caption>
            <thead>
              <tr>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">When</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Change</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Detail</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">By</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @access_events.each do |event| %>
                <tr>
                  <td class="px-4 py-2 text-sm text-gray-700"><%= l(event.created_at, format: :short) %></td>
                  <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= activity_label(event) %></td>
                  <td class="px-4 py-2 text-sm text-gray-700"><%= activity_detail(event) %> (<%= event.metadata['reason'].to_s.humanize.downcase %>)</td>
                  <td class="px-4 py-2 text-sm text-gray-700"><%= activity_actor_name(event) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <div data-controller="application-modal" data-action="turbo:submit-end->application-modal#handleFormSubmit">
      <%= turbo_frame_tag 'user-application-summary', data: { refresh_url: admin_user_path(@user) } do %>
        <%= render 'application_summary', user: @user %>
      <% end %>

      <dialog 
        id="application-modal"
        class="rounded-lg shadow-elevation-4 max-w-2xl w-full backdrop:bg-black backdrop:bg-opacity-50"
        aria-labelledby="modal-title">
  
  <div class="bg-white rounded-lg">
    <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
      <h3 id="modal-title" class="text-lg font-semibold text-gray-900">
        Application Details
      </h3>
      <button 
        type="button"
        class="text-gray-500 hover:text-gray-700 rounded"
        data-action="click->application-modal#close"
        aria-label="Close modal">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= turbo_frame_tag "application-modal-content" do %>
      <div class="px-6 py-4">
        <p class="text-gray-600">Loading application details...</p>
      </div>
    <% end %>

    <div class="sticky bottom-0 bg-gray-50 border-t border-gray-200 px-6 py-4 flex justify-end gap-3">
      <button 
        type="button"
        class="btn btn-outline"
        data-action="click->application-modal#close"
        aria-label="Close application details modal">
        Close
      </button>
      <button 
        type="button"
        id="modal-edit-button"
        class="btn btn-secondary"
        data-action="click->application-modal#openApplicationEdit">
        Edit
      </button>
      <a 
        id="modal-view-full-link"
        href="#"
        class="btn btn-primary"
        data-turbo-frame="_top">
        View Full Application
      </a>
    </div>
  </div>
</dialog>

      <dialog 
        id="application-edit-modal"
        class="rounded-lg shadow-elevation-4 max-w-2xl w-full backdrop:bg-black backdrop:bg-opacity-50"
        aria-labelledby="application-edit-modal-title">
        
        <div class="bg-white rounded-lg">
          <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
            <h3 id="application-edit-modal-title" class="text-lg font-semibold text-gray-900">
              Edit Application
            </h3>
            <button 
              type="button"
              class="text-gray-500 hover:text-gray-700 rounded"
              data-action="click->application-modal#close"
              aria-label="Close modal">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <%= turbo_frame_tag "application-edit-modal-content" do %>
            <div class="px-6 py-4">
              <p class="text-gray-600">Loading edit form...</p>
            </div>
          <% end %>

          <div class="sticky bottom-0 bg-gray-50 border-t border-gray-200 px-6 py-4 flex justify-end gap-3">
            <button 
              type="button"
              class="btn btn-outline"
              data-action="click->application-modal#close"
              aria-label="Cancel editing and close modal">
              Cancel
            </button>
          </div>
        </div>
      </dialog>
    </div>

  </div>
</div>
