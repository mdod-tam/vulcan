<%# locals: (user:) -%>
    <section class="card p-6 mb-6" aria-labelledby="guardian-dependent-info-title">
      <h2 id="guardian-dependent-info-title" class="text-xl font-semibold text-gray-900 mb-4">Guardian/Dependent Information</h2>

      <% if user.guardian? %>
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-3">Dependents Managed by <%= user.full_name %></h3>
          <% if user.guardian_relationships_as_guardian.any? %>
            <ul role="list" class="space-y-4" id="dependents_managed_list" aria-label="Dependents managed by <%= user.full_name %>">
              <% user.guardian_relationships_as_guardian.each do |gr| %>
                <% dependent = gr.dependent_user # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                <li class="p-4 border border-gray-200 rounded-lg shadow-elevation-1 bg-gray-50" id="dependent_<%= dependent.id %>">
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <p class="text-base font-semibold text-gray-900">
                        <%= link_to dependent.full_name, admin_user_path(dependent),
                                    class: 'text-primary-600 hover:text-primary-500 rounded',
                                    data: { turbo_frame: '_top' } %>
                      </p>
                      <p class="text-sm text-gray-700">Relationship: <span class="font-medium text-gray-900"><%= gr.relationship_type %></span></p>
                      <p class="text-sm text-gray-700">Established: <%= gr.created_at.strftime('%B %d, %Y') %></p>
                    </div>
                    <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">
                      <% if paper_application_eligibility(dependent).eligible? %>
                        <%= link_to new_admin_paper_application_path(guardian_id: user.id, dependent_id: dependent.id),
                                    class: 'btn btn-success btn-sm',
                                    data: { turbo_frame: '_top' },
                                    'aria-label': "Start paper application for #{dependent.full_name} managed by #{user.full_name}" do %>
                          Start Paper Application
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                  <div class="mt-3 text-sm text-gray-700">
                    <% last_app = latest_user_application(dependent) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                    <% active_app = @active_applications[dependent.id] # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                    <% approved_app = [active_app, last_app].compact.find { |a| a.status == 'approved' } # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>

                    <% if active_app %>
                      <div class="flex items-center flex-wrap gap-2">
                        <span class="text-sm font-medium text-gray-700">Application:</span>
                        <%= application_status_badge(active_app) %>
                        <span class="text-sm text-gray-700"><%= active_app.application_date.strftime('%b %d, %Y') %></span>
                        <button
                          type="button"
                          class="btn btn-secondary btn-sm"
                          data-action="click->application-modal#open"
                          data-modal-id="application-modal"
                          data-application-id="<%= active_app.id %>"
                          aria-label="View application for <%= dependent.full_name %>">
                          View
                        </button>
                      </div>
                      <div class="flex items-center flex-wrap gap-2 mt-2">
                        <% if active_app.income_proof_required? %>
                        <span class="text-sm text-gray-700">Income:</span>
                        <%= proof_status_badge('income', active_app.income_proof_status) %>
                        <% end %>
                        <span class="text-sm text-gray-700">Residency:</span>
                        <%= proof_status_badge('residency', active_app.residency_proof_status) %>
                        <span class="text-sm text-gray-700">Disability Certification:</span>
                        <%= disability_certification_status_badge(active_app) %>
                      </div>
                    <% elsif last_app %>
                      <div class="flex items-center flex-wrap gap-2">
                        <span class="text-sm font-medium text-gray-700">Application:</span>
                        <%= application_status_badge(last_app) %>
                        <span class="text-sm text-gray-700"><%= last_app.application_date.strftime('%b %d, %Y') %></span>
                        <button
                          type="button"
                          class="btn btn-secondary btn-sm"
                          data-action="click->application-modal#open"
                          data-modal-id="application-modal"
                          data-application-id="<%= last_app.id %>"
                          aria-label="View application for <%= dependent.full_name %>">
                          View
                        </button>
                      </div>
                      <div class="flex items-center flex-wrap gap-2 mt-2">
                        <% if last_app.income_proof_required? %>
                        <span class="text-sm text-gray-700">Income:</span>
                        <%= proof_status_badge('income', last_app.income_proof_status) %>
                        <% end %>
                        <span class="text-sm text-gray-700">Residency:</span>
                        <%= proof_status_badge('residency', last_app.residency_proof_status) %>
                        <span class="text-sm text-gray-700">Disability Certification:</span>
                        <%= disability_certification_status_badge(last_app) %>
                      </div>
                    <% else %>
                      <div class="text-xs text-gray-700">No prior applications</div>
                    <% end %>

                    <% app_to_show = active_app || last_app # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                    <% if app_to_show %>
                      <div class="mt-2 text-xs text-gray-600">
                        Last updated: <%= app_to_show.updated_at.strftime('%b %d, %Y at %l:%M %p') %>
                      </div>
                    <% end %>

                    <div class="mt-2">
                      <% if approved_app %>
                        <% approved_change = @approval_changes[approved_app.id] # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                        <div class="text-xs text-gray-700">
                          Application approved on <%= (approved_change&.changed_at || approved_app.updated_at).strftime('%b %d, %Y') %>
                        </div>
                        <% voucher = @latest_vouchers[approved_app.id] # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                        <% if voucher.present? && voucher.issued_at.present? %>
                          <div class="text-xs text-gray-700">
                            Voucher issued on <%= voucher.issued_at.strftime('%b %d, %Y') %>
                          </div>
                        <% end %>
                      <% end %>
                        <%= paper_application_eligibility_badge(paper_application_eligibility(dependent)) %>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-gray-700 text-sm">This user does not manage any dependents yet.</p>
          <% end %>
        </div>
      <% end %>

      <% if user.dependent? %>
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-3">Guardians for <%= user.full_name %></h3>
          <% if user.guardian_relationships_as_dependent.any? %>
            <ul role="list" class="space-y-4" id="guardians_list" aria-label="Guardians for <%= user.full_name %>">
              <% user.guardian_relationships_as_dependent.each do |gr| %>
                <% guardian = gr.guardian_user # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                <li class="p-4 border border-gray-200 rounded-lg shadow-elevation-1 bg-gray-50" id="guardian_<%= guardian.id %>">
                  <div class="flex-1">
                    <p class="text-base font-semibold text-gray-900">
                      <%= link_to guardian.full_name, admin_user_path(guardian),
                                  class: 'text-primary-600 hover:text-primary-500 rounded',
                                  data: { turbo_frame: '_top' } %>
                    </p>
                    <p class="text-sm text-gray-700">Relationship: <span class="font-medium text-gray-900"><%= gr.relationship_type %></span></p>
                    <p class="text-sm text-gray-700">Established: <%= gr.created_at.strftime('%B %d, %Y') %></p>
                    <div class="mt-3 p-3 bg-white rounded border border-gray-200">
                      <p class="text-xs font-medium text-gray-700 mb-1">Contact Information</p>
                      <p class="text-sm text-gray-900">
                        <span class="text-gray-700">Email:</span>
                        <% guardian_email_display = display_contact_email(guardian) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                        <% if displayable_contact_email?(guardian) %>
                          <%= mail_to guardian_email_display, guardian_email_display,
                                      class: 'text-primary-600 hover:text-primary-500 rounded' %>
                        <% else %>
                          <span class="text-gray-700"><%= guardian_email_display %></span>
                        <% end %>
                      </p>
                      <p class="text-sm text-gray-900">
                        <span class="text-gray-700">Phone:</span>
                        <% guardian_phone_display = display_contact_phone(guardian) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                        <% if guardian_phone_display != ConstituentCommunicationLabelsHelper::NO_PHONE_ON_FILE %>
                          <%= guardian_phone_display %>
                          <% if guardian.phone_type.present? %>
                            <span class="text-gray-700">(<%= guardian.phone_type %>)</span>
                          <% end %>
                        <% else %>
                          <span class="text-gray-700"><%= guardian_phone_display %></span>
                        <% end %>
                      </p>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-gray-700 text-sm">This user does not have any guardians listed yet.</p>
          <% end %>
        </div>
      <% end %>

      <% if !user.guardian? && !user.dependent? %>
        <p class="text-gray-700 text-sm">This user is neither a guardian nor a dependent in a recorded relationship.</p>
      <% end %>
    </section>

      <section aria-labelledby="applications-heading" class="card p-6 mb-6">
        <h2 id="applications-heading" class="text-xl font-semibold text-gray-900 mb-4"><%= user.first_name %>'s Applications</h2>
        <div class="space-y-4">
          <% if user.applications.any? %>
            <ul role="list" class="space-y-4">
              <% @application_lists.fetch(user.id).each do |application| %>
                <li class="p-4 border border-gray-200 rounded-lg shadow-elevation-1 bg-gray-50">
                  <div class="flex items-center flex-wrap gap-2">
                    <span class="text-sm font-medium text-gray-700">Application:</span>
                    <%= application_status_badge(application) %>
                    <span class="text-sm text-gray-700"><%= application.application_date.strftime('%b %d, %Y') %></span>
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm"
                      data-action="click->application-modal#open"
                      data-modal-id="application-modal"
                      data-application-id="<%= application.id %>"
                      aria-label="View application from <%= application.application_date.strftime('%B %d, %Y') %>">
                      View
                    </button>
                  </div>
                  <div class="flex items-center flex-wrap gap-2 mt-2">
                    <% if application.income_proof_required? %>
                    <span class="text-sm text-gray-700">Income:</span>
                    <%= proof_status_badge('income', application.income_proof_status) %>
                    <% end %>
                    <span class="text-sm text-gray-700">Residency:</span>
                    <%= proof_status_badge('residency', application.residency_proof_status) %>
                    <span class="text-sm text-gray-700">Disability Certification:</span>
                    <%= disability_certification_status_badge(application) %>
                  </div>
                  <div class="mt-2 text-xs text-gray-600">
                    Last updated: <%= application.updated_at.strftime('%b %d, %Y at %l:%M %p') %>
                  </div>
                  <% if application.status == 'approved' %>
                    <% approved_change = @approval_changes[application.id] # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                    <div class="mt-2">
                      <div class="text-xs text-gray-700">
                        Application approved on <%= (approved_change&.changed_at || application.updated_at).strftime('%b %d, %Y') %>
                      </div>
                      <% voucher = @latest_vouchers[application.id] # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
                      <% if voucher.present? && voucher.issued_at.present? %>
                        <div class="text-xs text-gray-700">
                          Voucher issued on <%= voucher.issued_at.strftime('%b %d, %Y') %>
                        </div>
                      <% end %>
                      <%= paper_application_eligibility_badge(paper_application_eligibility(user)) %>
                    </div>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-gray-700 text-sm">This user has no applications.</p>
          <% end %>
        </div>
      </section>
