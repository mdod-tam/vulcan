<div class="max-w-4xl mx-auto p-4 space-y-6">
  <h1 class="text-2xl font-bold">Correct purchase order <%= @purchase_order.number %></h1>
  <p>This purchase order contains <%= pluralize(@items.size, 'equipment item') %> across <%= pluralize(@items.map(&:application_id).uniq.size, 'application') %>,
     including <%= pluralize(@items.count(&:shipped_at?), 'shipped device') %>. Header changes affect every linked device.</p>
  <% if @form_errors.present? %>
    <div role="alert" tabindex="-1" class="rounded border border-red-300 bg-red-50 p-4 text-red-900">
      <ul class="list-disc pl-5"><% @form_errors.each do |error| %><li><%= error %></li><% end %></ul>
    </div>
  <% end %>
  <%= form_with model: @purchase_order, url: admin_purchase_order_correction_path(@purchase_order), method: :patch, local: true,
                data: { turbo: false }, class: 'space-y-4' do |form| %>
    <%= hidden_field_tag :expected_version, @expected_version %>
    <% @return_context.each do |key, value| %><%= hidden_field_tag "return_context[#{key}]", value %><% end %>
    <% @item_versions.each do |id, version| %><%= hidden_field_tag "item_versions[#{id}]", version %><% end %>
    <%= render 'admin/purchase_orders/fields', form: form, purchase_order: @purchase_order, vendors: @vendors %>
    <div>
      <%= label_tag :reason, 'Correction reason', class: 'block font-medium' %>
      <%= text_area_tag :reason, params[:reason], required: true, rows: 2, class: 'mt-1 w-full rounded border-gray-300' %>
    </div>
    <% if @reviewing %>
      <%= hidden_field_tag :reviewing, '1' %>
      <%= hidden_field_tag :impact_token, @impact_token %>
      <div class="rounded border border-amber-300 bg-amber-50 p-4">
        <h2 class="font-semibold">Review old and new header values</h2>
        <dl class="mt-2 space-y-1">
          <% Equipment::Correction::PO_FIELDS.each do |field| %>
            <div>
              <dt class="inline font-medium"><%= field.delete_suffix('_id').humanize %>:</dt>
              <dd class="inline">
                <%= equipment_impact_value(field, @previous_values[field], vendors: @vendors) %> →
                <%= equipment_impact_value(field, @purchase_order.public_send(field), vendors: @vendors) %>
              </dd>
            </div>
          <% end %>
        </dl>
        <p class="mt-3">
          <%= check_box_tag :confirmed_impact, '1', false, required: true %>
          <%= label_tag :confirmed_impact, 'I confirm the impact on all linked equipment and applications.' %>
        </p>
      </div>
    <% end %>
    <% if (@items.size > 1 || @items.any?(&:shipped_at?)) && !@reviewing %>
      <%= button_tag 'Review correction', name: :review, value: '1', formnovalidate: true, class: 'rounded bg-indigo-700 px-4 py-2 text-white' %>
    <% else %>
      <%= form.submit 'Save purchase order correction', class: 'rounded bg-indigo-700 px-4 py-2 text-white' %>
      <% if @reviewing %>
        <%= button_tag 'Review changed values', name: :review, value: '1', formnovalidate: true, class: 'ml-3 text-indigo-700 underline' %>
      <% end %>
    <% end %>
  <% end %>
  <p><%= link_to 'Refresh purchase order and discard this draft',
                 edit_admin_purchase_order_correction_path(@purchase_order, return_context: @return_context), class: 'text-indigo-700 underline' %></p>
  <%= link_to 'Back to purchase order', admin_purchase_order_path(@purchase_order, return_context: @return_context), class: 'text-indigo-700 underline' %>
</div>
