<div class="max-w-4xl mx-auto card p-6 space-y-5">
  <%= render 'admin/shared/index_header', title: "Costs and documents: #{icc_cost_label(@record)}", applications_link: false %>
  <% if @financial_constituent_names.any? %>
    <p id="financial-constituents">
      <strong><%= @financial_constituent_names.one? ? 'Constituent' : 'Constituents' %>:</strong> <%= @financial_constituent_names.to_sentence %>
    </p>
  <% elsif @record.is_a?(PurchaseOrder) && @record.program_stock? %>
    <p id="financial-constituents">For program stock.</p>
  <% end %>
  <% if @record.is_a?(PurchaseOrder) %>
    <p>Enter the amounts from the invoice. Enter 0 for shipping, tax or other charges that don’t apply. Leave unknown amounts blank.</p>
  <% else %>
    <p>Enter the amount paid or billed. Leave unknown amounts blank. You can add a bill after the service report is finished.</p>
  <% end %>
  <p>Funding: <strong><%= equipment_funding_source_label(@record.funding_source, fallback: 'Not recorded yet') %></strong></p>
  <nav class="flex flex-wrap items-center gap-3" aria-label="Related records">
    <%= link_to 'Back to Filing Preparation', admin_icanconnect_filing_prep_path, class: 'btn btn-outline', data: { turbo_frame: '_top' } %>
    <% unless @record.is_a?(ApplicationServiceExpense) %>
      <%= link_to icc_source_label(@record), icc_source_path(@record), class: 'underline' %>
    <% end %>
    <% if @record.respond_to?(:application) && @record.application %>
      <%= link_to 'View application', admin_application_path(@record.application), class: 'underline' %>
    <% end %>
  </nav>
  <% if @error %>
    <p class="text-danger-700" role="alert"><%= @error %></p>
  <% end %>
  <% if @record.icc_claimed? %>
    <p id="financial-correction-help" class="border border-warning-300 bg-warning-50 p-4">
      Filed for <%= @record.icc_claim_period %> (reference <%= @record.icc_external_filing_reference %>).
      To make a change, enter a reason and a claim or support ticket reference.
    </p>
  <% end %>
  <% if !@record.icc_claimed? && @record.icc_financial_evidence_locked? %>
    <p id="financial-correction-help" class="border border-warning-300 bg-warning-50 p-4">
      <% if @correction_required %>
        This invoice is already part of a filing. Explain what changed and give the claim or support ticket reference.
      <% elsif @record.icc_receipt_evidence_locked? %>
        To change the receipt date or price, give a reason and a claim or support ticket reference.
      <% else %>
        Receipt and installation dates can be recorded normally. To change the price, explain what changed and give the claim or support ticket reference.
      <% end %>
    </p>
  <% end %>
  <%= form_with url: admin_icanconnect_financial_record_path(@key), method: :patch, multipart: true, class: 'space-y-4' do |form| %>
    <%= form.hidden_field :lock_version, value: @expected_version %>
    <% Admin::Icanconnect::FinancialRecordsController::FINANCE_FIELDS.fetch(@record.class.name).each do |field| %>
      <div>
        <%= label_tag "finance_#{field}", icc_financial_field_label(field), class: 'form-label' %>
        <% if field == :funding_source %>
          <%= select_tag 'finance[funding_source]', options_for_select(icc_service_funding_options(@record), @record.funding_source),
                         class: 'form-input', aria: { describedby: 'service-funding-help' } %>
          <p id="service-funding-help" class="text-sm text-gray-600">Choose who pays for this service. iCanConnect services appear in filing preparation.</p>
        <% elsif field == :unit_cost %>
          <%= text_field_tag 'finance[unit_cost]', @record.unit_cost_before_type_cast, inputmode: 'decimal', autocomplete: 'off', class: 'form-input' %>
        <% elsif field == :mileage_rate %>
          <%= number_field_tag 'finance[mileage_rate]', @record.mileage_rate_before_type_cast.nil? ? @suggested_mileage_rate : @record.mileage_rate_before_type_cast,
                               min: 0, step: '0.001', autocomplete: 'off', class: 'form-input', aria: { describedby: 'mileage-rate-help' } %>
          <p id="mileage-rate-help" class="text-sm text-gray-600">
            Starts with the rate for the service date, <strong><%= accessible_date_value(@record.service_source_on) %></strong>.
            This record keeps its saved rate when mileage rates change.
            Mileage cost is miles × this rate, added to the hourly service charge.
            <%= link_to 'Manage mileage rates', admin_policies_path(anchor: 'mileage-rates'), class: 'text-primary-700 underline' %>
          </p>
        <% elsif field == :category %>
          <%= select_tag 'finance[category]',
                         options_for_select(ApplicationServiceExpense::CATEGORIES.map { |category| [category.humanize, category] }, @record.category),
                         required: true, class: 'form-input' %>
        <% elsif field == :equipment_item_id %>
          <%= select_tag 'finance[equipment_item_id]',
                         options_for_select(@equipment.map { |item| ["##{item.id} — #{item.product.name}", item.id] }, @record.equipment_item_id),
                         required: true, class: 'form-input' %>
        <% elsif field == :service_date || field.to_s.end_with?('_on') %>
          <%= text_field_tag "finance[#{field}]", typed_date_input_value(@record, field), typed_date_field_options(autocomplete: 'off', class: 'form-input') %>
        <% elsif %i[vendor_name other_cost_category vendor_invoice_number].include?(field) %>
          <%= text_field_tag "finance[#{field}]", @record.public_send(field), autocomplete: 'off', class: 'form-input' %>
        <% else %>
          <%= number_field_tag "finance[#{field}]", @record.public_send(field), min: 0, step: '0.01', autocomplete: 'off', class: 'form-input' %>
        <% end %>
      </div>
    <% end %>
    <% if @record.is_a?(TrainingSession) %>
      <fieldset class="space-y-2 border p-4"><legend>Devices used in this training</legend>
        <p>Choose the applicant’s devices used during this session. Confirm they had received the devices by the training date.</p>
        <%= hidden_field_tag 'finance[equipment_item_ids][]', '' %>
        <% @training_equipment.each do |unit| %>
          <div>
            <%= check_box_tag 'finance[equipment_item_ids][]', unit.id,
                              Array(params.dig(:finance, :equipment_item_ids) || @record.equipment_item_ids).map(&:to_s).include?(unit.id.to_s),
                              id: "finance_equipment_#{unit.id}" %>
            <%= label_tag "finance_equipment_#{unit.id}", "##{unit.id} — #{unit.product.name}" %>
          </div>
        <% end %>
      </fieldset>
    <% end %>
    <% if @record.respond_to?(:financial_document) %>
      <div>
      <%= label_tag 'finance_financial_document', 'Invoice or timesheet (PDF)', class: 'form-label' %>
        <%= fields_for :finance do |finance_form| %>
      <%= render 'shared/document_upload', form: finance_form, model: @record, field: :financial_document, input_id: 'finance_financial_document',
                                           purpose: :financial_evidence, accept: 'application/pdf,.pdf', blob: @financial_blob %>
    <% end %>
        <% if @record.financial_document.attached? %>
      <%= link_to 'View saved document', document_attachment_path(@record.financial_document.attachment), class: 'underline' %>
    <% end %>
        <% @record.superseded_financial_documents.each do |document| %><br><%= link_to 'Previous invoice or timesheet', document_attachment_path(document),
                                                                                       class: 'underline' %>
    <% end %>
      </div>
    <% end %>
    <% if @record.icc_financial_evidence_locked? %>
      <% if @record.icc_claimed? %><div>
      <%= form.check_box :void_filing_marker, checked: params[:void_filing_marker] == '1' %>
      <%= form.label :void_filing_marker,
                     'Remove this filed status after correcting the external filing' %>
    </div><% end %>
      <div>
      <%= form.label :correction_reason, class: 'form-label' %>
      <%= form.text_area :correction_reason, value: params[:correction_reason], required: @correction_required,
                                             aria: { describedby: 'financial-correction-help' }, class: 'form-input' %>
    </div>
      <div>
      <%= form.label :correction_reference, 'Claim or support ticket reference', class: 'form-label' %>
      <%= form.text_field :correction_reference,
                          value: params[:correction_reference], required: @correction_required,
                          aria: { describedby: 'financial-correction-help financial-correction-reference-help' }, class: 'form-input' %>
      <p id="financial-correction-reference-help" class="form-hint">
        Enter the claim title and resubmission date, or the support ticket number for the correction.
      </p>
    </div>
    <% end %>
    <%= form.submit @correction_required ? 'Save correction' : 'Save costs and documents', class: 'btn btn-primary' %>
  <% end %>
  <%= render 'admin/equipment_items/history', events: @history, audit_records: @equipment_audit_records,
                                              title: 'Financial history', expanded: true, history_id: 'financial-history' %>
</div>
