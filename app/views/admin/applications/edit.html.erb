<%= turbo_frame_tag(turbo_frame_request_id || "application_edit_#{@application.id}") do %>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold mb-6">Edit Application for <%= @application.user.first_name %></h1>

  <%= form_with(model: [:admin, @application], local: true, class: "space-y-6", data: { turbo_frame: turbo_frame_request_id || "_top" }) do |form| %>
    <%= hidden_field_tag :modal, params[:modal] if params[:modal].present? %>
    <% if @application.errors.any? %>
      <div id="error_explanation" class="bg-danger-100 border border-danger-400 text-danger-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold"><%= pluralize(@application.errors.count, "error") %> prohibited this application from being saved:</strong>
        <ul class="mt-2 list-disc list-inside">
          <% @application.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% if @application.income_proof_required? %>
        <div>
          <%= form.label :household_size, class: "form-label" %>
          <%= form.number_field :household_size, class: "form-input mt-1" %>
        </div>

        <div>
          <%= form.label :annual_income, class: "form-label" %>
          <div class="mt-1 relative rounded-md shadow-elevation-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-gray-500 sm:text-sm">$</span>
            </div>
            <%= form.number_field :annual_income, step: "0.01", class: "form-input pl-7" %>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :application_type, class: "form-label" %>
        <%= form.select :application_type, options_for_select(application_type_options, @application.application_type), {}, class: "form-input mt-1" %>
      </div>

      <div>
        <%= form.label :submission_method, class: "form-label" %>
        <%= form.select :submission_method, options_for_select(submission_method_options, @application.submission_method), {}, class: "form-input mt-1" %>
      </div>
    </div>

    <fieldset class="p-4 border border-gray-200 rounded">
      <legend class="text-lg font-medium text-gray-900 mb-2">Certifying Professional Information</legend>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :certifying_professional_name, "Name", class: "form-label" %>
          <%= form.text_field :certifying_professional_name, class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :certifying_professional_phone, "Phone", class: "form-label" %>
          <%= form.telephone_field :certifying_professional_phone, class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :certifying_professional_fax, "Fax (Optional)", class: "form-label" %>
          <%= form.telephone_field :certifying_professional_fax, class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :certifying_professional_email, "Email", class: "form-label" %>
          <%= form.email_field :certifying_professional_email, class: "form-input mt-1" %>
        </div>
      </div>
    </fieldset>

    <fieldset class="p-4 border border-gray-200 rounded">
      <legend class="text-lg font-medium text-gray-900 mb-2">Alternate Contact (optional)</legend>
      <p class="text-sm text-gray-600 mb-4"><%= t("applications.alternate_contact.admin_help") %></p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :alternate_contact_name, "Name", class: "form-label" %>
          <%= form.text_field :alternate_contact_name, class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :alternate_contact_relationship_type, "Relationship", class: "form-label" %>
          <%= form.select :alternate_contact_relationship_type,
              options_for_select([
                ["Select a relationship", ""],
                ["Parent", "parent"],
                ["Spouse", "spouse"],
                ["Child", "child"],
                ["Sibling", "sibling"],
                ["Neighbor", "neighbor"],
                ["Friend", "friend"],
                ["Other", "other"]
              ], @application.alternate_contact_relationship_type),
              { include_blank: false },
              class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :alternate_contact_phone, "Phone", class: "form-label" %>
          <%= form.telephone_field :alternate_contact_phone, class: "form-input mt-1" %>
        </div>
        <div>
          <%= form.label :alternate_contact_email, "Email", class: "form-label" %>
          <%= form.email_field :alternate_contact_email, class: "form-input mt-1" %>
        </div>
      </div>
    </fieldset>

    <div class="flex justify-end space-x-3">
      <%= link_to "Cancel", admin_application_path(@application),
          class: "btn btn-outline" %>
      <%= form.submit "Update Application", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<% end %>
