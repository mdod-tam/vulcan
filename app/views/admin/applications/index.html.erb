<% content_for :skip_link do %>
  <%= link_to 'Skip to applications', '#main-content', class: 'skip-link' %>
<% end %>
<div class="max-w-7xl mx-auto px-4 py-6" id="main-content" tabindex="-1">
    <%= render 'admin/shared/index_header', title: 'Applications', applications_link: false, title_id: 'page-title' %>

    <%= turbo_frame_tag 'applications_list' do %>
      <nav class="mb-6 flex flex-wrap gap-6 border-b border-gray-200" aria-label="Application views">
        <% { 'review' => 'Review applications', 'pipeline' => 'Approved pipeline', 'all' => 'All applications' }.each do |view, label| %>
          <%= link_to application_list_path(view: view, status: nil, filter: nil, date_range: nil, group: nil, stage: nil, sort: nil, direction: nil),
                      class: class_names('border-b-2 px-1 py-3 text-sm font-medium',
                                         'border-primary-600 text-primary-700' => @applications_view == view,
                                         'border-transparent text-gray-600 hover:text-primary-700' => @applications_view != view),
                      aria: { current: @applications_view == view ? 'page' : nil },
                      data: { turbo_frame: 'applications_list', turbo_action: 'advance' } do %>
            <%= label %>
            <% if (count = @application_view_counts[view.to_sym]) %>
              <span>(<%= count %>)</span>
            <% end %>
          <% end %>
        <% end %>
      </nav>
      <% if @applications_view == 'review' %>
        <%= render 'review_tasks', summaries: @review_summaries %>
      <% elsif @applications_view == 'pipeline' %>
        <% pipeline_summaries = @pipeline.summaries(@pipeline_group) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
        <% pipeline_group_labels = { equipment: 'Equipment fulfillment', voucher: 'Vouchers', none: 'No equipment needed' } # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
        <%= render 'approved_pipeline_cards', summaries: pipeline_summaries, group_labels: pipeline_group_labels %>
      <% end %>
      <section aria-labelledby="applications-heading" class="card mb-6" id="application-table">
        <h2 id="applications-heading" class="sr-only"><%= @applications_view == 'pipeline' ? 'Approved pipeline' : 'Applications' %></h2>
      <div class="p-4 border-b">
        <%= form_tag admin_applications_path,
                     method: :get, class: 'grid grid-cols-1 items-end gap-4 sm:grid-cols-2 xl:grid-cols-3',
                     data: { turbo_frame: 'applications_list', turbo_action: 'advance', controller: 'autosubmit' } do %>
          <%= hidden_field_tag :view, @applications_view %>
          <%= hidden_field_tag :sort, Applications::FilterService.sort_column(params) %>
          <%= hidden_field_tag :direction, Applications::FilterService.sort_direction(params) %>
          <% %i[filter dependent_q managing_guardian_id guardian_id dependent_id only_dependent_apps].each do |key| %>
            <%= hidden_field_tag key, params[key] if params[key].present? %>
          <% end %>
          <% if @applications_view == 'pipeline' %>
            <%= hidden_field_tag :group, @pipeline_group %>
            <%= hidden_field_tag :stage, @pipeline_stage %>
          <% else %>
          <div class="min-w-0 space-y-1">
            <%= label_tag :status, 'Status:', class: 'form-label' %>
            <%= select_tag :status,
                           options_for_select(
                             application_status_filter_options(view: @applications_view),
                             params[:status]
                           ),
                           class: 'form-input w-full min-w-0',
                           data: { action: 'change->autosubmit#submit', autosubmit_clear_param: 'filter' } %>
          </div>
          <% end %>
          
          <div class="min-w-0 space-y-1">
            <%= label_tag :program_group, 'Program group:', class: 'form-label' %>
            <%= select_tag :program_group, options_for_select([['All groups', '']] + Product::PROGRAM_GROUPS.map { |key, label| [label, key] }, params[:program_group]), class: 'form-input w-full min-w-0', data: { action: 'change->autosubmit#submit' } %>
          </div>
          <div class="min-w-0 space-y-1">
            <%= label_tag :date_range, @applications_view == 'pipeline' ? 'Approved during:' : 'Created during:', class: 'form-label' %>
            <%= select_tag :date_range,
                           options_for_select(
                             application_date_range_options(view: @applications_view),
                             params[:date_range]
                           ),
                           class: 'form-input w-full min-w-0',
                           data: { action: 'change->autosubmit#submit' } %>
          </div>
          
          <div class="min-w-0 space-y-1">
            <%= label_tag :q, 'Search:', class: 'form-label' %>
            <div class="relative min-w-0 w-full rounded-md shadow-elevation-1">
              <%= text_field_tag :q, params[:q],
                                 placeholder: 'Application, name, or email...', autocomplete: 'off',
                                 data: { action: 'input->autosubmit#search' }, class: 'form-input min-w-0 w-full pr-10' %>
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>

          <div class="min-w-0 space-y-1">
            <%= label_tag :managing_guardian_q, 'Managing Guardian:', class: 'form-label' %>
            <div class="relative min-w-0 w-full rounded-md shadow-elevation-1">
              <%= text_field_tag :managing_guardian_q,
                                 params[:managing_guardian_q],
                                 placeholder: 'Guardian name or email...', autocomplete: 'off',
                                 data: { action: 'input->autosubmit#search' },
                                 class: 'form-input min-w-0 w-full pr-10' %>
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= check_box_tag :for_minors, 'true', params[:for_minors].present?,
                              class: 'h-4 w-4 text-primary-600 border-gray-300 rounded',
                              data: { action: 'change->autosubmit#submit' } %>
            <%= label_tag :for_minors, "Show only dependent applications", class: "form-label" %>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <%= submit_tag 'Apply filters', class: 'btn btn-secondary' %>
            <%= link_to 'Clear filters',
                        admin_applications_path(view: @applications_view, group: @pipeline_group, stage: @pipeline_stage,
                                                sort: params[:sort], direction: params[:direction]),
                        class: 'btn btn-outline', data: { turbo_frame: 'applications_list', turbo_action: 'advance', action: 'click->autosubmit#discardSearch' } %>
          </div>
        <% end %>
      </div>

        <%= render 'admin/shared/filter_failure' if @filter_failed %>
        <% if @applications_view == 'pipeline' %>
          <%= render 'approved_pipeline', summaries: pipeline_summaries, group_labels: pipeline_group_labels %>
        <% else %>
        <div class="relative overflow-x-auto" role="region" aria-label="Applications" tabindex="0">
          <% if @applications.present? %>
            <% queue_partial = case params[:filter]
                               when 'training_requests' then 'training_requests_table'
                               when 'evaluation_requests' then 'evaluation_requests_table'
                               else 'applications_table'
                               end %>
            <%= render partial: queue_partial,
                       locals: {
                         applications: @applications,
                         provider_info_request_summaries: @provider_info_request_summaries
                       } %>
          <% else %>
            <div class="p-6 text-center">
              <p class="text-gray-500">No applications found</p>
            </div>
          <% end %>
        </div>
        <% end %>

        <% if @pagy && @pagy.pages > 1 %>
          <div class="px-4 py-3 border-t">
            <%== pagy_nav(@pagy) %>
          </div>
        <% end %>
      </section>
    <% end %>

    <%= render 'admin/shared/recent_notifications', notifications: @recent_notifications %>

    <%= turbo_frame_tag "charts_section", src: charts_admin_applications_path, loading: "lazy" do %>
      <div class="card mb-6 p-6">
        <div class="flex items-center justify-center">
          <svg class="animate-spin h-8 w-8 text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="ml-2 text-gray-600">Loading charts...</span>
        </div>
      </div>
    <% end %>
</div>
