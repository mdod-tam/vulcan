<section class="card p-6 mb-6" aria-labelledby="evaluation-status-title">
  <div class="mb-6">
    <h2 id="evaluation-status-title" class="text-xl font-semibold text-gray-900">
      Evaluation and Training Status
    </h2>
    <p class="mt-1 text-sm text-gray-600">
      Trainers and evaluators handle scheduling, completion, and notes from their own workflow pages.
    </p>
  </div>

  <div class="mb-6 space-y-6">
    <% latest_evaluation = @application.latest_evaluation %>

    <% if @application.equipment_fulfillment? %>
      <div>
        <div class="mb-3">
          <h3 class="text-base font-semibold text-gray-900">Evaluation</h3>
          <p class="mt-1 text-sm text-gray-600">
            Equipment fulfillment starts with an evaluation. Select an evaluator so they can schedule and complete the evaluation report.
          </p>
        </div>
        <%= render "assignment_section",
          type: "evaluator",
          entity: latest_evaluation,
          assigned_person: latest_evaluation&.evaluator,
          status_badge_method: :evaluation_status_badge,
          scheduled_date: latest_evaluation&.evaluation_date,
          scheduled_time: false,
          view_path: latest_evaluation.present? ? evaluators_evaluation_path(latest_evaluation) : nil,
          assign_form_path: assign_evaluator_admin_application_path(@application),
          reassign_form_path: @application.service_window_active? ? reassign_evaluator_admin_application_path(@application) : nil,
          assign_param: :evaluator_id,
          available_assignees: User.assignable_for(:can_evaluate)
        %>
      </div>
    <% elsif @application.voucher_fulfillment? %>
      <div>
        <div class="mb-3">
          <h3 class="text-base font-semibold text-gray-900">Evaluation</h3>
          <p class="mt-1 text-sm text-gray-600">
            Voucher applications do not require an evaluation by default. Mark one as needed only when staff determine this constituent should receive evaluator support.
          </p>
        </div>

        <% if latest_evaluation.blank? && !@application.evaluation_request_pending? %>
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-4" data-testid="evaluation-request-section">
            <%= button_to 'Mark Evaluation Needed',
                request_evaluation_admin_application_path(@application),
                method: :post,
                class: "btn btn-primary h-10",
                data: { turbo_confirm: 'Voucher applications do not require evaluation by default. Mark this application as needing evaluator support?' } %>
          </div>
        <% elsif latest_evaluation.blank? && @application.evaluation_request_pending? %>
          <div class="mb-3 rounded-lg border border-info-200 bg-info-50 p-4" data-testid="evaluation-request-pending">
            <p class="text-sm text-info-800">
              Evaluation requested on <%= @application.evaluation_requested_at.strftime("%B %d, %Y") %>. Assign an evaluator below.
            </p>
          </div>
          <%= render "assignment_section",
            type: "evaluator",
            entity: nil,
            assigned_person: nil,
            status_badge_method: :evaluation_status_badge,
            scheduled_date: nil,
            scheduled_time: false,
            view_path: nil,
            assign_form_path: assign_evaluator_admin_application_path(@application),
            reassign_form_path: @application.service_window_active? ? reassign_evaluator_admin_application_path(@application) : nil,
            assign_param: :evaluator_id,
            available_assignees: User.assignable_for(:can_evaluate)
          %>
        <% else %>
          <%= render "assignment_section",
            type: "evaluator",
            entity: latest_evaluation,
            assigned_person: latest_evaluation&.evaluator,
            status_badge_method: :evaluation_status_badge,
            scheduled_date: latest_evaluation&.evaluation_date,
            scheduled_time: false,
            view_path: latest_evaluation.present? ? evaluators_evaluation_path(latest_evaluation) : nil,
            assign_form_path: assign_evaluator_admin_application_path(@application),
            reassign_form_path: @application.service_window_active? ? reassign_evaluator_admin_application_path(@application) : nil,
            assign_param: :evaluator_id,
            available_assignees: User.assignable_for(:can_evaluate)
          %>
        <% end %>
      </div>
    <% end %>

    <section aria-labelledby="admin-training-heading">
      <h3 id="admin-training-heading" class="text-base font-semibold">Training</h3>
      <p class="mt-2 text-sm text-gray-600">Coverage continues between appointments. Removing a trainer revokes coverage and cancels any open appointment; completed reports are retained.</p>
      <p class="mt-3">
        <%= @completed_training_sessions_count %> completed,
        <%= @reserved_training_sessions_count - @completed_training_sessions_count %> reserved,
        <%= @remaining_training_sessions %> remaining of <%= @max_training_sessions %>.
      </p>
      <% if @application.training_request_pending? %>
        <p class="mt-3 font-medium" data-testid="training-request-pending">Training requested by constituent</p>
      <% end %>
      <% if @application.assigned_trainer %>
        <div class="mt-3 rounded-lg border border-gray-200 p-4" data-testid="trainer-assignment-section">
          <p>Current Trainer: <strong><%= @application.assigned_trainer.full_name %></strong></p>
          <% if @application.latest_training_session %>
            <%= link_to(
                  'View Details', trainers_training_session_path(@application.latest_training_session),
                  class: 'mt-3 inline-block text-primary-700 underline', data: { turbo_frame: '_top' }
                ) %>
          <% end %>
          <%= button_to(
                'Unassign Trainer', unassign_trainer_admin_application_path(@application),
                class: 'btn btn-danger-outline mt-3',
                form: { data: { turbo_confirm: 'Remove trainer coverage and cancel any open appointment? Completed reports remain available.' } }
              ) %>
          <% unless @application.assigned_trainer.assignable_trainer? %>
            <p class="mt-3 text-sm font-medium text-danger-700" data-testid="trainer-ineligible-notice">
              <%= @application.assigned_trainer.full_name %> can no longer take training assignments. Reassign the open training to an eligible trainer.
            </p>
          <% end %>
          <% open_sessions = @application.open_training_assignments.includes(:trainer).to_a %>
          <% if open_sessions.any? && !@application.service_window_active? %>
            <p class="mt-3 text-sm text-gray-600" data-testid="training-reassignment-unavailable">
              The service window for this application has ended, so open training cannot be transferred.
            </p>
          <% elsif open_sessions.any? %>
            <% others = User.assignable_for(:can_train) %>
            <% others = others.where.not(id: @application.assigned_trainer_id) if open_sessions.all? { |session| session.trainer_id == @application.assigned_trainer_id } %>
            <%= render 'reassignment_form',
                       type: 'trainer',
                       reassign_form_path: reassign_trainer_admin_application_path(@application),
                       assigned_people: open_sessions.map(&:trainer).uniq,
                       available_assignees: others,
                       expected_version: @application.training_assignment_version(open_sessions),
                       summary: 'Transfer open training to another trainer. Schedules, locations, notes and outcomes are preserved, ' \
                                'and completed sessions stay with their trainers.',
                       confirmation: "Transfer #{open_sessions.size} open training #{'session'.pluralize(open_sessions.size)} to the trainer selected below? " \
                                     'Appointments are preserved. The new trainer and the constituent are notified.' %>
          <% end %>
        </div>
      <% elsif @remaining_training_sessions.positive? && @application.service_window_active? %>
        <%= render(
              'assignment_section',
              type: 'trainer', entity: nil, assigned_person: nil,
              status_badge_method: :training_session_status_badge, view_path: nil,
              assign_form_path: assign_trainer_admin_application_path(@application), assign_param: :trainer_id,
              available_assignees: User.assignable_for(:can_train)
            ) %>
      <% else %>
        <p class="mt-3">New training assignment is unavailable because capacity or the service window has ended.</p>
      <% end %>
    </section>
  </div>
  <% latest_completed_evaluation = @application.evaluations.completed_sessions.by_report_submission.first # rubocop:disable Lint/UselessAssignment -- Used below. %>
  <% if latest_completed_evaluation.present? %>
    <div class="mb-6 border-t border-gray-200 pt-4" data-testid="evaluation-report-summary">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Evaluation Report / Recommendations</h3>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Evaluator</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= latest_completed_evaluation.evaluator&.full_name || 'Unknown' %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Appointment Completed</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= latest_completed_evaluation.appointment_completed_at&.strftime('%B %d, %Y') || 'Date not recorded' %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Report Submitted</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= latest_completed_evaluation.report_submitted_at&.strftime('%B %d, %Y') || 'Date not recorded' %></dd>
        </div>
      </dl>
      <%= render 'shared/evaluation_recommendations', evaluation: latest_completed_evaluation %>
      <% if latest_completed_evaluation.needs.present? %>
        <div class="mb-3">
          <dt class="text-sm font-medium text-gray-500">Needs Summary</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= simple_format(latest_completed_evaluation.needs) %></dd>
        </div>
      <% end %>
      <% if latest_completed_evaluation.notes.present? %>
        <div class="mb-3">
          <dt class="text-sm font-medium text-gray-500"><%= t('evaluators.evaluations.working_notes.title') %></dt>
          <p class="text-sm text-gray-700"><strong><%= t('evaluators.evaluations.forms.internal_notes_only') %></strong></p>
          <dd class="mt-1 text-sm text-gray-900"><%= truncate(latest_completed_evaluation.notes, length: 400) %></dd>
        </div>
      <% end %>
      <%= link_to 'View Full Evaluation',
          evaluators_evaluation_path(latest_completed_evaluation),
          class: "btn btn-secondary",
          data: { turbo_frame: "_top" } %>
    </div>
  <% end %>

  <% if @training_history.any? %>
    <div>
      <h3 class="text-sm font-medium text-gray-500 mb-2">Training Sessions (<%= @training_history.size %>)</h3>
      <% if @training_history.any? %>
        <div class="space-y-4">
          <% @training_history.each do |session| %>
            <div class="bg-gray-50 p-4 rounded-md shadow-elevation-1 flex flex-col md:flex-row justify-between items-start md:items-center">
              <div class="flex items-center space-x-4">
                <p class="text-sm font-medium text-gray-900">Session #<%= session.appointment_number %> — <%= session.trainer.full_name %></p>
                <%= training_session_status_badge(session) %>
              </div>
              <div class="flex space-x-2 mt-2 md:mt-0">
                <%= link_to "View Session",
                    trainers_training_session_path(session),
                    class: "btn btn-secondary",
                    data: { turbo_frame: "_top" } %>
                <% if session.status_completed? %>
                  <span class="text-sm text-gray-600">
                    Completed on <%= session.completed_at&.strftime("%B %d, %Y") %>
                    (<%= training_duration_hours_label(session.duration_hours) %>)
                  </span>
                <% end %>
              </div>
            </div>
            <% if session.status_completed? %>
              <div class="bg-gray-100 p-4 rounded-md mt-2">
                <p class="text-sm font-medium text-gray-700 mb-1">Product Trained On:</p>
                <p class="text-sm text-gray-900"><%= session.product_trained_on&.name || "Not specified" %></p>
                <p class="text-sm font-medium text-gray-700 mt-2 mb-1">Training Duration:</p>
                <p class="text-sm text-gray-900"><%= training_duration_hours_label(session.duration_hours) %></p>
                <p class="text-sm font-medium text-gray-700 mt-2 mb-1">Private staff notes:</p>
                <p class="text-sm text-gray-900"><%= simple_format(session.internal_notes).presence || 'No private notes provided' %></p>
                <p class="mt-2 text-sm font-medium">Shared summary — <%= language_label(session.summary_locale) %></p>
                <%= simple_format(session.constituent_summary) %>
                <p class="mt-2 text-sm">Report submitted: <%= session.report_submitted_at && l(session.report_submitted_at, format: :long) %></p>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
