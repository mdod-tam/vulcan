<div class="flex flex-wrap justify-between mb-4">
  <div class="flex space-x-4 mb-2 md:mb-0">
    <%= link_to admin_applications_path(sort: 'status', direction: params[:direction] == 'asc' ? 'desc' : 'asc'),
        class: "btn btn-outline",
        aria: { label: "Sort applications by status" } do %>
      <span>Sort by Status</span>
    <% end %>

    <%= link_to admin_applications_path(sort: 'application_date', direction: params[:direction] == 'asc' ? 'desc' : 'asc'),
        class: "btn btn-outline",
        aria: { label: "Sort applications by date" } do %>
      <span>Sort by Date</span>
    <% end %>
  </div>

  <div class="flex space-x-4 mb-2 md:mb-0">
    <% if params[:filter].present? %>
      <%= link_to admin_applications_path,
          class: "btn btn-outline",
          aria: { label: "View all applications" } do %>
        <span>View All Applications</span>
      <% end %>
    <% end %>

    <%= link_to admin_applications_path(filter: "proofs_needing_review"),
        class: "btn btn-outline #{params[:filter] == 'proofs_needing_review' ? 'bg-gray-50' : ''}",
        aria: { label: "Show applications needing proof review" } do %>
      <span>Proofs Needing Review</span>
    <% end %>

    <%= link_to admin_applications_path(filter: "awaiting_disability_certification"),
        class: "btn btn-outline #{params[:filter] == 'awaiting_disability_certification' ? 'bg-gray-50' : ''}",
        aria: { label: "Show applications awaiting disability certification" } do %>
      <span>Awaiting Disability Certification</span>
    <% end %>

    <%= link_to admin_applications_path(filter: "pending_provider_info"),
        class: "btn btn-outline #{params[:filter] == 'pending_provider_info' ? 'bg-gray-50' : ''}",
        aria: { label: t('admin.applications.filters.pending_provider_info_aria') } do %>
      <span><%= t('admin.applications.filters.pending_provider_info') %></span>
    <% end %>
  </div>
</div>
