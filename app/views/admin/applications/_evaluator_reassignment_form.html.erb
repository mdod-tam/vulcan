<div class="mt-4 border-t border-gray-200 pt-4">
  <h4 class="text-sm font-semibold text-gray-900">Reassign Evaluator</h4>
  <p class="mt-1 text-sm text-gray-600">Transfer this evaluation to another evaluator. The appointment and existing notes will be preserved. The new evaluator must confirm the arrangements with the applicant.</p>
  <% if available_assignees.any? %>
    <%= form_with url: reassign_form_path, method: :post, class: 'mt-3 flex max-w-2xl flex-col gap-3 sm:flex-row sm:items-end' do %>
      <div class="w-full sm:max-w-md">
        <%= label_tag :reassign_evaluator_id, 'New evaluator', class: 'block text-sm font-medium text-gray-700' %>
        <%= select_tag :evaluator_id, options_from_collection_for_select(available_assignees, :id, :full_name),
                       id: 'reassign_evaluator_id', include_blank: 'Select an evaluator…', required: true,
                       class: 'mt-1 block h-10 w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500' %>
      </div>
      <%= submit_tag 'Reassign Evaluator',
                     class: 'inline-flex min-h-10 items-center justify-center rounded bg-indigo-600 px-4 py-2 text-white ' \
                            'focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2' %>
    <% end %>
  <% else %>
    <p class="mt-2 text-sm text-gray-600">No other active evaluators are available.</p>
  <% end %>
</div>
