<%# locals: (assigned_person:, available_assignees:, reassign_form_path:) -%>
<div class="mt-4 border-t border-gray-200 pt-4">
  <h4 class="text-sm font-semibold text-gray-900">Reassign Evaluator</h4>
  <p class="mt-1 text-sm text-gray-600">
    Transfer this evaluation to another evaluator. The appointment and existing notes will be preserved.
    The new evaluator must confirm the arrangements with the application's contact person.
  </p>
  <% if available_assignees.any? %>
    <button type="button"
            class="mt-3 inline-flex min-h-10 items-center justify-center rounded bg-indigo-600 px-4 py-2 text-white
                   focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            data-controller="modal"
            data-action="click->modal#open"
            data-modal-id="evaluator-reassign-confirm-dialog"
            aria-haspopup="dialog"
            aria-controls="evaluator-reassign-confirm-dialog">
      Reassign Evaluator
    </button>
    <noscript>
      <p class="mt-2 text-sm text-gray-600">Enable JavaScript to confirm evaluator reassignment.</p>
    </noscript>

    <dialog id="evaluator-reassign-confirm-dialog"
            class="backdrop:bg-gray-500 backdrop:bg-opacity-75 bg-white rounded-lg max-w-md w-full shadow-xl p-0"
            data-controller="modal"
            data-action="click->modal#clickOutside close->modal#onClose"
            aria-labelledby="evaluator-reassign-confirm-heading"
            aria-describedby="evaluator-reassign-confirm-description">
      <div class="p-6">
        <h3 id="evaluator-reassign-confirm-heading" class="text-lg font-medium text-gray-900">Reassign Evaluator</h3>
        <p id="evaluator-reassign-confirm-description" class="mt-3 text-sm text-gray-600">
          Transfer this evaluation to the evaluator selected below?
          <% if assigned_person.present? %>
            Current evaluator: <%= practitioner_assignment_option_label(assigned_person) %>.
          <% end %>
          The appointment and existing notes will be preserved. This transfers responsibility for scheduling and report submission.
        </p>
        <%= form_with url: reassign_form_path, method: :post, class: 'mt-4' do %>
          <%= label_tag :reassign_evaluator_id, 'New evaluator (required)', class: 'block text-sm font-medium text-gray-700' %>
          <%= select_tag :evaluator_id,
                         options_from_collection_for_select(
                           available_assignees, :id, ->(person) { practitioner_assignment_option_label(person) }
                         ),
                         id: 'reassign_evaluator_id', include_blank: 'Select an evaluator…', required: true,
                         class: 'mt-1 block h-10 w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500' %>
          <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button type="button"
                    class="inline-flex min-h-10 w-full items-center justify-center rounded-md border border-gray-300 bg-white
                           px-4 py-2 text-center text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50
                           focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
                    data-action="click->modal#close"
                    autofocus>
              Cancel
            </button>
            <%= submit_tag 'Confirm reassignment',
                           data: { turbo_submits_with: 'Reassigning...' },
                           class: 'inline-flex min-h-10 w-full items-center justify-center rounded-md bg-indigo-600 px-4 py-2 ' \
                                  'text-sm font-medium text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 ' \
                                  'focus:ring-offset-2 sm:w-auto' %>
          </div>
        <% end %>
      </div>
    </dialog>
  <% else %>
    <p class="mt-2 text-sm text-gray-600">No other active evaluators are available.</p>
  <% end %>
</div>
