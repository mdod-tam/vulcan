<!-- Certification History Modal -->
<dialog id="viewCertificationHistoryModal" class="backdrop:bg-gray-500 backdrop:bg-opacity-75 bg-white rounded-lg max-w-3xl w-full shadow-xl p-0" data-action="click->modal#clickOutside" aria-labelledby="viewCertificationHistoryModal-heading">
    <div class="p-6">
      <h3 id="viewCertificationHistoryModal-heading" class="text-lg font-medium text-gray-900 mb-4">Medical Certification Request History</h3>

      <div class="overflow-y-auto max-h-96">
        <% if @certification_delivery_notifications.any? %>
          <ul class="space-y-4">
            <% @certification_delivery_notifications.each_with_index do |request, index| %>
              <li class="bg-gray-50 p-4 rounded-md" id="notification_<%= request.id %>">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">
                      Request #<%= @certification_delivery_notifications.size - index %>
                      <% if index == 0 %>
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                          Most Recent
                        </span>
                      <% end %>
                    </p>
                    
                    <p class="text-sm text-gray-600 mt-1">
                      Requested on <%= l(request.created_at, format: :short) %>
                    </p>
                    
                    <%= format_email_status(request) %>
                    <% if request.metadata.present? && request.metadata.is_a?(Hash) %>
                      <% if request.metadata['notes'].present? %>
                        <div class="mt-2 text-sm text-gray-700">
                          <p class="font-medium">Notes:</p>
                          <p><%= request.metadata['notes'] %></p>
                        </div>
                      <% end %>
                      <% if request.metadata['provider'].present? %>
                        <div class="mt-2 text-sm text-gray-700">
                          <p class="font-medium">Provider:</p>
                          <p><%= request.metadata['provider'] %></p>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <% if request.actor.present? %>
                    <div class="text-sm text-gray-500">
                      <p>By: <%= request.actor.full_name %></p>
                    </div>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-500">No request history available.</p>
        <% end %>
      </div>
      
      <div class="mt-6">
        <button type="button" 
                data-action="click->modal#close"
                class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          Close
        </button>
      </div>
    </div>
</dialog>
