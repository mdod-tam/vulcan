<% provider_info_request_summaries = local_assigns.fetch(:provider_info_request_summaries, {}) %>

<div class="card overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200 applications-table" role="table">
    <thead class="bg-gray-50" role="rowgroup">
      <tr role="row">
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap"
            aria-sort="<%= application_sort_aria(:created_at) %>" role="columnheader">
          <%= application_sort_link('Created', :created_at) %>
        </th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" aria-sort="<%= application_sort_aria(:applicant) %>" role="columnheader">
          <%= application_sort_link('Applicant', :applicant) %>
        </th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-[12%]" role="columnheader">Managing Guardian</th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell w-[9%]" role="columnheader">Phone</th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-[15%]" role="columnheader">Email</th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" aria-sort="<%= application_sort_aria(:status) %>" role="columnheader">
          <%= application_sort_link('Status', :status) %>
        </th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-[15%]" role="columnheader">Attachments</th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap w-[11%]" role="columnheader">Certification</th>
        <th scope="col" class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" aria-sort="<%= application_sort_aria(:next_action) %>" role="columnheader">
          <%= application_sort_link('Next action', :next_action) %>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200" role="rowgroup">
      <% applications.each do |application| %>
        <tr id="application_<%= application.id %>" class="application-row h-20 <%= 'bg-blue-50' if application.for_dependent? %>" role="row">
          <td class="px-2 py-2 text-sm text-gray-900 whitespace-nowrap overflow-hidden" role="cell">
            <%= application.created_at.strftime('%m/%d/%Y') %>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <div class="truncate" title="<%= application.user&.full_name || 'Unknown Applicant' %>">
              <% if application.user.present? %>
                <%= link_to application.user.full_name,
                            admin_user_path(application.user),
                            class: "font-semibold text-primary-600 hover:text-primary-500",
                            aria: { label: "View user details" },
                            data: { turbo_frame: "_top" } %>
              <% else %>
                Unknown Applicant
              <% end %>
            </div>
            <% if (attention_attempt = @delivery_attention&.fetch(application.id, [])&.first) %>
              <%= link_to t('delivery_visibility.attention'), application_delivery_attention_path(application, attention_attempt),
                          class: 'block mt-2 text-warning-900 underline', data: { turbo_frame: '_top' } %>
            <% end %>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <% if application.managing_guardian.present? %>
              <div class="truncate" title="<%= application.managing_guardian.full_name %>">
                <span class="font-semibold"><%= application.managing_guardian.full_name %></span>
                <%# Use preloaded guardian_relationships_as_dependent to avoid N+1 queries %>
                <% if application.user.present? %>
                  <% guardian_relationship = application.user.guardian_relationships_as_dependent.find { |rel| rel.guardian_id == application.managing_guardian_id } %>
                  <% if guardian_relationship %>
                    <span class="text-gray-600 text-xs ml-1">(<%= guardian_relationship.relationship_type %>)</span>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              N/A
            <% end %>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 hidden sm:table-cell whitespace-nowrap overflow-hidden" role="cell">
            <div class="truncate">
              <% if application.user.present? %>
                <%= display_contact_phone(application.user) %>
              <% else %>
                <%= ConstituentCommunicationLabelsHelper::NO_PHONE_ON_FILE %>
              <% end %>
            </div>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <div class="truncate" title="<%= application.user.present? ? display_contact_email(application.user) : ConstituentCommunicationLabelsHelper::NO_EMAIL_ON_FILE %>">
              <% if application.user.present? %>
                <%= display_contact_email(application.user) %>
              <% else %>
                <%= ConstituentCommunicationLabelsHelper::NO_EMAIL_ON_FILE %>
              <% end %>
            </div>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <%= application_status_badge(application) %>
            <span class="block mt-1 text-xs text-gray-600"><%= application_status_age(application) %></span>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <% 
              # The rows are storage decorators, which answer from the controller's preloaded attachment names.
              income_attached = application.income_proof_attached?
              residency_attached = application.residency_proof_attached?
              id_attached = application.id_proof_attached?

              proof_status_rows = []
              if application.income_proof_required?
                proof_status_rows << ['income', 'Income', application.income_proof_status]
              end
              proof_status_rows << ['residency', 'Residency', application.residency_proof_status]
              proof_status_rows << ['id', 'ID', application.id_proof_status]

              proofs_attached = (application.income_proof_required? && income_attached) || residency_attached || id_attached
            %>
            
            <% if proofs_attached %>
              <div class="flex flex-col space-y-1">
                <% proof_status_rows.each do |proof_type, label, status| %>
                  <div class="flex items-center space-x-2">
                    <span class="text-sm text-gray-600"><%= label %>:</span>
                    <%= proof_status_badge(proof_type, status) %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <span class="text-sm text-gray-500">No Proofs</span>
            <% end %>
          </td>
          <td class="px-2 py-2 text-sm text-gray-900 overflow-hidden" role="cell">
            <%= disability_certification_status_badge(application) %>
            <% if (provider_info_summary = provider_info_request_summaries&.[](application.id)) %>
              <div class="mt-2 rounded-md border border-warning-200 bg-warning-50 px-2 py-1 text-xs text-warning-900"
                   aria-label="<%= secure_request_summary_accessible_label(provider_info_summary) %>">
                <div class="font-medium"><%= t('admin.applications.secure_request_forms.summary.label') %></div>
                <% if (sent_text = secure_request_summary_sent_text(provider_info_summary)) %>
                  <div class="text-warning-800"><%= sent_text %></div>
                <% end %>
                <% if (expiration_text = secure_request_summary_expiration_text(provider_info_summary)) %>
                  <div class="text-warning-800"><%= expiration_text %></div>
                <% end %>
              </div>
            <% end %>
          </td>
          <td class="px-2 py-2 text-sm font-medium overflow-hidden">
            <%= link_to application.next_action,
                        application_next_action_path(application),
                        class: 'text-primary-600 hover:text-primary-900 underline',
                        aria: { label: "#{application.next_action} for #{application.user&.full_name || 'Unknown User'}" },
                        data: { turbo_frame: '_top' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
