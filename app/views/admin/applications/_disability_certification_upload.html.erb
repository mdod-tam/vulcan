<%# Certifications can arrive unexpectedly (mail, fax, email) without a formal request, so the form
    stays available until one awaits review or is approved. %>
<% if @application.staff_certification_upload_allowed? %>
  <div class="mb-4 p-4 bg-info-50 border-l-4 border-info-500 rounded-md"
       id="disability-certification-upload-form"
       data-testid="disability-certification-upload-form">
    <h3 class="text-sm font-medium text-info-700 mb-2">Upload Disability Certification</h3>
    <p class="text-sm text-info-600 mb-2">
      Use this form to attach a disability certification received for this application.
    </p>
    
    <%= form_with url: upload_disability_certification_admin_application_path(@application), 
                  method: :patch, 
                  local: true, 
                  class: "mt-3",
                  multipart: true,
                  data: { controller: 'document-proof-handler' } do |f| %>
      <% proof_review_request_params(@application, :disability_certification, :rejected).each do |key, value| %>
        <%= f.hidden_field key, value: value %>
      <% end %>
      <%= f.hidden_field :proof_type, value: 'disability_certification' %>

      <p id="certification_review_guidance" class="mb-4 rounded-md bg-gray-50 p-3 text-sm leading-6 text-gray-700 break-words">
        <%= proof_review_guidance(@application, :disability_certification) %>
      </p>

      <div class="flex items-center space-x-4 mb-4">
        <div>
          <%= f.radio_button "disability_certification_status", "approved",
              checked: true,
              class: "h-4 w-4 text-primary-600 border-gray-300",
              'aria-describedby': 'certification_status_help certification_review_guidance',
              id: "accept_disability_certification",
              data: { document_proof_handler_target: 'acceptRadio', action: 'change->document-proof-handler#toggleProofAction' } %>
          <%= f.label "accept_disability_certification", "Approve Certification and Upload",
              class: "ml-2 text-sm text-gray-700" %>
        </div>
        <div>
          <%= f.radio_button "disability_certification_status", "rejected",
              class: "h-4 w-4 text-primary-600 border-gray-300",
              'aria-describedby': 'certification_status_help certification_review_guidance',
              id: "reject_disability_certification",
              data: { document_proof_handler_target: 'rejectRadio', action: 'change->document-proof-handler#toggleProofAction' } %>
          <%= f.label "reject_disability_certification", "Reject Certification",
              class: "ml-2 text-sm text-gray-700" %>
        </div>
      </div>
      <p id="certification_status_help" class="sr-only">
        Choose whether to approve this disability certification and upload a document, or reject it and provide a reason
      </p>
      
      <div id="disability_certification_upload" class="mt-4" data-document-proof-handler-target="uploadSection">
        <div class="mb-4">
          <%= f.label "submission_method", "Submission Method",
              class: "form-label" %>
          <p id="submission_method_hint" class="text-xs text-gray-700 mb-2">
            Select how this certification was received
          </p>
          <%= f.select "submission_method",
              options_for_select([
                ["Fax", "fax"],
                ["Email", "email"],
                ["Portal", "portal"],
                ["Mail", "mail"],
                ["Other", "other"]
              ], "fax"),
              {},
              { class: "form-input mt-1 pr-10",
                "aria-describedby": "submission_method_hint" } %>
        </div>
        
        
        <div>
          <%= f.label "disability_certification", "Certification Document",
              class: "form-label" %>
          <p id="certification_hint" class="text-xs text-gray-700 mb-2">
            Upload the disability certification document. Accepted formats: <%= proof_upload_formats_label %>, <%= ProofUploadFormats.max_megabytes(:certification) %> MB or smaller.
          </p>
          
          <%= render 'shared/document_upload',
                     form: f, field: 'disability_certification', model: @application, described_by: 'certification_hint',
                     input_data: { document_proof_handler_target: 'fileInput' } %>

          <p id="certification_keyboard_hint" class="mt-1 text-xs text-gray-700">
            <span class="sr-only">Keyboard users:</span> Press Space or Enter to open the file browser
          </p>
        </div>
      </div>
      
      <div id="disability_certification_rejection" class="mt-4 hidden" data-document-proof-handler-target="rejectionSection">
        <div class="space-y-4">
          <div>
            <%= f.label "rejection_reason_code", "Rejection Reason",
                class: "form-label" %>
            <p id="certification_rejection_hint" class="text-xs text-gray-700 mb-2">
              Select the reason why this disability certification cannot be accepted
            </p>
            <select name="rejection_reason_code"
                    id="rejection_reason_code_select"
                    class="form-input mt-1 pr-10"
                    aria-describedby="certification_rejection_hint"
                    data-action="change->document-proof-handler#handleReasonSelectionChanged"
                    data-document-proof-handler-target="rejectionReasonSelect">
              <option value="">Select a reason</option>
              <% RejectionReason.options_for(locale: 'en', proof_type: 'disability_certification').each do |reason| %>
                <option value="<%= reason.code %>" data-reason-text="<%= reason.body_for(@application) %>"><%= RejectionReason.label_for(reason.code) %></option>
              <% end %>
              <option value="other">Other (custom reason)</option>
            </select>

            <div id="cert-rejection-reason-preview"
                 role="status" aria-live="polite" data-document-proof-handler-target="reasonPreview"
                 class="hidden mt-2 p-3 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-700 whitespace-pre-wrap">
            </div>

            <div id="cert-custom-reason-area" class="hidden mt-2" data-document-proof-handler-target="customReasonSection">
              <label for="disability_certification_rejection_reason" class="form-label">Custom Rejection Reason</label>
              <textarea name="disability_certification_rejection_reason"
                        id="disability_certification_rejection_reason"
                        rows="3"
                        disabled
                        data-document-proof-handler-target="customReasonField"
                        class="form-input mt-1"
                        placeholder="Enter the rejection reason that will be sent to the certifying professional..."></textarea>
            </div>
          </div>

        </div>
      </div>
      
      <div class="mt-4">
        <%= f.submit "Process Certification", 
                    class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>
