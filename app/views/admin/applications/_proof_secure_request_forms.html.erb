<%# locals: (proof_type:, secure_request_forms:) -%>

<% if @application.proof_requestable_via_secure_form?(proof_type) && secure_request_forms.any?(&:recipient_channel_letter?) %>
  <%= form_with url: admin_application_mailed_proof_path(@application), method: :post, multipart: true,
                class: 'mt-4 space-y-2', data: { turbo: false } do |form| %>
    <%= hidden_field_tag :proof_type, proof_type, id: nil %>
    <%= form.label "#{proof_type}_proof", "Upload mailed #{proof_secure_request_forms_label(proof_type)}",
                   for: "mailed-#{proof_type}-document", class: 'block text-sm font-semibold' %>
    <p id="mailed-<%= proof_type %>-formats" class="text-sm text-gray-700">
      <%= proof_upload_formats_label %>, up to <%= proof_upload_max_size_label %>.
    </p>
    <%= render 'shared/document_upload',
               form: form, field: "#{proof_type}_proof", model: @application,
               input_id: "mailed-#{proof_type}-document", described_by: "mailed-#{proof_type}-formats" %>
    <%= form.submit 'Upload for review', class: 'btn btn-secondary' %>
  <% end %>
<% end %>

<% if secure_request_forms.present? %>

  <div class="mt-4" data-testid="<%= proof_type %>-proof-secure-request-forms-panel">
    <h3 class="text-sm font-medium text-gray-700 mb-2">
      <%= t('admin.applications.proof_secure_request_forms.panel.title', proof_type: proof_secure_request_forms_label(proof_type)) %>
    </h3>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead>
          <tr>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.recipient') %>
            </th>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.contact') %>
            </th>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.channel') %>
            </th>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.status') %>
            </th>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('delivery_visibility.requested_on', time: '').strip %>
            </th>
            <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.expires') %>
            </th>
            <th scope="col" class="px-3 py-2 text-right font-semibold text-gray-900">
              <%= t('admin.applications.secure_request_forms.table.actions') %>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% secure_request_forms.each do |form| %>
            <tr id="<%= dom_id(form) %>">
              <td class="px-3 py-3 text-gray-700">
                <%= link_to secure_request_issued_recipient_label(form), admin_user_path(form.recipient),
                            class: 'text-primary-700 underline', data: { turbo_frame: '_top' } %>
                <% if (owner_text = secure_request_original_delivery_owner_text(form)) %>
                  <span class="block text-xs font-normal text-gray-600"><%= owner_text %></span>
                <% end %>
              </td>
              <td class="px-3 py-3 text-gray-700"><%= secure_request_masked_contact(form) %></td>
              <td class="px-3 py-3 text-gray-700"><%= secure_request_channel_label(form) %></td>
              <td class="px-3 py-3 text-gray-700"><%= secure_request_row_status(form) %></td>
              <td class="px-3 py-3 text-gray-700"><%= l(form.sent_at, format: :short) %></td>
              <td class="px-3 py-3 text-gray-700"><%= form.recipient_channel_letter? ? 'No link' : l(form.expires_at, format: :short) %></td>
              <td class="px-3 py-3 text-right">
                <% if (letter = form.print_queue_items.max_by(&:id)) %>
                  <%= link_to "Review letter ##{letter.id}", admin_print_queue_path(letter),
                              class: 'text-primary-700 underline', data: { turbo_frame: '_top' } %>
                <% end %>
                <% if form.operator_revocable? %>
                  <%= secure_request_close_button(@application, form,
                                                  recipient: secure_request_issued_recipient_label(form), proof_type: proof_secure_request_forms_label(proof_type)) %>
                <% elsif !letter %>
                  <span class="text-gray-500">
                    <%= t('admin.applications.proof_secure_request_forms.table.no_actions') %>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
