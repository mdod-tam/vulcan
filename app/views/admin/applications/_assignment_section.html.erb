<%# Shared partial for Evaluator and Trainer assignment sections
    Parameters:
    - type: 'evaluator' or 'trainer'
    - entity: the evaluation or training_session object
    - assigned_person: the evaluator or trainer person
    - assign_form_path: URL for the assignment POST (single endpoint; the practitioner id is sent as a form field)
    - assign_param: :trainer_id or :evaluator_id (the param name the controller expects)
    - view_path: path for viewing details
    - unassign_form_path: optional path for removing the current assignment
    - available_assignees: collection of available people to assign
    - status_badge_method: method to render badge (evaluation_status_badge or training_session_status_badge)
    - assignment_heading: optional heading for unassigned assignment form
    - assignment_submit_label: optional submit label for unassigned assignment form
    - assignment_select_label: optional accessible label for unassigned assignment select
%>

<div class="rounded-lg border border-gray-200 bg-gray-50 p-4" data-testid="<%= type %>-assignment-section">
  <% if entity.present? %>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Current <%= type.titleize %></h3>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <% if assigned_person.present? %>
            <span class="text-sm text-gray-900"><%= assigned_person.full_name %></span>
          <% else %>
            <span class="text-sm text-gray-500">No <%= type.titleize %> Assigned</span>
          <% end %>
          <%= send(status_badge_method, entity) %>
        </div>
        <% if assigned_person.present? && !assigned_person.public_send("assignable_#{type}?") %>
          <p class="mt-2 text-sm font-medium text-danger-700" data-testid="<%= type %>-ineligible-notice">
            <%= assigned_person.full_name %> can no longer take <%= type %> assignments. Reassign this work to an eligible <%= type %>.
          </p>
        <% end %>
        <% if local_assigns[:scheduled_date].present? %>
          <p class="text-sm text-gray-500 mt-1">
            Scheduled for: <%= scheduled_date.strftime("%B %d, %Y" + (scheduled_time ? " at %I:%M %p" : "")) %>
          </p>
        <% end %>
      </div>
      <% if view_path.present? && (!entity.respond_to?(:status_completed?) || !entity.status_completed?) %>
        <div class="flex flex-col gap-2 sm:flex-row">
          <%= link_to("View Details",
              view_path,
              class: "btn btn-secondary h-10",
              data: { turbo_frame: "_top" }) %>
          <% if local_assigns[:unassign_form_path].present? %>
            <% unassign_dialog_id = "#{type}-unassign-confirm-dialog" %>
            <button type="button"
                    class="btn btn-danger-outline h-10"
                    data-controller="modal"
                    data-action="click->modal#open"
                    data-modal-id="<%= unassign_dialog_id %>"
                    aria-label="Unassign <%= assigned_person&.full_name || type.titleize %>">
              Unassign <%= type.titleize %>
            </button>

            <dialog id="<%= unassign_dialog_id %>"
                    class="backdrop:bg-gray-500 backdrop:bg-opacity-75 bg-white rounded-lg max-w-md w-full shadow-elevation-4 p-0"
                    data-controller="modal"
                    data-action="click->modal#clickOutside close->modal#onClose"
                    aria-labelledby="<%= unassign_dialog_id %>-heading"
                    aria-describedby="<%= unassign_dialog_id %>-description">
              <div class="p-6">
                <h3 id="<%= unassign_dialog_id %>-heading" class="text-lg font-medium text-gray-900">
                  <%= local_assigns[:unassign_confirm_title].presence || "Unassign #{type.titleize}" %>
                </h3>
                <p id="<%= unassign_dialog_id %>-description" class="mt-3 text-sm text-gray-600">
                  <%= local_assigns[:unassign_confirm_message].presence || "Remove this #{type} assignment?" %>
                </p>
                <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                  <button type="button"
                          class="btn btn-outline min-h-10 w-full text-center sm:w-auto"
                          data-action="click->modal#close">
                    <%= local_assigns[:unassign_confirm_no_label].presence || "No" %>
                  </button>
                  <%= button_to local_assigns[:unassign_confirm_yes_label].presence || "Yes",
                      unassign_form_path,
                      method: :post,
                      form_class: "w-full sm:w-auto",
                      class: "btn btn-danger min-h-10 w-full text-center sm:w-auto" %>
                </div>
              </div>
            </dialog>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if local_assigns[:reassign_form_path].present? && !entity.status_completed? %>
      <%= render 'reassignment_form',
                 type: type,
                 reassign_form_path: reassign_form_path,
                 assigned_people: [assigned_person].compact,
                 available_assignees: available_assignees.where.not(id: assigned_person&.id),
                 summary: "Transfer this evaluation to another evaluator. The appointment and existing notes will be preserved. " \
                          "The new evaluator must confirm the arrangements with the application's contact person.",
                 confirmation: "Transfer this evaluation to the evaluator selected below? The appointment and existing notes will be preserved. " \
                               "This transfers responsibility for scheduling and report submission." %>
    <% end %>
  <% else %>
    <h3 class="text-sm font-semibold text-gray-900 mb-3"><%= local_assigns[:assignment_heading].presence || "Assign #{type.titleize}" %></h3>
    <% if available_assignees.blank? %>
      <p class="text-sm text-gray-500">No <%= type.pluralize %> are currently available for assignment.</p>
    <% else %>
      <%= form_with url: assign_form_path, method: :post, local: true, data: { testid: "#{type}-assignment-form" }, class: "flex max-w-2xl flex-col gap-3 sm:flex-row sm:items-end" do |f| %>
        <div class="w-full sm:max-w-md">
          <%= label_tag assign_param, local_assigns[:assignment_select_label].presence || "Select #{type.titleize.downcase}", class: "sr-only" %>
          <%= select_tag assign_param,
                         options_from_collection_for_select(available_assignees, :id, ->(person) { practitioner_assignment_option_label(person) }),
                         include_blank: "Select a #{type}…",
                         class: 'form-input h-10 text-sm',
                         required: true %>
        </div>
        <%= submit_tag local_assigns[:assignment_submit_label].presence || "Assign #{type.titleize}",
            class: "btn btn-primary h-10" %>
      <% end %>
    <% end %>
  <% end %>
</div>
