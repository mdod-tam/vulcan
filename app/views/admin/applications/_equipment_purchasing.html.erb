<%# locals: (application:) -%>
<section id="equipment" class="bg-white rounded-lg shadow p-6 mb-6" aria-labelledby="equipment-title">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <div class="flex flex-wrap items-center gap-3">
      <h2 id="equipment-title" class="text-xl font-semibold text-gray-900">Equipment</h2>
      <%= admin_fulfillment_badge(application) %>
    </div>
    <%= link_to 'Back to Equipment', equipment_return_path(equipment_return_context(params[:return_context])), class: 'text-sm text-indigo-600 underline',
                                                                                                               data: { turbo_frame: '_top' } %>
  </div>
  <%= render 'equipment_recommendations', application: application %>
  <h3 class="text-lg font-semibold text-gray-900 mb-2">New devices still needed</h3>
  <% if application.equipment_needs_initialized_at %>
    <% if application.equipment_needs.any? { |need| need.remaining_quantity.positive? } %>
      <ul class="mb-4 space-y-1 text-sm text-gray-700">
        <% application.equipment_needs.each do |need| %>
          <% if need.remaining_quantity.positive? %>
            <li><%= equipment_catalog_label(need.product) %> · <%= pluralize(need.remaining_quantity, 'device') %></li>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-600 mb-4">No new devices are currently needed.</p>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-600 mb-4">
      <% if application.equipment_legacy_unmapped? %>
        Earlier fulfillment needs explicit mapping before this application is ordered again.
      <% else %>
        Purchasing needs have not been initialized.
      <% end %>
    </p>
  <% end %>
  <% if application.equipment_procurement_eligible? %>
    <%= link_to 'Edit equipment needs', edit_admin_application_equipment_needs_path(application, return_context: equipment_return_context(params[:return_context])),
                class: 'text-sm text-indigo-600 underline', data: { turbo_frame: '_top' } %>
  <% end %>
  <%= render 'equipment_items', application: application %>
  <% if application.equipment_bids_sent_at || application.equipment_po_sent_at || application.equipment_tracking_number.present? %>
    <section class="mt-6 border-t border-gray-200 pt-4" aria-labelledby="earlier-fulfillment-title">
      <h3 id="earlier-fulfillment-title" class="text-lg font-semibold text-gray-900 mb-2">Earlier fulfillment details</h3>
      <p class="text-sm text-gray-600 mb-2">These historical application-wide facts do not identify individual devices or purchase orders.</p>
      <dl class="text-sm space-y-2">
        <% if application.equipment_bids_sent_at %>
          <div><dt class="font-medium">Date bids sent</dt><dd><%= l(application.equipment_bids_sent_at.to_date, format: :long) %></dd></div>
        <% end %>
        <% if application.equipment_po_sent_at %>
          <div><dt class="font-medium">Date PO sent</dt><dd><%= l(application.equipment_po_sent_at.to_date, format: :long) %></dd></div>
        <% end %>
        <% if application.equipment_tracking_number.present? %>
          <div><dt class="font-medium">Tracking number</dt><dd><%= application.equipment_tracking_number %></dd></div>
        <% end %>
      </dl>
    </section>
  <% end %>
</section>
