<%# Certifications can arrive unexpectedly (mail, fax, email) without a formal request, so the form
    stays available until one awaits review or is approved. %>
<% if @application.staff_certification_upload_allowed? %>
  <div class="mb-4 p-4 bg-info-50 border-l-4 border-info-500 rounded-md"
       id="medical-certification-upload-form"
       data-testid="medical-certification-upload-form">
    <h3 class="text-sm font-medium text-info-700 mb-2">Upload Disability Certification</h3>
    <p class="text-sm text-info-600 mb-2">
      Use this form to attach a medical certification received for this application.
    </p>
    
    <%= form_with url: upload_medical_certification_admin_application_path(@application), 
                  method: :patch, 
                  local: true, 
                  class: "mt-3",
                  multipart: true,
                  data: { controller: 'document-proof-handler' } do |f| %>
    
      <div class="flex items-center space-x-4 mb-4">
        <div>
          <%= f.radio_button "medical_certification_status", "approved",
              checked: true,
              class: "h-4 w-4 text-primary-600 border-gray-300",
              "aria-describedby": "certification_status_help",
              id: "accept_medical_certification",
              data: { document_proof_handler_target: 'acceptRadio', action: 'change->document-proof-handler#toggleProofAction' } %>
          <%= f.label "accept_medical_certification", "Approve Certification and Upload",
              class: "ml-2 text-sm text-gray-700" %>
        </div>
        <div>
          <%= f.radio_button "medical_certification_status", "rejected",
              class: "h-4 w-4 text-primary-600 border-gray-300",
              "aria-describedby": "certification_status_help",
              id: "reject_medical_certification",
              data: { document_proof_handler_target: 'rejectRadio', action: 'change->document-proof-handler#toggleProofAction' } %>
          <%= f.label "reject_medical_certification", "Reject Certification",
              class: "ml-2 text-sm text-gray-700" %>
        </div>
      </div>
      <p id="certification_status_help" class="sr-only">
        Choose whether to approve this medical certification and upload a document, or reject it and provide a reason
      </p>
      
      <div id="medical_certification_upload" class="mt-4" data-document-proof-handler-target="uploadSection">
        <div class="mb-4">
          <%= f.label "submission_method", "Submission Method",
              class: "form-label" %>
          <p id="submission_method_hint" class="text-xs text-gray-700 mb-2">
            Select how this certification was received
          </p>
          <%= f.select "submission_method",
              options_for_select([
                ["Fax", "fax"],
                ["Email", "email"],
                ["Portal", "portal"],
                ["Mail", "mail"],
                ["Other", "other"]
              ], "fax"),
              {},
              { class: "form-input mt-1 pr-10",
                "aria-describedby": "submission_method_hint" } %>
        </div>
        
        
        <div>
          <%= f.label "medical_certification", "Certification Document",
              class: "form-label" %>
          <p id="certification_hint" class="text-xs text-gray-700 mb-2">
            Upload the medical certification document. Accepted formats: <%= proof_upload_formats_label %>, <%= ProofUploadFormats.max_megabytes(:certification) %> MB or smaller.
          </p>
          
          <%= render 'shared/document_upload',
                     form: f, field: 'medical_certification', model: @application, described_by: 'certification_hint',
                     input_data: { document_proof_handler_target: 'fileInput' } %>

          <p id="certification_keyboard_hint" class="mt-1 text-xs text-gray-700">
            <span class="sr-only">Keyboard users:</span> Press Space or Enter to open the file browser
          </p>
        </div>
      </div>
      
      <%
        address_1 = @application.user&.physical_address_1.to_s
        address_2 = @application.user&.physical_address_2.presence || ''
        cert_city = @application.user&.city.to_s
        cert_state = @application.user&.state.to_s
        cert_zip = @application.user&.zip_code.to_s
        cert_full_address = "#{address_1} #{address_2} #{cert_city}, #{cert_state} #{cert_zip}".squish
        cert_interpolations = { address: cert_full_address }

        cert_reason_codes = %w[missing_signature missing_functional_limitations incomplete_disability_documentation missing_provider_credentials outdated_certification incorrect_form_used]
        cert_reason_texts = cert_reason_codes.index_with do |code|
          rejection_reason_body(proof_type: 'medical_certification', code: code, locale: 'en', interpolations: cert_interpolations)
        end
      %>
      <div id="medical_certification_rejection" class="mt-4 hidden" data-document-proof-handler-target="rejectionSection">
        <div class="space-y-4">
          <div>
            <%= f.label "rejection_reason_code", "Rejection Reason",
                class: "form-label" %>
            <p id="certification_rejection_hint" class="text-xs text-gray-700 mb-2">
              Select the reason why this medical certification cannot be accepted
            </p>
            <select name="rejection_reason_code"
                    id="rejection_reason_code_select"
                    class="form-input mt-1 pr-10"
                    aria-describedby="certification_rejection_hint"
                    data-action="change->document-proof-handler#handleReasonSelectionChanged"
                    data-document-proof-handler-target="rejectionReasonSelect">
              <option value="">Select a reason</option>
              <% cert_reason_codes.each do |code| %>
                <option value="<%= code %>" data-reason-text="<%= cert_reason_texts[code] %>"><%= RejectionReason.label_for(code) %></option>
              <% end %>
              <option value="other">Other (custom reason)</option>
            </select>

            <div id="cert-rejection-reason-preview"
                 role="status" aria-live="polite" data-document-proof-handler-target="reasonPreview"
                 class="hidden mt-2 p-3 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-700 whitespace-pre-wrap">
            </div>

            <div id="cert-custom-reason-area" class="hidden mt-2" data-document-proof-handler-target="customReasonSection">
              <label for="medical_certification_rejection_reason" class="form-label">Custom Rejection Reason</label>
              <textarea name="medical_certification_rejection_reason"
                        id="medical_certification_rejection_reason"
                        rows="3"
                        disabled
                        data-document-proof-handler-target="customReasonField"
                        class="form-input mt-1"
                        placeholder="Enter the rejection reason that will be sent to the certifying professional..."></textarea>
            </div>
          </div>

        </div>
      </div>
      
      <div class="mt-4">
        <%= f.submit "Process Certification", 
                    class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mb-4">
  <div class="flex justify-between items-center">
    <h3 class="text-sm font-medium text-gray-700 mb-2">
      <%= medical_certification_label(@application) %> History
    </h3>
  </div>
  
  <% if @application.medical_certification.attached? %>
    <% if @application.medical_certification_status == "approved" %>
      <div class="mt-4">
        <%= medical_certification_link(@application, :button) %>
      </div>
    <% else %>
      <%= medical_certification_link(@application, :link) %>
    <% end %>
  <% end %>
  
  <div class="mt-4 pl-4 border-l-2 border-gray-200">
    <% 
      status_changes = ApplicationStatusChange.where(application_id: @application.id)
                        .where("metadata->>'change_type' = ? OR metadata->>'submission_method' IS NOT NULL", 'medical_certification')
                        .order(created_at: :desc)
    %>
    
    <% if status_changes.any? %>
      <% status_changes.each do |change| %>
        <div class="history-item mb-2">
          <p class="text-sm text-gray-600 mb-1">
            <% case change.to_status %>
            <% when 'approved' %>
              <span class="text-success-600">✓</span> Approved on 
            <% when 'rejected' %>
              <span class="text-danger-600">×</span> Rejected on 
            <% when 'received', 'requested' %>
              <span class="text-info-600">→</span> <%= change.to_status.titleize %> on
            <% end %>
            <%= change.created_at&.strftime("%B %d, %Y at %I:%M %p") %>
            <% if change.user.present? %>
              by <%= change.user&.full_name || "Unknown Admin" %>
            <% end %>
            
            <% if change.metadata.present? && change.metadata['submission_method'].present? %>
              <span class="text-xs text-gray-500">(via <%= change.metadata['submission_method'] %>)</span>
            <% end %>
          </p>
          
          <% if change.to_status == 'rejected' && change.notes.present? %>
            <p class="text-sm text-gray-600 ml-4 mb-1">
              <span class="text-gray-500">Reason:</span> "<%= sanitize change.notes %>"
            </p>
          <% elsif change.notes.present? %>
            <p class="text-sm text-gray-600 ml-4 mb-1">
              <span class="text-gray-500">Note:</span> "<%= sanitize change.notes %>"
            </p>
          <% end %>
        </div>
      <% end %>
    <% elsif @application.medical_certification.attached? %>
      <div class="history-item mb-2">
        <p class="text-sm text-gray-600 mb-1">
          <span class="text-info-600">→</span> Submitted on 
          <%= @application.medical_certification.created_at.strftime("%B %d, %Y at %I:%M %p") %>
          <span class="text-xs text-gray-500">(via <%= medical_certification_submission_method(@application) %>)</span>
        </p>
      </div>
  <% end %>
</div>
</div>
