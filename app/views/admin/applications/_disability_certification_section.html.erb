<%# Rendered inside #disability-certification-section, whose contents Turbo Stream updates replace. %>
<% preload_document_scans([@application.disability_certification, *@application.additional_disability_certifications.attachments]) %>
<div class="flex justify-between items-start">
  <div class="flex items-center gap-3">
    <h2 id="certification-title" class="text-xl font-semibold text-gray-900">Disability Certification</h2>
    <% if @application.disability_certification_status == 'not_requested' %>
      <span class="badge badge-neutral">
        Not Requested
      </span>
    <% end %>
  </div>
  <div class="flex items-center space-x-2">
    <%= disability_certification_status_badge(@application) %>
    <%= document_signing_status_badge(@application) %>
  </div>
</div>

<% if @application.dcf_auto_request_not_sent? %>
  <p role="status" class="mt-4 rounded bg-warning-50 p-4 text-warning-900">Auto-send not sent — request manually. Check the provider email and communication settings before sending the request below.</p>
<% end %>

<div class="mt-6 space-y-4">
  <%= render 'disability_certification_upload' %>

  <% if @application.disability_certification.attached? %>
    <div class="mb-4" data-testid="disability-certification">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Disability Certification</h3>
      <div class="pl-4 border-l-2 border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-900">
              <%= @application.disability_certification.blob.filename %>
            </p>
            <p class="text-xs text-gray-500">
              <%= number_to_human_size(@application.disability_certification.blob.byte_size) %>
            </p>
            <%= render 'shared/document_scan_status', document: @application.disability_certification %>
          </div>
          <a href="<%= document_download_path(@application.disability_certification, disposition: 'attachment') %>"
             class="btn btn-primary btn-sm"
             download>
            Download
          </a>
        </div>
      </div>
    </div>
  <% end %>

  <% if @application.additional_disability_certifications.attached? %>
    <div class="mb-4" data-testid="additional-disability-certifications">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Additional Certification Submissions</h3>
      <div class="space-y-2 pl-4 border-l-2 border-gray-200">
        <% @application.additional_disability_certifications.each do |certification| %>
          <div class="flex items-center justify-between">
            <div class="min-w-0">
              <p class="text-sm font-medium text-gray-900 break-all">
                <%= certification.blob.filename %>
              </p>
              <p class="text-xs text-gray-500">
                <%= additional_disability_certification_source_label(certification) %> · <%= number_to_human_size(certification.blob.byte_size) %>
              </p>
              <%= render 'shared/document_scan_status', document: certification %>
            </div>
            <a href="<%= document_download_path(certification, disposition: 'attachment') %>"
               class="btn btn-primary btn-sm ml-3 shrink-0"
               download>
              Download
            </a>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @application.medical_provider_info_present? %>
    <div class="mb-4" data-testid="provider-information">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Provider Information</h3>
      <div class="pl-4 border-l-2 border-gray-200">
        <% if @application.medical_provider_name.present? %>
          <p class="text-sm font-medium text-gray-900"><%= @application.medical_provider_name %></p>
        <% end %>
        <% if @application.medical_provider_phone.present? || (@application.respond_to?(:medical_provider_fax) && @application.medical_provider_fax.present?) %>
          <p class="text-sm text-gray-600">
            <% if @application.medical_provider_phone.present? %>
              Phone: <%= @application.medical_provider_phone %>
            <% end %>
            <% if @application.respond_to?(:medical_provider_fax) && @application.medical_provider_fax.present? %>
              <% if @application.medical_provider_phone.present? %> / <% end %>
              Fax: <%= @application.medical_provider_fax %>
            <% end %>
          </p>
        <% end %>
        <% if @application.medical_provider_email.present? %>
          <p class="text-sm text-gray-600">Email: <%= @application.medical_provider_email %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render 'medical_provider_secure_request_forms_panel' %>

  <div class="mt-6">
    <%# RuboCop checks each ERB fragment separately; the local is read below. %>
    <% certification_action_state = disability_certification_action_state(@application, secure_request_forms: @certification_upload_forms) %> <%# erb_lint:disable Rubocop %>

    <% if show_disability_certification_request_buttons?(@application) && !@application.document_signing_status_signed? %>
      <div class="flex flex-wrap gap-2">
      <% if FeatureFlag.enabled?(:docusign_enabled, default: true) %>
        <% if certification_action_state.provider_ready_for_docuseal %>
          <%= button_to send_document_signing_request_admin_application_path(@application),
                        method: :post,
                        class: 'btn btn-primary',
                        form: {
                          data: {
                            turbo_confirm: certification_action_state.docuseal_confirm,
                            turbo_frame: '_top'
                          }
                        },
                        data: {
                          disable_with: 'Sending...'
                        },
                        'aria-label': "Send DocuSeal digital signing request to #{@application.medical_provider_name}" do %>
            <%= certification_action_state.docuseal_text %>
          <% end %>
        <% else %>
          <button disabled
                  aria-disabled="true"
                  aria-describedby="docuseal-disabled-reason"
                  class="btn btn-outline">
            <%= certification_action_state.docuseal_text %>
          </button>
          <p id="docuseal-disabled-reason" class="w-full text-sm text-gray-600">Provider name and email required for DocuSeal</p>
        <% end %>
      <% end %>
        <%= button_to queue_disability_certification_form_admin_application_path(@application),
                      method: :post,
                      params: { operation_id: SecureRandom.uuid },
                      class: 'btn btn-outline',
                      data: {
                        disable_with: 'Queuing...',
                        turbo_confirm: 'Add Disability Certification Form to the print queue?'
                      },
                      'aria-label': 'Queue disability certification form for printing' do %>
          Print DCF
        <% end %>
      </div>

    <% elsif (@application.disability_certification_status == "received" ||
           (@application.disability_certification_status == "requested" && @application.disability_certification.attached?) ||
           certification_action_state.requested_after_rejection) &&
           !["approved"].include?(@application.disability_certification_status) %>
      <button type="button"
            data-action="click->modal#open"
            data-modal-id="disabilityCertificationReviewModal"
            class="btn btn-primary">
        Review Disability Certification
      </button>
    <% end %>

    <% if show_secure_cert_upload_button?(@application) %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% if @application.medical_provider_email.present? %>
          <%= button_to admin_application_certification_upload_request_path(@application),
                        method: :post,
                        class: 'btn btn-outline',
                        form: {
                          data: {
                            turbo_confirm: certification_action_state.secure_cert_upload_confirm,
                            turbo_frame: '_top'
                          }
                        },
                        data: {
                          disable_with: 'Sending...'
                        },
                        'aria-label': "Send secure certification upload link to #{@application.medical_provider_name}" do %>
            Send Secure Cert Upload Link
          <% end %>
        <% else %>
          <button disabled
                  aria-disabled="true"
                  aria-describedby="secure-cert-upload-disabled-reason"
                  class="btn btn-outline">
            Send Secure Cert Upload Link
          </button>
          <p id="secure-cert-upload-disabled-reason" class="w-full text-sm text-gray-600" data-testid="secure-cert-upload-disabled-reason">
            <%= certification_action_state.secure_cert_upload_message %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @certification_delivery_attempts&.any? || @certification_local_delivery_notifications&.any? %>
  <div class="mt-4" id="latest-certification-delivery">
    <h3 class="text-sm font-medium text-gray-900"><%= t('delivery_visibility.certification_history') %></h3>
    <% @certification_delivery_attempts.each do |attempt| %>
      <div id="<%= dom_id(attempt) %>">
        <%= render 'shared/delivery/status', presenter: DeliveryStatusPresenter.new(attempt, attempt: attempt) %>
      </div>
    <% end %>
    <% @certification_local_delivery_notifications.each do |notification| %>
      <div id="<%= dom_id(notification, :certification_delivery) %>">
        <%= render 'shared/delivery/status', presenter: DeliveryStatusPresenter.new(notification) %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @application.document_signing_service == 'docuseal' && @application.document_signing_submission_id.present? %>
  <p class="mt-3 text-sm text-gray-700">DocuSeal invitation requested. Signing status: <%= @application.document_signing_status.humanize %>. Email delivery is not confirmed by this integration.</p>
<% end %>
