<%# locals: (purchase_order:, rows: nil) -%>
<%= form_with url: admin_purchase_order_cost_path(purchase_order), method: :patch, scope: :costs, class: 'space-y-4' do |form| %>
  <%= form.hidden_field :expected_version, value: purchase_order.lock_version %>
  <div>
    <%= form.label :vendor_name, 'Supplier name', class: 'form-label' %>
    <%= form.text_field :vendor_name, value: purchase_order.vendor_name, disabled: purchase_order.icc_financial_evidence_locked?, class: 'form-input' %>
  </div>
  <div class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
    <% purchase_order.equipment_items.each do |item| %>
      <% row = rows&.fetch(item.id.to_s, nil) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
      <div class="grid gap-2 p-3 sm:grid-cols-2 sm:gap-4">
        <div>
          <p class="font-semibold"><%= equipment_catalog_label(item.product) %></p>
          <p id="cost-device-<%= item.id %>" class="text-sm text-gray-600">Device #<%= item.id %></p>
          <% if item.product.msrp.present? %>
            <p id="cost-msrp-<%= item.id %>" class="text-sm text-gray-600">MSRP <%= number_to_currency(item.product.msrp) %></p>
          <% end %>
        </div>
        <div class="space-y-1">
          <%= hidden_field_tag 'costs[rows][][id]', item.id, id: nil %>
          <%= hidden_field_tag 'costs[rows][][lock_version]', row ? row['lock_version'] : item.lock_version, id: nil %>
          <%= label_tag "unit-cost-#{item.id}", 'Price paid (USD)', class: 'form-label', id: "cost-label-#{item.id}" %>
          <%= text_field_tag 'costs[rows][][unit_cost]', row ? row['unit_cost'] : item.unit_cost,
                             inputmode: 'decimal', autocomplete: 'off', id: "unit-cost-#{item.id}",
                             disabled: item.icc_financial_evidence_locked?, class: 'form-input',
                             aria: { labelledby: "cost-label-#{item.id} cost-device-#{item.id}",
                                     describedby: ("cost-msrp-#{item.id}" if item.product.msrp.present?) } %>
          <% if item.icc_financial_evidence_locked? %>
            <%= link_to 'Correct filed or shared invoice cost', edit_admin_icanconnect_financial_record_path("EquipmentItem:#{item.id}"),
                        class: 'text-sm text-primary-700 underline' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <%= form.submit 'Save device costs', class: 'btn btn-primary' %>
<% end %>
