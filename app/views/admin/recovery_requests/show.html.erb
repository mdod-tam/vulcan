<div class="container mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">Security Key Recovery Request</h1>
    <%= link_to 'Back to All Requests', admin_recovery_requests_path, class: 'text-primary-600 hover:text-primary-900' %>
  </div>

  <section class="card overflow-hidden p-6" aria-labelledby="recovery-details-heading">
    <h2 id="recovery-details-heading" class="text-lg font-medium">Request details</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      <div><dt class="font-medium">User</dt><dd><%= @recovery_request.user.full_name %></dd></div>
      <div><dt class="font-medium">Email</dt><dd class="break-words"><%= display_contact_email(@recovery_request.user) %></dd></div>
      <div><dt class="font-medium">Status</dt><dd><%= @recovery_request.status.titleize %></dd></div>
      <div><dt class="font-medium">Submitted</dt><dd><%= l(@recovery_request.created_at, format: :long) %></dd></div>
      <div><dt class="font-medium">IP address</dt><dd><%= @recovery_request.ip_address %></dd></div>
      <div><dt class="font-medium">User agent</dt><dd class="break-words text-sm"><%= @recovery_request.user_agent %></dd></div>
      <div class="sm:col-span-2">
        <dt class="font-medium">Submitted details</dt>
        <dd class="whitespace-pre-wrap"><%= @recovery_request.details.presence || 'No additional details provided.' %></dd>
      </div>
    </dl>
    <p class="mt-4 text-sm text-gray-600">The public request and its details do not prove the requester's identity.</p>
  </section>

  <section class="card mt-6 p-6" aria-labelledby="recovery-keys-heading">
    <h2 id="recovery-keys-heading" class="text-lg font-medium">Security Keys</h2>
    <p class="mt-2"><%= pluralize(@credentials.size, 'registered security key') %>.</p>
    <ul class="mt-3 space-y-2">
      <% @credentials.each do |credential| %>
        <li class="rounded bg-gray-50 p-2 text-sm"><%= credential.nickname %> — added <%= l(credential.created_at.to_date) %></li>
      <% end %>
    </ul>
  </section>

  <% if @recovery_request.pending? %>
    <section class="card mt-6 p-6" aria-labelledby="recovery-approval-heading">
      <h2 id="recovery-approval-heading" class="text-lg font-medium">Verify identity before approval</h2>
      <p class="mt-3 rounded border-l-4 border-warning-400 bg-warning-50 p-4 text-warning-900">
        Approval removes all WebAuthn security keys, signs this user out of every session, and cancels pending contact changes.
        Authenticator-app and SMS factors remain enrolled. Reports of a stolen phone or broader compromise need the broader account-security process.
      </p>
      <% if current_user.id == @recovery_request.user_id %>
        <p class="mt-4" role="status">A different administrator must approve your recovery request. Contact the security owner to arrange another administrator if none is available.</p>
      <% elsif !@recent_authentication %>
        <p class="mt-4">Verify your password and existing factor before completing the identity-check form.</p>
        <%= link_to 'Verify my identity', new_reauthentication_path(return_to: admin_recovery_request_path(@recovery_request)), class: 'btn btn-primary mt-4' %>
      <% else %>
        <% if @recovery_request.errors.any? %>
          <div class="mt-4 rounded border border-danger-300 bg-danger-50 p-4" role="alert" tabindex="-1">
            <h3 class="font-medium">Complete the verification record</h3>
            <ul class="mt-2 list-disc pl-5"><% @recovery_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
          </div>
        <% end %>
        <p id="recovery-verification-guidance" class="mt-4 text-sm text-gray-600">Complete the agency-approved non-SMS identity-check procedure first. Record only its nonsecret case or procedure reference; do not enter identity-document details, passwords, codes, or contact values.</p>
        <%= form_with model: @recovery_request, url: approve_admin_recovery_request_path(@recovery_request), method: :post, class: 'mt-5 space-y-4' do |form| %>
          <div>
            <%= form.label :verification_method, 'Verification method', class: 'block font-medium' %>
            <%= form.select :verification_method, RecoveryRequest::VERIFICATION_METHODS.map { |value, label| [label, value] }, { prompt: 'Choose the completed method' }, { required: true, class: 'form-select mt-1 w-full', aria: { describedby: 'recovery-verification-guidance' } } %>
          </div>
          <div>
            <%= form.label :verification_result, 'Verification result', class: 'block font-medium' %>
            <%= form.select :verification_result, [['Identity verified', 'verified']], { prompt: 'Choose the result' },
                            { required: true, class: 'form-select mt-1 w-full' } %>
          </div>
          <div>
            <%= form.label :verification_reference, 'Nonsecret case or procedure reference', class: 'block font-medium' %>
            <%= form.text_field :verification_reference, required: true, maxlength: RecoveryRequest::VERIFICATION_REFERENCE_LIMIT, class: 'form-input mt-1 w-full', aria: { describedby: 'recovery-verification-guidance' } %>
          </div>
          <div class="flex items-start gap-2">
            <%= form.check_box :identity_check_completed, required: true, class: 'mt-1' %>
            <%= form.label :identity_check_completed, 'I completed the approved non-SMS identity check and verified that this request belongs to this account owner.' %>
          </div>
          <%= form.submit 'Approve Security Key Reset', class: 'btn btn-success',
                                                        data: { turbo_confirm: 'Remove WebAuthn keys, revoke all sessions, and cancel pending contact changes?' } %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="card mt-6 p-6" aria-labelledby="recovery-outcome-heading">
      <h2 id="recovery-outcome-heading" class="text-lg font-medium">Recovery outcome</h2>
      <p class="mt-3">This request has already been processed.</p>
      <% if @recovery_request.approved? %>
        <p class="mt-3">
          Verification: <%= RecoveryRequest::VERIFICATION_METHODS[@recovery_request.verification_method] || 'Historical verification record' %>.
          Reference: <%= @recovery_request.verification_reference.presence || 'Not recorded' %>.
        </p>
        <% if @approval_notification %>
          <p class="mt-3" role="status">Notice status: <%= @approval_notification.delivery_status.presence || 'Awaiting dispatch' %>. Recovery remains approved if delivery fails.</p>
          <% unless @approval_notification.delivery_status.in?(%w[submitted delivered opened]) %>
            <%= button_to 'Retry recovery notice', retry_notice_admin_recovery_request_path(@recovery_request), method: :post, class: 'btn btn-secondary mt-4' %>
          <% end %>
        <% else %>
          <p class="mt-3">No durable recovery notice is recorded. Review this historical approval before taking further action.</p>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
