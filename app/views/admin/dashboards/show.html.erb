<div class="container mx-auto px-4 py-8">
  <div class="max-w-7xl mx-auto">
    <a href="#dashboard-content" class="skip-link">
      Skip to application status
    </a>
    
    <div class="mb-6">
      <div class="flex items-start justify-between gap-4 mb-4">
        <h1 class="text-3xl font-bold" id="page-title">
          Admin Dashboard
        </h1>
        
        <%= link_to admin_print_queue_index_path,
            class: "btn btn-outline whitespace-nowrap",
            aria: { label: "View print queue" } do %>
          <svg class="h-5 w-5 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <div class="text-left">
            <div class="font-semibold text-sm">Print Queue
              <% if @metrics[:print_queue_pending_count].to_i > 0 %>
                (<%= @metrics[:print_queue_pending_count] %>)
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @assigned_notes.present? %>
        <section aria-labelledby="assigned-notes-heading" class="card p-4 mb-6">
          <div class="flex items-center justify-between mb-4">
            <h2 id="assigned-notes-heading" class="text-lg font-medium text-gray-900">Assigned Notes</h2>
          </div>

          <ul class="space-y-3">
            <% @assigned_notes.each do |note| %>
              <li class="bg-warning-50 border-l-4 border-warning-400 p-3 rounded">
                <div class="flex justify-between items-start gap-2">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-gray-900 font-medium truncate">
                      <%= link_to "Application for #{note.application.user&.full_name || "Unknown Applicant"} on #{note.application.created_at.strftime('%B %d, %Y')}", admin_application_path(note.application), class: "text-primary-600 hover:text-primary-500" %>
                    </p>
                    <p class="text-sm text-gray-700 mt-1 line-clamp-2"><%= note.content %></p>
                    <div class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                      <span>by <%= note.admin.full_name %></span>
                      <span>•</span>
                      <span><%= time_ago_in_words(note.created_at) %> ago</span>
                    </div>
                  </div>
                  <div class="flex-shrink-0">
                    <%= link_to "View Note",
                                admin_application_path(note.application) + "#application-note-#{note.id}",
                                class: "text-primary-600 hover:text-primary-500 text-sm font-medium" %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>          

          <% if @pagy_assigned_notes && @pagy_assigned_notes.pages > 1 %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <%== pagy_nav(@pagy_assigned_notes) %>
            </div>
          <% end %>
        </section>
      <% end %>

    <%= render 'admin/shared/recent_notifications', notifications: @recent_notifications %>

      <div class="mb-8 space-y-8">
        <div>
          <h2 class="text-xs font-semibold text-gray-600 uppercase tracking-widest mb-4 pl-1">Application Management</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-x-3 gap-y-4">
            <%= link_to new_admin_paper_application_path,
                class: "btn btn-primary group justify-start",
                aria: { label: "Apply for constituent" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Apply for Constituent</div>
                  <div class="text-xs opacity-90">Create new application</div>
                </div>
              </div>
            <% end %>
            
            <%= link_to admin_applications_path(status: 'active'),
                class: "btn btn-outline group justify-start",
                aria: { label: "View active applications" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Applications</div>
                  <div class="text-xs text-gray-600">View active submissions</div>
                </div>
              </div>
            <% end %>
            
            <%= link_to admin_users_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "Manage system users" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.697" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Users</div>
                  <div class="text-xs text-gray-600">Manage team members</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-semibold text-gray-600 uppercase tracking-widest mb-4 pl-1">Review</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-x-3 gap-y-4">
            <%= link_to trainers_dashboard_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "View trainings dashboard" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Trainings</div>
                  <div class="text-xs text-gray-600">Training sessions</div>
                </div>
              </div>
            <% end %>
            
            <%= link_to evaluators_dashboard_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "View evaluations dashboard" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Evaluations</div>
                  <div class="text-xs text-gray-600">Review evaluations</div>
                </div>
              </div>
            <% end %>
            
            <%= link_to admin_reports_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "View detailed system reports and pain point analysis" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Reports</div>
                  <div class="text-xs text-gray-600">Analytics & insights</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <section aria-labelledby="equipment-tools-heading">
          <h2 id="equipment-tools-heading" class="text-xs font-semibold text-gray-600 uppercase tracking-widest mb-4 pl-1">Equipment and Reimbursement</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-x-3 gap-y-4">
            <%= link_to admin_equipment_index_path, class: 'btn btn-outline group justify-start', aria: { label: 'Equipment' } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m0 0l8 4m-8-4v10l8 4m0-10l8-4m0 0v10l-8 4m0-10v10" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Equipment</div>
                  <div class="text-xs text-gray-600">Bids, purchase orders, stock and shipments</div>
                </div>
              </div>
            <% end %>
            <%= link_to admin_icanconnect_filing_prep_path, class: 'btn btn-outline group justify-start', aria: { label: 'iCanConnect filing preparation' } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l6 6v10a2 2 0 01-2 2z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">iCanConnect Filing Preparation</div>
                  <div class="text-xs text-gray-600">Prepare reimbursement filings</div>
                </div>
              </div>
            <% end %>
          </div>
        </section>

        <% if FeatureFlag.enabled?(:vouchers_enabled) %>
          <div>
            <h2 class="text-xs font-semibold text-gray-600 uppercase tracking-widest mb-4 pl-1">Vouchers</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-3 gap-y-4">
              <%= link_to admin_vouchers_path,
                  class: "btn btn-outline group justify-start",
                  aria: { label: "Manage Vouchers" } do %>
                <div class="flex items-center gap-3">
                  <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <div class="text-left">
                    <div class="font-semibold text-sm">Manage Vouchers</div>
                    <div class="text-xs text-gray-600">View voucher updates</div>
                  </div>
                </div>
              <% end %>

              <%= link_to admin_vendors_path,
                  class: "btn btn-outline group justify-start",
                  aria: { label: "Manage vendors" } do %>
                <div class="flex items-center gap-3">
                  <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                  </svg>
                  <div class="text-left">
                    <div class="font-semibold text-sm">Manage Vendors</div>
                    <div class="text-xs text-gray-600">Review vendor details</div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <section aria-labelledby="configuration-tools-heading">
          <h2 id="configuration-tools-heading" class="text-xs font-semibold text-gray-600 uppercase tracking-widest mb-4 pl-1">Configuration</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-x-3 gap-y-4">
            <%= link_to admin_policies_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "Edit system policies and settings" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Edit Policies</div>
                  <div class="text-xs text-gray-600">System settings</div>
                </div>
              </div>
            <% end %>

            <%= link_to admin_feature_flags_path, class: 'btn btn-outline group justify-start', aria: { label: 'Feature Flags' } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 21V4m0 0c5-4 9 4 14 0v10c-5 4-9-4-14 0" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Feature Flags</div>
                  <div class="text-xs text-gray-600">Turn workflows on or off</div>
                </div>
              </div>
            <% end %>

            <%= link_to admin_products_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "Manage products catalog" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m0 0l8 4m-8-4v10l8 4m0-10l8 4m-8-4v10l8 4M7 12l8 4m0 0l8-4" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Manage Products</div>
                  <div class="text-xs text-gray-600">Product catalog</div>
                </div>
              </div>
            <% end %>

            <%= link_to admin_email_templates_path,
                class: "btn btn-outline group justify-start",
                aria: { label: "Manage email templates and rejection reasons" } do %>
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 flex-shrink-0 text-primary-600 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div class="text-left">
                  <div class="font-semibold text-sm">Email Templates</div>
                  <div class="text-xs text-gray-600">Content and delivery settings</div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      </div>
      </div>

    <section aria-labelledby="status-cards-heading" class="mb-6" id="dashboard-content">
      <h2 id="status-cards-heading" class="sr-only">Application Status Overview</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 id="active-applications-heading" class="text-lg font-medium text-gray-900">In Progress Applications</h3>
          <p class="text-3xl font-bold text-primary-600" aria-labelledby="active-applications-heading" aria-live="polite"><%= @metrics[:open_applications_count] || 0 %></p>
          <p class="text-sm text-gray-500">All active applications: submitted but unapproved</p>
          <ul class="mt-3 space-y-1 text-sm text-gray-700">
            <li><%= link_to "#{pluralize(@metrics.fetch(:active_awaiting_proofs_count), 'application')} awaiting proofs from constituents",
                            admin_applications_path(view: 'review', status: 'active', filter: 'awaiting_proofs'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:active_proofs_needing_review_count), 'application')} with proofs to review",
                            admin_applications_path(view: 'review', status: 'active', filter: 'proofs_needing_review'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:active_cert_requests_needed_count), 'application')} needing cert request",
                            admin_applications_path(view: 'review', status: 'active', filter: 'cert_requests_needed'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:active_awaiting_certifications_count), 'application')} awaiting certifications from providers",
                            admin_applications_path(view: 'review', status: 'active', filter: 'certifications_awaiting_provider'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:active_disability_certs_to_review_count), 'application')} with disability certifications to review",
                            admin_applications_path(view: 'review', status: 'active', filter: 'certifications_needing_review'), class: 'text-primary-700 underline' %></li>
          </ul>
          <div class="mt-2">
            <%= link_to admin_applications_path(status: 'active'),
                class: "inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-500",
                aria: { label: "View only active applications" } do %>
              <span>View Only Active Applications</span>
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          </div>
        </div>
        
        <div class="card p-6">
          <h3 id="approved-heading" class="text-lg font-medium text-gray-900">Approved</h3>
          <p class="text-3xl font-bold text-primary-600" aria-labelledby="approved-heading" aria-live="polite"><%= @metrics[:pending_services_count] || 0 %></p>
          <p class="text-sm text-gray-500">Approved applications</p>
          <ul class="mt-3 space-y-1 text-sm text-gray-700">
            <li><%= link_to "#{pluralize(@metrics.fetch(:approved_training_waiting_count), 'application')} awaiting training",
                            admin_applications_path(view: 'all', filter: 'awaiting_training'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:approved_stage_group_counts).fetch(:awaiting_evaluation), 'application')} awaiting evaluation",
                            admin_applications_path(view: 'pipeline', group: 'equipment', stage: 'awaiting_evaluation'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@metrics.fetch(:approved_stage_group_counts).fetch(:getting_bids), 'application')} getting bids",
                            admin_applications_path(view: 'pipeline', group: 'equipment', stage: 'getting_bids'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@approved_stage_counts[:ready_to_send_po], 'application')} needing a PO sent date",
                            admin_applications_path(view: 'pipeline', group: 'equipment', stage: 'ready_to_send_po'), class: 'text-primary-700 underline' %></li>
            <li><%= link_to "#{pluralize(@approved_stage_counts[:awaiting_shipment], 'application')} needing shipping info",
                            admin_applications_path(view: 'pipeline', group: 'equipment', stage: 'awaiting_shipment'), class: 'text-primary-700 underline' %></li>
          </ul>
          <div class="mt-2">
            <%= link_to admin_applications_path(view: 'pipeline'),
                class: "inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-500",
                aria: { label: 'Open approved pipeline' } do %>
              <span>Open approved pipeline</span>
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          </div>
        </div>
      </div>
    </section>
    
    <%= turbo_frame_tag "charts_section", src: charts_admin_applications_path, loading: "lazy" do %>
      <div class="mb-6 card p-6">
        <div class="flex items-center justify-center">
          <svg class="animate-spin h-8 w-8 text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="ml-2 text-gray-600">Loading charts...</span>
        </div>
      </div>
    <% end %>
  </div>
</div>
