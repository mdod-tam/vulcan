<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">W9 Review Details</h1>
    <div class="flex space-x-2">
      <%= link_to "Back to Vendor", admin_vendor_path(@vendor), class: "btn btn-outline" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="card overflow-hidden">
      <div class="px-4 py-5 sm:px-6 bg-gray-50">
        <h3 class="text-lg leading-6 font-medium text-gray-900">W9 Form Preview</h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">
          <%= @vendor.business_name %>'s W9 Form
        </p>
      </div>
      <div class="border-t border-gray-200 p-4">
        <% if @w9_form.present? %>
          <%= render 'shared/document_scan_status', document: @w9_form %>
          <div class="w-full h-[600px] overflow-hidden">
            <% if @w9_form.content_type.to_s.start_with?('image/') %>
              <div class="flex h-full items-center justify-center bg-gray-50">
                <%= image_tag vendor_w9_document_path(@vendor, @w9_form.is_a?(ActiveStorage::Blob) ? @w9_form : @w9_form.blob),
                    class: "max-h-full max-w-full object-contain",
                    alt: "W9 form image for #{@vendor.business_name}" %>
              </div>
            <% else %>
              <iframe
                src="<%= vendor_w9_document_path(@vendor, @w9_form.is_a?(ActiveStorage::Blob) ? @w9_form : @w9_form.blob) %>"
                data-original-src="<%= vendor_w9_document_path(@vendor, @w9_form.is_a?(ActiveStorage::Blob) ? @w9_form : @w9_form.blob) %>"
                title="Reviewed W9 document"
                type="application/pdf"
                width="100%"
                height="600px"
                class="w-full h-full"
                data-turbo="false"
                allow="fullscreen">
                <p class="text-gray-500">
                  It appears your browser cannot display this PDF inline.
                  <%= link_to 'Click here to download the file',
                              vendor_w9_document_path(@vendor, @w9_form.is_a?(ActiveStorage::Blob) ? @w9_form : @w9_form.blob, disposition: :attachment),
                              class: 'text-primary-600 hover:text-primary-500', target: '_blank', rel: 'noopener' %>
                </p>
              </iframe>
            <% end %>
          </div>
          <div class="mt-4 flex justify-center">
            <%= link_to 'Open in New Tab',
                        vendor_w9_document_path(@vendor, @w9_form.is_a?(ActiveStorage::Blob) ? @w9_form : @w9_form.blob, disposition: 'inline'),
                        target: '_blank', rel: 'noopener',
                        class: 'btn btn-outline' %>
          </div>
        <% else %>
          <div class="flex items-center justify-center h-[600px] bg-gray-100">
            <p class="text-gray-500">Reviewed document unknown.</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="px-4 py-5 sm:px-6 bg-gray-50">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Review Details</h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">
          Review performed on <%= @w9_review.reviewed_at.strftime("%B %d, %Y at %I:%M %p") %>
        </p>
      </div>
      <div class="border-t border-gray-200">
        <dl>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Vendor</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @vendor.business_name %></dd>
          </div>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Reviewed By</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @w9_review.admin.email %></dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Decision</dt>
            <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
              <%= badge(@w9_review.status.titleize, @w9_review.status_approved? ? :success : :danger) %>
            </dd>
          </div>
          
          <% if @w9_review.status_rejected? %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Rejection Reason</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <%= @w9_review.rejection_reason_code.to_s.titleize %>
              </dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Detailed Explanation</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <%= @w9_review.rejection_reason %>
              </dd>
            </div>
          <% end %>

        </dl>
      </div>
    </div>
  </div>
</div>

<%= render 'delivery_history', request_forms: @vendor_secure_request_forms, notifications: @w9_notifications %>
