<div class="max-w-7xl mx-auto px-4 py-6 space-y-4">
  <%= render 'admin/shared/index_header', title: 'Purchase Orders' %>
<%= render 'admin/equipment/navigation' %>
<% if @purchase_orders.empty? %>
<p>No purchase orders match these filters.</p>
<% end %>
<% @purchase_orders.each do |order| %>
<article class="border rounded p-4">
<%= link_to "PO #{order.number}", admin_purchase_order_path(order, return_context: @return_context),
            class: 'underline font-semibold' %>
 · <%= order.purpose.humanize %>
 · <%= equipment_funding_label(order) %>
 · <%= order.sent_at ? "Sent #{accessible_date_value(order.sent_at)}" : 'PO sent date needed' %>
 · <%= pluralize(order.equipment_items.size, 'device') %> across <%= pluralize(order.equipment_items.map(&:application_id).compact.uniq.size, 'application') %>
 · <%= order.shipment_status %>
</article>
<% end %>
</div>
