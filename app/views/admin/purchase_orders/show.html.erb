<div class="max-w-7xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-4">PO <%= @purchase_order.number %></h1>
  <p><%= @purchase_order.vendor.business_name %> · Date PO sent: <%= accessible_date_value(@purchase_order.sent_at) %> · <%= @purchase_order.shipment_status %></p>
  <p class="my-4"><%= link_to 'Correct shared purchase order', edit_admin_purchase_order_correction_path(@purchase_order, return_context: @return_context),
                              class: 'text-primary-700 underline' %> · <%= link_to 'Back to Equipment',
                                                                                   equipment_return_path(@return_context), class: 'text-primary-700 underline' %></p>
  <%= render 'admin/applications/equipment_items', items: @purchase_order.equipment_items, audit_records: @equipment_audit_records, return_context: @return_context %>
  <%= render 'admin/equipment_items/history', events: @history, title: 'Order and device history', audit_records: @equipment_audit_records %>
</div>
