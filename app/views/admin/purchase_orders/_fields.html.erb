<%# locals: (form:, purchase_order:, prefix: '') -%>
<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <%= form.label :number, "#{prefix}PO number", class: 'form-label' %>
    <%= form.text_field :number, maxlength: 100, class: 'form-input mt-1' %>
  </div>
  <div>
    <%= form.label :sent_at, "#{prefix}Date PO sent", class: 'form-label' %>
    <%= form.text_field :sent_at,
                        typed_date_field_options(value: typed_date_input_value(purchase_order, :sent_at),
                                                 class: 'form-input mt-1',
                                                 'aria-invalid': purchase_order.errors[:sent_at].any?,
                                                 'aria-describedby': ["#{form.field_id(:sent_at)}-help",
                                                                      ("#{form.field_id(:sent_at)}-error" if purchase_order.errors[:sent_at].any?)].compact.join(' ')) %>
    <p id="<%= form.field_id(:sent_at) %>-help" class="form-hint">MM/DD/YYYY, no later than today.</p>
    <% if purchase_order.errors[:sent_at].any? %>
      <p id="<%= form.field_id(:sent_at) %>-error" class="text-sm text-danger-700"><%= purchase_order.errors.full_messages_for(:sent_at).to_sentence %></p>
    <% end %>
  </div>
</div>
<% if purchase_order.program_stock? %>
  <fieldset class="mt-4 grid gap-4 sm:grid-cols-2">
    <legend class="font-medium">Confirmed program receiving address</legend>
    <% EquipmentShipping::FIELDS.each do |field| %>
      <div><%= form.label field, class: 'form-label' %><%= form.text_field field, class: 'form-input mt-1' %></div>
    <% end %>
  </fieldset>
<% end %>
