<%# locals: (form:, purchase_order:, vendors:, prefix: '') -%>
<div class="grid gap-4 sm:grid-cols-3">
  <div>
    <%= form.label :vendor_id, "#{prefix}Vendor", class: 'block font-medium' %>
    <%= form.collection_select :vendor_id, vendors, :id, :business_name,
                               { include_blank: 'Select a vendor' }, class: 'mt-1 w-full rounded border-gray-300' %>
  </div>
  <div>
    <%= form.label :number, "#{prefix}PO number", class: 'block font-medium' %>
    <%= form.text_field :number, maxlength: 100, class: 'mt-1 w-full rounded border-gray-300' %>
  </div>
  <div>
    <%= form.label :sent_at, "#{prefix}Date PO sent", class: 'block font-medium' %>
    <%= form.text_field :sent_at,
                        typed_date_field_options(value: typed_date_input_value(purchase_order, :sent_at),
                                                 class: 'mt-1 w-full rounded border-gray-300',
                                                 'aria-describedby': "#{form.field_id(:sent_at)}-help") %>
    <p id="<%= form.field_id(:sent_at) %>-help" class="text-sm text-gray-600">MM/DD/YYYY, no later than today.</p>
  </div>
</div>
