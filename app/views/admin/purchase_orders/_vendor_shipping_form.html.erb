<%# locals: (order:, draft:, label:) -%>
<%= form_with model: draft, url: admin_purchase_order_shipping_request_path(order), method: :post, class: 'mt-3 space-y-3' do |form| %>
  <%= hidden_field_tag :expected_version, order.lock_version, id: 'vendor_shipping_expected_version' %>
  <div>
    <%= form.label :recipient_email, 'Vendor shipping email', class: 'form-label' %>
    <%= form.email_field :recipient_email, required: true, maxlength: 254, class: 'form-input', aria: { describedby: 'vendor-shipping-help' } %>
    <p id="vendor-shipping-help" class="form-hint">The link lets the vendor view this order and add tracking for each package.</p>
  </div>
  <div>
    <%= form.label :shipping_instructions, 'Shipping instructions (optional)', class: 'form-label' %>
    <%= form.text_area :shipping_instructions, maxlength: 2000, rows: 3, class: 'form-input' %>
  </div>
  <%= form.submit label, class: 'btn btn-primary' %>
<% end %>
