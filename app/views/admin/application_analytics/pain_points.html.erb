<% content_for :title, 'Where draft applications stopped' %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold mb-6">Where draft applications stopped</h1>

  <p class="mb-4">Shows the last recorded field for existing draft applications.</p>

  <% if @analysis_results.blank? %>
    <div class="bg-warning-100 border border-warning-400 text-warning-700 px-4 py-3 rounded relative" role="alert">
      No drafts have a recorded last field.
    </div>
  <% else %>
    <div class="card overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Last field
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Draft applications
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @analysis_results.each do |step, count| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= t("applications.form_labels.#{step}", default: Application.human_attribute_name(step)) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to 'Back to Applications', admin_applications_path, class: "text-primary-600 hover:text-primary-800" %>
  </div>
</div>
