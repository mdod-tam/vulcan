<main class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold">Income rejection letter</h1>
  <div class="card mt-4 p-6">
    <% if @receipt.notifiable %>
      <%= link_to @receipt.notifiable.full_name, admin_user_path(@receipt.notifiable), class: 'text-primary-700 underline' %>
    <% end %>

    <% if @receipt.metadata['mailed_manually_at'].present? %>
      <p class="mt-2">Mailed by hand</p>
    <% elsif @letter %>
      <p class="mt-2"><%= rejection_letter_status(@letter) %></p>
      <%= link_to 'Review letter', admin_print_queue_path(@letter), class: 'mt-3 inline-block text-primary-700 underline' %>
    <% elsif @receipt.local_delivery_outcome? %>
      <p class="mt-2 font-semibold">Letter not queued</p>
      <p><%= @reason ? EmailDelivery::ControlPanel.reason_text(@reason, category: :application).upcase_first : 'Preparation failed. Try again from paper intake.' %></p>
      <% if @reason == 'unsupported_letter_text' %>
        <%= button_to('Record as mailed', record_manual_mail_admin_paper_rejection_letter_path(@receipt),
                      class: 'btn btn-secondary mt-3', form: { data: { turbo_confirm: 'Record that you mailed this letter by hand?' } }) %>
      <% end %>
    <% elsif @receipt.queued_delivery_status? %>
      <p class="mt-2">Queued for preparation</p>
      <%= link_to 'Check status', admin_paper_rejection_letter_path(@receipt), class: 'mt-3 inline-block text-primary-700 underline' %>
    <% else %>
      <p class="mt-2">Check the print queue before trying again.</p>
    <% end %>
  </div>
  <%= link_to 'Back to paper intake', new_admin_paper_application_path, class: 'mt-4 inline-block text-primary-700 underline' %>
</main>
