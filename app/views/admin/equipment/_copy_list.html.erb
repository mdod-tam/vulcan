<%# locals: (supplier_list:, heading:, summary_label:, id_prefix:, description: nil) -%>
<section class="mt-6 space-y-4 rounded-lg border border-gray-200 p-4" aria-labelledby="<%= id_prefix %>-heading">
  <h2 id="<%= id_prefix %>-heading" class="text-xl font-semibold"><%= heading %></h2>
  <% if description.present? %><p class="text-sm text-gray-600"><%= description %></p><% end %>
  <div class="space-y-3">
    <p><%= supplier_list.summary %></p>
    <div class="relative overflow-x-auto" role="region" tabindex="0" aria-labelledby="<%= id_prefix %>-heading">
      <table class="admin-record-table" aria-labelledby="<%= id_prefix %>-heading">
        <thead>
          <tr>
            <th scope="col">Product model</th>
            <th scope="col" class="w-14 whitespace-nowrap text-right sm:w-24">
              <span class="hidden sm:inline">Quantity</span><span class="sm:hidden" aria-hidden="true">Qty</span><span class="sr-only sm:hidden">Quantity</span>
            </th>
            <th scope="col">Ship to</th>
            <% unless supplier_list.purchase_order %>
              <th scope="col">Disability setup</th>
              <th scope="col">Shipment</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% supplier_list.rows.each do |row| %>
            <tr>
              <th scope="row"><%= row.model %></th>
              <td class="text-right tabular-nums"><%= row.quantity %></td>
              <td>
                <span class="block font-medium"><%= row.recipient %></span>
                <%= safe_join(row.address, tag.br) %>
              </td>
              <% unless supplier_list.purchase_order %>
                <td><%= row.setup %></td>
                <td><%= row.completed ? 'Already shipped' : 'Pending' %></td>
              <% end %>
            </tr>
          <% end %>
          <% if supplier_list.rows.empty? %><tr><td colspan="<%= supplier_list.headings.size - 1 %>">No products to list.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
  <details>
    <summary class="cursor-pointer text-primary-700 underline"><%= summary_label %></summary>
    <label for="<%= id_prefix %>-text" class="mt-3 block font-medium"><%= heading %></label>
    <textarea id="<%= id_prefix %>-text" class="mt-2 w-full resize-y rounded border-gray-400"
              rows="<%= supplier_list.purchase_order ? 11 : 8 %>" readonly><%= supplier_list.plain_text %></textarea>
  </details>
</section>
