<%# locals: (record:, previous_values:, fields:, impact_token:, title:, confirmation:, body: nil, products: [], purchase_orders: [], autofocus: true) -%>
<%= hidden_field_tag :reviewing, '1' %>
<%= hidden_field_tag :impact_token, impact_token %>
<div class="rounded border border-warning-300 bg-warning-50 p-4">
  <%= tag.h2(
        title,
        id: 'equipment-correction-impact-heading', tabindex: '-1', autofocus: autofocus,
        class: 'font-semibold'
      ) %>
  <% if body %><p><%= body %></p><% end %>
  <div class="mt-2 rounded border border-gray-200 bg-white">
    <%= render 'admin/equipment/change_comparison',
               changes: equipment_correction_changes(record, previous_values, fields:),
               records: { products: products, purchase_orders: purchase_orders } %>
  </div>
  <% if confirmation %>
    <p class="mt-3">
      <%= check_box_tag :confirmed_impact, '1', false, required: true %>
      <%= label_tag :confirmed_impact, confirmation %>
    </p>
  <% end %>
</div>
