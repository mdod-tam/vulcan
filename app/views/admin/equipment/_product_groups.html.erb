<%# locals: (groups:, return_context:, available_counts:) -%>
<% groups.each do |product, rows| %>
  <section class="card border border-gray-200 p-4 space-y-3" data-equipment-selection-target="group">
    <h2 class="text-lg font-semibold"><%= equipment_catalog_label(product) %></h2>
    <% if return_context[:tab] == 'needs_ordering' %>
    <label><input type="checkbox" data-equipment-selection-target="groupCheckbox" data-action="equipment-selection#selectGroup"> Select matching requests for this model</label>
      <%= render 'needs_table', product: product, rows: rows, available_stock: available_counts[product.id].to_i, return_context: return_context %>
    <% else %>
    <% rows.each do |row| %>
      <article class="border-t py-3 flex flex-wrap gap-3 items-center" data-equipment-selection-target="row"
               data-model="<%= product.id %>" data-manufacturer="<%= product.manufacturer %>" data-category="<%= product.category %>"
               data-program-groups="<%= row.application.program_disability_groups.join(',') %>"
               data-source="<%= row.stock? ? 'stock' : 'vendor' %>"
               data-search-text="<%= row.application.user.full_name %> Application #<%= row.application_id %>">
        <%= link_to "#{row.application.user.full_name} · Application ##{row.application_id}",
                    admin_application_path(row.application_id, anchor: 'equipment', return_context: return_context), class: 'underline' %>
        <%= equipment_queue_badge(row) %><%= link_to "Device ##{row.id}", edit_admin_equipment_item_path(row, return_context: return_context), class: 'underline' %>
        <% if row.purchase_order %><%= link_to "PO #{row.purchase_order.number}", admin_purchase_order_path(row.purchase_order), class: 'underline' %><% end %>
        <span>Funding: <%= equipment_funding_label(row) %></span>
        <span>Date received: <%= accessible_date_value(row.delivered_on) || 'Not recorded' %></span>
        <%= link_to 'Costs and receipt dates', edit_admin_icanconnect_financial_record_path("EquipmentItem:#{row.id}"), class: 'underline' %>
        <span>Device setup: <%= equipment_request_setup(row) %></span>
        <span>
          <%= row.shipping_ready? ? 'Destination confirmed' : 'Destination needed' %>
        </span>
      </article>
    <% end %>
    <% end %>
  </section>
<% end %>
