<% content_for :skip_link do %>
  <%= link_to 'Skip to main content', '#main-content', class: 'skip-link' %>
<% end %>
<div id="main-content" tabindex="-1" class="max-w-7xl mx-auto px-4 py-6 space-y-6 [overflow-wrap:anywhere]" data-controller="equipment-selection">
  <%= render 'admin/shared/index_header',
             title: { 'needs_ordering' => 'Needs bid number', 'ordered' => 'Enter shipping info' }.fetch(@context[:tab], 'View shipment history') %>
  <%= render 'admin/equipment/navigation' %>
  <% if @context[:tab] == 'shipped' %>
    <nav class="flex flex-wrap gap-2" aria-label="Shipment history filters">
      <%= link_to 'All shipments', admin_equipment_index_path(@context.except(:delivery)),
                  class: (@context[:delivery] ? 'btn btn-outline' : 'btn btn-secondary'),
                  aria: { current: ('page' unless @context[:delivery]) } %>
      <%= link_to 'Awaiting delivery', admin_equipment_index_path(@context.merge(delivery: 'awaiting')),
                  class: (@context[:delivery] ? 'btn btn-secondary' : 'btn btn-outline'),
                  aria: { current: ('page' if @context[:delivery]) } %>
    </nav>
  <% end %>
  <%= form_with url: admin_equipment_index_path, method: :get, id: 'equipment-filters',
                data: { action: 'submit->equipment-selection#applyFilters' }, class: 'card border border-gray-200 p-4 space-y-4' do |form| %>
    <% @context.except(:search, :product_id, :manufacturer, :category, :program_group, :source).each do |key, value| %><%= hidden_field_tag "return_context[#{key}]",
                                                                                                                                            value %><% end %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <%= label_tag :equipment_search, 'Constituent name or application #', class: 'form-label' %>
        <%= search_field_tag 'return_context[search]', @context[:search],
                             id: 'equipment_search', autocomplete: 'off',
                             data: { equipment_selection_target: 'search', action: 'input->equipment-selection#filter' }, class: 'form-input' %>
      </div>
      <div>
        <%= label_tag :equipment_model, 'Model', class: 'form-label' %>
        <%= select_tag 'return_context[product_id]', options_for_select(equipment_catalog_options(@products), @context[:product_id]),
                       include_blank: 'All models', id: 'equipment_model',
                       data: { equipment_selection_target: 'model', action: 'change->equipment-selection#filter' }, class: 'form-input' %>
      </div>
      <div>
        <%= label_tag :equipment_manufacturer, 'Manufacturer', class: 'form-label' %>
        <%= select_tag 'return_context[manufacturer]',
                       options_for_select(@products.map(&:manufacturer).compact_blank.uniq.sort, @context[:manufacturer]),
                       include_blank: 'All manufacturers', id: 'equipment_manufacturer',
                       data: { equipment_selection_target: 'manufacturer', action: 'change->equipment-selection#filter' }, class: 'form-input' %>
      </div>
      <div>
        <%= label_tag :equipment_category, 'Category', class: 'form-label' %>
        <%= select_tag 'return_context[category]', options_for_select(Product::CATEGORIES.invert, @context[:category]),
                       include_blank: 'All categories', id: 'equipment_category',
                       data: { equipment_selection_target: 'category', action: 'change->equipment-selection#filter' }, class: 'form-input' %>
      </div>
      <div>
        <%= label_tag :equipment_program_group, 'Disability group', class: 'form-label' %>
        <%= select_tag 'return_context[program_group]', options_for_select(Product::PROGRAM_GROUPS.invert, @context[:program_group]),
                       include_blank: 'All program groups', id: 'equipment_program_group',
                       data: { equipment_selection_target: 'programGroup', action: 'change->equipment-selection#filter' }, class: 'form-input' %>
      </div>
      <% if @context[:tab].in?(%w[ordered shipped]) %>
        <div>
          <%= label_tag :equipment_source, 'Equipment source', class: 'form-label' %>
          <%= select_tag 'return_context[source]', options_for_select([['From program stock', 'stock'], ['From vendor', 'vendor']], @context[:source]),
                         include_blank: 'All sources', id: 'equipment_source',
                         data: { equipment_selection_target: 'source', action: 'change->equipment-selection#filter' }, class: 'form-input' %>
        </div>
      <% end %>
    </div>
    <%= form.submit 'Apply filters', class: 'btn btn-secondary' %>
  <% end %>
  <%= tag.p 'No equipment matches these filters.', class: 'rounded bg-gray-50 p-4', data: { equipment_selection_target: 'empty' }, hidden: @groups.any? %>
  <% if @context[:tab] == 'shipped' %>
    <%= render 'product_groups', groups: @groups, return_context: @context, available_counts: @available_counts %>
  <% else %>
    <%= form_with url: (@context[:tab] == 'ordered' ? new_admin_equipment_shipment_path : new_admin_bid_group_path), method: :get,
                  id: 'equipment-selection-form', class: 'space-y-4' do |form| %>
      <% @context.reverse_merge(search: nil, product_id: nil, manufacturer: nil, category: nil, program_group: nil, source: nil).each do |key, value| %>
        <%= hidden_field_tag "return_context[#{key}]", value, id: nil, data: { equipment_selection_target: 'contextField' } %>
      <% end %>
      <% if @context[:tab] == 'needs_ordering' %>
        <p class="text-sm text-gray-700">The quantity shown leaves out devices already in a bid. “In stock?” shows whether stock covers this request. Stock is shared across constituents; selecting a row doesn’t reserve it.</p>
      <% end %>
      <p role="status" data-equipment-selection-target="summary">0 selected</p>
      <button type="button" data-action="equipment-selection#selectMatching" class="btn btn-outline">Select matching</button>
      <% if @context[:tab] == 'ordered' %>
        <%= render 'dispatch_groups', groups: @dispatch_groups, return_context: @context %>
      <% else %>
        <%= render 'product_groups', groups: @groups, return_context: @context, available_counts: @available_counts %>
      <% end %>
      <div class="flex flex-wrap gap-4">
        <% if @context[:tab] == 'needs_ordering' %>
          <%= form.submit 'Enter bid number', class: 'btn btn-primary' %>
          <%= button_tag 'Use stock', type: 'submit', formaction: new_admin_stock_allocation_path, class: 'btn btn-outline' %>
        <% else %>
          <%= form.submit 'Enter shipping info', class: 'btn btn-primary' %>
        <% end %>
      </div>
      <% if @context[:tab] == 'needs_ordering' %>
        <p class="text-sm text-gray-700">Use stock lets you check quantities, device setup and shipping addresses first. Choose Reserve for dispatch on the next page to set the devices aside, then open Enter shipping info when they ship.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
