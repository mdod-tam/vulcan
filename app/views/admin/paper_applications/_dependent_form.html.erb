<%# 
  Dependent Information Form
  
  This partial provides dependent information with:
  - Personal identification
  - Contact information (with guardian fallback options)
  - Communication preferences
  - Guardian relationship type
%>

<%# The submission being re-rendered, if any. Hoisted so every section below -- contact strategy,
    the dependent's own contact values, and the relationship select -- reads one source. %>
<% on_file_dependent = defined?(on_file_dependent) ? on_file_dependent : nil %>
<%# An existing dependent's identity is on-file fact, not paper-intake input. See
    docs/development/paper_application_retry_contract.md for why this is read-only. %>
<% identity_record = on_file_dependent || dependent %>
<% identity_read_only = mode == :edit && identity_record.present? %>
<% submitted_dependent_params = (@paper_application.is_a?(Hash) ? @paper_application[:submitted_params] : nil).to_h.with_indifferent_access %>

<fieldset id="dependent-info-section" class="mb-6 p-4 border border-gray-200 rounded-lg bg-white shadow-sm" data-controller="dependent-fields">
  <%# Short by design. The status card below already announces which dependent is selected, and
      repeating the name here made a screen reader read it twice before reaching the details. %>
  <legend class="text-lg font-semibold text-gray-900 px-2">
    <%= mode == :edit && dependent.present? ? 'Dependent Information' : 'New Dependent Information' %>
  </legend>

  <%# One summary card, not four restatements. The identity used to appear in the legend, a banner,
      the <dl>, and a trailing note; a screen reader read the name four times before the form. %>
  <% if identity_read_only %>
    <div id="existing-dependent-summary"
         class="mb-4 p-4 bg-blue-50 border border-blue-200 rounded-md text-sm">
      <h3 class="text-sm font-semibold text-blue-900">Existing dependent selected</h3>

      <%# Only the selection is announced. The guidance and the change-selection control sit outside
          this region deliberately: inside it, every Turbo re-render would replay the whole
          paragraph. %>
      <p class="mt-1 text-blue-900" role="status">
        Existing dependent selected: <%= identity_record.full_name %><% if identity_record.date_of_birth.present? %>, date of birth <%= identity_record.date_of_birth.to_fs(:long) %><% end %>.
      </p>

      <p class="mt-2 text-blue-800">
        The name and date of birth below come from the dependent's existing record. This paper
        application will not change them.
      </p>

      <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-3">
        <div>
          <dt class="block text-sm font-medium text-gray-700">First Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= identity_record.first_name %></dd>
        </div>
        <div>
          <dt class="block text-sm font-medium text-gray-700">Last Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= identity_record.last_name %></dd>
        </div>
        <div>
          <dt class="block text-sm font-medium text-gray-700">Date of Birth</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= identity_record.date_of_birth&.to_fs(:long) %></dd>
        </div>
      </dl>

      <%# Two different problems, two different answers. Telling staff to pick someone else when it
          is the *record* that is wrong would push them toward creating a duplicate. %>
      <p class="mt-3 text-blue-800">
        If this paper application is for someone else, change the selection. If this is the correct
        dependent but the record is wrong, contact the MAT support team before submitting.
        <strong>Do not create a new dependent to work around incorrect details.</strong>
      </p>

      <%# Clears the dependent only. The picker's own control higher up calls `clearSelection`,
          which also drops `guardian_id`, the dependents frame and the last-application context --
          far more than a button in the dependent card should do.
          Labelled "Change Dependent", not "Change Selection", because the guardian card already
          owns that exact label with the wider meaning. Two identically named buttons doing
          different things is precisely the confusion this card exists to remove, and a screen
          reader listing controls would announce the same name twice.
          Addressed to `applicant-type`, which wraps the whole form, rather than to guardian-picker
          directly: this frame renders *outside* the guardian-picker element on initial selection
          (and inside it on retry), so a guardian-picker action would bind on one path only.
          applicant-type already declares the picker as an outlet and forwards the intent. %>
      <button type="button"
              class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-600 hover:text-gray-800 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
              data-action="applicant-type#changeDependent">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Change Dependent
      </button>
    </div>
  <% end %>

  <%= fields_for :constituent do |d| %>
    <%# ================================================================ %>
    <%# SECTION 1: Personal Identification %>
    <%# ================================================================ %>
    <div class="mb-6">
      <h3 class="text-base font-medium text-gray-800 mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        Dependent's Personal Information
      </h3>
      
      <%# Read-only by decision, not by omission. Name and date of birth are the identity tuple
          duplicate detection matches on and the identity decision is signed over, and the paper
          writer does not own identity changes -- it never persisted edits to these fields. They
          were rendered as inputs anyway, so a correction looked accepted and was silently
          discarded. No hidden copies are submitted either: `dependent_id` alone says which record
          this is.
          The values themselves render in the summary card above, so nothing appears here. %>
      <% unless identity_read_only %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <div>
          <%= d.label :first_name, "First Name", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_first_name" %>
          <%= d.text_field :first_name, 
              id: "dependent_constituent_first_name",
              value: dependent&.first_name,
              required: true,
              autocomplete: "given-name",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              "aria-required": "true",
              data: { "applicant-type-target": "dependentField" } %>
        </div>
        <div>
          <%= d.label :last_name, "Last Name", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_last_name" %>
          <%= d.text_field :last_name,
              id: "dependent_constituent_last_name", 
              value: dependent&.last_name,
              required: true,
              autocomplete: "family-name",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              "aria-required": "true",
              data: { "applicant-type-target": "dependentField" } %>
        </div>
        <div>
          <%= d.label :date_of_birth, "Date of Birth", class: "block text-sm font-medium text-gray-700" %>
          <%= d.text_field :date_of_birth,
              id: "dependent_constituent_date_of_birth",
              value: accessible_date_value(dependent&.date_of_birth),
              required: true,
              autocomplete: "bday",
              inputmode: "numeric",
              placeholder: "MM/DD/YYYY",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              "aria-required": "true",
              "aria-describedby": "dependent_dob_hint",
              data: { "applicant-type-target": "dependentField" } %>
          <% if mode == :edit && dependent.present? %>
            <p id="dependent_dob_hint" class="text-xs text-amber-600 mt-1">Enter as MM/DD/YYYY. Verify carefully before changing.</p>
          <% else %>
            <p id="dependent_dob_hint" class="text-xs text-gray-500 mt-1">Enter date of birth as MM/DD/YYYY</p>
          <% end %>
        </div>
      </div>
      <% end %>
    </div>

    <%# ================================================================ %>
    <%# SECTION 2: Contact Information (with Guardian fallback) %>
    <%# ================================================================ %>
    <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200" data-controller="contact-feedback">
      <h3 class="text-base font-medium text-gray-800 mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Contact Information
      </h3>
      <p class="text-sm text-gray-600 mb-4">
        <%= t("applications.dependent_contact.strategy_help") %>
      </p>
      
      <%# Dependent no-email: UI-only; selects guardian email strategy (not a shared top-level flag) %>
      <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
        <label class="flex items-start cursor-pointer">
          <input type="checkbox"
                 id="dependent_no_email_address"
                 class="mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                 data-action="change->contact-feedback#toggleDependentNoEmail">
          <span class="ml-3">
            <span class="block text-sm font-medium text-gray-700">Dependent does not have an email address</span>
            <span class="block text-xs text-gray-500 mt-1">Uses guardian email strategy; official documents will be sent by printed letter unless the dependent has their own email.</span>
          </span>
        </label>
      </div>
      
      <%# `dependent_email` / `dependent_phone` are submitted parameters rather than columns, so
          assigning them to the rebuilt record does nothing -- they have to be read back from the
          submission directly or a retry renders them blank. %>
      <% submitted_dependent_constituent = submitted_dependent_params[:constituent] || {} %>
      <%# `key?`, not `.presence`: staff clearing a field on purpose is an answer, and falling back
          to the on-file value would quietly put back the contact they just removed. Absent means the
          form was never submitted; present-but-blank means blank. %>
      <% dependent_own_email = submitted_dependent_constituent.key?(:dependent_email) ?
                                 submitted_dependent_constituent[:dependent_email] :
                                 dependent&.paper_intake_own_email %>
      <% dependent_own_phone = submitted_dependent_constituent.key?(:dependent_phone) ?
                                 submitted_dependent_constituent[:dependent_phone] :
                                 dependent&.paper_intake_own_phone %>
      <%# On a re-render after a failed submission the submitted values are the newer answer, so they
          win over whatever the record implies. `nil` means not submitted at all -- a fresh form --
          which is different from having been submitted as unchecked. %>
      <% submitted_use_guardian_email = submitted_dependent_params.key?(:use_guardian_email) ? ActiveModel::Type::Boolean.new.cast(submitted_dependent_params[:use_guardian_email]) : nil %>
      <% submitted_use_guardian_phone = submitted_dependent_params.key?(:use_guardian_phone) ? ActiveModel::Type::Boolean.new.cast(submitted_dependent_params[:use_guardian_phone]) : nil %>
      <% submitted_use_guardian_address = submitted_dependent_params.key?(:use_guardian_address) ? ActiveModel::Type::Boolean.new.cast(submitted_dependent_params[:use_guardian_address]) : nil %>
      <% use_guardian_address_default = submitted_use_guardian_address.nil? ? (dependent.blank? || dependent&.physical_address_1.blank?) : submitted_use_guardian_address %>
      <% use_guardian_email_default = submitted_use_guardian_email.nil? ? (dependent.blank? || dependent.paper_intake_uses_guardian_email?) : submitted_use_guardian_email %>
      <% use_guardian_phone_default = submitted_use_guardian_phone.nil? ? (dependent.blank? || dependent.paper_intake_uses_guardian_phone?) : submitted_use_guardian_phone %>

      <%# Email Section %>
      <div class="mb-5 p-3 bg-white rounded border border-gray-200">
        <div class="flex items-start mb-3">
          <%# Hidden companion so an unchecked box is still submitted as "0". Without it a retry
              cannot distinguish a deliberate uncheck from an absent parameter. %>
          <%= hidden_field_tag :use_guardian_email, "0", id: nil %>
          <%= check_box_tag :use_guardian_email, "1", use_guardian_email_default, {
            id: "use_guardian_email_checkbox",
            class: "mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded", 
            data: { 
              dependent_fields_target: "sameEmailCheckbox",
              action: "change->dependent-fields#toggleEmailField"
            }
          } %>
          <label for="use_guardian_email_checkbox" class="ml-2">
            <span class="block text-sm font-medium text-gray-700">Use guardian's email address</span>
            <span class="block text-xs text-gray-500"><%= t("applications.dependent_contact.guardian_email_help") %></span>
          </label>
        </div>
        
        <div class="ml-6 <%= 'hidden' if use_guardian_email_default %>" data-dependent-fields-target="emailFieldContainer">
          <%= d.label :dependent_email, "Dependent's Email Address", class: "block text-sm font-medium text-gray-700" %>
          <%= d.email_field :dependent_email, 
              value: dependent_own_email,
              autocomplete: "email",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
              data: { 
                dependent_fields_target: "dependentEmail",
                "contact-feedback-target": "email"
              } %>
          <p class="mt-1 text-xs text-gray-500"><%= t("applications.dependent_contact.dependent_email_help") %></p>
        </div>
      </div>
      
      <%# Phone Section %>
      <div class="mb-5 p-3 bg-white rounded border border-gray-200">
        <div class="flex items-start mb-3">
          <%# Hidden companion so an unchecked box is still submitted as "0". Without it a retry
              cannot distinguish a deliberate uncheck from an absent parameter. %>
          <%= hidden_field_tag :use_guardian_phone, "0", id: nil %>
          <%= check_box_tag :use_guardian_phone, "1", use_guardian_phone_default, {
            id: "use_guardian_phone_checkbox",
            class: "mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded", 
            data: { 
              dependent_fields_target: "samePhoneCheckbox",
              action: "change->dependent-fields#togglePhoneField"
            }
          } %>
          <label for="use_guardian_phone_checkbox" class="ml-2">
            <span class="block text-sm font-medium text-gray-700">Use guardian's phone number</span>
            <span class="block text-xs text-gray-500"><%= t("applications.dependent_contact.guardian_phone_help") %></span>
          </label>
        </div>
        
        <div class="ml-6 <%= 'hidden' if use_guardian_phone_default %>" data-dependent-fields-target="phoneFieldContainer">
          <%= d.label :dependent_phone, "Dependent's Phone Number", class: "block text-sm font-medium text-gray-700" %>
          <%= d.telephone_field :dependent_phone, 
              value: dependent_own_phone,
              autocomplete: "tel",
              placeholder: "XXX-XXX-XXXX",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
              data: { 
                dependent_fields_target: "dependentPhone",
                "contact-feedback-target": "phone"
              } %>
        </div>
      </div>

      <%# Preferred Contact Method for Dependent %>
      <fieldset class="mb-4" aria-describedby="dependent_contact_method_help dependent_contact_method_feedback">
        <legend class="text-sm font-medium text-gray-700 mb-2">Contact method</legend>
        <p id="dependent_contact_method_help" class="text-xs text-gray-500 mb-2">How would you like us to contact the dependent if we have any questions?</p>
        <div class="flex flex-wrap gap-4">
          <div class="flex items-center">
            <%= d.radio_button :phone_type, "voice", 
                id: "dependent_constituent_phone_type_voice", 
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateFeedback" } %>
            <%= d.label :phone_type_voice, "Call them", for: "dependent_constituent_phone_type_voice", class: "ml-2 text-sm text-gray-700" %>
          </div>
          <div class="flex items-center">
            <%= d.radio_button :phone_type, "text", 
                id: "dependent_constituent_phone_type_text", 
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateFeedback" } %>
            <%= d.label :phone_type_text, "Text them", for: "dependent_constituent_phone_type_text", class: "ml-2 text-sm text-gray-700" %>
          </div>
          <div class="flex items-center">
            <%= d.radio_button :phone_type, "videophone", 
                id: "dependent_constituent_phone_type_videophone", 
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateFeedback" } %>
            <%= d.label :phone_type_videophone, "Call using ASL (videophone)", for: "dependent_constituent_phone_type_videophone", class: "ml-2 text-sm text-gray-700" %>
          </div>
          <div class="flex items-center">
            <%= d.radio_button :phone_type, "email", 
                id: "dependent_constituent_phone_type_email", 
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateFeedback" } %>
            <%= d.label :phone_type_email, "Email them", for: "dependent_constituent_phone_type_email", class: "ml-2 text-sm text-gray-700" %>
          </div>
          <div class="flex items-center">
            <%= d.radio_button :phone_type, "letter", 
                id: "dependent_constituent_phone_type_letter", 
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateFeedback" } %>
            <%= d.label :phone_type_letter, "Send a letter", for: "dependent_constituent_phone_type_letter", class: "ml-2 text-sm text-gray-700" %>
          </div>
        </div>
        <div id="dependent_contact_method_feedback" data-contact-feedback-target="feedback" class="hidden" aria-live="polite"></div>
      </fieldset>
      
      <%# Address Section %>
      <div class="p-3 bg-white rounded border border-gray-200">
        <div class="flex items-start mb-3">
          <%# Hidden companion so an unchecked box is still submitted as "0". Without it a retry
              cannot distinguish a deliberate uncheck from an absent parameter, and "Same address as
              guardian" silently flips back on after a failure. %>
          <%= hidden_field_tag :use_guardian_address, "0", id: nil %>
          <%= check_box_tag :use_guardian_address, "1", use_guardian_address_default, {
            id: "use_guardian_address_checkbox",
            class: "mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded", 
            data: { 
              dependent_fields_target: "sameAddressCheckbox",
              action: "change->dependent-fields#toggleContactFields"
            }
          } %>
          <label for="use_guardian_address_checkbox" class="ml-2">
            <span class="block text-sm font-medium text-gray-700">Same address as guardian</span>
            <span class="block text-xs text-gray-500">Dependent lives with guardian</span>
          </label>
        </div>
        
        <div class="ml-6 space-y-4 <%= 'hidden' if dependent.blank? || dependent&.physical_address_1.blank? %>" data-dependent-fields-target="addressFields">
          <div>
            <%= d.label :physical_address_1, "Street Address", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_physical_address_1" %>
            <%= d.text_field :physical_address_1, 
                id: "dependent_constituent_physical_address_1", 
                value: dependent&.physical_address_1,
                autocomplete: "address-line1",
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                data: { dependent_fields_target: "dependentAddress1", contact_feedback_target: "address1" } %>
          </div>
          <div>
            <%= d.label :physical_address_2, "Apt, suite, unit (optional)", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_physical_address_2" %>
            <%= d.text_field :physical_address_2, 
                id: "dependent_constituent_physical_address_2", 
                value: dependent&.physical_address_2,
                autocomplete: "address-line2",
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                data: { dependent_fields_target: "dependentAddress2", contact_feedback_target: "address2" } %>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="col-span-2">
              <%= d.label :city, "City", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_city" %>
              <%= d.text_field :city, 
                  id: "dependent_constituent_city", 
                  value: dependent&.city,
                  autocomplete: "address-level2",
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                  data: { dependent_fields_target: "dependentCity", contact_feedback_target: "city" } %>
            </div>
            <div>
              <%= d.label :state, "State", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_state" %>
              <%= d.text_field :state, 
                  id: "dependent_constituent_state", 
                  value: (dependent&.state || "MD"),
                  autocomplete: "address-level1",
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                  data: { dependent_fields_target: "dependentState", contact_feedback_target: "state" } %>
            </div>
            <div>
              <%= d.label :zip_code, "ZIP Code", class: "block text-sm font-medium text-gray-700", for: "dependent_constituent_zip_code" %>
              <%= d.text_field :zip_code, 
                  id: "dependent_constituent_zip_code", 
                  value: dependent&.zip_code,
                  autocomplete: "postal-code",
                  pattern: "[0-9]{5}(-[0-9]{4})?",
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                  data: { dependent_fields_target: "dependentZip", contact_feedback_target: "zipCode" } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ================================================================ %>
    <%# SECTION 3: Communication & Accessibility Preferences %>
    <%# ================================================================ %>
    <div class="mb-6 p-4 bg-indigo-50 rounded-lg border border-indigo-100">
      <h3 class="text-base font-medium text-gray-800 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        Dependent's Communication Preferences
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%# Language Preference %>
        <div>
          <%= d.label :locale, "Preferred Language", class: "block text-sm font-medium text-gray-700 mb-1", for: "dependent_constituent_locale" %>
          <%= d.select :locale, 
              options_for_select([
                ["English", "en"], 
                ["Spanish", "es"]
              ], dependent&.locale || "en"), 
              { prompt: "Select Language" }, 
              id: "dependent_constituent_locale",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              data: {
                paper_application_target: "applicantLocale",
                action: "change->paper-application#updateLanguagePreferenceNotices"
              } %>
        </div>

        <%# Preferred Communication Method (ASL, Written, etc.) %>
        <div>
          <%= d.label :preferred_means_of_communication, "How does the dependent prefer to communicate?", class: "block text-sm font-medium text-gray-700 mb-1", for: "dependent_constituent_preferred_comm" %>
          <%= d.select :preferred_means_of_communication, 
              options_for_select([
                ["Voice (spoken language)", "voice"],
                ["Read lips", "lip_reading"],
                ["American Sign Language (ASL)", "asl"],
                ["Signed English", "signed_english"],
                ["Written notes", "written"],
                ["Typed communication", "typed"],
                ["Braille", "braille"],
                ["Augmentative & Alternative Communication (AAC)", "aac"]
              ], dependent&.preferred_means_of_communication), 
              { prompt: "Select preference", include_blank: false }, 
              id: "dependent_constituent_preferred_comm",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              "aria-describedby": "dependent_comm_method_hint" %>
          <p id="dependent_comm_method_hint" class="mt-1 text-xs text-gray-500">This helps us communicate in their preferred way</p>
        </div>
      </div>

      <%# Official Document Delivery Preference %>
      <fieldset class="mt-6 p-4 bg-blue-50 border-2 border-blue-200 rounded-lg" aria-describedby="dependent_document_delivery_help dependent_document_delivery_feedback">
        <legend class="text-base font-semibold text-blue-900 mb-1 px-2">
          Document delivery
        </legend>
        <p id="dependent_document_delivery_help" class="text-xs text-blue-800 mb-3">Where should we send official program documents?</p>
        <p class="text-sm text-blue-700 mb-3 px-2">
          Important notices, approval letters, and voucher information will be delivered here
        </p>
        <div class="flex flex-wrap gap-6">
          <div class="flex items-start">
            <%= d.radio_button :communication_preference, "email", 
                id: "dependent_constituent_communication_preference_email", 
                class: "mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateDeliveryFeedback" } %>
            <label for="dependent_constituent_communication_preference_email" class="ml-2">
              <span class="block text-sm font-medium text-gray-700">Email</span>
              <span class="block text-xs text-gray-500">Faster delivery, easy to save</span>
            </label>
          </div>
          <div class="flex items-start">
            <%= d.radio_button :communication_preference, "letter", 
                id: "dependent_constituent_communication_preference_letter", 
                class: "mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300",
                data: { action: "change->contact-feedback#updateDeliveryFeedback" } %>
            <label for="dependent_constituent_communication_preference_letter" class="ml-2">
              <span class="block text-sm font-medium text-gray-700">Printed letter by mail</span>
              <span class="block text-xs text-gray-500">Physical copy to your address</span>
            </label>
          </div>
        </div>
        <%# Live feedback for delivery method %>
        <div id="dependent_document_delivery_feedback" data-contact-feedback-target="deliveryFeedback" class="hidden" aria-live="polite"></div>
      </fieldset>
    </div>

    <%# ================================================================ %>
    <%# SECTION 4: How Did You Hear About Us %>
    <%# ================================================================ %>
    <div class="mb-4">
      <%= d.label :referral_source, "How did you hear about the MAT Program?", class: "block text-sm font-medium text-gray-700 mb-1", for: "dependent_constituent_referral_source" %>
      <%= d.select :referral_source, 
          options_for_select([
            ["Certifying professional / Doctor's office", "medical_provider"],
            ["Social worker / Case manager", "social_worker"],
            ["State agency (DORS, MDOD, etc.)", "state_agency"],
            ["Community organization", "community_org"],
            ["Friend or family member", "friend_family"],
            ["Internet search", "internet"],
            ["Social media", "social_media"],
            ["Other", "other"]
          ], dependent&.referral_source), 
          { prompt: "Select an option (optional)", include_blank: true }, 
          id: "dependent_constituent_referral_source",
          class: "mt-1 block w-full rounded-md border-gray-300 bg-white shadow-sm ring-1 ring-inset ring-gray-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  <% end %>
  
  <%# ================================================================ %>
  <%# SECTION 5: Guardian Relationship Type %>
  <%# ================================================================ %>
  <div class="mt-6 p-4 bg-amber-50 rounded-lg border border-amber-200">
    <label for="relationship_type" class="block text-sm font-medium text-gray-700 mb-1">
      Guardian's Relationship to Dependent
      <span class="text-red-500" aria-hidden="true">*</span>
    </label>
    <select id="relationship_type" 
            name="relationship_type" 
            required
            class="mt-1 block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" 
            aria-required="true"
            data-dependent-fields-target="relationshipType">
      <option value="">Select Relationship</option>
      <option value="Parent" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Parent' %>>Parent</option>
      <option value="Grandparent" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Grandparent' %>>Grandparent</option>
      <option value="Foster Parent" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Foster Parent' %>>Foster Parent</option>
      <option value="Legal Guardian" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Legal Guardian' %>>Legal Guardian</option>
      <option value="Relative Caregiver" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Relative Caregiver' %>>Relative Caregiver</option>
      <option value="Power of Attorney" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Power of Attorney' %>>Power of Attorney</option>
      <option value="Other" <%= 'selected' if submitted_dependent_params[:relationship_type] == 'Other' %>>Other</option>
    </select>
    <p class="mt-1 text-xs text-gray-600">This helps us understand who is authorized to manage this application</p>
  </div>
</fieldset>
