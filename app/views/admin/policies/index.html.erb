<%= turbo_frame_tag "policies" do %>
  <main class="container mx-auto px-4 py-8" role="main" aria-labelledby="edit-policies-title">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold" id="edit-policies-title">System Policies</h1>
      <div>
        <a href="<%= admin_dashboard_path %>"
           class="btn btn-outline"
           data-turbo-frame="_top"
           aria-label="Return to applications dashboard">
          Back to Dashboard
        </a>
      </div>
    </div>
    
    <div class="card">
      <div class="p-6 border-b border-gray-200">
        <h1 class="text-2xl font-semibold text-gray-900">
          System Policies
        </h1>
      </div>

      <%= render "policies_form" %>
    </div>
  </main>
<% end %>
