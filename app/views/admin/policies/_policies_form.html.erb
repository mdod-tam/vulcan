<%= form_with url: bulk_update_admin_policies_path, method: :patch, data: { turbo_frame: '_top' } do |form| %>
  <div class="p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Federal Poverty Level (FPL) Settings</h2>

    <div class="bg-warning-50 border-l-4 border-warning-400 p-4 mb-6">
      <p class="text-sm text-warning-700">
        These values should be updated annually when new Federal Poverty Level guidelines are released,
        typically in January or February.
      </p>
    </div>

    <div class="mb-6">
      <% if @modifier_policy %>
        <div class="flex flex-wrap items-center gap-4">
          <%= hidden_field_tag 'policies[][id]', @modifier_policy.id, id: nil %>
          <label for="policies_<%= @modifier_policy.id %>_value" class="form-label">
            FPL Modifier Percentage
          </label>
          <div class="relative rounded-md shadow-elevation-1 w-32">
            <%= number_field_tag 'policies[][value]', @modifier_policy.value, id: "policies_#{@modifier_policy.id}_value", autocomplete: 'off', class: 'form-input pr-8',
                                                                              required: true, min: 100, step: 100 %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
              <span class="text-gray-500 sm:text-sm">%</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Household Size
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Base FPL Amount
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Calculated Threshold (<%= @modifier_policy&.value %>%)
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @fpl_policy_rows.each do |size, _, policy| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= size %> <%= 'Person'.pluralize(size) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if policy %>
                  <%= hidden_field_tag 'policies[][id]', policy.id, id: nil %>
                  <%= label_tag "policies_#{policy.id}_value", "Base FPL for #{size} #{'person'.pluralize(size)}", class: 'sr-only' %>
                  <div class="relative rounded-md shadow-elevation-1 w-48">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <span class="text-gray-500 sm:text-sm">$</span>
                    </div>
                    <%= number_field_tag 'policies[][value]',
                                         policy.value,
                                         id: "policies_#{policy.id}_value", autocomplete: 'off',
                                         class: 'form-input pl-7',
                                         required: true,
                                         min: 0 %>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <% if policy && @modifier_policy %>
                  <%= number_to_currency(policy.value * @modifier_policy.value / 100) %>
                <% else %>
                  <span class="text-gray-500">Not available</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-4">
      <% if @additional_person_policy %>
        <%= hidden_field_tag 'policies[][id]', @additional_person_policy.id, id: nil %>
        <%= label_tag "policies_#{@additional_person_policy.id}_value",
                      "Base FPL added for each person above #{IncomeThresholdCalculationService::TABLE_HOUSEHOLD_SIZE}", class: 'form-label' %>
        <div class="relative rounded-md w-48">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500" aria-hidden="true">$</span>
          <%= number_field_tag 'policies[][value]', @additional_person_policy.value,
                               id: "policies_#{@additional_person_policy.id}_value", min: 1, required: true,
                               autocomplete: 'off', class: 'form-input pl-7' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="p-6 border-t border-gray-200">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Proof Submission Rate Limits</h2>

    <div class="bg-info-50 border-l-4 border-info-400 p-4 mb-6">
      <p class="text-sm text-info-700">
        Configure how many proof submissions are allowed within a time period.
        Portal and secure-form submissions are rate limited through the web interface.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6">
      <div>
        <%= render 'admin/policies/rate_limit_input', policy: @period_policy, label: 'Time Window (hours)' %>
      </div>

      <div class="grid grid-cols-1 gap-6">
        <div>
          <%= render 'admin/policies/rate_limit_input', policy: @web_policy, label: 'Portal Submissions' %>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6 border-t border-gray-200">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Voucher Policies</h2>

    <div class="bg-info-50 border-l-4 border-info-400 p-4 mb-6">
      <p class="text-sm text-info-700">
        Configure the voucher values for each disability type and other voucher-related settings.
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Disability Type
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Voucher Value ($)
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @voucher_disability_rows.each do |disability_type, _, policy| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= disability_type.titleize %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if policy %>
                  <%= hidden_field_tag 'policies[][id]', policy.id, id: nil %>
                  <%= label_tag "policies_#{policy.id}_value", "#{disability_type.titleize} voucher value", class: 'sr-only' %>
                  <div class="relative rounded-md shadow-elevation-1 w-48">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <span class="text-gray-500 sm:text-sm">$</span>
                    </div>
                    <%= number_field_tag 'policies[][value]',
                                         policy.value,
                                         id: "policies_#{policy.id}_value", autocomplete: 'off',
                                         class: 'form-input pl-7',
                                         required: true,
                                         min: 0 %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6">
      <h3 class="text-base font-medium text-gray-900 mb-4">Other Voucher Settings</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Setting
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Value
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @voucher_setting_rows.each do |key, policy| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= key.gsub('voucher_', '').humanize %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if policy %>
                    <%= hidden_field_tag 'policies[][id]', policy.id, id: nil %>
                    <%= label_tag "policies_#{policy.id}_value", key.delete_prefix('voucher_').humanize, class: 'sr-only' %>
                    <div class="relative rounded-md shadow-elevation-1 w-48">
                      <%= number_field_tag 'policies[][value]',
                                           policy.value,
                                           id: "policies_#{policy.id}_value", autocomplete: 'off',
                                           class: 'form-input',
                                           required: true,
                                           min: 0 %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <section class="p-6 border-t border-gray-200" aria-labelledby="other-system-policies-title">
    <h2 id="other-system-policies-title" class="text-lg font-medium text-gray-900 mb-4">Other System Policies</h2>

    <div class="divide-y divide-gray-200">
      <% @policies
           .reject { |p| p.key.start_with?('fpl_') }
           .reject { |p| p.key.start_with?('proof_submission_rate_') }
           .reject { |p| p.key.start_with?('voucher_') }
           .each do |policy| %>
        <% details = system_policy_details(policy.key) # rubocop:disable Lint/UselessAssignment -- Used by the following ERB output tags. %>
        <div class="grid gap-3 py-4 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-6">
          <div class="min-w-0 text-sm text-gray-900">
            <%= label_tag "policies_#{policy.id}_value", details[:label], class: 'block font-medium' %>
            <p id="policy_<%= policy.id %>_description" class="mt-1 max-w-2xl text-gray-600"><%= details[:description] %></p>
          </div>
          <div>
            <%= hidden_field_tag 'policies[][id]', policy.id, id: nil %>
            <%= number_field_tag 'policies[][value]',
                                 policy.value,
                                 id: "policies_#{policy.id}_value", autocomplete: 'off',
                                 aria: { describedby: "policy_#{policy.id}_description policy_#{policy.id}_unit" },
                                 class: 'form-input w-32',
                                 required: true,
                                 min: 0 %>
            <p id="policy_<%= policy.id %>_unit" class="mt-1 text-sm text-gray-600"><%= details[:unit] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <div class="p-6 border-t border-gray-200">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Recent Policy Changes</h2>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Date
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Policy
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Changed By
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Previous Value
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              New Value
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_changes.each do |change| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= change.created_at.strftime('%B %d, %Y %I:%M %p') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= change.policy.key.titleize %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <%= change.user.full_name %>
                </div>
                <div class="text-xs text-gray-500">
                  <%= change.user.email %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_policy_value(change.policy.key, change.previous_value) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_policy_value(change.policy.key, change.new_value) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @recent_changes.empty? %>
        <p class="text-sm text-gray-500 text-center py-4">No recent policy changes</p>
      <% end %>
    </div>

    <div class="mt-4 text-right">
      <%= link_to changes_admin_policies_path,
                  data: { turbo_frame: 'policies' },
                  class: 'text-sm text-primary-600 hover:text-primary-500' do %>
        View Full Change History
        <span aria-hidden="true"> &rarr;</span>
      <% end %>
    </div>
  </div>

  <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3">
    <%= link_to 'Cancel',
                admin_dashboard_path,
                class: 'btn btn-outline', data: { turbo_frame: '_top' } %>

    <%= form.submit 'Update Policies',
                    class: 'btn btn-primary' %>
  </div>
<% end %>
