<div class="flex items-center space-x-4">
  <% if policy.present? %>
    <%= hidden_field_tag "policies[][id]", policy.id %>
    <label for="policies_<%= policy.id %>_value" class="form-label">
      <%= label %>
    </label>
    <div class="relative rounded-md shadow-elevation-1 w-32">
      <%= number_field_tag "policies[][value]",
          policy.value,
          class: "form-input",
          required: true,
          min: 1,
          max: 100,
          step: 1 %>
    </div>
  <% else %>
    <p class="text-sm text-danger-600">Policy not found: <%= label %></p>
  <% end %>
</div>
