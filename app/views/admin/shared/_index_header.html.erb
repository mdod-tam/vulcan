<%# locals: (title:, applications_link: true, title_id: nil) -%>
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <%= tag.h1 title, id: title_id, class: 'text-2xl font-bold' %>
  <nav aria-label="Return navigation" class="flex flex-wrap gap-3">
    <%= link_to 'Back to Dashboard', admin_dashboard_path, class: 'btn btn-outline', data: { turbo_frame: '_top' } %>
    <% if applications_link %>
      <%= link_to 'Back to Applications', admin_applications_path, class: 'btn btn-outline', data: { turbo_frame: '_top' } %>
    <% end %>
  </nav>
</div>
