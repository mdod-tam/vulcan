<%# Switches between Email Templates and Rejection Reasons; the current section is the filled button. %>
<% current_section = local_assigns.fetch(:current, :email_templates) %>
<% secondary_link = 'btn btn-outline' %>
<% primary_link = 'btn btn-primary' %>
<nav aria-label="Emails and rejection reasons" class="mb-6">
  <ul class="flex flex-wrap gap-2">
    <li>
      <%= link_to admin_email_templates_path,
          class: current_section == :email_templates ? primary_link : secondary_link,
          aria: { current: ('page' if current_section == :email_templates) } do %>
        Email Templates
      <% end %>
    </li>
    <li>
      <%= link_to admin_rejection_reasons_path,
          class: current_section == :rejection_reasons ? primary_link : secondary_link,
          aria: { current: ('page' if current_section == :rejection_reasons) } do %>
        Rejection Reasons
      <% end %>
    </li>
  </ul>
</nav>
