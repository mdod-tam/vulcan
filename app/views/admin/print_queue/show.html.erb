<main class="container mx-auto px-4 py-8">
  <%= link_to 'Back to print queue', admin_print_queue_index_path, class: 'text-indigo-700 underline' %>
  <h1 class="mt-4 text-2xl font-bold">Letter #<%= @letter.id %></h1>
  <div class="mt-4 rounded-lg bg-white p-6 shadow">
    <dl class="space-y-2">
      <div><dt class="inline font-semibold">Recipient:</dt> <dd class="inline"><%= @letter.constituent.full_name %></dd></div>
      <div><dt class="inline font-semibold">Type:</dt> <dd class="inline"><%= @letter.letter_type.humanize %></dd></div>
      <div><dt class="inline font-semibold">Status:</dt> <dd class="inline"><%= @letter.status.humanize %></dd></div>
      <% if @letter.released_at %>
        <div><dt class="inline font-semibold">Release authorized:</dt> <dd class="inline"><%= l(@letter.released_at, format: :long) %></dd></div>
      <% end %>
      <% if @letter.canceled? %>
        <div><dt class="inline font-semibold">Canceled:</dt> <dd class="inline"><%= EmailDelivery::ControlPanel.reason_text(@letter.cancellation_reason) %></dd></div>
      <% end %>
    </dl>
    <p class="mt-4 max-w-prose text-sm text-gray-700">Downloading releases the final PDF for printing. Release does not confirm printing or delivery. Previously downloaded copies cannot be recalled.</p>
    <% unless @letter.canceled? %>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= button_to(@letter.released_at ? 'Download PDF again' : 'Release and download PDF',
                      release_admin_print_queue_path(@letter),
                      method: :post, form: { data: { turbo: false } },
                      class: 'rounded bg-blue-700 px-4 py-2 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2') %>
        <% if @letter.pending? && @letter.released_at %>
          <%= button_to 'Mark as Printed', mark_as_printed_admin_print_queue_path(@letter), method: :post,
                                                                                            class: 'rounded bg-green-700 px-4 py-2 text-white' %>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
