<section class="mb-8" aria-labelledby="print-attention-heading">
  <h2 id="print-attention-heading" class="mb-3 text-xl font-semibold">Needs attention</h2>
  <ul role="list" class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
    <% @preparation_notices.each do |notice| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-4">
        <span class="font-semibold text-danger-800"><%= notice.error_delivery_status? ? 'Letter preparation failed' : 'PDF overdue' %></span>
        <%= print_preparation_link(notice) %>
        <% if notice.error_delivery_status? %>
          <%= button_to 'Close follow-up', dismiss_preparation_failure_admin_print_queue_index_path,
                        params: { notification_id: notice.id }, aria: { label: "Close follow-up for notice ##{notice.id}" }, class: 'btn btn-outline' %>
        <% end %>
      </li>
    <% end %>
    <% @attention_letters.each do |letter| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-4">
        <span class="font-semibold text-danger-800"><%= print_queue_attention_reason(letter, refusal: @release_refusals&.fetch(letter.id, nil)) %></span>
        <%= link_to "Review letter ##{letter.id}", admin_print_queue_path(letter), class: 'text-primary-700 underline' %>
        <% if letter.canceled? %>
          <%= button_to 'Close follow-up', close_follow_up_admin_print_queue_path(letter),
                        aria: { label: "Close follow-up for letter ##{letter.id}" }, class: 'btn btn-outline' %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
