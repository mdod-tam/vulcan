<%# locals: (error: nil) -%>
<main id="print-queue-content" tabindex="-1" class="container mx-auto px-4 py-8">
  <% if error %>
    <p role="alert" tabindex="-1" data-print-release-error class="mb-4 rounded bg-red-50 p-4 text-red-800"><%= error %></p>
  <% end %>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Print Queue</h1>
    <%= link_to 'Communication settings', admin_email_templates_path(anchor: 'email-delivery'), class: 'text-indigo-700 underline' %>
    <%= link_to 'Back to Dashboard', admin_dashboard_path, class: 'text-indigo-700 underline' %>
  </div>
  <p class="mb-6 max-w-prose text-sm text-gray-700">Review letters before releasing their PDFs. All, Printed letters, category and template controls are checked at release. Mark printed only after physical printing; neither action confirms delivery to the recipient.</p>

  <%= render 'letters', letters: @pending_letters, title: 'Awaiting release', release: true, confirm: false %>
  <%= render 'letters', letters: @released_letters, title: 'Released — awaiting print confirmation', release: true, confirm: true %>
  <%= render 'letters', letters: @printed_letters, title: 'Recently printed', release: false, confirm: false %>
  <%= render 'letters', letters: @canceled_letters, title: 'Recently canceled', release: false, confirm: false %>
</main>
