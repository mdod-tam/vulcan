<%# locals: (error: nil) -%>
<main id="print-queue-content" tabindex="-1" class="container mx-auto px-4 py-8">
  <%= link_to 'Back to print queue', admin_print_queue_index_path, class: 'text-primary-700 underline' %>
  <h1 class="mb-4 mt-3 text-2xl font-bold" tabindex="-1" autofocus>Print batch</h1>
  <% if error %>
    <p role="alert" tabindex="-1" data-print-release-error class="mb-4 rounded bg-danger-50 p-4 text-danger-800"><%= error %></p>
  <% end %>
  <%= render 'letters', letters: @batch_letters, title: 'Batch letters', mode: :batch %>
</main>
