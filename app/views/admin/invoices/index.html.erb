<div class="container mx-auto px-4 py-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Invoices</h1>
    <div class="flex flex-wrap gap-3">
      <%= link_to 'Back to Dashboard', admin_applications_path,
                  data: { turbo_frame: '_top' }, class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm ' \
                                                        'text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
      <%= link_to 'Export CSV (all matching invoices)', admin_invoices_path(format: :csv, **request.query_parameters.except('page')),
                  class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
    </div>
  </div>

  <% if @generation_failures.any? %>
    <section aria-labelledby="failures-heading" class="mb-6 rounded-lg border border-red-200 bg-red-50 p-6">
      <h2 id="failures-heading" class="text-lg font-medium text-red-900 mb-1">Invoicing failed for <%= pluralize(@generation_failures.size, 'vendor') %></h2>
      <p class="text-sm text-red-800 mb-4">Their voucher redemptions are still waiting. Retry once the cause is fixed. A retry that runs without an error clears the vendor from this list, whether or not it creates an invoice.</p>
      <ul role="list" class="divide-y divide-red-200">
        <% @generation_failures.each do |failure| %>
          <li class="py-3 flex flex-wrap items-center justify-between gap-2 text-sm">
            <span>
              <span class="font-medium text-gray-900"><%= failure.vendor.business_name %></span>
              <span class="text-gray-700">· last tried <%= l(failure.attempted_at, format: :long) %> · <%= pluralize(failure.attempts, 'attempt') %></span>
            </span>
            <%= button_to 'Retry invoicing', generate_admin_invoices_path,
                          params: { vendor_id: failure.vendor_id }, class: invoice_form_class(:small),
                          form: { 'aria-label': "Retry invoicing for #{failure.vendor.business_name}" } %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section aria-labelledby="not-invoiced-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="not-invoiced-heading" class="text-lg font-medium text-gray-900 mb-1">Not yet invoiced</h2>
    <p class="text-sm text-gray-600 mb-4">
      Invoices are created automatically every 14 days for voucher redemptions made before the run day.
      "Invoice now" does the same for one vendor today. Voucher redemptions on hold are left out until released.
    </p>
    <% if @not_yet_invoiced.any? %>
      <ul role="list" class="divide-y divide-gray-200">
        <% @not_yet_invoiced.each do |vendor_id, business_name, billable_total, billable_count, held_count| %>
          <li class="py-3 flex flex-wrap items-center justify-between gap-2 text-sm">
            <span>
              <span class="font-medium text-gray-900"><%= business_name %></span>
              <span class="text-gray-700">· <%= number_to_currency(billable_total) %> in <%= pluralize(billable_count, 'voucher redemption') %></span>
              <% if held_count.positive? %>
                <span class="text-amber-800">· <%= held_count %> on hold</span>
              <% end %>
            </span>
            <% if billable_count.positive? %>
              <%= button_to 'Invoice now', generate_admin_invoices_path,
                            params: { vendor_id: vendor_id }, class: invoice_form_class(:small),
                            form: { 'aria-label': "Invoice now for #{business_name}" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">Every completed voucher redemption is on an invoice.</p>
    <% end %>
  </section>

  <section aria-labelledby="filters-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="filters-heading" class="text-lg font-medium text-gray-900 mb-4">Find invoices</h2>
    <%= form_with url: admin_invoices_path, method: :get, class: 'space-y-4' do |f| %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-5">
        <div>
          <%= f.label :status, 'Status', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.select :status, [['All statuses', '']] + Invoices::ListFilter::STATUSES.map { |key, status| [InvoicesHelper::STATUS_LABELS[status], key] },
                       { selected: params[:status] }, class: invoice_form_class(:input) %>
        </div>
        <div>
          <%= f.label :vendor_id, 'Vendor', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.select :vendor_id, options_from_collection_for_select(Users::Vendor.order(:business_name), :id, :business_name, params[:vendor_id]),
                       { include_blank: 'All vendors' }, class: invoice_form_class(:input) %>
        </div>
        <div>
          <%= f.label :date_basis, 'Dates refer to', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.select :date_basis, Invoices::ListFilter::DATE_BASES.map { |key, label| [label, key] },
                       { selected: @filter.date_basis }, class: invoice_form_class(:input) %>
        </div>
        <div>
          <%= f.label :from, 'From', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.text_field :from, typed_date_field_options(value: params[:from], class: invoice_form_class(:input), 'aria-describedby': 'filter-dates-hint') %>
        </div>
        <div>
          <%= f.label :through, 'Through', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.text_field :through, typed_date_field_options(value: params[:through], class: invoice_form_class(:input), 'aria-describedby': 'filter-dates-hint') %>
        </div>
      </div>
      <p id="filter-dates-hint" class="text-xs text-gray-500">Enter dates as MM/DD/YYYY. "Invoice period" finds invoices covering those days; "Payment date" finds invoices paid on them.</p>
      <%= f.submit 'Apply filters',
                   class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm ' \
                          'font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700' %>
    <% end %>
  </section>

  <section aria-labelledby="invoices-heading" class="bg-white shadow rounded-lg overflow-hidden">
    <h2 id="invoices-heading" class="px-6 pt-6 text-lg font-medium text-gray-900">Invoices (<%= @pagy.count %>)</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 mt-4">
        <thead class="bg-gray-50">
          <tr>
            <% ['Invoice', 'Vendor', 'Total', 'Status', 'Covers voucher redemptions', 'Paid'].each do |heading| %>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= heading %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @invoices.each do |invoice| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm"><%= link_to invoice.invoice_number, [:admin, invoice], class: 'text-indigo-600 hover:text-indigo-900' %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= invoice.vendor.business_name.presence || invoice.vendor.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_to_currency(invoice.total_amount) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm"><%= invoice_status_badge(invoice) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= invoice.period_label(format: '%b %-d, %Y') %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if invoice.status_invoice_paid? %>
                  <%= invoice.payment_date ? l(invoice.payment_date.to_date, format: :long) : 'Date not recorded' %>
                  <% if invoice_payment_method_label(invoice) %>· <%= invoice_payment_method_label(invoice) %><% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @invoices.empty? %>
      <p class="px-6 py-4 text-sm text-gray-500">No invoices match these filters.</p>
    <% end %>
    <div class="px-6 py-4 border-t border-gray-200"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  </section>
</div>
