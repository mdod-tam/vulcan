<% input_class = 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm' %>
<% primary_button = 'inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white ' \
                    'bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
<% secondary_button = 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 ' \
                      'bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
<div class="container mx-auto px-4 py-8 max-w-5xl">
  <nav aria-label="Breadcrumb" class="mb-2">
    <%= link_to 'Invoices', admin_invoices_path, class: 'text-sm font-medium text-gray-500 hover:text-gray-700' %>
  </nav>
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Invoice <%= @invoice.invoice_number %></h1>

  <section aria-labelledby="invoice-details-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="invoice-details-heading" class="text-lg font-medium text-gray-900 mb-4">Billing and payment</h2>
    <%= render 'invoices/payment_details', invoice: @invoice, audience: :admin %>
    <p class="mt-4 text-sm text-gray-600">
      Vendor: <%= link_to @invoice.vendor.business_name.presence || @invoice.vendor.email, admin_vendor_path(@invoice.vendor),
                          class: 'text-indigo-600 hover:text-indigo-900' %>
    </p>
  </section>

  <% if @invoice.status_invoice_pending? %>
    <section aria-labelledby="approve-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 id="approve-heading" class="text-lg font-medium text-gray-900 mb-2">Approve for payment</h2>
      <p class="text-sm text-gray-600 mb-4">Approval fixes the purchases and total on this invoice.</p>
      <%= button_to 'Approve invoice', approve_admin_invoice_path(@invoice),
                    method: :patch, params: { expected_status: @invoice.status }, class: primary_button %>
    </section>
  <% end %>

  <% if @invoice.status_invoice_approved? %>
    <section aria-labelledby="payment-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 id="payment-heading" class="text-lg font-medium text-gray-900 mb-2">Record payment</h2>
      <p id="payment-help" class="text-sm text-gray-600 mb-4">Record the one full payment for this invoice. Once recorded, payment details cannot be edited; corrections are added as notes.</p>
      <% input = @payment_input || {} %>
      <%= form_with url: record_payment_admin_invoice_path(@invoice), method: :patch, scope: :payment, class: 'space-y-4',
                    html: { 'aria-describedby': 'payment-help' } do |f| %>
        <%= hidden_field_tag :expected_status, @invoice.status, id: nil %>
        <% if @payment_errors&.any? %>
          <div id="payment-errors" role="alert" tabindex="-1" data-controller="error-summary"
               class="rounded-md bg-red-50 p-4 focus:outline-none focus:ring-2 focus:ring-red-500">
            <h3 class="text-sm font-medium text-red-800">The payment was not recorded:</h3>
            <ul class="mt-2 list-disc list-inside text-sm text-red-700">
              <% @payment_errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <%= f.label :payment_date, 'Payment date', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :payment_date, typed_date_field_options(value: input[:payment_date], required: true, class: input_class,
                                                                     'aria-describedby': 'payment-date-hint') %>
            <p id="payment-date-hint" class="text-xs text-gray-500 mt-1">The date the payment was made. Enter as MM/DD/YYYY.</p>
          </div>
          <div>
            <%= f.label :payment_method, 'Payment method', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :payment_method, invoice_payment_method_options, { include_blank: 'Choose a method', selected: input[:payment_method] },
                         required: true, class: input_class %>
          </div>
          <div>
            <%= f.label :payment_reference, 'Payment reference (direct deposit or EFT)', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :payment_reference, value: input[:payment_reference], class: input_class %>
          </div>
          <div>
            <%= f.label :check_number, 'Check number (checks)', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :check_number, value: input[:check_number], class: input_class %>
          </div>
          <div>
            <%= f.label :gad_invoice_reference, 'GAD invoice reference', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :gad_invoice_reference, value: input[:gad_invoice_reference], required: true, class: input_class %>
          </div>
        </div>
        <div>
          <%= f.label :payment_notes, 'Internal payment notes (optional, not shown to the vendor)', class: 'block text-sm font-medium text-gray-700' %>
          <%= f.text_area :payment_notes, value: input[:payment_notes], rows: 2, class: input_class %>
        </div>
        <%= f.submit 'Record payment', class: primary_button %>
      <% end %>
    </section>
  <% end %>

  <% if @invoice.status_invoice_pending? || @invoice.status_invoice_approved? %>
    <section aria-labelledby="withdraw-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 id="withdraw-heading" class="text-lg font-medium text-gray-900 mb-2">Withdraw invoice</h2>
      <p id="withdraw-help" class="text-sm text-gray-600 mb-4">
        Its purchases are released and can be added to a later invoice. This invoice and its number are kept and marked Withdrawn.
        To keep a purchase off the next invoice, put it on hold from its voucher page after withdrawing.
      </p>
      <% withdraw_confirm = 'Withdraw this invoice? Its purchases are released and can be added to a later invoice. ' \
                            'The invoice and its number are kept and marked Withdrawn.' %>
      <%= form_with url: withdraw_admin_invoice_path(@invoice), method: :patch, class: 'space-y-4',
                    data: { turbo_confirm: withdraw_confirm } do |f| %>
        <%= hidden_field_tag :expected_status, @invoice.status, id: nil %>
        <div>
          <%= label_tag :reason, 'Reason', class: 'block text-sm font-medium text-gray-700' %>
          <%= text_area_tag :reason, nil, rows: 2, required: true, class: input_class, 'aria-describedby': 'withdraw-help' %>
        </div>
        <%= submit_tag 'Withdraw invoice', class: secondary_button %>
      <% end %>
    </section>
  <% end %>

  <% if @invoice.status_invoice_paid? || @invoice.status_invoice_cancelled? %>
    <section aria-labelledby="correction-heading" class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 id="correction-heading" class="text-lg font-medium text-gray-900 mb-2">Add a correction note</h2>
      <p id="correction-help" class="text-sm text-gray-600 mb-4">
        Fix the error in accounting first, then record its accounting reference and what was done. The note is kept in this
        invoice's history; the original payment details are not changed.
      </p>
      <%= form_with url: correction_note_admin_invoice_path(@invoice), method: :post, class: 'space-y-4' do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div>
            <%= label_tag :reference, 'Accounting reference', class: 'block text-sm font-medium text-gray-700' %>
            <%= text_field_tag :reference, nil, required: true, autocomplete: 'off', class: input_class %>
          </div>
          <div class="md:col-span-2">
            <%= label_tag :note, 'Note', class: 'block text-sm font-medium text-gray-700' %>
            <%= text_area_tag :note, nil, rows: 2, required: true, class: input_class, 'aria-describedby': 'correction-help' %>
          </div>
        </div>
        <%= submit_tag 'Add correction note', class: secondary_button %>
      <% end %>
    </section>
  <% end %>

  <section aria-labelledby="purchases-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="purchases-heading" class="text-lg font-medium text-gray-900 mb-4">Purchases (<%= @transactions.size %>)</h2>
    <% if @transactions.any? %>
      <ul role="list" class="divide-y divide-gray-200">
        <% @transactions.each do |transaction| %>
          <li class="py-3 flex flex-wrap justify-between gap-2 text-sm">
            <span>
              <%= number_to_currency(transaction.amount) %> on voucher
              <%= link_to transaction.voucher.code, [:admin, transaction.voucher], class: 'font-medium text-indigo-600 hover:text-indigo-900' %>
            </span>
            <span class="text-gray-500"><%= l(transaction.processed_at.to_date, format: :long) %> · Ref <%= transaction.reference_number %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">No purchases are on this invoice.</p>
    <% end %>
  </section>

  <section aria-labelledby="history-heading" class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 id="history-heading" class="text-lg font-medium text-gray-900 mb-4">History</h2>
    <ul role="list" class="divide-y divide-gray-200">
      <% @audit_events.each do |event| %>
        <li class="py-3 text-sm">
          <span class="font-medium text-gray-900"><%= event.action.humanize %></span>
          <span class="text-gray-500">· <%= event.user&.full_name || 'System' %> · <%= l(event.created_at, format: :long) %></span>
          <% details = event.metadata.to_h.slice('reason', 'reference', 'note', 'from_status', 'to_status').compact_blank %>
          <% if details.any? %>
            <p class="text-gray-700 mt-1">
              <%= details.map { |key, value| "#{key.humanize}: #{key.end_with?('_status') ? InvoicesHelper::STATUS_LABELS.fetch(value, value) : value}" }
                         .join(' · ') %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @invoice.email_delivery_attempts.any? %>
    <section aria-label="<%= t('delivery_visibility.history') %>" class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4"><%= t('delivery_visibility.history') %></h2>
      <%= delivery_visibility(@invoice) %>
    </section>
  <% end %>
</div>
