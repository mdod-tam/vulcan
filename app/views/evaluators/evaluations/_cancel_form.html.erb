<%# locals: (evaluation:) -%>
<% form_values = @evaluation_form_values.fetch(:cancel, {}) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<div class="card mb-6">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="cancel-evaluation-heading">
      Cancel Evaluation
    </h3>

    <%= form_with(
          model: evaluation,
          namespace: 'cancel',
          url: cancel_evaluators_evaluation_path(evaluation),
          method: :post,
          local: true,
          id: 'cancel-evaluation-form',
          class: 'space-y-4'
        ) do |f| %>
      <%= render(
            'shared/action_errors',
            action: :cancel, form: f, form_errors: @evaluation_form_errors,
            heading: evaluation_action_error_heading(:cancel)
          ) %>
      <div>
        <%= f.label :notes, class: 'form-label' do %>
          Cancellation Reason <span class="text-danger-600">*</span><span class="sr-only"> (required)</span>
        <% end %>
        <%= f.text_area(
              :notes,
              value: form_values.fetch(:notes, ''),
              rows: 3,
              class: 'form-input mt-1',
              required: true,
              placeholder: 'Please provide a reason...',
              aria: action_form_field_aria(:cancel, :notes, describedby: 'cancel-notes-help', form_errors: @evaluation_form_errors)
            ) %>
        <p id="cancel-notes-help" class="form-hint">
          <strong><%= t('evaluators.evaluations.forms.internal_notes_only') %></strong>
        </p>
        <%= render 'shared/field_errors', action: :cancel, attribute: :notes, form_errors: @evaluation_form_errors %>
      </div>

      <%= f.submit 'Cancel Evaluation',
                   data: { turbo_submits_with: 'Cancelling...' },
                   class: 'btn btn-danger w-full' %>
    <% end %>
  </div>
</div>
