<%# locals: (evaluation:, available_products:, recommendation_products:) -%>
<% form_values = @evaluation_form_values.fetch(:submit_report, {}) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<% trial_inputs = (form_values.empty? ? evaluation.products_tried_inputs : form_values.fetch(:products_tried_inputs, {})).with_indifferent_access # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<% outside_specialist = evaluation.status_requested? || form_values[:assessment_source] == 'outside_specialist' # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<% confirmed_groups = Array(form_values.fetch(:program_disability_groups, evaluation.application.program_disability_groups)).compact_blank.uniq # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<% selected_ids = form_values.fetch(:recommended_product_ids, evaluation.recommended_product_ids) # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<% profile_values = evaluation_equipment_profile_values(evaluation, form_values) # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<% location_required = !outside_specialist && !evaluation.outside_specialist_report_allowed?(current_user) # rubocop:disable Lint/UselessAssignment -- ERB local. %>
<div class="card">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
      Complete evaluation report
    </h3>
    <p class="text-sm text-gray-600 mb-4">
      <%= t('evaluators.evaluations.forms.report_help') %>
    </p>

    <%= form_with(
          model: evaluation,
          namespace: 'complete',
          url: submit_report_evaluators_evaluation_path(evaluation),
          method: :post,
          local: true,
          id: 'complete-evaluation-form',
          class: 'space-y-4',
          data: { controller: 'recommendation-outcome', action: 'change->recommendation-outcome#update',
                  recommendation_outcome_conflict_value: t('evaluators.evaluations.recommendations.conflict') }
        ) do |f| %>
      <%= render(
            'shared/action_errors',
            action: :submit_report, form: f, form_errors: @evaluation_form_errors,
            heading: evaluation_action_error_heading(:submit_report),
            field_targets: evaluation_report_error_targets
          ) %>
      <% if evaluation.outside_specialist_report_allowed?(current_user) %>
        <div>
          <%= f.label :assessment_source, 'Assessment source', class: 'form-label' %>
          <%= f.select :assessment_source, evaluation_assessment_source_options(evaluation),
                       { include_blank: 'Select assessment source',
                         selected: form_values.fetch(:assessment_source, evaluation.status_requested? ? nil : 'direct_assessment') },
                       required: true,
                       class: 'form-input mt-1',
                       aria: action_form_field_aria(:submit_report, :assessment_source, describedby: 'assessment-source-help', form_errors: @evaluation_form_errors),
                       data: { recommendation_outcome_target: 'source', action: 'recommendation-outcome#update' } %>
          <p id="assessment-source-help" class="form-hint">
            For a consultation with an outside specialist, enter the consultation date and describe the source and context in Report internal notes. Include product trials only when you know what was tried. For a direct assessment, schedule an appointment first.
          </p>
          <%= render 'shared/field_errors', action: :submit_report, attribute: :assessment_source, form_errors: @evaluation_form_errors %>
        </div>
      <% end %>
      <div>
        <%= f.label :appointment_completed_at, class: 'form-label' do %>
          <%= if evaluation.outside_specialist_report_allowed?(current_user)
                'Assessment or consultation date and time'
              else
                t('evaluators.evaluations.forms.appointment_date_time')
              end %> <span class="text-danger-600">*</span><span class="sr-only"> (required)</span>
        <% end %>
        <%= f.datetime_local_field(
              :appointment_completed_at,
              value: form_values.fetch(
                :appointment_completed_at,
                evaluation.evaluation_date&.past? ? evaluation.evaluation_date.strftime('%Y-%m-%dT%H:%M') : nil
              ),
              class: 'form-input mt-1',
              required: true,
              aria: action_form_field_aria(:submit_report, :appointment_completed_at, describedby: 'complete-time-help', form_errors: @evaluation_form_errors)
            ) %>
        <p id="complete-time-help" class="form-hint">
          <%= t('evaluators.evaluations.forms.appointment_time_help') %>
          <%= t('date_time_input.hint', zone: Time.zone.name) %>
        </p>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :appointment_completed_at, form_errors: @evaluation_form_errors %>
      </div>
      <div>
        <%= f.label :location, class: 'form-label' do %>
          Location <span data-recommendation-outcome-target="locationRequired" class="<%= 'hidden' if outside_specialist %>"><span class="text-danger-600">*</span><span class="sr-only"> (required)</span></span>
        <% end %>
        <%= f.text_field(
              :location,
              value: form_values.fetch(:location, evaluation.location),
              class: 'form-input mt-1',
              required: location_required,
              aria: action_form_field_aria(:submit_report, :location, form_errors: @evaluation_form_errors).merge(required: location_required),
              data: { recommendation_outcome_target: 'location' }
            ) %>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :location, form_errors: @evaluation_form_errors %>
      </div>

      <div>
        <%= f.label :attendees_field, class: 'form-label' do %>
          Other Attendees <span class="text-gray-500 font-normal">(optional)</span>
        <% end %>
        <%= f.text_field(
              :attendees_field,
              value: form_values.fetch(:attendees_field, evaluation.attendees_field),
              class: 'form-input mt-1',
              placeholder: 'e.g., family friend, interpreter, Jane Doe',
              aria: action_form_field_aria(:submit_report, :attendees_field, describedby: 'complete-attendees-help', form_errors: @evaluation_form_errors)
            ) %>
        <p id="complete-attendees-help" class="form-hint">If anyone else attended the session, include them here. Separate multiple attendees with commas.</p>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :attendees_field, form_errors: @evaluation_form_errors %>
      </div>

      <fieldset id="program-groups-group" class="rounded border border-gray-300 p-4" tabindex="-1">
        <legend class="form-label">Program eligibility groups</legend>
        <p class="form-hint">Confirm each program group the applicant qualifies for. Browsing products from another group does not confirm eligibility.</p>
        <%= hidden_field_tag 'evaluation[program_disability_groups][]', '', id: nil %>
        <div class="grid gap-3 sm:grid-cols-2">
          <% (Product::PROGRAM_GROUPS.keys | Array(confirmed_groups)).each do |group| %>
            <label class="flex items-center gap-2">
              <%= check_box_tag 'evaluation[program_disability_groups][]', group, confirmed_groups.include?(group),
                                id: "report-program-group-#{group}", data: { recommendation_outcome_target: 'group' } %>
              <%= Product::PROGRAM_GROUPS.fetch(group, "#{group} (invalid group)") %>
            </label>
          <% end %>
        </div>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :program_disability_groups, form_errors: @evaluation_form_errors %>
      </fieldset>

      <details class="rounded border border-gray-300 p-4">
        <summary class="font-medium">Default equipment shipping address</summary>
        <p class="form-hint mt-2">Confirm where the equipment should be sent, including any apartment or unit number. The suggested address may belong to a guardian. You can submit this report now and confirm the address later during equipment review.</p>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <% EquipmentShipping::FIELDS.each do |field| %>
            <div>
              <%= f.label field, field.delete_prefix('shipping_').humanize, class: 'form-label' %>
              <%= f.text_field field, value: profile_values[field], class: 'form-input mt-1' %>
            </div>
          <% end %>
        </div>
        <label class="mt-4 flex items-center gap-2">
          <%= check_box_tag 'evaluation[shipping_confirmed]', '1', form_values[:shipping_confirmed] == '1', id: 'report-shipping-confirmed' %>
          Use this confirmed address for equipment shipments
        </label>
      </details>

      <fieldset id="products-tried-group" tabindex="-1" class="rounded-md"
                <%= tag.attributes(aria: action_form_field_aria(
                      :submit_report, :products_tried_inputs,
                      describedby: 'products-tried-help',
                      form_errors: @evaluation_form_errors
                    )) %>>
        <legend class="form-label">
          Products Tried
          <span data-recommendation-outcome-target="triedRequired" class="hidden">
            <span class="text-danger-600">*</span><span class="sr-only"> (required)</span>
          </span>
        </legend>
        <p id="products-tried-help" class="form-hint"><%= t('evaluators.evaluations.recommendations.tried_help') %></p>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :products_tried_inputs, form_errors: @evaluation_form_errors %>
        <div class="mt-2 space-y-3 border border-gray-300 rounded-md p-3 bg-white">
          <% available_products.group_by(&:category).each do |category, products| %>
            <details open class="rounded border border-gray-200 p-3">
              <summary class="font-medium"><%= Product::CATEGORIES.fetch(category, category) %></summary>
              <% products.each do |product| %>
            <% trial = trial_inputs.fetch(product.id.to_s, {}).with_indifferent_access # rubocop:disable Lint/UselessAssignment -- ERB local. %>
            <div class="space-y-2" data-recommendation-outcome-target="trialRow">
              <div class="flex items-start gap-3">
                <%= hidden_field_tag "evaluation[products_tried_inputs][#{product.id}][selected]", '0', id: nil %>
                <%= check_box_tag "evaluation[products_tried_inputs][#{product.id}][selected]", '1', trial[:selected] == '1',
                                  id: "trial-#{product.id}", class: 'mt-1 h-4 w-4 rounded border-gray-300 text-primary-600',
                                  data: { trial_choice: true } %>
                <%= label_tag "trial-#{product.id}", product.catalog_label, class: 'form-label' %>
              </div>
              <div class="ml-7" data-trial-rating <%= 'hidden' unless trial[:selected] == '1' %>>
                <%= label_tag "trial-#{product.id}-reaction", "Satisfaction with #{product.name}", class: 'form-label' %>
                <%= select_tag "evaluation[products_tried_inputs][#{product.id}][reaction]",
                               options_for_select(Evaluation::TRIAL_REACTIONS, trial[:reaction]),
                               include_blank: 'Select satisfaction', id: "trial-#{product.id}-reaction",
                               class: 'form-input mt-1', disabled: trial[:selected] != '1', required: trial[:selected] == '1',
                               aria: action_form_field_aria(:submit_report, :products_tried_inputs, form_errors: @evaluation_form_errors),
                               data: { trial_reaction: true } %>
              </div>
            </div>
              <% end %>
            </details>
          <% end %>
        </div>
      </fieldset>

      <fieldset id="catalog-recommendations-group" tabindex="-1"
                class="rounded-md"
                <%= tag.attributes(aria: action_form_field_aria(:submit_report, :recommended_product_ids, form_errors: @evaluation_form_errors)) %>>
        <legend class="form-label"><%= t('evaluators.evaluations.recommendations.catalog_heading') %></legend>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :recommended_product_ids, form_errors: @evaluation_form_errors %>
        <div class="my-3 flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="grow">
            <%= label_tag 'report-catalog-search', 'Search manufacturer or model', class: 'form-label' %>
            <%= search_field_tag nil, nil, id: 'report-catalog-search', class: 'form-input', autocomplete: 'off',
                                           data: { recommendation_outcome_target: 'search', action: 'input->recommendation-outcome#filter' } %>
          </div>
          <label class="flex items-center gap-2">
            <%= check_box_tag 'catalog_show_all', '1', false, data: { recommendation_outcome_target: 'showAll', action: 'recommendation-outcome#filter' } %>
            Show all active products
          </label>
        </div>
        <p class="form-hint">Products are shown for the selected program groups. To recommend a product from another group, confirm that the applicant also qualifies for that group.</p>
        <div class="mt-2 space-y-3">
          <% recommendation_products.group_by(&:category).each do |category, products| %>
            <details open class="rounded border border-gray-300 p-3">
              <summary class="font-medium"><%= Product::CATEGORIES.fetch(category, category) %></summary>
              <%= f.collection_check_boxes :recommended_product_ids, products, :id, :catalog_label,
                                           checked: selected_ids do |box| %>
                <div class="mt-3 flex items-start gap-3 <%= 'hidden' unless evaluation_recommendation_visible?(box.object, confirmed_groups, selected_ids) %>"
                     data-recommendation-outcome-target="productRow"
                     data-product-groups="<%= box.object.eligible_disability_groups.join(' ') %>"
                     data-product-search="<%= box.object.catalog_label.downcase %>">
                  <%= box.check_box class: 'mt-1 h-4 w-4 rounded border-gray-300 text-primary-600', data: { recommendation_outcome_target: 'catalog' } %>
                  <div>
                    <%= box.label class: 'font-medium text-gray-700' %>
                    <% unless box.object.available? %><p class="text-danger-700">This product is unavailable. Uncheck it before submitting the report.</p><% end %>
                  </div>
                </div>
              <% end %>
            </details>
          <% end %>
        </div>
      </fieldset>

      <div>
        <%= f.label :recommendation_notes, class: 'form-label' do %>
          <%= t('evaluators.evaluations.recommendations.details') %>
          <span data-recommendation-outcome-target="notesRequired" class="hidden">
            <span class="text-danger-600">*</span><span class="sr-only"> (required)</span>
          </span>
        <% end %>
        <p id="recommendation-notes-help" class="mt-1 text-sm text-gray-700"><strong><%= t('evaluators.evaluations.recommendations.details_help') %></strong></p>
        <%= f.text_area :recommendation_notes,
                        value: form_values.fetch(:recommendation_notes, evaluation.recommendation_notes),
                        rows: 3,
                        required: false,
                        class: 'form-input mt-1',
                        aria: action_form_field_aria(
                          :submit_report, :recommendation_notes,
                          describedby: 'recommendation-notes-help',
                          form_errors: @evaluation_form_errors
                        ),
                        data: { recommendation_outcome_target: 'notes' } %>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :recommendation_notes, form_errors: @evaluation_form_errors %>
      </div>

      <div id="recommendation-outcome-group" tabindex="-1" class="rounded-md">
        <div class="flex items-start gap-3">
          <%= hidden_field_tag 'evaluation[no_suitable_product]', '0', id: nil %>
          <%= check_box_tag 'evaluation[no_suitable_product]', '1', form_values[:no_suitable_product] == '1',
                            id: 'complete_evaluation_no_suitable_product',
                            class: 'mt-1 h-4 w-4 rounded border-gray-300 text-primary-600',
                            aria: action_form_field_aria(
                              :submit_report, :no_suitable_product, describedby: 'no-suitable-product-help', form_errors: @evaluation_form_errors
                            ),
                            data: { recommendation_outcome_target: 'noSuitable' } %>
          <%= f.label :no_suitable_product, t('evaluators.evaluations.recommendations.no_suitable_product_label'), class: 'form-label' %>
        </div>
        <p id="no-suitable-product-help" class="form-hint"><%= t('evaluators.evaluations.recommendations.no_suitable_product_help') %></p>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :no_suitable_product, form_errors: @evaluation_form_errors %>
      </div>

      <div>
        <%= f.label :notes, class: 'form-label' do %>
          <%= t('evaluators.evaluations.forms.report_internal_notes') %> <span class="text-danger-600">*</span><span class="sr-only"> (required)</span>
        <% end %>
        <%= f.text_area(
              :notes,
              value: form_values.fetch(:notes, ''),
              rows: 3,
              class: 'form-input mt-1',
              placeholder: 'Evaluation notes, including specific needs...',
              required: true,
              aria: action_form_field_aria(:submit_report, :notes, describedby: 'complete-internal-notes-help', form_errors: @evaluation_form_errors)
            ) %>
        <p id="complete-internal-notes-help" class="mt-1 text-sm text-gray-700">
          <strong><%= t('evaluators.evaluations.forms.internal_notes_only') %></strong>
          <%= t('evaluators.evaluations.forms.report_internal_notes_help') %>
        </p>
        <%= render 'shared/field_errors', action: :submit_report, attribute: :notes, form_errors: @evaluation_form_errors %>
      </div>

      <%= f.submit 'Submit completed report',
                   data: { turbo_submits_with: 'Submitting report...' },
                   class: 'btn btn-success w-full' %>
    <% end %>
  </div>
</div>
