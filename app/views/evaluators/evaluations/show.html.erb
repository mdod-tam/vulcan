<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:p-2 focus:bg-indigo-600 focus:text-white focus:z-50 focus:rounded">
  Skip to main content
</a>

<div id="main-content" tabindex="-1" class="container mx-auto px-4 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
    <h1 class="text-2xl font-bold mb-2 sm:mb-0" id="page-heading">Evaluation Details</h1>

    <div class="flex items-center space-x-4">
      <%= link_to "Back to Evaluations", evaluators_evaluations_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded inline-flex items-center" %>
    </div>
  </div>

  <section aria-labelledby="evaluation-details-heading" class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
      <div>
        <h2 id="evaluation-details-heading" class="text-lg leading-6 font-medium text-gray-900">
          Evaluation for <%= @evaluation.constituent.full_name %>
        </h2>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">
          Application #<%= @evaluation.application_id %>
        </p>
        <%= link_to current_user.admin? ? 'View Full Application Details' : t('evaluator_context.link'),
                    current_user.admin? ? admin_application_path(@evaluation.application) : application_details_evaluators_evaluation_path(@evaluation),
                    class: "mt-1 inline-block text-sm text-indigo-600 hover:text-indigo-900" %>
      </div>

      <%= evaluation_status_badge(@evaluation) %>
    </div>

    <div class="border-t border-gray-200">
      <dl>
        <% if @evaluation.status_completed? %>
          <% [
               [t('evaluators.evaluations.dates.scheduled_for'), @evaluation.evaluation_date],
               [t('evaluators.evaluations.dates.appointment_completed_at'), @evaluation.appointment_completed_at],
               [t('evaluators.evaluations.dates.report_submitted_at'), @evaluation.report_submitted_at]
             ].each do |label, date| %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <% if date.present? %>
                  <time datetime="<%= date.iso8601 %>"><%= date.strftime('%B %d, %Y at %I:%M %p %Z') %></time>
                <% else %>
                  <%= t('evaluators.evaluations.dates.not_recorded') %>
                <% end %>
              </dd>
            </div>
          <% end %>
        <% elsif @evaluation.status_requested? && @evaluation.evaluation_date.blank? %>
          <div class="bg-blue-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-blue-900">Next Step</dt>
            <dd class="mt-1 text-sm text-blue-900 sm:mt-0 sm:col-span-2">
              <p class="font-semibold">This evaluation has not been scheduled yet.</p>
              <p class="mt-1">
                <% if @can_manage_evaluation %>
                  This evaluation was assigned to <%= @evaluation.evaluator.full_name %>, but no date has been set. Contact the applicant, agree on an evaluation time, then use the scheduling form below.
                <% else %>
                  This evaluation was assigned to <%= @evaluation.evaluator.full_name %>, but no date has been set. The assigned evaluator should contact the applicant and set the evaluation date.
                <% end %>
              </p>
            </dd>
          </div>
        <% elsif !@evaluation.status_cancelled? && !@evaluation.status_no_show? %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Scheduled For</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <% if @evaluation.evaluation_date.present? %>
                <time datetime="<%= @evaluation.evaluation_date.iso8601 %>">
                  <%= @evaluation.evaluation_date.strftime('%B %d, %Y at %I:%M %p %Z') %>
                </time>
              <% else %>
                Not scheduled
              <% end %>
            </dd>
          </div>
        <% end %>

        <% if @evaluation.location.present? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Location</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= @evaluation.location %>
            </dd>
          </div>
        <% end %>

        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Assigned Evaluator</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= link_to @evaluation.evaluator.full_name,
                        evaluators_evaluations_path(scope: current_user.admin? ? "all" : "mine"),
                        class: "text-indigo-600 hover:text-indigo-900" %>
          </dd>
        </div>

        <% if @evaluation.notes.present? && @evaluation.status_completed? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Evaluator Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= simple_format(@evaluation.notes) %>
            </dd>
          </div>
        <% elsif @evaluation.notes.present? && @evaluation.status_cancelled? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Current Cancellation Reason</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= simple_format(@evaluation.notes) %>
            </dd>
          </div>
        <% elsif @evaluation.notes.present? && @evaluation.status_no_show? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Current No-Show Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= simple_format(@evaluation.notes) %>
            </dd>
          </div>
        <% elsif @evaluation.notes.present? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Current Evaluator Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= simple_format(@evaluation.notes) %>
            </dd>
          </div>
        <% end %>

        <% if @evaluation.reschedule_reason.present? %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Current Rescheduling Reason</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= simple_format(@evaluation.reschedule_reason) %>
            </dd>
          </div>
        <% end %>

        <%= render 'assessment_contacts', context: @contact_context %>

        <% if @evaluation.attendees.any? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Attendees</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= safe_join(@evaluation.attendee_display_values, tag.br) %>
            </dd>
          </div>
        <% end %>

        <% if @evaluation.products_tried.any? %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Products Tried</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <ul class="list-disc pl-5">
                <% @evaluation.products_tried.each do |product| %>
                  <% product_name = Product.find_by(id: product['product_id'])&.name || "Unknown Product" %>
                  <li><%= "#{product_name} — #{product['reaction']}" %></li>
                <% end %>
              </ul>
            </dd>
          </div>
        <% end %>

        <% if @evaluation.recommended_products.any? %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Recommended Products</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <ul class="list-disc pl-5">
                <% @evaluation.recommended_products.each do |product| %>
                  <li><%= product.name %></li>
                <% end %>
              </ul>
            </dd>
          </div>
        <% end %>
        <% if @evaluation.status_completed? %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500"><%= t('evaluators.evaluations.recommendations.outcome') %></dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= t("evaluations.recommendation_outcomes.#{@evaluation.recommendation_outcome}") %>
            </dd>
          </div>
          <% if @evaluation.recommendation_notes.present? %>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500"><%= t('evaluators.evaluations.recommendations.details') %></dt>
              <dd class="mt-1 min-w-0 break-words text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <%= simple_format(@evaluation.recommendation_notes) %>
              </dd>
            </div>
          <% end %>
        <% end %>
      </dl>
    </div>
  </section>

  <%= render 'working_notes_form', evaluation: @evaluation,
                                   can_edit: @can_manage_evaluation && @evaluation.working_notes_editable? %>

  <% visible_form_actions = evaluation_visible_form_actions(@evaluation, can_manage: @can_manage_evaluation) # rubocop:disable Lint/UselessAssignment -- ERB local. %>
  <section aria-label="<%= @can_manage_evaluation ? 'Evaluation Actions' : 'Evaluation Status' %>" class="mt-8">
    <% if !@can_manage_evaluation %>
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-sm text-slate-700">
        This is a read-only oversight view. Only the assigned evaluator can update this evaluation.
      </div>
    <% elsif visible_form_actions.include?(:schedule) %>
      <div class="space-y-6 mb-6">
        <%= render "schedule_form", evaluation: @evaluation %>
        <%= render "cancel_form", evaluation: @evaluation %>
      </div>
    <% elsif visible_form_actions.include?(:no_show) %>
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-sm text-blue-900 mb-6">
        <p class="font-semibold">This evaluation needs an outcome.</p>
        <p class="mt-1">The scheduled time for this evaluation has passed. Record the evaluation outcome, or use a secondary action if the evaluation did not happen as planned.</p>
      </div>
      <div class="space-y-6 mb-6">
        <%= render "completion_form", evaluation: @evaluation, available_products: @available_products %>
        <%= render "no_show_form", evaluation: @evaluation %>
        <%= render "cancel_form", evaluation: @evaluation %>
        <%= render "reschedule_form",
            evaluation: @evaluation,
            suggested_date: @evaluation.evaluation_date %>
      </div>
    <% elsif visible_form_actions.include?(:submit_report) %>
      <div class="space-y-6 mb-6">
        <%= render "completion_form", evaluation: @evaluation, available_products: @available_products %>
        <%= render "cancel_form", evaluation: @evaluation %>
        <%= render "reschedule_form",
            evaluation: @evaluation,
            suggested_date: @evaluation.evaluation_date %>
      </div>
    <% elsif visible_form_actions.include?(:reschedule) %>
      <%= render "reschedule_form",
          evaluation: @evaluation,
          suggested_date: 1.week.from_now %>
    <% elsif visible_form_actions.include?(:supplemental_notes) %>
      <%= render "completed_notes_form", evaluation: @evaluation %>
    <% else %>
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-sm text-slate-700">
        No lifecycle actions are available for this evaluation status.
      </div>
    <% end %>
    <% (@evaluation_form_errors.keys.map(&:to_sym) - visible_form_actions - [:save_working_notes]).each do |action| %>
      <div class="mt-6">
        <%= render 'action_errors', action: action, form: nil, form_errors: @evaluation_form_errors %>
      </div>
    <% end %>
  </section>

  <div class="mt-8">
    <%= render "shared/activity_history", activity_logs: @activity_logs, title: "Activity History" %>
  </div>
</div>

<% if @evaluation.email_delivery_attempts.any? %>
  <section class="mt-6 rounded border border-gray-200 p-4" aria-label="<%= t('delivery_visibility.history') %>">
    <h2 class="text-lg font-semibold"><%= t('delivery_visibility.history') %></h2>
    <%= delivery_visibility(@evaluation) %>
  </section>
<% end %>
