<%# locals: (evaluation:) -%>
<% form_values = @evaluation_form_values.fetch(:no_show, {}) # rubocop:disable Lint/UselessAssignment -- Used by later ERB fragments. %>
<div class="card">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="no-show-evaluation-heading">
      Mark as No-Show
    </h3>
    <p class="text-sm text-gray-600 mb-4">
      Use this if the applicant did not attend the scheduled evaluation session.
    </p>

    <%= form_with(
          model: evaluation,
          namespace: 'no-show',
          url: no_show_evaluators_evaluation_path(evaluation),
          method: :post,
          local: true,
          id: 'no-show-evaluation-form',
          class: 'space-y-4'
        ) do |f| %>
      <%= render(
            'shared/action_errors',
            action: :no_show, form: f, form_errors: @evaluation_form_errors,
            heading: evaluation_action_error_heading(:no_show)
          ) %>
      <div>
        <%= f.label :notes, "No-Show Notes (optional)", class: 'form-label' %>
        <%= f.text_area(
              :notes,
              value: form_values.fetch(:notes, ''),
              rows: 3,
              class: 'form-input mt-1',
              placeholder: 'Optional notes about the no-show...',
              aria: action_form_field_aria(:no_show, :notes, describedby: 'no-show-notes-help', form_errors: @evaluation_form_errors)
            ) %>
        <p id="no-show-notes-help" class="form-hint">
          <strong><%= t('evaluators.evaluations.forms.internal_notes_only') %></strong>
        </p>
        <%= render 'shared/field_errors', action: :no_show, attribute: :notes, form_errors: @evaluation_form_errors %>
      </div>
      <%= f.submit 'Mark as No-Show',
                   data: { turbo_submits_with: 'Recording no-show...' },
                   class: 'btn btn-danger w-full' %>
    <% end %>
  </div>
</div>
