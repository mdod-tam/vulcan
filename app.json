{
  "name": "mat_vulcan",
  "description": "Application for administering programs",
  "keywords": [
    "rails",
    "ruby"
  ],
  "stack": "heroku-26",
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "heroku/ruby" }
  ],
  "env": {
    "SKIP_YARN_INSTALL": {
      "description": "Node installs dependencies before Rails builds assets; skip the Rails bundling tasks' duplicate installs.",
      "value": "1"
    }
  },
  "environments": {
    "test": {
      "buildpacks": [
        { "url": "heroku/nodejs" },
        { "url": "heroku/ruby" },
        { "url": "heroku-community/chrome-for-testing" }
      ],
      "addons": [
        "bucketeer"
      ],
      "env": {
        "RAILS_ENV": "test",
        "HEADLESS": "true",
        "CHROME_NO_SANDBOX": "true"
      },
      "scripts": {
        "test-setup": "bin/rails db:prepare",
        "test": "bin/rails test && bin/rails test:system"
      }
    }
  }
}
