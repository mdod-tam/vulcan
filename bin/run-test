#!/usr/bin/env bash
set -euo pipefail

# Runs a test with auth debugging and system-test screenshots enabled, then prints the end of the test log.

echo "=============================================="
echo "System Test Runner with Enhanced Debugging"
echo "=============================================="

export DEBUG_AUTH=true
export RAILS_SYSTEM_TESTING_SCREENSHOT="${RAILS_SYSTEM_TESTING_SCREENSHOT:-simple}"
export RAILS_SYSTEM_TESTING_SCREENSHOT_HTML="${RAILS_SYSTEM_TESTING_SCREENSHOT_HTML:-1}"

chrome_version=$(google-chrome --version 2>/dev/null || chrome --version 2>/dev/null \
  || "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --version 2>/dev/null \
  || echo "Unknown Chrome version")
echo "Chrome version: $chrome_version"

echo "Running test with debugging enabled..."
echo "Command: bin/rails test $@"
RAILS_ENV=test bin/rails test "$@" -v

echo "=============================================="
echo "Recent test logs:"
tail -n 20 log/test.log 2>/dev/null || echo "No test log found"

echo "=============================================="
echo "Test run complete"
echo "Screenshots saved to: tmp/capybara/"
